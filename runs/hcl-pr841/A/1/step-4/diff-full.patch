+func TestBodySetAttributeKeepsStructure(t *testing.T) {
+	expr, diags := ParseExpression([]byte(`{ hat = "derby" }`), "", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatalf("unexpected diagnostics: %s", diags)
+	}
+
+	f := NewFile()
+	f.Body().SetAttribute("a", expr)
+
+	obj := f.Body().GetAttribute("a").Expr().AsObjectConsExpr()
