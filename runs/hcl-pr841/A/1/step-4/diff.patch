diff --git a/hclwrite/parser.go b/hclwrite/parser.go
index 6bbea42..d67f2f9 100644
--- a/hclwrite/parser.go
+++ b/hclwrite/parser.go
@@ -69,6 +69,39 @@ func parse(src []byte, filename string, start hcl.Pos) (*File, hcl.Diagnostics)
 	return ret, diags
 }
 
+// parseExpr is like parse, but parses the given source as a single
+// standalone expression. Any comments, newlines and spaces before or after
+// the expression are discarded.
+//
+// If the parsing step produces any errors, the returned Expression is nil
+// for the same reason as for parse.
+func parseExpr(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	nativeTokens, lexDiags := hclsyntax.LexExpression(src, filename, start)
+	if lexDiags.HasErrors() {
+		// should never happen, since we would've caught these diags in
+		// the first call above.
+		return nil, lexDiags
+	}
+
+	from := inputTokens{
+		nativeTokens: nativeTokens,
+		writerTokens: writerTokens(nativeTokens),
+	}
+	_, within, _ := from.Partition(nativeExpr.Range())
+	if len(within.writerTokens) > 0 {
+		// The spaces before the first token separate it from the dropped
+		// tokens, so they are not part of the expression either.
+		within.writerTokens[0].SpacesBefore = 0
+	}
+
+	return parseExpression(nativeExpr, within).content.(*Expression), diags
+}
+
 type inputTokens struct {
 	nativeTokens hclsyntax.Tokens
 	writerTokens Tokens
diff --git a/hclwrite/public.go b/hclwrite/public.go
index 7c38ee1..3bd7a5a 100644
--- a/hclwrite/public.go
+++ b/hclwrite/public.go
@@ -30,6 +30,16 @@ func ParseConfig(src []byte, filename string, start hcl.Pos) (*File, hcl.Diagnos
 	return parse(src, filename, start)
 }
 
+// ParseExpression attempts to parse the given buffer as a HCL expression,
+// returning the resulting syntax element if successful.
+//
+// Comments, newlines and spaces before or after the expression are not included in
+// the result. If the source is not a valid expression, the returned
+// expression is nil and the diagnostics describe the errors.
+func ParseExpression(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	return parseExpr(src, filename, start)
+}
