+
+func TestToGraphQLParams(t *testing.T) {
+	int32Ptr := func(v int32) *int32 { return &v }
+	stringPtr := func(v string) *string { return &v }
+
+	tests := []struct {
+		name        string
+		params      CursorPaginationParams
+		expected    *GraphQLPaginationParams
+		errContains string
+	}{
+		{
+			name:     "no cursor",
+			params:   CursorPaginationParams{PerPage: 30},
+			expected: &GraphQLPaginationParams{First: int32Ptr(30)},
+		},
+		{
+			name:     "with cursor",
+			params:   CursorPaginationParams{PerPage: 10, After: "cursor123"},
+			expected: &GraphQLPaginationParams{First: int32Ptr(10), After: stringPtr("cursor123")},
+		},
+		{
+			name:     "maximum perPage",
+			params:   CursorPaginationParams{PerPage: 100},
+			expected: &GraphQLPaginationParams{First: int32Ptr(100)},
+		},
+		{
+			name:        "perPage above maximum",
+			params:      CursorPaginationParams{PerPage: 101},
+			errContains: "perPage value 101 exceeds maximum of 100",
+		},
+		{
+			name:        "negative perPage",
+			params:      CursorPaginationParams{PerPage: -1},
+			errContains: "perPage value -1 cannot be negative",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			check := func(t *testing.T, result *GraphQLPaginationParams, err error) {
+				if tc.errContains != "" {
+					require.Error(t, err)
+					assert.Contains(t, err.Error(), tc.errContains)
+					return
+				}
+				require.NoError(t, err)
+				assert.Equal(t, tc.expected, result)
+			}
+
+			t.Run("CursorPaginationParams", func(t *testing.T) {
+				result, err := tc.params.ToGraphQLParams()
+				check(t, result, err)
+			})
+			t.Run("PaginationParams", func(t *testing.T) {
+				result, err := PaginationParams{Page: 3, PerPage: tc.params.PerPage, After: tc.params.After}.ToGraphQLParams()
+				check(t, result, err)
+			})
+		})
+	}
+}
