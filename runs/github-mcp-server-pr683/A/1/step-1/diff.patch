+// pageInfoFragment is the PageInfo object of a GraphQL connection.
+// https://docs.github.com/en/graphql/reference/objects#pageinfo
+type pageInfoFragment struct {
+	HasNextPage     githubv4.Boolean
+	HasPreviousPage githubv4.Boolean
+	StartCursor     githubv4.String
+	EndCursor       githubv4.String
+}
+
+func (p pageInfoFragment) toMap() map[string]any {
+	return map[string]any{
+		"hasNextPage":     bool(p.HasNextPage),
+		"hasPreviousPage": bool(p.HasPreviousPage),
+		"startCursor":     string(p.StartCursor),
+		"endCursor":       string(p.EndCursor),
+	}
+}
+
+// paginationVars returns the "first" and "after" GraphQL variables.
+// "after" is sent as null when there is no cursor.
+func paginationVars(p *GraphQLPaginationParams) map[string]any {
+	vars := map[string]any{
+		"first": githubv4.Int(*p.First),
+		"after": (*githubv4.String)(nil),
+	}
+	if p.After != nil {
+		vars["after"] = githubv4.NewString(githubv4.String(*p.After))
+	}
+	return vars
+}
