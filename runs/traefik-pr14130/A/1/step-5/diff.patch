+// detectClusterTrustBundles sets clusterTrustBundlesErr when ClusterTrustBundles cannot be watched,
+// and returns an error when this cannot be determined.
+func (c *clientWrapper) detectClusterTrustBundles(ctx context.Context) error {
+	resources, err := c.csKube.Discovery().ServerResourcesForGroupVersion(certificatesv1.SchemeGroupVersion.String())
+	if kerrors.IsNotFound(err) {
+		c.clusterTrustBundlesErr = errClusterTrustBundlesNotServed
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("discovering %s resources: %w", certificatesv1.SchemeGroupVersion, err)
+	}
+
+	if !slices.ContainsFunc(resources.APIResources, func(resource metav1.APIResource) bool {
+		return resource.Name == "clustertrustbundles"
+	}) {
+		c.clusterTrustBundlesErr = errClusterTrustBundlesNotServed
+		return nil
+	}
+
+	for _, verb := range []string{"list", "watch"} {
+		review := &authorizationv1.SelfSubjectAccessReview{
+			Spec: authorizationv1.SelfSubjectAccessReviewSpec{
+				ResourceAttributes: &authorizationv1.ResourceAttributes{
+					Group:    certificatesv1.GroupName,
+					Resource: "clustertrustbundles",
+					Verb:     verb,
+				},
+			},
+		}
+
+		review, err = c.csKube.AuthorizationV1().SelfSubjectAccessReviews().Create(ctx, review, metav1.CreateOptions{})
+		if err != nil {
+			return fmt.Errorf("reviewing access to %s clustertrustbundles: %w", verb, err)
+		}
+
+		if !review.Status.Allowed {
+			c.clusterTrustBundlesErr = errClusterTrustBundlesNotAllowed
+			return nil
+		}
+	}
+
+	c.clusterTrustBundlesErr = nil
+	return nil
+}
