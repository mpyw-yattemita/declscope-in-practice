+func TestWatchAll_clusterTrustBundles(t *testing.T) {
+	testCases := []struct {
+		desc         string
+		served       bool
+		allowedVerbs []string
+		expectedErr  error
+	}{
+		{
+			desc:        "API not served",
+			expectedErr: errClusterTrustBundlesNotServed,
+		},
+		{
+			desc:        "list and watch not allowed",
+			served:      true,
+			expectedErr: errClusterTrustBundlesNotAllowed,
+		},
+		{
+			desc:         "watch not allowed",
+			served:       true,
+			allowedVerbs: []string{"list"},
+			expectedErr:  errClusterTrustBundlesNotAllowed,
+		},
+		{
+			desc:         "list not allowed",
+			served:       true,
+			allowedVerbs: []string{"watch"},
+			expectedErr:  errClusterTrustBundlesNotAllowed,
+		},
+		{
+			desc:         "supported",
+			served:       true,
+			allowedVerbs: []string{"list", "watch"},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			client := newClientImpl(newClusterTrustBundleClientSet(test.served, test.allowedVerbs), newGatewaySimpleClientSet(t))
+
+			_, err := client.WatchAll(nil, make(chan struct{}))
+			require.NoError(t, err)
+
+			assert.Equal(t, test.expectedErr, client.ClusterTrustBundlesSupport())
+			assert.Equal(t, test.expectedErr == nil, client.factoryClusterTrustBundle != nil)
+		})
+	}
+}
