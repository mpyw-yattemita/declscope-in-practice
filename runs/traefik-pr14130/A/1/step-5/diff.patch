+// resolveBackendCACertificate returns the CA certificate referenced by a BackendTLSPolicy,
+// or the ResolvedRefs condition explaining why it cannot.
+func (p *Provider) resolveBackendCACertificate(namespace string, policy *gatev1.BackendTLSPolicy, ref gatev1.LocalObjectReference) (string, *metav1.Condition) {
+	resolvedRefsFalse := func(reason gatev1.PolicyConditionReason, message string) *metav1.Condition {
+		return &metav1.Condition{
+			Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: policy.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(reason),
+			Message:            message,
+		}
+	}
+
+	isCore := ref.Group == "" || ref.Group == groupCore
+
+	var caCRT string
+	switch {
+	case ref.Group == groupCertificates && ref.Kind == kindClusterTrustBundle:
+		if err := p.client.ClusterTrustBundlesSupport(); err != nil {
+			return "", resolvedRefsFalse(gatev1.BackendTLSPolicyReasonInvalidKind, err.Error())
+		}
+
+		bundle, err := p.client.GetClusterTrustBundle(string(ref.Name))
+		if err != nil {
+			return "", resolvedRefsFalse(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("Cannot get ClusterTrustBundle %s: %s", ref.Name, err))
+		}
+
+		if bundle.Spec.TrustBundle == "" {
+			return "", resolvedRefsFalse(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("ClusterTrustBundle %s has an empty trustBundle", ref.Name))
+		}
+
+		return bundle.Spec.TrustBundle, nil
+
+	case isCore && ref.Kind == kindConfigMap:
+		configmap, err := p.client.GetConfigMap(namespace, string(ref.Name))
+		if err != nil {
+			return "", resolvedRefsFalse(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting configmap %s/%s: %s", namespace, ref.Name, err))
+		}
+		caCRT = configmap.Data["ca.crt"]
+
+	case isCore && ref.Kind == kindSecret:
+		secret, err := p.client.GetSecret(namespace, string(ref.Name))
+		if err != nil {
+			return "", resolvedRefsFalse(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting secret %s/%s: %s", namespace, ref.Name, err))
+		}
+		caCRT = string(secret.Data["ca.crt"])
+
+	default:
+		return "", resolvedRefsFalse(gatev1.BackendTLSPolicyReasonInvalidKind, "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported")
+	}
+
+	if caCRT == "" {
+		return "", resolvedRefsFalse(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("%s %s/%s does not have a ca.crt", ref.Kind, namespace, ref.Name))
+	}
+
+	return caCRT, nil
+}
