+func TestLoadRoutes_backendTLSPolicyClusterTrustBundle(t *testing.T) {
+	routes := []struct {
+		desc        string
+		path        string
+		policyName  string
+		entryPoints map[string]Entrypoint
+		rootCAs     func(conf *dynamic.Configuration) [][]types.FileOrContent
+	}{
+		{
+			desc:        "HTTPRoute",
+			path:        "httproute/with_backend_tls_policy_cluster_trust_bundle.yml",
+			policyName:  "policy-1",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			rootCAs:     httpRootCAs,
+		},
+		{
+			desc:        "GRPCRoute",
+			path:        "grpcroute/with_backend_tls_policy_cluster_trust_bundle.yml",
+			policyName:  "backend-tls-policy",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			rootCAs:     httpRootCAs,
+		},
+		{
+			desc:        "TLSRoute",
+			path:        "tlsroute/with_backend_tls_policy_cluster_trust_bundle.yml",
+			policyName:  "policy-1",
+			entryPoints: map[string]Entrypoint{"tls": {Address: ":9001"}},
+			rootCAs: func(conf *dynamic.Configuration) [][]types.FileOrContent {
+				var rootCAs [][]types.FileOrContent
+				for _, st := range conf.TCP.ServersTransports {
+					rootCAs = append(rootCAs, st.TLS.RootCAs)
+				}
+				return rootCAs
+			},
+		},
+	}
+
+	clusters := []struct {
+		desc            string
+		served          bool
+		allowedVerbs    []string
+		expectedRootCAs [][]types.FileOrContent
+		expectedStatus  metav1.ConditionStatus
+		expectedReason  gatev1.PolicyConditionReason
+		expectedMessage string
+	}{
+		{
+			desc:            "supported",
+			served:          true,
+			allowedVerbs:    []string{"list", "watch"},
+			expectedRootCAs: [][]types.FileOrContent{{"CA-bundle"}},
+			expectedStatus:  metav1.ConditionTrue,
+			expectedReason:  gatev1.BackendTLSPolicyReasonResolvedRefs,
+		},
+		{
+			desc:            "API not served",
+			expectedStatus:  metav1.ConditionFalse,
+			expectedReason:  gatev1.BackendTLSPolicyReasonInvalidKind,
+			expectedMessage: "ClusterTrustBundles are not supported, the cluster does not serve the certificates.k8s.io/v1 API",
+		},
+		{
+			desc:            "permissions missing",
+			served:          true,
+			expectedStatus:  metav1.ConditionFalse,
+			expectedReason:  gatev1.BackendTLSPolicyReasonInvalidKind,
+			expectedMessage: "ClusterTrustBundles are not supported, Traefik is not allowed to list and watch clustertrustbundles",
+		},
+	}
+
+	for _, route := range routes {
+		for _, cluster := range clusters {
+			t.Run(route.desc+" "+cluster.desc, func(t *testing.T) {
+				t.Parallel()
+
+				k8sObjects, gwObjects := readResources(t, []string{"services.yml", route.path})
+
+				gwClient := newGatewaySimpleClientSet(t, gwObjects...)
+				client := newClientImpl(newClusterTrustBundleClientSet(cluster.served, cluster.allowedVerbs, k8sObjects...), gwClient)
+
+				eventCh, err := client.WatchAll(nil, make(chan struct{}))
+				require.NoError(t, err)
+
+				// just wait for the first event
+				<-eventCh
+
+				p := Provider{
+					EntryPoints: route.entryPoints,
+					client:      client,
+				}
+
+				conf, statusReport, err := p.loadConfigurationFromGateways(t.Context())
+				require.NoError(t, err)
+
+				assert.Equal(t, cluster.expectedRootCAs, route.rootCAs(conf))
+
+				statusReport.Flush(t.Context(), client)
+
+				policy, err := gwClient.GatewayV1().BackendTLSPolicies("default").Get(t.Context(), route.policyName, metav1.GetOptions{})
+				require.NoError(t, err)
+				require.Len(t, policy.Status.Ancestors, 1)
+
+				resolvedRefs := meta.FindStatusCondition(policy.Status.Ancestors[0].Conditions, string(gatev1.BackendTLSPolicyConditionResolvedRefs))
+				require.NotNil(t, resolvedRefs)
+				assert.Equal(t, cluster.expectedStatus, resolvedRefs.Status)
+				assert.Equal(t, string(cluster.expectedReason), resolvedRefs.Reason)
+				assert.Equal(t, cluster.expectedMessage, resolvedRefs.Message)
+			})
+		}
+	}
+}
