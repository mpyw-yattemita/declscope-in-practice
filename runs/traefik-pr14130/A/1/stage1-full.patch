 	}
 
 	err := retry.RetryOnConflict(retry.DefaultRetry, func() error {
 		currentGateway, err := c.factoriesGateway[c.lookupNamespace(gateway.Namespace)].Gateway().V1().Gateways().Lister().Gateways(gateway.Namespace).Get(gateway.Name)
