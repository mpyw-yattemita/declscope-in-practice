+                        rule: 'self.sourceType == ''Header'' ? has(self.headerName)
+                          : !has(self.headerName)'
+                      - message: literalValue is required when sourceType is Literal,
+                          and must be empty otherwise
+                        rule: 'self.sourceType == ''Literal'' ? has(self.literalValue)
+                          : !has(self.literalValue)'
