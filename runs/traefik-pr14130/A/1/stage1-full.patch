 			if len(k8sObjects) > 0 {
 				<-eventCh
 			}
 
 			p := Provider{client: client}
 
 			assert.Equal(t, test.expected, p.isListenerSetAllowed(t.Context(), test.gw, test.ls))
 		})
 	}
