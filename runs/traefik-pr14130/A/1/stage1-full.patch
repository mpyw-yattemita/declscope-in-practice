     resources:
       - configmaps
     verbs:
       - get
       - list
       - watch
   - apiGroups:
       - gateway.networking.k8s.io
     resources:
       - backendtlspolicies
     verbs:
       - get
       - list
       - watch
   - apiGroups:
       - gateway.networking.k8s.io
     resources:
       - backendtlspolicies/status
     verbs:
       - update
   ...
