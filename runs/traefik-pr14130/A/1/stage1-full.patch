+                            (i.e., as a span tag).
+                          maxLength: 256
+                          minLength: 1
+                          pattern: ^[a-zA-Z0-9_.:/-]+$
+                          type: string
+                        sourceType:
+                          description: |-
+                            SourceType specifies where the attribute value comes from.
+                            Valid values are "Header", "Literal", or "Attribute".
+                          enum:
