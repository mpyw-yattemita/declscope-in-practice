 					Group:     new(gatev1.Group(gatev1.GroupName)),
 					Kind:      new(gatev1.Kind("Gateway")),
 				},
 				{
 					Name:      "other-gateway",
 					Namespace: new(gatev1.Namespace("default")),
 					Group:     new(gatev1.Group(gatev1.GroupName)),
 					Kind:      new(gatev1.Kind("Gateway")),
 				},
