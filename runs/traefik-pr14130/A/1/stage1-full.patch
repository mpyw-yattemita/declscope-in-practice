+				Conditions: []metav1.Condition{accepted, resolvedRefs},
 				Listeners: []gatev1.ListenerStatus{{
 					Name:       "http",
 					Conditions: []metav1.Condition{listenerAccepted},
 				}},
 			},
 			expected: gatev1.GatewayStatus{
-				Conditions: []metav1.Condition{accepted},
+				Conditions: []metav1.Condition{accepted, resolvedRefs},
 				Listeners: []gatev1.ListenerStatus{{
 					Name:       "http",
 					Conditions: []metav1.Condition{listenerAccepted},
