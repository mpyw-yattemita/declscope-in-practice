 					},
 				},
 			},
 			ls: &gatev1.ListenerSet{
 				Name: "ls", Namespace: "default",
 			},
 			expected: true,
 		},
 		{
 			desc: "FromSame - different namespace",
 			gw: &gatev1.Gateway{
 				Name: "gw", Namespace: "default",
 				Spec: gatev1.GatewaySpec{
 					AllowedListeners: &gatev1.AllowedListeners{
