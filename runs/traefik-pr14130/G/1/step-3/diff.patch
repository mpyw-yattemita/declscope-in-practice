+// createHTTPRouteRetry builds the Retry middleware of an HTTPRoute rule.
+func createHTTPRouteRetry(ctx context.Context, retry *gatev1.HTTPRouteRetry, maxRequestBodyBytes int64) *dynamic.Middleware {
+	// Traefik counts the initial request as an attempt, while the Gateway API does not.
+	// The Gateway API attempts default to 1, so Attempts defaults to 2.
+	retryConf := &dynamic.Retry{
+		Attempts:            ptr.Deref(retry.Attempts, 1) + 1,
+		MaxRequestBodyBytes: new(maxRequestBodyBytes),
+	}
+
+	for _, code := range retry.Codes {
+		retryConf.Status = append(retryConf.Status, strconv.Itoa(int(code)))
+	}
+
+	if retry.Backoff != nil {
+		// The CRD CEL validation guarantees a valid GEP-2257 duration string.
+		if d, err := time.ParseDuration(string(*retry.Backoff)); err != nil {
+			log.Ctx(ctx).Error().Err(err).Msg("Ignoring HTTPRoute retry.backoff: invalid duration")
+		} else {
+			retryConf.InitialInterval = ptypes.Duration(d)
+		}
+	}
+
+	return &dynamic.Middleware{Retry: retryConf}
+}
