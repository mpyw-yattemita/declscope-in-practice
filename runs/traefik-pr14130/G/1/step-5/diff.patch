+
+func newKubeClientset(t *testing.T, api clusterTrustBundleAPI, objects ...runtime.Object) *kubefake.Clientset {
+	t.Helper()
+
+	client := kubefake.NewClientset(objects...)
+	if api == clusterTrustBundleAPINotServed {
+		return client
+	}
+
+	client.Resources = append(client.Resources, &metav1.APIResourceList{
+		GroupVersion: certificatesv1.SchemeGroupVersion.String(),
+		APIResources: []metav1.APIResource{{Name: resourceClusterTrustBundles, Kind: kindClusterTrustBundle}},
+	})
+	client.PrependReactor("create", "selfsubjectaccessreviews", func(action ktesting.Action) (bool, runtime.Object, error) {
+		review := action.(ktesting.CreateAction).GetObject().(*authorizationv1.SelfSubjectAccessReview).DeepCopy()
+		review.Status.Allowed = api == clusterTrustBundleAPIAllowed
+		return true, review, nil
+	})
+
+	return client
+}
