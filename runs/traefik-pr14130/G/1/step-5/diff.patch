+// resolveBackendCACertificateRef returns the PEM CA certificate referenced by a BackendTLSPolicy,
+// or the ResolvedRefs condition explaining why it cannot be resolved.
+func (p *Provider) resolveBackendCACertificateRef(namespace string, policy *gatev1.BackendTLSPolicy, caCertRef gatev1.LocalObjectReference) (string, *metav1.Condition) {
+	invalid := func(reason gatev1.PolicyConditionReason, message string) (string, *metav1.Condition) {
+		return "", &metav1.Condition{
+			Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: policy.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(reason),
+			Message:            message,
+		}
+	}
+
+	switch {
+	case caCertRef.Group == certificatesv1.GroupName && caCertRef.Kind == kindClusterTrustBundle:
+		if reason := p.client.ClusterTrustBundleUnsupportedReason(); reason != "" {
+			return invalid(gatev1.BackendTLSPolicyReasonInvalidKind, "ClusterTrustBundles are not supported, "+reason)
+		}
+
+		bundle, err := p.client.GetClusterTrustBundle(string(caCertRef.Name))
+		if err != nil {
+			return invalid(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("Cannot get ClusterTrustBundle %s: %s", caCertRef.Name, err))
+		}
+		if bundle.Spec.TrustBundle == "" {
+			return invalid(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("ClusterTrustBundle %s has an empty trustBundle", caCertRef.Name))
+		}
+
+		return bundle.Spec.TrustBundle, nil
+
+	case caCertRef.Group != "" && caCertRef.Group != groupCore,
+		caCertRef.Kind != kindConfigMap && caCertRef.Kind != kindSecret:
+		return invalid(gatev1.BackendTLSPolicyReasonInvalidKind, "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported")
+	}
+
+	var caCRT string
+	switch caCertRef.Kind {
+	case kindConfigMap:
+		configmap, err := p.client.GetConfigMap(namespace, string(caCertRef.Name))
+		if err != nil {
+			return invalid(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting configmap %s/%s: %s", namespace, string(caCertRef.Name), err))
+		}
+		caCRT = configmap.Data["ca.crt"]
+	case kindSecret:
+		secret, err := p.client.GetSecret(namespace, string(caCertRef.Name))
+		if err != nil {
+			return invalid(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting secret %s/%s: %s", namespace, string(caCertRef.Name), err))
+		}
+		caCRT = string(secret.Data["ca.crt"])
+	}
+
+	if caCRT == "" {
+		return invalid(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("%s %s/%s does not have a ca.crt", caCertRef.Kind, namespace, string(caCertRef.Name)))
+	}
+
+	return caCRT, nil
+}
