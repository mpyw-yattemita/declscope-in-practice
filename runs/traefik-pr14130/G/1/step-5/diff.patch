+func Test_clientWrapper_WatchAll_clusterTrustBundleSupport(t *testing.T) {
+	testCases := []struct {
+		desc       string
+		setup      func(client *kubefake.Clientset)
+		wantReason string
+		wantErr    bool
+	}{
+		{
+			desc:       "group version not served",
+			wantReason: reasonClusterTrustBundleNotServed,
+		},
+		{
+			desc: "group version served without clustertrustbundles",
+			setup: func(client *kubefake.Clientset) {
+				client.Resources = append(client.Resources, &metav1.APIResourceList{
+					GroupVersion: certificatesv1.SchemeGroupVersion.String(),
+					APIResources: []metav1.APIResource{{Name: "certificatesigningrequests"}},
+				})
+			},
+			wantReason: reasonClusterTrustBundleNotServed,
+		},
+		{
+			desc: "discovery error",
+			setup: func(client *kubefake.Clientset) {
+				client.PrependReactor("get", "resource", func(ktesting.Action) (bool, runtime.Object, error) {
+					return true, nil, errors.New("boom")
+				})
+			},
+			wantErr: true,
+		},
+		{
+			desc: "access review error",
+			setup: func(client *kubefake.Clientset) {
+				client.Resources = append(client.Resources, &metav1.APIResourceList{
+					GroupVersion: certificatesv1.SchemeGroupVersion.String(),
+					APIResources: []metav1.APIResource{{Name: resourceClusterTrustBundles}},
+				})
+				client.PrependReactor("create", "selfsubjectaccessreviews", func(ktesting.Action) (bool, runtime.Object, error) {
+					return true, nil, errors.New("boom")
+				})
+			},
+			wantErr: true,
+		},
+		{
+			desc: "watch not allowed",
+			setup: func(client *kubefake.Clientset) {
+				client.Resources = append(client.Resources, &metav1.APIResourceList{
+					GroupVersion: certificatesv1.SchemeGroupVersion.String(),
+					APIResources: []metav1.APIResource{{Name: resourceClusterTrustBundles}},
+				})
+				client.PrependReactor("create", "selfsubjectaccessreviews", func(action ktesting.Action) (bool, runtime.Object, error) {
+					review := action.(ktesting.CreateAction).GetObject().(*authorizationv1.SelfSubjectAccessReview).DeepCopy()
+					review.Status.Allowed = review.Spec.ResourceAttributes.Verb == "list"
+					return true, review, nil
+				})
+			},
+			wantReason: reasonClusterTrustBundleNotAllowed,
+		},
+		{
+			desc: "list and watch allowed",
+			setup: func(client *kubefake.Clientset) {
+				client.Resources = append(client.Resources, &metav1.APIResourceList{
+					GroupVersion: certificatesv1.SchemeGroupVersion.String(),
+					APIResources: []metav1.APIResource{{Name: resourceClusterTrustBundles}},
+				})
+				client.PrependReactor("create", "selfsubjectaccessreviews", func(action ktesting.Action) (bool, runtime.Object, error) {
+					review := action.(ktesting.CreateAction).GetObject().(*authorizationv1.SelfSubjectAccessReview).DeepCopy()
+					review.Status.Allowed = true
+					return true, review, nil
+				})
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			kubeClient := kubefake.NewClientset()
+			if test.setup != nil {
+				test.setup(kubeClient)
+			}
+
+			client := newClientImpl(kubeClient, gatefake.NewSimpleClientset())
+
+			_, err := client.WatchAll(nil, make(chan struct{}))
+			if test.wantErr {
+				require.Error(t, err)
+				return
+			}
+			require.NoError(t, err)
+
+			assert.Equal(t, test.wantReason, client.ClusterTrustBundleUnsupportedReason())
+			assert.Equal(t, test.wantReason == "", client.factoryClusterTrustBundle != nil)
+		})
+	}
+}
