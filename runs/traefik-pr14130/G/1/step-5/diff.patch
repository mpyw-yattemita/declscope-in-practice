+			expectedCondition: &metav1.Condition{
+				Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 1,
+				Reason:             string(gatev1.BackendTLSPolicyReasonInvalidKind),
+				Message:            "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported",
+			},
+		},
+		{
+			desc: "unsupported kind in the certificates group",
+			ref:  gatev1.LocalObjectReference{Group: certificatesv1.GroupName, Kind: "CertificateSigningRequest", Name: "my-csr"},
+			expectedCondition: &metav1.Condition{
+				Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 1,
+				Reason:             string(gatev1.BackendTLSPolicyReasonInvalidKind),
+				Message:            "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported",
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			caCert, condition := p.resolveBackendCACertificateRef("default", policy, test.ref)
+
+			// LastTransitionTime is set with metav1.Now() and is not relevant to this test.
+			if condition != nil {
+				condition.LastTransitionTime = metav1.Time{}
+			}
+
+			assert.Equal(t, test.wantCACert, caCert)
+			assert.Equal(t, test.expectedCondition, condition)
+		})
+	}
+}
