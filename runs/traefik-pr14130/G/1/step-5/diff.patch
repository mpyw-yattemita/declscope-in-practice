+// clusterTrustBundleAPI is the state of the ClusterTrustBundle API simulated by newKubeClientset.
+type clusterTrustBundleAPI int
+
+const (
+	clusterTrustBundleAPINotServed clusterTrustBundleAPI = iota
+	clusterTrustBundleAPIForbidden
+	clusterTrustBundleAPIAllowed
