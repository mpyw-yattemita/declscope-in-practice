diff --git a/internal/storage/v2/api/tracestore/search_capabilities.go b/internal/storage/v2/api/tracestore/search_capabilities.go
new file mode 100644
index 0000000..b2746d6
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/search_capabilities.go
@@ -0,0 +1,17 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+// SearchCapabilities describes how a Reader's search methods behave where
+// backends differ. Reader.SearchCapabilities returns it.
+//
+// The zero value is the least capable reader: every field is false. A field
+// added later is therefore false for every implementation that does not set
+// it, so a reader never claims a capability it was not written for.
+type SearchCapabilities struct {
+	// WithoutServiceName is true when FindTraces, FindTraceIDs and
+	// FindTraceSummaries accept a TraceQueryParams whose ServiceName is empty
+	// and read it as "any service", rather than as an error or an empty result.
+	WithoutServiceName bool
+}
