+func TestToLegacyShape(t *testing.T) {
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		query := TraceQueryParams{ServiceName: "cart"}
+		got, err := query.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("nested conjunctions and qualified attributes", func(t *testing.T) {
+		query := withFilter(call(expression.OpAnd,
+			call(expression.OpAnd,
+				call(expression.OpEq, attr("a", expression.LevelSpan), str("1")),
+				call(expression.OpEq, attr("b", expression.LevelResource), anyValue("2"))),
+			call(expression.OpEq, attr("c", expression.LevelEvent), anyValue("3")),
+			call(expression.OpEq, field(expression.LevelResource, expression.ResourceFieldService), anyValue("cart")),
+			call(expression.OpEq, field(expression.LevelSpan, expression.SpanFieldName), str("GET")),
+			call(expression.OpGte, field(expression.LevelSpan, expression.SpanFieldDuration), dur(time.Second)),
+			call(expression.OpLte, field(expression.LevelSpan, expression.SpanFieldDuration), dur(time.Minute)),
+		))
+		got, err := query.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Nil(t, got.Filter)
+		assert.Equal(t, "cart", got.ServiceName)
+		assert.Equal(t, "GET", got.OperationName)
+		assert.Equal(t, time.Second, got.DurationMin)
+		assert.Equal(t, time.Minute, got.DurationMax)
+		assert.Equal(t, map[string]any{"a": "1", "b": "2", "c": "3"}, got.Attributes.AsRaw())
+		assert.Equal(t, 0, query.Attributes.Len(), "the caller's map is not changed")
+	})
+
+	t.Run("a filter beside legacy fields is invalid", func(t *testing.T) {
+		query := withFilter(tagEq("a", "1"))
+		query.ServiceName = "cart"
+		got, err := query.ToLegacyShape()
+		require.ErrorIs(t, err, ErrFilterInvalid)
+		assert.Equal(t, query, got)
+	})
+}
