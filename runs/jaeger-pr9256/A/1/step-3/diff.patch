+func TestToLegacyShape_UnresolvedDurationIsInvalid(t *testing.T) {
+	query := withFilter(call(expression.OpGte,
+		field(expression.LevelSpan, expression.SpanFieldDuration), anyValue("2s")))
+	_, err := query.ToLegacyShape()
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	assert.Contains(t, err.Error(), `the bound "2s" on "duration" was never read as a duration`)
+}
