+func TestToLegacyShape_RoundTrip(t *testing.T) {
+	for name, query := range map[string]TraceQueryParams{
+		"every field": legacyQuery(),
+		"service only": {
+			ServiceName: "cart",
+			Attributes:  pcommon.NewMap(),
