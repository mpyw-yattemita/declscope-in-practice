diff --git a/internal/storage/v2/api/tracestore/filter.go b/internal/storage/v2/api/tracestore/filter.go
new file mode 100644
index 0000000..d89a747
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/filter.go
@@ -0,0 +1,379 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// A TraceQueryParams carries its predicates in one of two models: the structured Filter, or the
+// legacy scalar fields every backend serves. The methods in this file decide which model a
+// Reader receives, so that every caller gets the same answer rather than each backend's own.
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces.
+//
+// The error wraps ErrFilterInvalid and names every conflicting field, because the
+// query is malformed whatever the backend can serve.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if hasAttributes(q.Attributes) {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: the filter replaces the predicate fields %v, so a query sets one or the other",
+		ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate.
+//
+// A Reader that declared no filter capabilities receives the filter rewritten into the
+// legacy predicate fields, or a refusal where they cannot express it. A Reader that declared
+// some receives the filter as it is, or a refusal naming the first part it did not declare.
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// EnsureSupported walks the filter and refuses the first predicate the Reader
+// did not declare it can evaluate.
+//
+// Every operator must be listed, and every reference must name a level the Reader
+// indexes. Constants need no support. The refusal wraps ErrFilterUnsupported.
+func (c FilterCapabilities) EnsureSupported(filter *expression.Call) error {
+	if filter == nil {
+		return nil
+	}
+	if !c.SupportsOperator(filter.Op) {
+		return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, filter.Op)
+	}
+	for _, arg := range filter.Args {
+		if nested, ok := arg.(*expression.Call); ok {
+			if err := c.EnsureSupported(nested); err != nil {
+				return err
+			}
+			continue
+		}
+		if level, ok := referenceLevel(arg); ok && !c.SupportsLevel(level) {
+			return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, level)
+		}
+	}
+	return nil
+}
+
+// referenceLevel returns the level a reference names. Its second result is false for
+// anything that is not a reference, such as a constant.
+func referenceLevel(e expression.Expression) (expression.Level, bool) {
+	switch ref := e.(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.NestedRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	}
+	return "", false
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates.
+//
+// It cannot fail, because each legacy field has an exact filter equivalent. A query
+// that already has a Filter is returned as it is. The result is already finalized:
+// it passes expression.ValidateFilter, and expression.ResolveConstants changes nothing.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []expression.Expression
+	if q.ServiceName != "" {
+		predicates = append(predicates, call(expression.OpEq, serviceField(), &expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, call(expression.OpEq, operationField(), &expression.StringValue{Value: q.OperationName}))
+	}
+	if hasAttributes(q.Attributes) {
+		for key, value := range q.Attributes.All() {
+			predicates = append(predicates, call(expression.OpEq,
+				&expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value.AsString()}))
+		}
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, call(expression.OpGte, durationField(), &expression.DurationValue{Value: q.DurationMin}))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, call(expression.OpLte, durationField(), &expression.DurationValue{Value: q.DurationMax}))
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	switch len(predicates) {
+	case 0:
+		q.Filter = nil
+	case 1:
+		q.Filter = predicates[0].(*expression.Call)
+	default:
+		q.Filter = call(expression.OpAnd, predicates...)
+	}
+	return q
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves.
+//
+// Only a flat conjunction of the predicates the legacy fields can hold converts; anything
+// else is refused rather than approximated, with an error wrapping ErrFilterUnsupported (or
+// ErrFilterInvalid for a filter that was never finalized). On error q is returned as it is.
+// The result has a new Attributes map, so the caller's own map is not changed.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	w := legacyWriter{
+		query:   q,
+		claimed: make(map[legacySlot]bool),
+	}
+	w.query.Filter = nil
+	w.query.Attributes = pcommon.NewMap()
+	for _, conjunct := range conjuncts(q.Filter, nil) {
+		if err := w.write(conjunct); err != nil {
+			return q, err
+		}
+	}
+	return w.query, nil
+}
+
+// conjuncts flattens nested OpAnd calls into the list of their operands, appended to out.
+// OpAnd is associative, so the flattened list asks the same question.
+func conjuncts(e expression.Expression, out []expression.Expression) []expression.Expression {
+	c, ok := e.(*expression.Call)
+	if !ok || c == nil || c.Op != expression.OpAnd {
+		return append(out, e)
+	}
+	for _, arg := range c.Args {
+		out = conjuncts(arg, out)
+	}
+	return out
+}
+
+// legacySlot identifies one legacy field a predicate writes, so that a second predicate on
+// the same field is refused rather than silently overwriting the first.
+type legacySlot struct {
+	kind string
+	name string
+}
+
+var (
+	serviceSlot     = legacySlot{kind: "service"}
+	operationSlot   = legacySlot{kind: "operation"}
+	durationMinSlot = legacySlot{kind: "duration_min"}
+	durationMaxSlot = legacySlot{kind: "duration_max"}
+)
+
+func attributeSlot(key string) legacySlot {
+	return legacySlot{kind: "attribute", name: key}
+}
+
+// legacyWriter writes conjuncts into the legacy fields of query, one predicate at a time.
+type legacyWriter struct {
+	query   TraceQueryParams
+	claimed map[legacySlot]bool
+}
+
+// write converts one conjunct, or refuses it.
+func (w *legacyWriter) write(conjunct expression.Expression) error {
+	predicate, ok := conjunct.(*expression.Call)
+	if !ok || predicate == nil {
+		return fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+	}
+	switch {
+	case predicate.Op == expression.OpOr,
+		predicate.Op == expression.OpNot,
+		predicate.Op == expression.OpExists,
+		len(predicate.Args) != 2:
+		return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, predicate.Op)
+	}
+	op, subject, value := predicate.Op, predicate.Args[0], predicate.Args[1]
+	switch ref := subject.(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return w.writeAttribute(op, ref, value)
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return w.writeField(op, ref, value)
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+// writeAttribute converts an equality on an attribute into a tag. The legacy tags do not
+// record a level, so a span-, resource- or event-level attribute widens to a plain tag. The
+// link and scope levels are not searched by tags at all.
+func (w *legacyWriter) writeAttribute(op expression.Operator, ref *expression.AttributeRef, value expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+	default:
+		return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, ref.Level)
+	}
+	text, err := equalsString(op, ref.Key, value)
+	if err != nil {
+		return err
+	}
+	if err := w.claim(attributeSlot(ref.Key), ref.Key); err != nil {
+		return err
+	}
+	w.query.Attributes.PutStr(ref.Key, text)
+	return nil
+}
+
+// writeField converts a predicate on one of the three built-in fields the legacy fields hold.
+func (w *legacyWriter) writeField(op expression.Operator, ref *expression.FieldRef, value expression.Expression) error {
+	switch *ref {
+	case *serviceField():
+		text, err := equalsString(op, ref.Name, value)
+		if err != nil {
+			return err
+		}
+		if err := w.claim(serviceSlot, ref.Name); err != nil {
+			return err
+		}
+		w.query.ServiceName = text
+		return nil
+	case *operationField():
+		text, err := equalsString(op, ref.Name, value)
+		if err != nil {
+			return err
+		}
+		if err := w.claim(operationSlot, ref.Name); err != nil {
+			return err
+		}
+		w.query.OperationName = text
+		return nil
+	case *durationField():
+		return w.writeDuration(op, ref.Name, value)
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+// writeDuration converts an inclusive bound on the span duration into DurationMin or
+// DurationMax.
+func (w *legacyWriter) writeDuration(op expression.Operator, name string, value expression.Expression) error {
+	var slot legacySlot
+	var target *time.Duration
+	switch op {
+	case expression.OpGte:
+		slot, target = durationMinSlot, &w.query.DurationMin
+	case expression.OpLte:
+		slot, target = durationMaxSlot, &w.query.DurationMax
+	default:
+		return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+	}
+	switch bound := value.(type) {
+	case *expression.DurationValue:
+		if bound != nil {
+			if err := w.claim(slot, name); err != nil {
+				return err
+			}
+			*target = bound.Value
+			return nil
+		}
+	case *expression.AnyValue:
+		if bound != nil {
+			return fmt.Errorf("%w: the bound %q on %q was never read as a duration; finalize the filter first",
+				ErrFilterInvalid, bound.Value, name)
+		}
+	}
+	return fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only", ErrFilterUnsupported, name)
+}
+
+// claim records that a predicate writes slot, and refuses a second one.
+func (w *legacyWriter) claim(slot legacySlot, name string) error {
+	if w.claimed[slot] {
+		return fmt.Errorf("%w: it takes only one predicate on %q", ErrFilterUnsupported, name)
+	}
+	w.claimed[slot] = true
+	return nil
+}
+
+// equalsString returns the text of an equality between a string-valued reference, named name,
+// and a string or untyped constant.
+func equalsString(op expression.Operator, name string, value expression.Expression) (string, error) {
+	if op != expression.OpEq {
+		return "", fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+	}
+	switch constant := value.(type) {
+	case *expression.StringValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	case *expression.AnyValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+// hasAttributes reports whether m holds an entry. It is safe to call on the zero value,
+// which a TraceQueryParams built without pcommon.NewMap() carries.
+func hasAttributes(m pcommon.Map) bool {
+	return m != (pcommon.Map{}) && m.Len() > 0
+}
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func serviceField() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func operationField() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
+
+func durationField() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+}
diff --git a/internal/storage/v2/api/tracestore/filter_test.go b/internal/storage/v2/api/tracestore/filter_test.go
new file mode 100644
index 0000000..cdd6c18
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/filter_test.go
@@ -0,0 +1,490 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"testing"
+	"time"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+func attr(key string, level expression.Level) *expression.AttributeRef {
+	return &expression.AttributeRef{Key: key, Level: level}
+}
+
+func field(level expression.Level, name string) *expression.FieldRef {
+	return &expression.FieldRef{Level: level, Name: name}
+}
+
+func anyValue(v string) *expression.AnyValue { return &expression.AnyValue{Value: v} }
+
+func str(v string) *expression.StringValue { return &expression.StringValue{Value: v} }
+
+func dur(d time.Duration) *expression.DurationValue { return &expression.DurationValue{Value: d} }
+
+func tagEq(key, value string) *expression.Call {
+	return call(expression.OpEq, attr(key, ""), anyValue(value))
+}
+
+func withFilter(filter *expression.Call) TraceQueryParams {
+	return TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}
+}
+
+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := tagEq("a", "1")
+	tests := []struct {
+		name     string
+		query    TraceQueryParams
+		expected string // empty when the query passes
+	}{
+		{name: "no filter", query: TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}},
+		{name: "filter alone", query: withFilter(filter)},
+		{name: "filter with zero-value attributes", query: TraceQueryParams{Filter: filter}},
+		{
+			name:     "service name",
+			query:    TraceQueryParams{Filter: filter, ServiceName: "cart"},
+			expected: "[service_name]",
+		},
+		{
+			name: "every field",
+			query: func() TraceQueryParams {
+				q := TraceQueryParams{
+					Filter:        filter,
+					ServiceName:   "cart",
+					OperationName: "GET",
+					DurationMin:   time.Second,
+					DurationMax:   time.Minute,
+					Attributes:    pcommon.NewMap(),
+				}
+				q.Attributes.PutStr("a", "1")
+				return q
+			}(),
+			expected: "[service_name operation_name duration_min duration_max attributes]",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.query.EnsureFilterStandsAlone()
+			if test.expected == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.Contains(t, err.Error(), test.expected)
+		})
+	}
+}
+
+func TestFilterCapabilities_EnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpNe, expression.OpSome},
+	}
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string // empty when the filter is supported
+	}{
+		{name: "nil filter"},
+		{name: "unqualified attribute", filter: tagEq("a", "1")},
+		{
+			name:   "nested conjunction at a listed level",
+			filter: call(expression.OpAnd, tagEq("a", "1"), call(expression.OpEq, attr("b", expression.LevelSpan), str("x"))),
+		},
+		{
+			name:     "an operator it did not list",
+			filter:   call(expression.OpGt, attr("a", ""), anyValue("1")),
+			expected: `it does not support the operator "gt"`,
+		},
+		{
+			name:     "an operator it did not list, nested",
+			filter:   call(expression.OpAnd, tagEq("a", "1"), call(expression.OpOr, tagEq("b", "1"), tagEq("c", "1"))),
+			expected: `it does not support the operator "or"`,
+		},
+		{
+			name:     "an attribute level it does not index",
+			filter:   call(expression.OpEq, attr("a", expression.LevelLink), anyValue("1")),
+			expected: `it does not index the "link" level`,
+		},
+		{
+			name:     "a field level it does not index",
+			filter:   call(expression.OpEq, field(expression.LevelResource, expression.ResourceFieldService), str("x")),
+			expected: `it does not index the "resource" level`,
+		},
+		{
+			name:     "a level it does not index, on the right of a comparison",
+			filter:   call(expression.OpNe, attr("a", expression.LevelSpan), attr("a", expression.LevelScope)),
+			expected: `it does not index the "scope" level`,
+		},
+		{
+			name: "a nested call on the right of a quantifier",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelSpan},
+				call(expression.OpEq, field(expression.LevelEvent, expression.EventFieldName), str("x"))),
+			expected: `it does not index the "event" level`,
+		},
+		{
+			name: "a collection it does not index",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, attr("a", ""), str("x"))),
+			expected: `it does not index the "event" level`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := caps.EnsureSupported(test.filter)
+			if test.expected == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.Contains(t, err.Error(), test.expected)
+		})
+	}
+}
+
+func TestForCapabilities(t *testing.T) {
+	declaring := SearchCapabilities{Filter: &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}}}
+
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		query := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		for _, caps := range []SearchCapabilities{{}, declaring} {
+			got, err := query.ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Equal(t, query, got)
+		}
+	})
+
+	t.Run("an empty declaration gets the legacy shape", func(t *testing.T) {
+		for _, caps := range []SearchCapabilities{{}, {Filter: &FilterCapabilities{}}} {
+			got, err := withFilter(tagEq("a", "1")).ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Nil(t, got.Filter)
+			value, ok := got.Attributes.Get("a")
+			require.True(t, ok)
+			assert.Equal(t, "1", value.Str())
+		}
+	})
+
+	t.Run("an empty declaration refuses what the legacy shape cannot hold", func(t *testing.T) {
+		query := withFilter(call(expression.OpNe, attr("a", ""), anyValue("1")))
+		got, err := query.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("a declaring reader gets the filter as it is", func(t *testing.T) {
+		query := withFilter(call(expression.OpEq, attr("a", ""), anyValue("1")))
+		got, err := query.ForCapabilities(declaring)
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("a declaring reader refuses what it did not declare", func(t *testing.T) {
+		query := withFilter(call(expression.OpNe, attr("a", ""), anyValue("1")))
+		_, err := query.ForCapabilities(declaring)
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Contains(t, err.Error(), `it does not support the operator "ne"`)
+	})
+}
+
+func legacyQuery() TraceQueryParams {
+	q := TraceQueryParams{
+		ServiceName:   "cart",
+		OperationName: "GET /cart",
+		Attributes:    pcommon.NewMap(),
+		StartTimeMin:  time.Unix(100, 0),
+		StartTimeMax:  time.Unix(200, 0),
+		DurationMin:   time.Second,
+		DurationMax:   time.Minute,
+		SearchDepth:   20,
+	}
+	q.Attributes.PutStr("http.method", "GET")
+	q.Attributes.PutStr("http.status_code", "500")
+	return q
+}
+
+func TestToFilterShape(t *testing.T) {
+	t.Run("every field", func(t *testing.T) {
+		query := legacyQuery()
+		got := query.ToFilterShape()
+
+		expected := call(expression.OpAnd,
+			call(expression.OpEq, field(expression.LevelResource, expression.ResourceFieldService), str("cart")),
+			call(expression.OpEq, field(expression.LevelSpan, expression.SpanFieldName), str("GET /cart")),
+			call(expression.OpEq, attr("http.method", ""), anyValue("GET")),
+			call(expression.OpEq, attr("http.status_code", ""), anyValue("500")),
+			call(expression.OpGte, field(expression.LevelSpan, expression.SpanFieldDuration), dur(time.Second)),
+			call(expression.OpLte, field(expression.LevelSpan, expression.SpanFieldDuration), dur(time.Minute)),
+		)
+		assert.Equal(t, expected, got.Filter)
+		assert.Empty(t, got.ServiceName)
+		assert.Empty(t, got.OperationName)
+		assert.Zero(t, got.DurationMin)
+		assert.Zero(t, got.DurationMax)
+		assert.Equal(t, 0, got.Attributes.Len())
+		assert.Equal(t, query.StartTimeMin, got.StartTimeMin)
+		assert.Equal(t, query.StartTimeMax, got.StartTimeMax)
+		assert.Equal(t, query.SearchDepth, got.SearchDepth)
+		assert.Equal(t, 2, query.Attributes.Len(), "the caller's map is not changed")
+
+		require.NoError(t, expression.ValidateFilter(got.Filter))
+		resolved, err := expression.ResolveConstants(got.Filter)
+		require.NoError(t, err)
+		assert.Equal(t, got.Filter, resolved)
+	})
+
+	t.Run("one predicate stands on its own", func(t *testing.T) {
+		got := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}.ToFilterShape()
+		assert.Equal(t,
+			call(expression.OpEq, field(expression.LevelResource, expression.ResourceFieldService), str("cart")),
+			got.Filter)
+		require.NoError(t, expression.ValidateFilter(got.Filter))
+	})
+
+	t.Run("no predicates give no filter", func(t *testing.T) {
+		got := TraceQueryParams{SearchDepth: 5, Attributes: pcommon.NewMap()}.ToFilterShape()
+		assert.Nil(t, got.Filter)
+		assert.Equal(t, 5, got.SearchDepth)
+	})
+
+	t.Run("zero-value attributes", func(t *testing.T) {
+		got := TraceQueryParams{OperationName: "GET"}.ToFilterShape()
+		assert.Equal(t,
+			call(expression.OpEq, field(expression.LevelSpan, expression.SpanFieldName), str("GET")),
+			got.Filter)
+		assert.Equal(t, 0, got.Attributes.Len())
+	})
+
+	t.Run("a query with a filter is returned as it is", func(t *testing.T) {
+		query := withFilter(tagEq("a", "1"))
+		query.ServiceName = "cart"
+		assert.Equal(t, query, query.ToFilterShape())
+	})
+}
