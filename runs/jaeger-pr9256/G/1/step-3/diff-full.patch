+func TestToFilterShape(t *testing.T) {
+	start, end := time.Unix(100, 0), time.Unix(200, 0)
+
+	t.Run("every field converts, in order", func(t *testing.T) {
+		attrs := pcommon.NewMap()
+		attrs.PutStr("http.method", "GET")
+		attrs.PutInt("http.status_code", 500)
+		q := TraceQueryParams{
+			ServiceName:   "cart",
+			OperationName: "GET /cart",
+			Attributes:    attrs,
+			StartTimeMin:  start,
+			StartTimeMax:  end,
+			DurationMin:   time.Second,
+			DurationMax:   2 * time.Second,
+			SearchDepth:   20,
+		}
+		got := q.ToFilterShape()
+
+		want := call(expression.OpAnd,
+			call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+				str("cart")),
+			call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+				str("GET /cart")),
+			tagEq("http.method", "GET"),
+			tagEq("http.status_code", "500"),
+			call(expression.OpGte, durationRef(), duration(time.Second)),
+			call(expression.OpLte, durationRef(), duration(2*time.Second)),
+		)
+		assert.Equal(t, want, got.Filter)
+		assert.Empty(t, got.ServiceName)
+		assert.Empty(t, got.OperationName)
+		assert.Zero(t, got.DurationMin)
+		assert.Zero(t, got.DurationMax)
+		assert.Equal(t, 0, got.Attributes.Len())
+		assert.Equal(t, 2, attrs.Len(), "the caller's map is not changed")
+		assert.Equal(t, start, got.StartTimeMin)
+		assert.Equal(t, end, got.StartTimeMax)
+		assert.Equal(t, 20, got.SearchDepth)
+
+		require.NoError(t, expression.ValidateFilter(got.Filter))
+		resolved, err := expression.ResolveConstants(got.Filter)
+		require.NoError(t, err)
+		assert.Equal(t, got.Filter, resolved)
+	})
+
+	t.Run("one predicate stands on its own", func(t *testing.T) {
+		got := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}.ToFilterShape()
+		assert.Equal(t, call(expression.OpEq, serviceRef(), str("cart")), got.Filter)
+		require.NoError(t, expression.ValidateFilter(got.Filter))
+	})
+
+	t.Run("no predicate gives no filter", func(t *testing.T) {
+		got := TraceQueryParams{SearchDepth: 5, Attributes: pcommon.NewMap()}.ToFilterShape()
+		assert.Nil(t, got.Filter)
+		assert.Equal(t, 5, got.SearchDepth)
+	})
+
+	t.Run("zero-value attributes do not panic", func(t *testing.T) {
+		var got TraceQueryParams
+		require.NotPanics(t, func() {
+			got = TraceQueryParams{DurationMax: time.Second}.ToFilterShape()
+		})
+		assert.Equal(t, call(expression.OpLte, durationRef(), duration(time.Second)), got.Filter)
+		assert.Equal(t, 0, got.Attributes.Len())
+	})
+
+	t.Run("a query with a filter is returned as it is", func(t *testing.T) {
+		q := filterOnly(tagEq("a", "1"))
+		q.ServiceName = "cart"
+		assert.Equal(t, q, q.ToFilterShape())
+	})
+}
+
+func TestToLegacyShape_Converts(t *testing.T) {
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		q := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("round trip", func(t *testing.T) {
+		attrs := pcommon.NewMap()
+		attrs.PutStr("http.method", "GET")
+		attrs.PutStr("error", "true")
+		q := TraceQueryParams{
+			ServiceName:   "cart",
+			OperationName: "GET /cart",
+			Attributes:    attrs,
+			StartTimeMin:  time.Unix(100, 0),
+			StartTimeMax:  time.Unix(200, 0),
+			DurationMin:   time.Second,
+			DurationMax:   2 * time.Second,
+			SearchDepth:   20,
+		}
+		got, err := q.ToFilterShape().ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, q.ServiceName, got.ServiceName)
+		assert.Equal(t, q.OperationName, got.OperationName)
+		assert.Equal(t, q.Attributes.AsRaw(), got.Attributes.AsRaw())
+		got.Attributes = q.Attributes
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("every convertible form, nested and flattened", func(t *testing.T) {
+		filter := call(expression.OpAnd,
+			call(expression.OpEq, &expression.AttributeRef{Key: "span.a", Level: expression.LevelSpan}, str("1")),
+			call(expression.OpAnd,
+				call(expression.OpEq, &expression.AttributeRef{Key: "res.b", Level: expression.LevelResource}, anyValue("2")),
+				call(expression.OpEq, &expression.AttributeRef{Key: "event.c", Level: expression.LevelEvent}, anyValue("3")),
+				call(expression.OpAnd,
+					tagEq("d", "4"),
+					call(expression.OpEq, serviceRef(), anyValue("cart")))),
+			call(expression.OpEq, operationRef(), str("GET /cart")),
+			call(expression.OpGte, durationRef(), duration(time.Second)),
+			call(expression.OpLte, durationRef(), duration(3*time.Second)),
+		)
+		q := filterOnly(filter)
+		q.SearchDepth = 10
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Nil(t, got.Filter)
+		assert.Equal(t, "cart", got.ServiceName)
+		assert.Equal(t, "GET /cart", got.OperationName)
+		assert.Equal(t, time.Second, got.DurationMin)
+		assert.Equal(t, 3*time.Second, got.DurationMax)
+		assert.Equal(t, 10, got.SearchDepth)
+		assert.Equal(t, map[string]any{"span.a": "1", "res.b": "2", "event.c": "3", "d": "4"}, got.Attributes.AsRaw())
+	})
+
+	t.Run("the caller's map is not changed", func(t *testing.T) {
+		q := filterOnly(tagEq("a", "1"))
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, 0, q.Attributes.Len())
+		assert.Equal(t, 1, got.Attributes.Len())
+		assert.NotNil(t, q.Filter)
+	})
+
+	t.Run("zero-value attributes", func(t *testing.T) {
+		got, err := TraceQueryParams{Filter: tagEq("a", "1")}.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, map[string]any{"a": "1"}, got.Attributes.AsRaw())
+	})
+
+	t.Run("a lower bound of zero", func(t *testing.T) {
+		got, err := filterOnly(call(expression.OpGte, durationRef(), duration(0))).ToLegacyShape()
+		require.NoError(t, err)
+		assert.Zero(t, got.DurationMin)
+	})
+}
+
+func TestToLegacyShape_Refuses(t *testing.T) {
+	durationEq := func(op expression.Operator, value expression.Expression) *expression.Call {
+		return call(op, durationRef(), value)
+	}
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{
+			name:    "or",
+			filter:  call(expression.OpOr, tagEq("a", "1"), tagEq("b", "2")),
+			wantErr: `does not support the operator "or"`,
+		},
+		{
+			name:    "not",
+			filter:  call(expression.OpNot, tagEq("a", "1")),
+			wantErr: `does not support the operator "not"`,
+		},
+		{
+			name:    "exists",
+			filter:  call(expression.OpExists, attr("a")),
+			wantErr: `does not support the operator "exists"`,
+		},
+		{
+			name:    "or nested in a conjunction",
+			filter:  call(expression.OpAnd, tagEq("a", "1"), call(expression.OpOr, tagEq("b", "2"), tagEq("c", "3"))),
+			wantErr: `does not support the operator "or"`,
+		},
+		{
+			name:    "a predicate without two arguments",
+			filter:  call(expression.OpEq, attr("a")),
+			wantErr: `does not support the operator "eq"`,
+		},
+		{
+			name:    "a bare reference in a conjunction",
+			filter:  call(expression.OpAnd, tagEq("a", "1"), attr("b")),
+			wantErr: "conjunction of predicates only",
+		},
+		{
+			name:    "ne on an attribute",
+			filter:  call(expression.OpNe, attr("http.method"), anyValue("GET")),
+			wantErr: `does not support the operator "ne" on "http.method"`,
+		},
+		{
+			name:    "in on an attribute",
+			filter:  call(expression.OpIn, attr("http.status_code"), &expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			wantErr: `does not support the operator "in" on "http.status_code"`,
+		},
+		{
+			name:    "gt on the duration",
+			filter:  durationEq(expression.OpGt, duration(time.Second)),
+			wantErr: `does not support the operator "gt" on "duration"`,
+		},
+		{
+			name:    "regex on the operation name",
+			filter:  call(expression.OpRegex, operationRef(), str("GET.*")),
+			wantErr: `does not support the operator "regex" on "name"`,
+		},
+		{
+			name:    "ne on the service",
+			filter:  call(expression.OpNe, serviceRef(), str("cart")),
+			wantErr: `does not support the operator "ne" on "service"`,
+		},
+		{
+			name:    "an attribute at the link level",
+			filter:  call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelLink}, anyValue("1")),
+			wantErr: `does not index the "link" level`,
+		},
+		{
+			name:    "an attribute at the scope level",
+			filter:  call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelScope}, anyValue("1")),
+			wantErr: `does not index the "scope" level`,
+		},
+		{
+			name:    "another built-in field",
+			filter:  call(expression.OpEq, &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}, str("server")),
+			wantErr: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name:    "an attribute against a list",
+			filter:  call(expression.OpEq, attr("a"), &expression.List{Values: []string{"1"}}),
+			wantErr: `compares "a" against a string constant only`,
+		},
+		{
+			name:    "an attribute against an integer",
+			filter:  call(expression.OpEq, attr("a"), &expression.IntValue{Value: 1}),
+			wantErr: `compares "a" against a string constant only`,
+		},
+		{
+			name:    "the service against a boolean",
+			filter:  call(expression.OpEq, serviceRef(), &expression.BoolValue{Value: true}),
+			wantErr: `compares "service" against a string constant only`,
+		},
+		{
+			name:    "the operation name against another reference",
+			filter:  call(expression.OpEq, operationRef(), attr("a")),
+			wantErr: `compares "name" against a string constant only`,
+		},
+		{
+			name:    "a duration against a string",
+			filter:  durationEq(expression.OpGte, str("2s")),
+			wantErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:    "a duration against a missing constant",
+			filter:  durationEq(expression.OpGte, (*expression.DurationValue)(nil)),
+			wantErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:    "a duration against another reference",
+			filter:  durationEq(expression.OpLte, attr("a")),
+			wantErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name: "a quantifier over the events",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, &expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception"))),
+			wantErr: "compares a reference against a constant only",
+		},
+		{
+			name:    "a constant on the left",
+			filter:  call(expression.OpEq, anyValue("1"), attr("a")),
+			wantErr: "compares a reference against a constant only",
+		},
+		{
+			name:    "the same attribute twice",
+			filter:  call(expression.OpAnd, tagEq("a", "1"), call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelSpan}, anyValue("2"))),
+			wantErr: `only one predicate on "a"`,
+		},
+		{
+			name:    "the service twice",
+			filter:  call(expression.OpAnd, call(expression.OpEq, serviceRef(), str("a")), call(expression.OpEq, serviceRef(), str("b"))),
+			wantErr: `only one predicate on "service"`,
+		},
+		{
+			name:    "the operation name twice",
+			filter:  call(expression.OpAnd, call(expression.OpEq, operationRef(), str("a")), call(expression.OpEq, operationRef(), str("b"))),
+			wantErr: `only one predicate on "name"`,
+		},
+		{
+			name:    "the lower bound twice",
+			filter:  call(expression.OpAnd, durationEq(expression.OpGte, duration(time.Second)), durationEq(expression.OpGte, duration(2*time.Second))),
+			wantErr: `only one predicate on "duration"`,
+		},
+		{
+			name:    "the upper bound twice",
+			filter:  call(expression.OpAnd, durationEq(expression.OpLte, duration(time.Second)), durationEq(expression.OpLte, duration(2*time.Second))),
+			wantErr: `only one predicate on "duration"`,
+		},
+		{
+			name:    "an empty service, which the legacy field reads as none",
+			filter:  call(expression.OpEq, serviceRef(), str("")),
+			wantErr: `reads an empty "service" as no predicate`,
+		},
+		{
+			name:    "an upper bound of zero, which the legacy field reads as none",
+			filter:  durationEq(expression.OpLte, duration(0)),
+			wantErr: `reads a bound of "0s" on "duration" as no bound`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			q := filterOnly(tt.filter)
+			got, err := q.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.Contains(t, err.Error(), tt.wantErr)
+			assert.Equal(t, q, got, "on error the original query is returned")
+			assert.Equal(t, 0, q.Attributes.Len(), "the caller's map is not changed")
+		})
+	}
+}
+
+func TestToLegacyShape_RefusesAsInvalid(t *testing.T) {
+	t.Run("an unresolved duration bound", func(t *testing.T) {
+		q := filterOnly(call(expression.OpGte, durationRef(), anyValue("2s")))
+		got, err := q.ToLegacyShape()
+		require.ErrorIs(t, err, ErrFilterInvalid)
+		assert.Contains(t, err.Error(), `the bound "2s" on "duration" was never read as a duration`)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("a legacy field beside the filter", func(t *testing.T) {
+		q := filterOnly(call(expression.OpEq, serviceRef(), str("a")))
+		q.ServiceName = "b"
+		got, err := q.ToLegacyShape()
+		require.ErrorIs(t, err, ErrFilterInvalid)
+		assert.Contains(t, err.Error(), "[service_name]")
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("a conjunction that contains itself", func(t *testing.T) {
+		cyclic := call(expression.OpAnd, tagEq("a", "1"))
+		cyclic.Args = append(cyclic.Args, cyclic)
+		_, err := filterOnly(cyclic).ToLegacyShape()
+		require.ErrorIs(t, err, ErrFilterInvalid)
+		require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+	})
+}
