diff --git a/internal/storage/v2/api/tracestore/filter.go b/internal/storage/v2/api/tracestore/filter.go
index dcbb92e..003148c 100644
--- a/internal/storage/v2/api/tracestore/filter.go
+++ b/internal/storage/v2/api/tracestore/filter.go
@@ -1,57 +1,119 @@
 // Copyright (c) 2026 The Jaeger Authors.
 // SPDX-License-Identifier: Apache-2.0
 
 package tracestore
 
 import (
 	"errors"
+	"fmt"
 	"slices"
 
 	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
 )
 
 // ErrFilterUnsupported is returned for a well-formed query filter that the
 // storage cannot serve: a level it does not index, an operator it has not
 // implemented, or a boolean structure a flat index cannot evaluate. The query
 // is refused rather than approximated.
 var ErrFilterUnsupported = errors.New("this storage backend cannot serve this query filter")
 
 // ErrFilterInvalid is returned for a query filter whose value does not fit the
 // field it compares.
 var ErrFilterInvalid = errors.New("invalid query filter")
 
 // FilterCapabilities declares how much of a structured filter a Reader
 // evaluates, by naming the levels and operators it serves.
 //
 // Nothing is implicit: a Reader opts in only by naming something, so an empty
 // FilterCapabilities declares the same as none.
 type FilterCapabilities struct {
 	// Levels are the levels a reference may name. Empty means the Reader can
 	// serve only unqualified references.
 	Levels []expression.Level
 	// Operators are the operators the Reader evaluates, including the boolean
 	// combinators OpAnd, OpOr and OpNot.
 	Operators []expression.Operator
 }
 
 // IsEmpty reports whether c names no level and no operator. It is true for a
 // nil pointer, for the zero value, and for empty slices. Callers ask IsEmpty
 // rather than comparing against nil.
 func (c *FilterCapabilities) IsEmpty() bool {
 	return c == nil || (len(c.Levels) == 0 && len(c.Operators) == 0)
 }
 
 // SupportsLevel reports whether a reference may name level. The empty level,
 // an unqualified reference, is always supported; any other level only when it
 // is listed in Levels.
 func (c FilterCapabilities) SupportsLevel(level expression.Level) bool {
 	return level == "" || slices.Contains(c.Levels, level)
 }
 
 // SupportsOperator reports whether op is listed in Operators. The boolean
 // combinators are declared like any other operator, so the zero value supports
 // none of them, not even OpAnd. Nesting is not declared: and is associative,
 // so a caller flattens it before asking.
 func (c FilterCapabilities) SupportsOperator(op expression.Operator) bool {
 	return slices.Contains(c.Operators, op)
 }
+
+// EnsureSupported walks the filter and refuses the first predicate the Reader
+// did not declare it can evaluate: an operator absent from Operators, or a
+// reference to a level absent from Levels. A nil filter is supported, and a
+// constant needs no support.
+//
+// Nesting is checked like everything else: a call nested anywhere, also on the
+// right side of a comparison, is checked in full.
+func (c FilterCapabilities) EnsureSupported(filter *expression.Call) error {
+	return c.ensureCallSupported(filter, 1)
+}
+
+func (c FilterCapabilities) ensureCallSupported(call *expression.Call, depth int) error {
+	if call == nil {
+		return nil
+	}
+	// The AST is built from pointers, so a call can contain itself; the bound
+	// keeps the walk finite whatever tree it is handed.
+	if depth > expression.MaxNestingDepth {
+		return fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if !c.SupportsOperator(call.Op) {
+		return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, call.Op)
+	}
+	for _, arg := range call.Args {
+		if nested, ok := arg.(*expression.Call); ok {
+			if err := c.ensureCallSupported(nested, depth+1); err != nil {
+				return err
+			}
+			continue
+		}
+		if level, ok := referenceLevel(arg); ok && !c.SupportsLevel(level) {
+			return errLevelNotIndexed(level)
+		}
+	}
+	return nil
+}
+
+// referenceLevel returns the level a reference names. It reports false for
+// anything that is not a reference, such as a constant.
+func referenceLevel(e expression.Expression) (expression.Level, bool) {
+	switch ref := e.(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.NestedRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	}
+	return "", false
+}
+
+func errLevelNotIndexed(level expression.Level) error {
+	return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, level)
+}
diff --git a/internal/storage/v2/api/tracestore/filter_test.go b/internal/storage/v2/api/tracestore/filter_test.go
index 5f3a4aa..26965a5 100644
--- a/internal/storage/v2/api/tracestore/filter_test.go
+++ b/internal/storage/v2/api/tracestore/filter_test.go
@@ -1,69 +1,145 @@
 // Copyright (c) 2026 The Jaeger Authors.
 // SPDX-License-Identifier: Apache-2.0
 
 package tracestore
 
 import (
 	"testing"
 
 	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
 	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
 )
 
 func TestFilterCapabilitiesIsEmpty(t *testing.T) {
 	tests := []struct {
 		name string
 		caps *FilterCapabilities
 		want bool
 	}{
 		{name: "nil", caps: nil, want: true},
 		{name: "zero value", caps: &FilterCapabilities{}, want: true},
 		{
 			name: "empty slices",
 			caps: &FilterCapabilities{Levels: []expression.Level{}, Operators: []expression.Operator{}},
 			want: true,
 		},
 		{
 			name: "one level",
 			caps: &FilterCapabilities{Levels: []expression.Level{expression.LevelSpan}},
 			want: false,
 		},
 		{
 			name: "one operator",
 			caps: &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}},
 			want: false,
 		},
 	}
 	for _, tt := range tests {
 		t.Run(tt.name, func(t *testing.T) {
 			assert.Equal(t, tt.want, tt.caps.IsEmpty())
 		})
 	}
 }
 
 func TestFilterCapabilitiesSupportsLevel(t *testing.T) {
 	caps := FilterCapabilities{Levels: []expression.Level{expression.LevelSpan, expression.LevelResource}}
 	assert.True(t, caps.SupportsLevel(""), "an unqualified reference is always supported")
 	assert.True(t, caps.SupportsLevel(expression.LevelSpan))
 	assert.True(t, caps.SupportsLevel(expression.LevelResource))
 	assert.False(t, caps.SupportsLevel(expression.LevelScope))
 	assert.False(t, caps.SupportsLevel(expression.LevelEvent))
 
 	var zero FilterCapabilities
 	assert.True(t, zero.SupportsLevel(""))
 	assert.False(t, zero.SupportsLevel(expression.LevelSpan))
 }
 
 func TestFilterCapabilitiesSupportsOperator(t *testing.T) {
 	conjunctive := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd, expression.OpEq}}
 	assert.True(t, conjunctive.SupportsOperator(expression.OpAnd))
 	assert.True(t, conjunctive.SupportsOperator(expression.OpEq))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpOr))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpNot))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpRegex))
 
 	var zero FilterCapabilities
 	for _, op := range []expression.Operator{expression.OpAnd, expression.OpOr, expression.OpNot, expression.OpEq} {
 		assert.False(t, zero.SupportsOperator(op), "zero value must not support %q", op)
 	}
 }
+
+func TestFilterCapabilitiesEnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpNe, expression.OpSome},
+	}
+	spanName := &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{name: "nil filter"},
+		{
+			name: "declared operators and levels, with constants",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, attr("a"), anyValue("1")),
+				call(expression.OpEq, spanName, &expression.IntValue{Value: 1})),
+		},
+		{
+			name:    "an undeclared operator",
+			filter:  call(expression.OpOr, call(expression.OpEq, attr("a"), anyValue("1"))),
+			wantErr: `it does not support the operator "or"`,
+		},
+		{
+			name: "an undeclared operator nested on the right of a comparison",
+			filter: call(expression.OpEq, attr("a"),
+				call(expression.OpGt, attr("b"), anyValue("1"))),
+			wantErr: `it does not support the operator "gt"`,
+		},
+		{
+			name: "an attribute at an undeclared level",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a", Level: expression.LevelResource}, anyValue("1")),
+			wantErr: `it does not index the "resource" level`,
+		},
+		{
+			name: "a field at an undeclared level",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelScope, Name: expression.ScopeFieldName}, str("x")),
+			wantErr: `it does not index the "scope" level`,
+		},
+		{
+			name: "a nested reference at an undeclared level",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, attr("a"), anyValue("1"))),
+			wantErr: `it does not index the "event" level`,
+		},
+		{
+			name: "a reference at an undeclared level on the right",
+			filter: call(expression.OpNe, attr("a"),
+				&expression.AttributeRef{Key: "a", Level: expression.LevelLink}),
+			wantErr: `it does not index the "link" level`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := caps.EnsureSupported(tt.filter)
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.Contains(t, err.Error(), tt.wantErr)
+		})
+	}
+
+	t.Run("a call that contains itself", func(t *testing.T) {
+		cyclic := call(expression.OpAnd, call(expression.OpEq, attr("a"), anyValue("1")))
+		cyclic.Args = append(cyclic.Args, cyclic)
+		err := caps.EnsureSupported(cyclic)
+		require.ErrorIs(t, err, ErrFilterInvalid)
+		require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+	})
+}
diff --git a/internal/storage/v2/api/tracestore/query_shape.go b/internal/storage/v2/api/tracestore/query_shape.go
new file mode 100644
index 0000000..bcebb1e
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_shape.go
@@ -0,0 +1,350 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// A TraceQueryParams states its predicates in one of two shapes: the legacy
+// scalar fields (ServiceName, OperationName, Attributes and the duration
+// bounds), which every backend serves, or Filter, which only a Reader that
+// declares SearchCapabilities.Filter evaluates. The methods in this file decide
+// which shape a Reader receives and convert between the two.
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. The error wraps ErrFilterInvalid
+// and names every conflicting field.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if attributeCount(q.Attributes) > 0 {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) > 0 {
+		return fmt.Errorf("%w: the filter replaces the predicate fields %v, which must be empty beside it",
+			ErrFilterInvalid, conflicts)
+	}
+	return nil
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A query without a filter is returned unchanged. A
+// Reader that declares no filter capability receives q.ToLegacyShape(); any
+// other Reader receives q as it is, provided it declared everything the filter
+// uses (see FilterCapabilities.EnsureSupported).
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates. It
+// cannot fail, because each legacy field has an exact filter equivalent. A
+// query that already has a Filter is returned as it is.
+//
+// The converted fields are cleared and every other field is kept. The filter
+// is already finalized: it holds typed constants with the reference first, so
+// expression.Finalize returns an equal tree.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, eq(serviceRef(), &expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, eq(operationRef(), &expression.StringValue{Value: q.OperationName}))
+	}
+	if attributeCount(q.Attributes) > 0 {
+		for key, value := range q.Attributes.All() {
+			predicates = append(predicates,
+				eq(&expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value.AsString()}))
+		}
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, &expression.Call{
+			Op:   expression.OpGte,
+			Args: []expression.Expression{durationRef(), &expression.DurationValue{Value: q.DurationMin}},
+		})
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, &expression.Call{
+			Op:   expression.OpLte,
+			Args: []expression.Expression{durationRef(), &expression.DurationValue{Value: q.DurationMax}},
+		})
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	switch len(predicates) {
+	case 0:
+		q.Filter = nil
+	case 1:
+		q.Filter = predicates[0]
+	default:
+		args := make([]expression.Expression, len(predicates))
+		for i, predicate := range predicates {
+			args[i] = predicate
+		}
+		q.Filter = &expression.Call{Op: expression.OpAnd, Args: args}
+	}
+	return q
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves. A query without a filter is returned unchanged.
+//
+// Only a flat conjunction of the predicates the legacy fields can hold converts;
+// anything else is refused with ErrFilterUnsupported rather than approximated.
+// A query that also sets a legacy predicate field is refused as
+// EnsureFilterStandsAlone refuses it, since converting would overwrite that
+// field. On error the original query is returned.
+//
+// The result has a nil Filter and a new Attributes map, so the caller's map is
+// not changed.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	conjuncts, err := flattenConjunction(q.Filter, nil, 1)
+	if err != nil {
+		return q, err
+	}
+	legacy := legacyQuery{query: q}
+	legacy.query.Filter = nil
+	legacy.query.Attributes = pcommon.NewMap()
+	for _, conjunct := range conjuncts {
+		if err := legacy.add(conjunct); err != nil {
+			return q, err
+		}
+	}
+	return legacy.query, nil
+}
+
+// flattenConjunction appends the conjuncts of e to out, descending into nested
+// OpAnd calls, which is safe because and is associative.
+func flattenConjunction(e expression.Expression, out []expression.Expression, depth int) ([]expression.Expression, error) {
+	call, ok := e.(*expression.Call)
+	if !ok || call == nil || call.Op != expression.OpAnd {
+		return append(out, e), nil
+	}
+	if depth > expression.MaxNestingDepth {
+		return nil, fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	for _, arg := range call.Args {
+		var err error
+		if out, err = flattenConjunction(arg, out, depth+1); err != nil {
+			return nil, err
+		}
+	}
+	return out, nil
+}
+
+// legacyQuery accumulates the legacy predicate fields of a query, one
+// predicate at a time, and remembers which fields a predicate has written so a
+// second predicate on the same field is refused rather than overwriting it.
+type legacyQuery struct {
+	query                                    TraceQueryParams
+	hasService, hasOperation, hasMin, hasMax bool
+}
+
+func (l *legacyQuery) add(conjunct expression.Expression) error {
+	call, ok := conjunct.(*expression.Call)
+	if !ok || call == nil {
+		return fmt.Errorf("%w: it serves a conjunction of predicates only, not %T", ErrFilterUnsupported, conjunct)
+	}
+	switch call.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return errOperatorUnsupported(call.Op)
+	}
+	if len(call.Args) != 2 {
+		return errOperatorUnsupported(call.Op)
+	}
+	switch ref := call.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return l.addAttribute(call.Op, ref, call.Args[1])
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return l.addField(call.Op, ref, call.Args[1])
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only, not %T",
+		ErrFilterUnsupported, call.Args[0])
+}
+
+func (l *legacyQuery) addAttribute(op expression.Operator, ref *expression.AttributeRef, operand expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+		// A tag is searched across these levels, so a qualified attribute widens
+		// to a plain tag.
+	default:
+		return errLevelNotIndexed(ref.Level)
+	}
+	if op != expression.OpEq {
+		return errOperatorOnUnsupported(op, ref.Key)
+	}
+	value, err := stringConstant(ref.Key, operand)
+	if err != nil {
+		return err
+	}
+	if _, exists := l.query.Attributes.Get(ref.Key); exists {
+		return errOnePredicateOnly(ref.Key)
+	}
+	l.query.Attributes.PutStr(ref.Key, value)
+	return nil
+}
+
+func (l *legacyQuery) addField(op expression.Operator, ref *expression.FieldRef, operand expression.Expression) error {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		return addStringField(op, ref.Name, operand, &l.hasService, &l.query.ServiceName)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		return addStringField(op, ref.Name, operand, &l.hasOperation, &l.query.OperationName)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		switch op {
+		case expression.OpGte:
+			return addDurationBound(op, operand, &l.hasMin, &l.query.DurationMin)
+		case expression.OpLte:
+			return addDurationBound(op, operand, &l.hasMax, &l.query.DurationMax)
+		default:
+			return errOperatorOnUnsupported(op, ref.Name)
+		}
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+func addStringField(op expression.Operator, name string, operand expression.Expression, written *bool, field *string) error {
+	if op != expression.OpEq {
+		return errOperatorOnUnsupported(op, name)
+	}
+	value, err := stringConstant(name, operand)
+	if err != nil {
+		return err
+	}
+	if value == "" {
+		// The legacy field reads an empty string as no predicate at all, which
+		// would widen the query rather than serve it.
+		return fmt.Errorf("%w: it reads an empty %q as no predicate", ErrFilterUnsupported, name)
+	}
+	if *written {
+		return errOnePredicateOnly(name)
+	}
+	*written = true
+	*field = value
+	return nil
+}
+
+func addDurationBound(op expression.Operator, operand expression.Expression, written *bool, bound *time.Duration) error {
+	name := expression.SpanFieldDuration
+	if untyped, ok := operand.(*expression.AnyValue); ok && untyped != nil {
+		return fmt.Errorf("%w: the bound %q on %q was never read as a duration",
+			ErrFilterInvalid, untyped.Value, name)
+	}
+	constant, ok := operand.(*expression.DurationValue)
+	if !ok || constant == nil {
+		return fmt.Errorf("%w: it compares %q against a duration such as %q only",
+			ErrFilterUnsupported, name, "2s")
+	}
+	value := constant.Value
+	if op == expression.OpLte && value == 0 {
+		// DurationMax reads zero as no bound, which would widen the query
+		// rather than serve it. A lower bound of zero is no bound either way.
+		return fmt.Errorf("%w: it reads a bound of %q on %q as no bound", ErrFilterUnsupported, value, name)
+	}
+	if *written {
+		return errOnePredicateOnly(name)
+	}
+	*written = true
+	*bound = value
+	return nil
+}
+
+// stringConstant returns the text of the constant a string predicate compares
+// against: a string, or an untyped constant, which a tag always was.
+func stringConstant(name string, operand expression.Expression) (string, error) {
+	switch constant := operand.(type) {
+	case *expression.StringValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	case *expression.AnyValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only, not %T",
+		ErrFilterUnsupported, name, operand)
+}
+
+func errOperatorUnsupported(op expression.Operator) error {
+	return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, op)
+}
+
+func errOperatorOnUnsupported(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func errOnePredicateOnly(name string) error {
+	return fmt.Errorf("%w: it supports only one predicate on %q", ErrFilterUnsupported, name)
+}
+
+// attributeCount is m.Len(), except that it also accepts the zero value of
+// pcommon.Map, which a caller gets by not calling pcommon.NewMap() and whose
+// Len panics.
+func attributeCount(m pcommon.Map) int {
+	if m == (pcommon.Map{}) {
+		return 0
+	}
+	return m.Len()
+}
+
+func eq(ref, constant expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpEq, Args: []expression.Expression{ref, constant}}
+}
+
+func serviceRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func operationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
+
+func durationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+}
