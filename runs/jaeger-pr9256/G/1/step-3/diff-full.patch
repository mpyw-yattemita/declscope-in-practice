+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := tagEq("http.method", "GET")
+	tests := []struct {
+		name    string
+		query   func() TraceQueryParams
+		wantErr string
+	}{
+		{name: "no filter", query: func() TraceQueryParams {
+			return TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		}},
+		{name: "filter alone", query: func() TraceQueryParams { return filterOnly(filter) }},
+		{name: "filter with zero-value attributes", query: func() TraceQueryParams {
+			return TraceQueryParams{Filter: filter}
+		}},
+		{name: "service name", wantErr: "[service_name]", query: func() TraceQueryParams {
+			q := filterOnly(filter)
+			q.ServiceName = "cart"
+			return q
+		}},
+		{name: "operation name", wantErr: "[operation_name]", query: func() TraceQueryParams {
+			q := filterOnly(filter)
+			q.OperationName = "GET /cart"
+			return q
+		}},
+		{name: "duration min", wantErr: "[duration_min]", query: func() TraceQueryParams {
+			q := filterOnly(filter)
+			q.DurationMin = time.Second
+			return q
+		}},
+		{name: "duration max", wantErr: "[duration_max]", query: func() TraceQueryParams {
+			q := filterOnly(filter)
+			q.DurationMax = time.Second
+			return q
+		}},
+		{name: "attributes", wantErr: "[attributes]", query: func() TraceQueryParams {
+			q := filterOnly(filter)
+			q.Attributes.PutStr("a", "1")
+			return q
+		}},
+		{
+			name:    "all of them, in order",
+			wantErr: "[service_name operation_name duration_min duration_max attributes]",
+			query: func() TraceQueryParams {
+				q := filterOnly(filter)
+				q.Attributes.PutStr("a", "1")
+				q.DurationMax = 2 * time.Second
+				q.DurationMin = time.Second
+				q.OperationName = "op"
+				q.ServiceName = "svc"
+				return q
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.query().EnsureFilterStandsAlone()
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.Contains(t, err.Error(), tt.wantErr)
+		})
+	}
+}
