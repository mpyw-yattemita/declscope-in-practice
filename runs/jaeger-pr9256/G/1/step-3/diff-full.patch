+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func attr(key string) *expression.AttributeRef {
+	return &expression.AttributeRef{Key: key}
+}
+
+func anyValue(v string) *expression.AnyValue {
+	return &expression.AnyValue{Value: v}
+}
+
+func str(v string) *expression.StringValue {
+	return &expression.StringValue{Value: v}
+}
+
+func duration(d time.Duration) *expression.DurationValue {
+	return &expression.DurationValue{Value: d}
+}
+
+func tagEq(key, value string) *expression.Call {
+	return call(expression.OpEq, attr(key), anyValue(value))
+}
+
+func filterOnly(filter *expression.Call) TraceQueryParams {
+	return TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}
+}
