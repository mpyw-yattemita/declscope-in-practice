+func TestForCapabilities(t *testing.T) {
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		q := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap(), SearchDepth: 7}
+		got, err := q.ForCapabilities(SearchCapabilities{})
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("no declaration gets the legacy shape", func(t *testing.T) {
+		for name, caps := range map[string]SearchCapabilities{
+			"nil":   {},
+			"empty": {Filter: &FilterCapabilities{}},
+		} {
+			t.Run(name, func(t *testing.T) {
+				got, err := filterOnly(tagEq("http.method", "GET")).ForCapabilities(caps)
+				require.NoError(t, err)
+				assert.Nil(t, got.Filter)
+				assert.Equal(t, map[string]any{"http.method": "GET"}, got.Attributes.AsRaw())
+			})
+		}
+	})
+
+	t.Run("no declaration and an unconvertible filter is refused", func(t *testing.T) {
+		q := filterOnly(call(expression.OpOr, tagEq("a", "1"), tagEq("b", "2")))
+		got, err := q.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, q, got)
+	})
+
+	caps := SearchCapabilities{Filter: &FilterCapabilities{
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq},
+	}}
+
+	t.Run("a declared filter is passed as it is", func(t *testing.T) {
+		q := filterOnly(call(expression.OpAnd, tagEq("a", "1"), tagEq("b", "2")))
+		got, err := q.ForCapabilities(caps)
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("an undeclared operator is refused", func(t *testing.T) {
+		q := filterOnly(call(expression.OpOr, tagEq("a", "1"), tagEq("b", "2")))
+		got, err := q.ForCapabilities(caps)
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Contains(t, err.Error(), `it does not support the operator "or"`)
+		assert.Equal(t, q, got)
+	})
+}
