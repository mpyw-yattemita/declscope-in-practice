+func TestToLegacyShape_Converts(t *testing.T) {
+	spanAttr := &expression.AttributeRef{Key: "span.k", Level: expression.LevelSpan}
+	resourceAttr := &expression.AttributeRef{Key: "resource.k", Level: expression.LevelResource}
+	eventAttr := &expression.AttributeRef{Key: "event.k", Level: expression.LevelEvent}
+	filter := call(expression.OpAnd,
+		call(expression.OpEq, serviceRef(), &expression.AnyValue{Value: "cart"}),
+		call(expression.OpAnd,
+			call(expression.OpEq, operationRef(), str("GET /cart")),
+			call(expression.OpAnd,
+				call(expression.OpEq, spanAttr, str("s")),
+				call(expression.OpEq, resourceAttr, &expression.AnyValue{Value: "r"}))),
+		call(expression.OpEq, eventAttr, str("e")),
+		tagEq("plain", "p"),
+		call(expression.OpGte, durationRef(), dur(time.Second)),
+		call(expression.OpLte, durationRef(), dur(3*time.Second)),
+	)
+	query := withFilter(filter)
+	query.SearchDepth = 7
+
+	got, err := query.ToLegacyShape()
+	require.NoError(t, err)
+	assert.Nil(t, got.Filter)
+	assert.Equal(t, "cart", got.ServiceName)
+	assert.Equal(t, "GET /cart", got.OperationName)
+	assert.Equal(t, time.Second, got.DurationMin)
+	assert.Equal(t, 3*time.Second, got.DurationMax)
+	assert.Equal(t, 7, got.SearchDepth)
+	assert.Equal(t, map[string]any{
+		"span.k": "s", "resource.k": "r", "event.k": "e", "plain": "p",
+	}, got.Attributes.AsRaw())
+	assert.Equal(t, 0, query.Attributes.Len(), "the caller's map is not changed")
+	assert.Same(t, filter, query.Filter)
+}
