diff --git a/internal/storage/v2/api/tracestore/filter.go b/internal/storage/v2/api/tracestore/filter.go
index dc76a60..2bf3b07 100644
--- a/internal/storage/v2/api/tracestore/filter.go
+++ b/internal/storage/v2/api/tracestore/filter.go
@@ -5,6 +5,7 @@ package tracestore
 
 import (
 	"errors"
+	"fmt"
 	"slices"
 
 	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
@@ -55,3 +56,48 @@ func (c FilterCapabilities) SupportsLevel(level expression.Level) bool {
 func (c FilterCapabilities) SupportsOperator(op expression.Operator) bool {
 	return slices.Contains(c.Operators, op)
 }
+
+// EnsureSupported walks filter and refuses the first predicate the Reader did
+// not declare it can evaluate: an operator absent from Operators, or a
+// reference to a level absent from Levels. A nil filter is supported.
+// Constants need no support. Every refusal wraps ErrFilterUnsupported.
+func (c FilterCapabilities) EnsureSupported(filter *expression.Call) error {
+	if filter == nil {
+		return nil
+	}
+	if !c.SupportsOperator(filter.Op) {
+		return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, filter.Op)
+	}
+	for _, arg := range filter.Args {
+		if call, ok := arg.(*expression.Call); ok {
+			if err := c.EnsureSupported(call); err != nil {
+				return err
+			}
+			continue
+		}
+		if level, ok := referenceLevel(arg); ok && !c.SupportsLevel(level) {
+			return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, level)
+		}
+	}
+	return nil
+}
+
+// referenceLevel returns the level a reference names. Its second result is
+// false for anything that is not a reference, such as a constant.
+func referenceLevel(e expression.Expression) (expression.Level, bool) {
+	switch ref := e.(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.NestedRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	}
+	return "", false
+}
diff --git a/internal/storage/v2/api/tracestore/filter_test.go b/internal/storage/v2/api/tracestore/filter_test.go
index a9ff978..225964a 100644
--- a/internal/storage/v2/api/tracestore/filter_test.go
+++ b/internal/storage/v2/api/tracestore/filter_test.go
@@ -8,6 +8,7 @@ import (
 
 	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
 	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
 )
 
 func TestFilterCapabilities_IsEmpty(t *testing.T) {
@@ -56,3 +57,81 @@ func TestFilterCapabilities_SupportsOperator(t *testing.T) {
 	assert.False(t, zero.SupportsOperator(expression.OpAnd), "the zero value supports no operator, not even and")
 	assert.False(t, zero.SupportsOperator(expression.OpEq))
 }
+
+func TestFilterCapabilities_EnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan, expression.LevelEvent},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpNe, expression.OpSome},
+	}
+	spanAttr := &expression.AttributeRef{Key: "k", Level: expression.LevelSpan}
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string
+	}{
+		{name: "nil filter"},
+		{name: "unqualified attribute", filter: tagEq("a", "1")},
+		{name: "nil references", filter: call(expression.OpEq, (*expression.AttributeRef)(nil), (*expression.FieldRef)(nil))},
+		{name: "a nil nested call", filter: call(expression.OpAnd, (*expression.Call)(nil))},
+		{
+			name: "declared levels and operators, nested",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, spanAttr, str("v")),
+				call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+					call(expression.OpEq,
+						&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName},
+						str("exception")))),
+		},
+		{
+			name:     "an undeclared operator",
+			filter:   call(expression.OpGt, spanAttr, str("1")),
+			expected: `it does not support the operator "gt"`,
+		},
+		{
+			name:     "an undeclared operator nested in a conjunction",
+			filter:   call(expression.OpAnd, tagEq("a", "1"), call(expression.OpOr, tagEq("b", "1"), tagEq("c", "1"))),
+			expected: `it does not support the operator "or"`,
+		},
+		{
+			name: "an undeclared level on an attribute",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "k", Level: expression.LevelResource}, str("v")),
+			expected: `it does not index the "resource" level`,
+		},
+		{
+			name: "an undeclared level on a field",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelScope, Name: expression.ScopeFieldName}, str("v")),
+			expected: `it does not index the "scope" level`,
+		},
+		{
+			name: "an undeclared level on a collection",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelLink},
+				call(expression.OpEq, spanAttr, str("v"))),
+			expected: `it does not index the "link" level`,
+		},
+		{
+			name: "an undeclared level on the right of a comparison",
+			filter: call(expression.OpNe, spanAttr,
+				&expression.AttributeRef{Key: "k", Level: expression.LevelResource}),
+			expected: `it does not index the "resource" level`,
+		},
+		{
+			name: "an undeclared operator in a call on the right of a comparison",
+			filter: call(expression.OpEq, spanAttr,
+				call(expression.OpRegex, spanAttr, str(".*"))),
+			expected: `it does not support the operator "regex"`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := caps.EnsureSupported(test.filter)
+			if test.expected == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.Contains(t, err.Error(), test.expected)
+		})
+	}
+}
diff --git a/internal/storage/v2/api/tracestore/query_filter.go b/internal/storage/v2/api/tracestore/query_filter.go
new file mode 100644
index 0000000..fefaeed
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_filter.go
@@ -0,0 +1,323 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces, because a Reader serves one
+// filtering model, not a mix of the two. The error wraps ErrFilterInvalid and
+// names every conflicting field.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if hasAttributes(q.Attributes) {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) > 0 {
+		return fmt.Errorf("%w: a filter cannot be combined with the predicate fields it replaces, %v",
+			ErrFilterInvalid, conflicts)
+	}
+	return nil
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A Reader that declared filter support receives the
+// filter as it is, provided it can evaluate every predicate in it. A Reader that
+// declared none receives the filter expressed in the legacy predicate fields,
+// provided the filter can be expressed there (see ToLegacyShape).
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates. It
+// cannot fail, since each legacy field has an exact filter equivalent. A query
+// that already has a Filter is returned as it is.
+//
+// The converted fields are cleared and every other field is kept. The filter
+// is nil when there is nothing to filter on, a single predicate when there is
+// one, and a conjunction otherwise. Its constants are already typed, so it
+// needs no resolution.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, predicate(expression.OpEq,
+			&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+			&expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, predicate(expression.OpEq,
+			&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+			&expression.StringValue{Value: q.OperationName}))
+	}
+	if hasAttributes(q.Attributes) {
+		q.Attributes.Range(func(key string, value pcommon.Value) bool {
+			predicates = append(predicates, predicate(expression.OpEq,
+				&expression.AttributeRef{Key: key},
+				&expression.AnyValue{Value: value.AsString()}))
+			return true
+		})
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, predicate(expression.OpGte, durationRef(),
+			&expression.DurationValue{Value: q.DurationMin}))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, predicate(expression.OpLte, durationRef(),
+			&expression.DurationValue{Value: q.DurationMax}))
+	}
+
+	shaped := q
+	shaped.ServiceName = ""
+	shaped.OperationName = ""
+	shaped.Attributes = pcommon.NewMap()
+	shaped.DurationMin = 0
+	shaped.DurationMax = 0
+	switch len(predicates) {
+	case 0:
+		shaped.Filter = nil
+	case 1:
+		shaped.Filter = predicates[0]
+	default:
+		args := make([]expression.Expression, len(predicates))
+		for i, p := range predicates {
+			args[i] = p
+		}
+		shaped.Filter = &expression.Call{Op: expression.OpAnd, Args: args}
+	}
+	return shaped
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves. A query without a filter is returned unchanged.
+//
+// Only a flat conjunction of the predicates the legacy fields can hold
+// converts: equality on an attribute, the service or the operation name, and
+// the inclusive duration bounds. Anything else is refused with an error
+// wrapping ErrFilterUnsupported, rather than approximated. A filter that was
+// never finalized, or one that sits beside the legacy fields it would write, is
+// refused with ErrFilterInvalid. On error the original query is returned.
+//
+// The result has a nil Filter and a new Attributes map, so the caller's map is
+// not changed.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	w := legacyWriter{query: q}
+	w.query.Filter = nil
+	w.query.Attributes = pcommon.NewMap()
+	if err := w.write(q.Filter); err != nil {
+		return q, err
+	}
+	return w.query, nil
+}
+
+// legacyWriter writes the conjuncts of a filter into the legacy predicate
+// fields of query, remembering which fields it has written so that a second
+// predicate on one of them is refused rather than overwriting the first.
+type legacyWriter struct {
+	query TraceQueryParams
+
+	wroteService     bool
+	wroteOperation   bool
+	wroteDurationMin bool
+	wroteDurationMax bool
+}
+
+// write writes one conjunct, flattening a nested conjunction into its own.
+func (w *legacyWriter) write(e expression.Expression) error {
+	call, ok := e.(*expression.Call)
+	if !ok || call == nil {
+		return fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+	}
+	switch call.Op {
+	case expression.OpAnd:
+		for _, arg := range call.Args {
+			if err := w.write(arg); err != nil {
+				return err
+			}
+		}
+		return nil
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return errOperator(call.Op)
+	}
+	if len(call.Args) != 2 {
+		return errOperator(call.Op)
+	}
+	switch ref := call.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return w.writeAttribute(call.Op, ref, call.Args[1])
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return w.writeField(call.Op, ref, call.Args[1])
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+// writeAttribute writes an equality on an attribute as a tag. A tag is looked
+// up at the span and resource levels, and the event level where a backend
+// indexes it, so a predicate on one of those levels widens to a plain tag. The
+// link and scope levels are not searched for tags at all.
+func (w *legacyWriter) writeAttribute(op expression.Operator, ref *expression.AttributeRef, operand expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+	default:
+		return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, ref.Level)
+	}
+	if op != expression.OpEq {
+		return errOperatorOn(op, ref.Key)
+	}
+	value, err := stringOperand(ref.Key, operand)
+	if err != nil {
+		return err
+	}
+	if _, ok := w.query.Attributes.Get(ref.Key); ok {
+		return errDuplicate(ref.Key)
+	}
+	w.query.Attributes.PutStr(ref.Key, value)
+	return nil
+}
+
+// writeField writes a predicate on one of the three built-in fields the legacy
+// fields hold: the service, the operation name and the duration.
+func (w *legacyWriter) writeField(op expression.Operator, ref *expression.FieldRef, operand expression.Expression) error {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		return writeString(op, ref.Name, operand, &w.query.ServiceName, &w.wroteService)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		return writeString(op, ref.Name, operand, &w.query.OperationName, &w.wroteOperation)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		return w.writeDuration(op, ref.Name, operand)
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+// writeString writes an equality on a string-valued field into target, which
+// wrote records as written.
+func writeString(op expression.Operator, name string, operand expression.Expression, target *string, wrote *bool) error {
+	if op != expression.OpEq {
+		return errOperatorOn(op, name)
+	}
+	value, err := stringOperand(name, operand)
+	if err != nil {
+		return err
+	}
+	if *wrote {
+		return errDuplicate(name)
+	}
+	*target, *wrote = value, true
+	return nil
+}
+
+// writeDuration writes an inclusive duration bound.
+func (w *legacyWriter) writeDuration(op expression.Operator, name string, operand expression.Expression) error {
+	var target *time.Duration
+	var wrote *bool
+	switch op {
+	case expression.OpGte:
+		target, wrote = &w.query.DurationMin, &w.wroteDurationMin
+	case expression.OpLte:
+		target, wrote = &w.query.DurationMax, &w.wroteDurationMax
+	default:
+		return errOperatorOn(op, name)
+	}
+	switch value := operand.(type) {
+	case *expression.DurationValue:
+		if value != nil {
+			if *wrote {
+				return errDuplicate(name)
+			}
+			*target, *wrote = value.Value, true
+			return nil
+		}
+	case *expression.AnyValue:
+		if value != nil {
+			// Resolving the filter reads this constant as a duration, so an
+			// untyped one means the filter was never finalized.
+			return fmt.Errorf("%w: the bound %q on %q was never read as a duration",
+				ErrFilterInvalid, value.Value, name)
+		}
+	}
+	return fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only", ErrFilterUnsupported, name)
+}
+
+// stringOperand returns the text of a string or untyped constant, the only
+// values the legacy string fields and tags hold.
+func stringOperand(name string, operand expression.Expression) (string, error) {
+	switch value := operand.(type) {
+	case *expression.StringValue:
+		if value != nil {
+			return value.Value, nil
+		}
+	case *expression.AnyValue:
+		if value != nil {
+			return value.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+func errOperator(op expression.Operator) error {
+	return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, op)
+}
+
+func errOperatorOn(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func errDuplicate(name string) error {
+	return fmt.Errorf("%w: it accepts only one predicate on %q", ErrFilterUnsupported, name)
+}
+
+func predicate(op expression.Operator, ref, constant expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: []expression.Expression{ref, constant}}
+}
+
+func durationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+}
+
+// hasAttributes reports whether m holds an entry. A Map left at its zero value,
+// rather than created with pcommon.NewMap, holds none and must not be read.
+func hasAttributes(m pcommon.Map) bool {
+	return m != (pcommon.Map{}) && m.Len() > 0
+}
diff --git a/internal/storage/v2/api/tracestore/query_filter_test.go b/internal/storage/v2/api/tracestore/query_filter_test.go
new file mode 100644
index 0000000..99e60a0
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_filter_test.go
@@ -0,0 +1,509 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"testing"
+	"time"
+
+	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func attr(key string) *expression.AttributeRef {
+	return &expression.AttributeRef{Key: key}
+}
+
+func tagEq(key, value string) *expression.Call {
+	return call(expression.OpEq, attr(key), &expression.AnyValue{Value: value})
+}
+
+func serviceRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func operationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
+
+func str(v string) *expression.StringValue { return &expression.StringValue{Value: v} }
+
+func dur(d time.Duration) *expression.DurationValue { return &expression.DurationValue{Value: d} }
+
+func withFilter(filter *expression.Call) TraceQueryParams {
+	return TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}
+}
+
+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := tagEq("http.method", "GET")
+	tests := []struct {
+		name     string
+		query    func() TraceQueryParams
+		expected string
+	}{
+		{name: "no filter", query: func() TraceQueryParams {
+			return TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		}},
+		{name: "filter alone", query: func() TraceQueryParams { return withFilter(filter) }},
+		{name: "filter with a zero-value attributes map", query: func() TraceQueryParams {
+			return TraceQueryParams{Filter: filter}
+		}},
+		{name: "filter beside a service name", query: func() TraceQueryParams {
+			q := withFilter(filter)
+			q.ServiceName = "cart"
+			return q
+		}, expected: "[service_name]"},
+		{name: "filter beside an attribute", query: func() TraceQueryParams {
+			q := withFilter(filter)
+			q.Attributes.PutStr("a", "1")
+			return q
+		}, expected: "[attributes]"},
+		{name: "filter beside every predicate field", query: func() TraceQueryParams {
+			q := withFilter(filter)
+			q.ServiceName = "cart"
+			q.OperationName = "GET /cart"
+			q.DurationMin = time.Second
+			q.DurationMax = 2 * time.Second
+			q.Attributes.PutStr("a", "1")
+			return q
+		}, expected: "[service_name operation_name duration_min duration_max attributes]"},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.query().EnsureFilterStandsAlone()
+			if test.expected == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.Contains(t, err.Error(), test.expected)
+		})
+	}
+}
+
+func TestForCapabilities(t *testing.T) {
+	declared := SearchCapabilities{Filter: &FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq},
+	}}
+
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		query := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		got, err := query.ForCapabilities(declared)
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("a declaring reader gets the filter", func(t *testing.T) {
+		query := withFilter(call(expression.OpAnd, tagEq("a", "1"), tagEq("b", "2")))
+		got, err := query.ForCapabilities(declared)
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("a declaring reader refuses what it did not declare", func(t *testing.T) {
+		query := withFilter(call(expression.OpOr, tagEq("a", "1"), tagEq("b", "2")))
+		got, err := query.ForCapabilities(declared)
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Contains(t, err.Error(), `does not support the operator "or"`)
+		assert.Equal(t, query, got)
+	})
+
+	for name, caps := range map[string]SearchCapabilities{
+		"no declaration":    {},
+		"empty declaration": {Filter: &FilterCapabilities{}},
+	} {
+		t.Run(name+" gets the legacy shape", func(t *testing.T) {
+			query := withFilter(call(expression.OpEq, serviceRef(), str("cart")))
+			got, err := query.ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Nil(t, got.Filter)
+			assert.Equal(t, "cart", got.ServiceName)
+
+			_, err = withFilter(call(expression.OpOr, tagEq("a", "1"), tagEq("b", "2"))).ForCapabilities(caps)
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+		})
+	}
+}
