+func TestToLegacyShape_RefusesAnUnresolvedBound(t *testing.T) {
+	query := withFilter(call(expression.OpGte, durationRef(), &expression.AnyValue{Value: "2s"}))
+	got, err := query.ToLegacyShape()
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	assert.NotErrorIs(t, err, ErrFilterUnsupported)
+	assert.Contains(t, err.Error(), `the bound "2s" on "duration" was never read as a duration`)
+	assert.Equal(t, query, got)
+}
