+func TestToFilterShape(t *testing.T) {
+	start := time.Date(2026, 1, 2, 3, 4, 5, 0, time.UTC)
+	query := TraceQueryParams{
+		ServiceName:   "cart",
+		OperationName: "GET /cart",
+		Attributes:    pcommon.NewMap(),
+		StartTimeMin:  start,
+		StartTimeMax:  start.Add(time.Hour),
+		DurationMin:   time.Second,
+		DurationMax:   2 * time.Second,
+		SearchDepth:   20,
+	}
+	query.Attributes.PutStr("http.method", "GET")
+	query.Attributes.PutStr("http.route", "/cart")
+
+	got := query.ToFilterShape()
+
+	assert.Equal(t, call(expression.OpAnd,
+		call(expression.OpEq, serviceRef(), str("cart")),
+		call(expression.OpEq, operationRef(), str("GET /cart")),
+		tagEq("http.method", "GET"),
+		tagEq("http.route", "/cart"),
+		call(expression.OpGte, durationRef(), dur(time.Second)),
+		call(expression.OpLte, durationRef(), dur(2*time.Second)),
+	), got.Filter)
+	assert.Empty(t, got.ServiceName)
+	assert.Empty(t, got.OperationName)
+	assert.Zero(t, got.DurationMin)
+	assert.Zero(t, got.DurationMax)
+	assert.Equal(t, 0, got.Attributes.Len())
+	assert.Equal(t, 2, query.Attributes.Len(), "the caller's map is not changed")
+	assert.Equal(t, start, got.StartTimeMin)
+	assert.Equal(t, start.Add(time.Hour), got.StartTimeMax)
+	assert.Equal(t, 20, got.SearchDepth)
+
+	require.NoError(t, expression.ValidateFilter(got.Filter))
+	resolved, err := expression.ResolveConstants(got.Filter)
+	require.NoError(t, err)
+	assert.Equal(t, got.Filter, resolved, "the filter needs no further resolution")
+}
