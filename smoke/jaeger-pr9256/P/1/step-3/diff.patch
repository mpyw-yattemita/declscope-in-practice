+func TestToLegacyShape_Refuses(t *testing.T) {
+	linkAttr := &expression.AttributeRef{Key: "peer.service", Level: expression.LevelLink}
+	scopeAttr := &expression.AttributeRef{Key: "otel.library", Level: expression.LevelScope}
+	kind := &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}
+	events := &expression.NestedRef{Level: expression.LevelEvent}
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string
+	}{
+		{
+			name:     "a disjunction",
+			filter:   call(expression.OpOr, tagEq("a", "1"), tagEq("b", "2")),
+			expected: `does not support the operator "or"`,
+		},
+		{
+			name:     "a disjunction nested in a conjunction",
+			filter:   call(expression.OpAnd, tagEq("a", "1"), call(expression.OpOr, tagEq("b", "2"), tagEq("c", "3"))),
+			expected: `does not support the operator "or"`,
+		},
+		{
+			name:     "a negation",
+			filter:   call(expression.OpNot, tagEq("a", "1")),
+			expected: `does not support the operator "not"`,
+		},
+		{
+			name:     "an existence test",
+			filter:   call(expression.OpExists, attr("a")),
+			expected: `does not support the operator "exists"`,
+		},
+		{
+			name:     "a predicate with one argument",
+			filter:   call(expression.OpEq, attr("a")),
+			expected: `does not support the operator "eq"`,
+		},
+		{
+			name:     "a predicate with three arguments",
+			filter:   call(expression.OpEq, attr("a"), str("1"), str("2")),
+			expected: `does not support the operator "eq"`,
+		},
+		{
+			name:     "a bare reference as a conjunct",
+			filter:   call(expression.OpAnd, tagEq("a", "1"), attr("b")),
+			expected: "conjunction of predicates only",
+		},
+		{
+			name:     "a nil conjunct",
+			filter:   call(expression.OpAnd, tagEq("a", "1"), (*expression.Call)(nil)),
+			expected: "conjunction of predicates only",
+		},
+		{
+			name:     "ne on an attribute",
+			filter:   call(expression.OpNe, attr("http.method"), str("GET")),
+			expected: `does not support the operator "ne" on "http.method"`,
+		},
+		{
+			name:     "in on an attribute",
+			filter:   call(expression.OpIn, attr("http.status_code"), &expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			expected: `does not support the operator "in" on "http.status_code"`,
+		},
+		{
+			name:     "gt on the duration",
+			filter:   call(expression.OpGt, durationRef(), dur(time.Second)),
+			expected: `does not support the operator "gt" on "duration"`,
+		},
+		{
+			name:     "regex on the operation name",
+			filter:   call(expression.OpRegex, operationRef(), str("GET .*")),
+			expected: `does not support the operator "regex" on "name"`,
+		},
+		{
+			name:     "ne on the service",
+			filter:   call(expression.OpNe, serviceRef(), str("cart")),
+			expected: `does not support the operator "ne" on "service"`,
+		},
+		{
+			name:     "an attribute at the link level",
+			filter:   call(expression.OpEq, linkAttr, str("cart")),
+			expected: `does not index the "link" level`,
+		},
+		{
+			name:     "an attribute at the scope level",
+			filter:   call(expression.OpEq, scopeAttr, str("otelhttp")),
+			expected: `does not index the "scope" level`,
+		},
+		{
+			name:     "another built-in field",
+			filter:   call(expression.OpEq, kind, str("server")),
+			expected: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name: "a built-in field of the right name at another level",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception")),
+			expected: `does not support the built-in field "name" of the "event" level`,
+		},
+		{
+			name:     "an attribute against a list",
+			filter:   call(expression.OpEq, attr("a"), &expression.List{Values: []string{"1"}}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name:     "an attribute against an integer",
+			filter:   call(expression.OpEq, attr("a"), &expression.IntValue{Value: 1}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name:     "an attribute against another reference",
+			filter:   call(expression.OpEq, attr("a"), attr("b")),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name:     "the service against a boolean",
+			filter:   call(expression.OpEq, serviceRef(), &expression.BoolValue{Value: true}),
+			expected: `compares "service" against a string constant only`,
+		},
+		{
+			name:     "the operation name against a reference",
+			filter:   call(expression.OpEq, operationRef(), attr("a")),
+			expected: `compares "name" against a string constant only`,
+		},
+		{
+			name:     "a duration against a string",
+			filter:   call(expression.OpGte, durationRef(), str("2s")),
+			expected: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:     "a duration against an integer",
+			filter:   call(expression.OpLte, durationRef(), &expression.IntValue{Value: 2}),
+			expected: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:     "a nil duration constant",
+			filter:   call(expression.OpGte, durationRef(), (*expression.DurationValue)(nil)),
+			expected: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:     "a nil untyped duration constant",
+			filter:   call(expression.OpGte, durationRef(), (*expression.AnyValue)(nil)),
+			expected: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:     "a nil string constant",
+			filter:   call(expression.OpEq, attr("a"), (*expression.StringValue)(nil)),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name:     "a nil attribute reference",
+			filter:   call(expression.OpEq, (*expression.AttributeRef)(nil), str("1")),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "a nil field reference",
+			filter:   call(expression.OpEq, (*expression.FieldRef)(nil), str("1")),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "a quantifier over the events",
+			filter:   call(expression.OpSome, events, call(expression.OpEq, attr("a"), str("1"))),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "a constant on the left",
+			filter:   call(expression.OpEq, str("1"), attr("a")),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "two predicates on one attribute",
+			filter:   call(expression.OpAnd, tagEq("a", "1"), tagEq("a", "2")),
+			expected: `only one predicate on "a"`,
+		},
+		{
+			name: "two predicates on one attribute at different levels",
+			filter: call(expression.OpAnd, tagEq("a", "1"),
+				call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelSpan}, str("1"))),
+			expected: `only one predicate on "a"`,
+		},
+		{
+			name: "two predicates on the service",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, serviceRef(), str("a")), call(expression.OpEq, serviceRef(), str("b"))),
+			expected: `only one predicate on "service"`,
+		},
+		{
+			name: "two predicates on the empty service",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, serviceRef(), str("")), call(expression.OpEq, serviceRef(), str(""))),
+			expected: `only one predicate on "service"`,
+		},
+		{
+			name: "two predicates on the operation name",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, operationRef(), str("a")), call(expression.OpEq, operationRef(), str("b"))),
+			expected: `only one predicate on "name"`,
+		},
+		{
+			name: "two lower bounds",
+			filter: call(expression.OpAnd,
+				call(expression.OpGte, durationRef(), dur(time.Second)), call(expression.OpGte, durationRef(), dur(time.Minute))),
+			expected: `only one predicate on "duration"`,
+		},
+		{
+			name: "two upper bounds",
+			filter: call(expression.OpAnd,
+				call(expression.OpLte, durationRef(), dur(time.Second)), call(expression.OpLte, durationRef(), dur(time.Minute))),
+			expected: `only one predicate on "duration"`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			query := withFilter(test.filter)
+			got, err := query.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.NotErrorIs(t, err, ErrFilterInvalid)
+			assert.Contains(t, err.Error(), test.expected)
+			assert.Equal(t, query, got, "on error the original query is returned")
+		})
+	}
+}
