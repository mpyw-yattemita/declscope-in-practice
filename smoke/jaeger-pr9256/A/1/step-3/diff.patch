+func TestToLegacyShape_Refusals(t *testing.T) {
+	eqA := call(expression.OpEq, attr("a"), untyped("1"))
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string
+	}{
+		{"or", call(expression.OpOr, eqA, eqA), `does not support the operator "or"`},
+		{"not", call(expression.OpNot, eqA), `does not support the operator "not"`},
+		{"exists", call(expression.OpExists, attr("a")), `does not support the operator "exists"`},
+		{"or nested in a conjunction", call(expression.OpAnd, eqA, call(expression.OpOr, eqA, eqA)),
+			`does not support the operator "or"`},
+		{"wrong arity", call(expression.OpEq, attr("a")), `does not support the operator "eq"`},
+		{"bare reference", call(expression.OpAnd, eqA, attr("b")), "conjunction of predicates only"},
+		{"ne on an attribute", call(expression.OpNe, attr("http.method"), untyped("GET")),
+			`does not support the operator "ne" on "http.method"`},
+		{"in on an attribute", call(expression.OpIn, attr("http.status_code"),
+			&expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			`does not support the operator "in" on "http.status_code"`},
+		{"gt on duration", call(expression.OpGt, durationField, dur(time.Second)),
+			`does not support the operator "gt" on "duration"`},
+		{"regex on name", call(expression.OpRegex, operationField, str("GET.*")),
+			`does not support the operator "regex" on "name"`},
+		{"ne on service", call(expression.OpNe, serviceField, str("cart")),
+			`does not support the operator "ne" on "service"`},
+		{"link attribute", call(expression.OpEq, attrAt(expression.LevelLink, "a"), untyped("1")),
+			`does not index the "link" level`},
+		{"scope attribute", call(expression.OpEq, attrAt(expression.LevelScope, "a"), untyped("1")),
+			`does not index the "scope" level`},
+		{"other built-in field", call(expression.OpEq, field(expression.LevelSpan, expression.SpanFieldKind), str("server")),
+			`does not support the built-in field "kind" of the "span" level`},
+		{"attribute against a list", call(expression.OpEq, attr("a"), &expression.List{Values: []string{"1"}}),
+			`compares "a" against a string constant only`},
+		{"attribute against an integer", call(expression.OpEq, attr("a"), &expression.IntValue{Value: 1}),
+			`compares "a" against a string constant only`},
+		{"service against a boolean", call(expression.OpEq, serviceField, &expression.BoolValue{Value: true}),
+			`compares "service" against a string constant only`},
+		{"operation against a reference", call(expression.OpEq, operationField, attr("b")),
+			`compares "name" against a string constant only`},
+		{"duration against a missing duration", call(expression.OpGte, durationField, (*expression.DurationValue)(nil)),
+			`compares "duration" against a duration such as "2s" only`},
+		{"duration against a missing constant", call(expression.OpLte, durationField, (*expression.AnyValue)(nil)),
+			`compares "duration" against a duration such as "2s" only`},
+		{"duration against a string", call(expression.OpGte, durationField, str("2s")),
+			`compares "duration" against a duration such as "2s" only`},
+		{"quantifier", call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent}, eqA),
+			"compares a reference against a constant only"},
+		{"constant on the left", call(expression.OpEq, untyped("1"), attr("a")),
+			"compares a reference against a constant only"},
+		{"same attribute twice", call(expression.OpAnd, eqA, call(expression.OpEq, attrAt(expression.LevelSpan, "a"), untyped("2"))),
+			`only one predicate on "a"`},
+		{"service twice", call(expression.OpAnd,
+			call(expression.OpEq, serviceField, str("a")), call(expression.OpEq, serviceField, str("b"))),
+			`only one predicate on "service"`},
+		{"operation twice", call(expression.OpAnd,
+			call(expression.OpEq, operationField, str("a")), call(expression.OpEq, operationField, str("b"))),
+			`only one predicate on "name"`},
+		{"lower bound twice", call(expression.OpAnd,
+			call(expression.OpGte, durationField, dur(time.Second)), call(expression.OpGte, durationField, dur(time.Minute))),
+			`only one predicate on "duration"`},
+		{"upper bound twice", call(expression.OpAnd,
+			call(expression.OpLte, durationField, dur(time.Second)), call(expression.OpLte, durationField, dur(time.Minute))),
+			`only one predicate on "duration"`},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			q := filterQuery(test.filter)
+			got, err := q.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.Contains(t, err.Error(), test.expected)
+			assert.Equal(t, q, got, "the original query is returned")
+		})
+	}
+}
