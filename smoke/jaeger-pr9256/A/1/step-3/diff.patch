+func TestToLegacyShape(t *testing.T) {
+	t.Run("no filter", func(t *testing.T) {
+		q := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+	t.Run("converts and flattens", func(t *testing.T) {
+		q := filterQuery(call(expression.OpAnd,
+			call(expression.OpEq, serviceField, untyped("cart")),
+			call(expression.OpAnd,
+				call(expression.OpEq, operationField, str("GET")),
+				call(expression.OpEq, attrAt(expression.LevelSpan, "a"), str("1"))),
+			call(expression.OpEq, attrAt(expression.LevelResource, "b"), untyped("2")),
+			call(expression.OpEq, attrAt(expression.LevelEvent, "c"), untyped("3")),
+			call(expression.OpEq, attr("d"), untyped("4")),
+			call(expression.OpGte, durationField, dur(time.Second)),
+			call(expression.OpLte, durationField, dur(time.Minute))))
+		original := q.Attributes
+
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Nil(t, got.Filter)
+		assert.Equal(t, "cart", got.ServiceName)
+		assert.Equal(t, "GET", got.OperationName)
+		assert.Equal(t, time.Second, got.DurationMin)
+		assert.Equal(t, time.Minute, got.DurationMax)
+		assert.Equal(t, map[string]any{"a": "1", "b": "2", "c": "3", "d": "4"}, got.Attributes.AsRaw())
+		assert.Equal(t, 0, original.Len(), "the caller's map is not changed")
+	})
+	t.Run("keeps attributes already on the query", func(t *testing.T) {
+		q := filterQuery(call(expression.OpEq, attr("a"), untyped("1")))
+		q.Attributes.PutStr("b", "2")
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, map[string]any{"a": "1", "b": "2"}, got.Attributes.AsRaw())
+		assert.Equal(t, map[string]any{"b": "2"}, q.Attributes.AsRaw(), "the caller's map is not changed")
+	})
+	t.Run("single predicate with zero attributes", func(t *testing.T) {
+		got, err := TraceQueryParams{Filter: call(expression.OpEq, attr("a"), untyped("1"))}.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, map[string]any{"a": "1"}, got.Attributes.AsRaw())
+	})
+}
