+func TestToLegacyShape_RefusesACycle(t *testing.T) {
+	cycle := call(expression.OpAnd)
+	cycle.Args = []expression.Expression{cycle}
+	_, err := filterQuery(cycle).ToLegacyShape()
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+}
