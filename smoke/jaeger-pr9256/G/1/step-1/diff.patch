diff --git a/internal/storage/v2/api/tracestore/reader.go b/internal/storage/v2/api/tracestore/reader.go
index 125c1de..ed07779 100644
--- a/internal/storage/v2/api/tracestore/reader.go
+++ b/internal/storage/v2/api/tracestore/reader.go
@@ -75,6 +75,31 @@ type Reader interface {
 	// summaries, and implementations may yield incrementally rather than buffering all
 	// results first.
 	FindTraceSummaries(ctx context.Context, query TraceQueryParams) iter.Seq2[[]TraceSummary, error]
+
+	// SearchCapabilities reports how this reader's search methods behave.
+	//
+	// A reader that does not declare a capability returns the zero value. A reader
+	// that cannot say, for example because its backend sits behind an API that
+	// cannot be asked, returns an error that wraps errors.ErrUnsupported; callers
+	// must not trust the returned value in that case.
+	//
+	// A Reader that wraps another Reader (a decorator or interceptor) must forward
+	// this call to the wrapped Reader rather than answer for itself.
+	SearchCapabilities(ctx context.Context) (SearchCapabilities, error)
+}
+
+// SearchCapabilities describes how a Reader's search methods behave where
+// backends differ.
+//
+// Each capability is a field whose false value is the conservative answer, so
+// the zero value of SearchCapabilities describes the least capable reader. A
+// capability added later is therefore false for every existing implementation
+// until it declares otherwise.
+type SearchCapabilities struct {
+	// WithoutServiceName is true when FindTraces, FindTraceIDs and
+	// FindTraceSummaries accept a TraceQueryParams whose ServiceName is empty
+	// and read it as "any service", rather than as an error or an empty result.
+	WithoutServiceName bool
 }
 
 // GetTraceParams contains single-trace parameters for a GetTraces request.
diff --git a/internal/storage/v2/api/tracestore/reader_test.go b/internal/storage/v2/api/tracestore/reader_test.go
index 04fd0ae..e622486 100644
--- a/internal/storage/v2/api/tracestore/reader_test.go
+++ b/internal/storage/v2/api/tracestore/reader_test.go
@@ -2,3 +2,22 @@
 // SPDX-License-Identifier: Apache-2.0
 
 package tracestore
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// TestSearchCapabilities_FieldCount fails when a field is added to
+// SearchCapabilities. The forwarding tests of the decorators enumerate every
+// field, so a new field must be added to them too:
+//   - tracestoremetrics.TestReadMetricsDecorator_SearchCapabilities
+//   - queryinterceptor.TestReader_SearchCapabilities_ForwardsBackendDeclaration
+//
+// Update those tables, then update the count here.
+func TestSearchCapabilities_FieldCount(t *testing.T) {
+	assert.Equal(t, 1, reflect.TypeFor[SearchCapabilities]().NumField(),
+		"SearchCapabilities gained a field: extend the decorators' forwarding tests to cover it")
+}
