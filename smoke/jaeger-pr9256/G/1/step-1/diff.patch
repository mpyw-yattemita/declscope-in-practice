diff --git a/internal/storage/v2/api/tracestore/search_capabilities.go b/internal/storage/v2/api/tracestore/search_capabilities.go
new file mode 100644
index 0000000..73f6ca0
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/search_capabilities.go
@@ -0,0 +1,17 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+// SearchCapabilities describes how a Reader's search methods behave where
+// backends differ.
+//
+// The zero value describes the least capable reader: every field is false.
+// A capability added later is a new field, so a reader that does not set it
+// declares that it lacks it.
+type SearchCapabilities struct {
+	// WithoutServiceName is true when FindTraces, FindTraceIDs and
+	// FindTraceSummaries accept a TraceQueryParams whose ServiceName is empty
+	// and read it as "any service", rather than as an error or an empty result.
+	WithoutServiceName bool
+}
diff --git a/internal/storage/v2/api/tracestore/search_capabilities_test.go b/internal/storage/v2/api/tracestore/search_capabilities_test.go
new file mode 100644
index 0000000..f7112fb
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/search_capabilities_test.go
@@ -0,0 +1,24 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// TestSearchCapabilitiesFieldCount fails when a field is added to
+// SearchCapabilities. The decorators that wrap a Reader (tracestoremetrics
+// and the query interceptor) have forwarding tests that enumerate every
+// field; extend them for the new field, then update the count here.
+func TestSearchCapabilitiesFieldCount(t *testing.T) {
+	assert.Equal(t, 1, reflect.TypeFor[SearchCapabilities]().NumField(),
+		"a field was added to SearchCapabilities: extend the decorators' forwarding tests")
+}
+
+func TestSearchCapabilitiesZeroValue(t *testing.T) {
+	assert.False(t, SearchCapabilities{}.WithoutServiceName)
+}
