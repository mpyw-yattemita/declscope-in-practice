diff --git a/internal/storage/v2/api/tracestore/filter.go b/internal/storage/v2/api/tracestore/filter.go
index 6ab651a..415b1ee 100644
--- a/internal/storage/v2/api/tracestore/filter.go
+++ b/internal/storage/v2/api/tracestore/filter.go
@@ -1,55 +1,111 @@
 // Copyright (c) 2026 The Jaeger Authors.
 // SPDX-License-Identifier: Apache-2.0
 
 package tracestore
 
 import (
 	"errors"
+	"fmt"
 	"slices"
 
 	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
 )
 
 // ErrFilterUnsupported is returned for a well-formed query filter that the
 // storage cannot serve: a level it does not index, an operator it has not
 // implemented, or a boolean structure a flat index cannot evaluate. The query
 // is refused rather than approximated.
 var ErrFilterUnsupported = errors.New("this storage backend cannot serve this query filter")
 
 // ErrFilterInvalid is returned for a query filter whose value does not fit the
 // field it compares.
 var ErrFilterInvalid = errors.New("invalid query filter")
 
 // FilterCapabilities declares how much of a structured filter a Reader
 // evaluates, by naming the levels and operators it serves.
 //
 // Nothing is implicit: a Reader opts in only by naming something, so an empty
 // FilterCapabilities declares the same as none at all.
 type FilterCapabilities struct {
 	// Levels are the levels a reference may name. Empty means the Reader can
 	// serve only unqualified references.
 	Levels []expression.Level
 	// Operators are the operators the Reader evaluates, including the boolean
 	// combinators OpAnd, OpOr and OpNot.
 	Operators []expression.Operator
 }
 
 // IsEmpty reports whether c declares nothing: it is nil, or names no level
 // and no operator. Callers ask IsEmpty rather than comparing against nil.
 func (c *FilterCapabilities) IsEmpty() bool {
 	return c == nil || (len(c.Levels) == 0 && len(c.Operators) == 0)
 }
 
 // SupportsLevel reports whether a reference may name level. The empty level,
 // an unqualified reference, is always supported.
 func (c FilterCapabilities) SupportsLevel(level expression.Level) bool {
 	return level == "" || slices.Contains(c.Levels, level)
 }
 
 // SupportsOperator reports whether op is listed in Operators. The boolean
 // combinators are declared like any other operator, so the zero value
 // supports none, not even OpAnd. Nesting is not declared: and is
 // associative, so a caller flattens it before asking.
 func (c FilterCapabilities) SupportsOperator(op expression.Operator) bool {
 	return slices.Contains(c.Operators, op)
 }
+
+// EnsureSupported walks the filter and refuses the first predicate the Reader
+// did not declare it can evaluate: an operator it does not list, or a
+// reference to a level it does not index. Constants need no support. A nil
+// filter is supported.
+func (c FilterCapabilities) EnsureSupported(filter *expression.Call) error {
+	if filter == nil {
+		return nil
+	}
+	return c.ensureCallSupported(filter, 1)
+}
+
+// ensureCallSupported checks one call and, through its arguments, every call
+// below it. depth counts the calls down to this one, so that a filter that
+// contains itself is refused rather than walked until the stack runs out.
+func (c FilterCapabilities) ensureCallSupported(call *expression.Call, depth int) error {
+	if depth > expression.MaxNestingDepth {
+		return fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if !c.SupportsOperator(call.Op) {
+		return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, call.Op)
+	}
+	for _, arg := range call.Args {
+		if nested, ok := arg.(*expression.Call); ok && nested != nil {
+			if err := c.ensureCallSupported(nested, depth+1); err != nil {
+				return err
+			}
+			continue
+		}
+		if level, ok := referenceLevel(arg); ok && !c.SupportsLevel(level) {
+			return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, level)
+		}
+	}
+	return nil
+}
+
+// referenceLevel returns the level a reference names. Its second result is
+// false for anything that is not a reference, such as a constant.
+func referenceLevel(e expression.Expression) (expression.Level, bool) {
+	switch ref := e.(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.NestedRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	}
+	return "", false
+}
diff --git a/internal/storage/v2/api/tracestore/filter_test.go b/internal/storage/v2/api/tracestore/filter_test.go
index f2b06d9..6c0eb5f 100644
--- a/internal/storage/v2/api/tracestore/filter_test.go
+++ b/internal/storage/v2/api/tracestore/filter_test.go
@@ -1,78 +1,169 @@
 // Copyright (c) 2026 The Jaeger Authors.
 // SPDX-License-Identifier: Apache-2.0
 
 package tracestore
 
 import (
 	"testing"
 
 	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
 	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
 )
 
 func TestFilterCapabilitiesIsEmpty(t *testing.T) {
 	tests := []struct {
 		name  string
 		caps  *FilterCapabilities
 		empty bool
 	}{
 		{name: "nil", caps: nil, empty: true},
 		{name: "zero value", caps: &FilterCapabilities{}, empty: true},
 		{
 			name: "empty non-nil slices",
 			caps: &FilterCapabilities{
 				Levels:    []expression.Level{},
 				Operators: []expression.Operator{},
 			},
 			empty: true,
 		},
 		{
 			name:  "one level",
 			caps:  &FilterCapabilities{Levels: []expression.Level{expression.LevelSpan}},
 			empty: false,
 		},
 		{
 			name:  "one operator",
 			caps:  &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}},
 			empty: false,
 		},
 	}
 	for _, tt := range tests {
 		t.Run(tt.name, func(t *testing.T) {
 			assert.Equal(t, tt.empty, tt.caps.IsEmpty())
 		})
 	}
 }
 
 func TestFilterCapabilitiesSupportsLevel(t *testing.T) {
 	var zero FilterCapabilities
 	assert.True(t, zero.SupportsLevel(""), "an unqualified reference is always supported")
 	assert.False(t, zero.SupportsLevel(expression.LevelSpan))
 
 	caps := FilterCapabilities{
 		Levels: []expression.Level{expression.LevelSpan, expression.LevelResource},
 	}
 	assert.True(t, caps.SupportsLevel(""))
 	assert.True(t, caps.SupportsLevel(expression.LevelSpan))
 	assert.True(t, caps.SupportsLevel(expression.LevelResource))
 	assert.False(t, caps.SupportsLevel(expression.LevelScope))
 	assert.False(t, caps.SupportsLevel(expression.LevelEvent))
 	assert.False(t, caps.SupportsLevel(expression.LevelLink))
 }
 
 func TestFilterCapabilitiesSupportsOperator(t *testing.T) {
 	var zero FilterCapabilities
 	for _, op := range []expression.Operator{expression.OpAnd, expression.OpOr, expression.OpNot, expression.OpEq} {
 		assert.False(t, zero.SupportsOperator(op), "zero value must not support %q", op)
 	}
 
 	// A reader confined to conjunctive search.
 	conjunctive := FilterCapabilities{
 		Operators: []expression.Operator{expression.OpAnd, expression.OpEq},
 	}
 	assert.True(t, conjunctive.SupportsOperator(expression.OpAnd))
 	assert.True(t, conjunctive.SupportsOperator(expression.OpEq))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpOr))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpNot))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpRegex))
 }
+
+func TestFilterCapabilitiesEnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpSome},
+	}
+	spanAttr := &expression.AttributeRef{Key: "http.method", Level: expression.LevelSpan}
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{name: "nil filter"},
+		{
+			name:   "supported operator and level",
+			filter: eqCall(spanAttr, &expression.StringValue{Value: "GET"}),
+		},
+		{
+			name:   "unqualified attribute",
+			filter: eqCall(&expression.AttributeRef{Key: "k"}, &expression.AnyValue{Value: "v"}),
+		},
+		{
+			name:    "unsupported operator",
+			filter:  &expression.Call{Op: expression.OpNe, Args: []expression.Expression{spanAttr, &expression.StringValue{Value: "GET"}}},
+			wantErr: `it does not support the operator "ne"`,
+		},
+		{
+			name: "unsupported nested operator",
+			filter: andCall(
+				eqCall(spanAttr, &expression.StringValue{Value: "GET"}),
+				&expression.Call{Op: expression.OpOr, Args: []expression.Expression{
+					eqCall(spanAttr, &expression.StringValue{Value: "PUT"}),
+					eqCall(spanAttr, &expression.StringValue{Value: "GET"}),
+				}},
+			),
+			wantErr: `it does not support the operator "or"`,
+		},
+		{
+			name:    "unsupported attribute level",
+			filter:  eqCall(&expression.AttributeRef{Key: "k", Level: expression.LevelResource}, &expression.StringValue{Value: "v"}),
+			wantErr: `it does not index the "resource" level`,
+		},
+		{
+			name:    "unsupported field level",
+			filter:  eqCall(&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}, &expression.StringValue{Value: "v"}),
+			wantErr: `it does not index the "resource" level`,
+		},
+		{
+			name: "unsupported nested reference level",
+			filter: &expression.Call{Op: expression.OpSome, Args: []expression.Expression{
+				&expression.NestedRef{Level: expression.LevelEvent},
+				eqCall(spanAttr, &expression.StringValue{Value: "v"}),
+			}},
+			wantErr: `it does not index the "event" level`,
+		},
+		{
+			name:    "nested call on the right of a comparison",
+			filter:  eqCall(spanAttr, &expression.Call{Op: expression.OpRegex}),
+			wantErr: `it does not support the operator "regex"`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := caps.EnsureSupported(tt.filter)
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, tt.wantErr)
+		})
+	}
+}
+
+func TestFilterCapabilitiesEnsureSupportedRefusesCycle(t *testing.T) {
+	caps := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd}}
+	cycle := &expression.Call{Op: expression.OpAnd}
+	cycle.Args = []expression.Expression{cycle, cycle}
+	err := caps.EnsureSupported(cycle)
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+}
+
+func eqCall(left, right expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpEq, Args: []expression.Expression{left, right}}
+}
+
+func andCall(args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpAnd, Args: args}
+}
diff --git a/internal/storage/v2/api/tracestore/query_shape.go b/internal/storage/v2/api/tracestore/query_shape.go
new file mode 100644
index 0000000..b68fa5f
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_shape.go
@@ -0,0 +1,384 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// A query expresses its predicates in one of two models: the scalar fields
+// ServiceName, OperationName, Attributes and the duration bounds, which every
+// backend serves, or Filter, which a Reader serves only as far as its
+// SearchCapabilities.Filter declares. The methods below decide which model a
+// Reader receives and convert between the two, so that every caller gets the
+// same answer instead of each backend's own.
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. Mixing the two would leave each
+// backend to decide how they combine, so the query is refused instead. An
+// empty Attributes map is not a predicate.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if attributesLen(q.Attributes) > 0 {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: a query with a filter cannot also set %v", ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A Reader that declares no filter support receives
+// the filter expressed in the legacy fields, or a refusal if those cannot
+// express it. Any other Reader receives the filter as it is, or a refusal for
+// the first part of it the Reader did not declare.
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates.
+// It cannot fail, because each legacy field has an exact filter equivalent.
+// A query that already has a Filter is returned as it is.
+//
+// The converted fields are cleared, and the predicates are conjoined in the
+// order service, operation, attributes, minimum and maximum duration. A query
+// with no predicate gets a nil Filter, and one with a single predicate gets
+// that predicate without a conjunction around it.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, eq(serviceField(), &expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, eq(operationField(), &expression.StringValue{Value: q.OperationName}))
+	}
+	if attributesLen(q.Attributes) > 0 {
+		q.Attributes.Range(func(key string, value pcommon.Value) bool {
+			predicates = append(predicates, eq(&expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value.AsString()}))
+			return true
+		})
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, durationBound(expression.OpGte, q.DurationMin))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, durationBound(expression.OpLte, q.DurationMax))
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	q.Filter = conjoin(predicates)
+	return q
+}
+
+// conjoin joins predicates with OpAnd, using a conjunction only when there is
+// something to conjoin.
+func conjoin(predicates []*expression.Call) *expression.Call {
+	switch len(predicates) {
+	case 0:
+		return nil
+	case 1:
+		return predicates[0]
+	}
+	args := make([]expression.Expression, len(predicates))
+	for i, p := range predicates {
+		args[i] = p
+	}
+	return &expression.Call{Op: expression.OpAnd, Args: args}
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves. Only what those fields can say converts: a flat conjunction
+// of equality on attributes, the service or the operation name, and inclusive
+// bounds on the span duration. Anything else is refused with
+// ErrFilterUnsupported rather than approximated.
+//
+// The result has a nil Filter and a new Attributes map, so the caller's own
+// map is not changed. On error the original query is returned. A query that
+// also sets the legacy fields is refused as EnsureFilterStandsAlone refuses
+// it, since a predicate from the filter would otherwise overwrite one of them.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	conjuncts, err := flattenConjunction(q.Filter, nil, 1)
+	if err != nil {
+		return q, err
+	}
+	legacy := legacyFields{attributes: pcommon.NewMap(), written: map[string]bool{}}
+	for _, conjunct := range conjuncts {
+		if err := legacy.add(conjunct); err != nil {
+			return q, err
+		}
+	}
+	out := q
+	out.Filter = nil
+	out.ServiceName = legacy.serviceName
+	out.OperationName = legacy.operationName
+	out.Attributes = legacy.attributes
+	out.DurationMin = legacy.durationMin
+	out.DurationMax = legacy.durationMax
+	return out, nil
+}
+
+// flattenConjunction appends the predicates of a conjunction to into, opening
+// nested conjunctions, since and is associative. A filter that is not a
+// conjunction is a conjunction of one predicate.
+func flattenConjunction(call *expression.Call, into []*expression.Call, depth int) ([]*expression.Call, error) {
+	if depth > expression.MaxNestingDepth {
+		return nil, fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if call.Op != expression.OpAnd {
+		return append(into, call), nil
+	}
+	if len(call.Args) == 0 {
+		// Dropping an empty conjunction would answer with every trace in the time
+		// range, which is not what anyone who sent one meant.
+		return nil, fmt.Errorf("%w: operator %q takes at least two arguments", ErrFilterInvalid, expression.OpAnd)
+	}
+	for _, arg := range call.Args {
+		nested, ok := arg.(*expression.Call)
+		if !ok || nested == nil {
+			return nil, fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+		}
+		var err error
+		if into, err = flattenConjunction(nested, into, depth+1); err != nil {
+			return nil, err
+		}
+	}
+	return into, nil
+}
+
+// legacyFields collects the scalar predicate fields as a filter's conjuncts
+// are converted. written names every field set so far, so that a second
+// predicate on one is refused instead of overwriting the first.
+type legacyFields struct {
+	serviceName   string
+	operationName string
+	attributes    pcommon.Map
+	durationMin   time.Duration
+	durationMax   time.Duration
+	written       map[string]bool
+}
+
+// Keys of legacyFields.written for the fields that are not attributes. They
+// cannot collide with an attribute key, which is written as "attribute:<key>".
+const (
+	writtenService     = "field:service"
+	writtenOperation   = "field:operation"
+	writtenDurationMin = "field:duration_min"
+	writtenDurationMax = "field:duration_max"
+)
+
+// add converts one conjunct into the field it sets.
+func (l *legacyFields) add(call *expression.Call) error {
+	switch call.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return errUnsupportedOperator(call.Op)
+	}
+	if len(call.Args) != 2 {
+		return errUnsupportedOperator(call.Op)
+	}
+	switch ref := call.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return l.addAttribute(call.Op, ref, call.Args[1])
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return l.addField(call.Op, ref, call.Args[1])
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+// addAttribute converts equality on an attribute into a tag. A tag is matched
+// at the span, resource and event levels alike, so a predicate naming one of
+// those levels widens to it.
+func (l *legacyFields) addAttribute(op expression.Operator, ref *expression.AttributeRef, operand expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+	default:
+		return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, ref.Level)
+	}
+	if op != expression.OpEq {
+		return errUnsupportedOperatorOn(op, ref.Key)
+	}
+	value, err := stringOperand(ref.Key, operand)
+	if err != nil {
+		return err
+	}
+	if err := l.write("attribute:"+ref.Key, ref.Key); err != nil {
+		return err
+	}
+	l.attributes.PutStr(ref.Key, value)
+	return nil
+}
+
+// addField converts a predicate on one of the three built-in fields the legacy
+// shape has a field for.
+func (l *legacyFields) addField(op expression.Operator, ref *expression.FieldRef, operand expression.Expression) error {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		return l.addString(op, ref.Name, operand, writtenService, &l.serviceName)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		return l.addString(op, ref.Name, operand, writtenOperation, &l.operationName)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		return l.addDuration(op, ref.Name, operand)
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+// addString converts equality on a string field into the field that holds it.
+func (l *legacyFields) addString(
+	op expression.Operator, name string, operand expression.Expression, key string, field *string,
+) error {
+	if op != expression.OpEq {
+		return errUnsupportedOperatorOn(op, name)
+	}
+	value, err := stringOperand(name, operand)
+	if err != nil {
+		return err
+	}
+	if err := l.write(key, name); err != nil {
+		return err
+	}
+	*field = value
+	return nil
+}
+
+// addDuration converts an inclusive bound on the span duration into
+// DurationMin or DurationMax.
+func (l *legacyFields) addDuration(op expression.Operator, name string, operand expression.Expression) error {
+	var key string
+	var field *time.Duration
+	switch op {
+	case expression.OpGte:
+		key, field = writtenDurationMin, &l.durationMin
+	case expression.OpLte:
+		key, field = writtenDurationMax, &l.durationMax
+	default:
+		return errUnsupportedOperatorOn(op, name)
+	}
+	switch value := operand.(type) {
+	case *expression.DurationValue:
+		if value == nil {
+			break
+		}
+		if err := l.write(key, name); err != nil {
+			return err
+		}
+		*field = value.Value
+		return nil
+	case *expression.AnyValue:
+		if value == nil {
+			break
+		}
+		// Finalizing a filter reads such a constant as a duration, so one that
+		// is still untyped reached here without being finalized.
+		return fmt.Errorf("%w: the bound %q on %q was never read as a duration", ErrFilterInvalid, value.Value, name)
+	}
+	return fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only", ErrFilterUnsupported, name)
+}
+
+// write records that a field is set, and refuses a second predicate on it.
+func (l *legacyFields) write(key, name string) error {
+	if l.written[key] {
+		return fmt.Errorf("%w: it takes only one predicate on %q", ErrFilterUnsupported, name)
+	}
+	l.written[key] = true
+	return nil
+}
+
+// stringOperand returns the text of a string or untyped constant, which is all
+// a legacy field can hold.
+func stringOperand(name string, operand expression.Expression) (string, error) {
+	switch value := operand.(type) {
+	case *expression.StringValue:
+		if value != nil {
+			return value.Value, nil
+		}
+	case *expression.AnyValue:
+		if value != nil {
+			return value.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+func errUnsupportedOperator(op expression.Operator) error {
+	return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, op)
+}
+
+func errUnsupportedOperatorOn(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func serviceField() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func operationField() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
+
+func durationBound(op expression.Operator, bound time.Duration) *expression.Call {
+	return &expression.Call{
+		Op: op,
+		Args: []expression.Expression{
+			&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration},
+			&expression.DurationValue{Value: bound},
+		},
+	}
+}
+
+func eq(left, right expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpEq, Args: []expression.Expression{left, right}}
+}
+
+// attributesLen is m.Len, except that a map left at its zero value, which
+// pcommon.Map.Len would dereference, has no entries.
+func attributesLen(m pcommon.Map) int {
+	if m == (pcommon.Map{}) {
+		return 0
+	}
+	return m.Len()
+}
