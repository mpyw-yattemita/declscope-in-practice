+var (
+	refService   = &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+	refOperation = &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+	refDuration  = &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+)
+
+func attr(key string) *expression.AttributeRef { return &expression.AttributeRef{Key: key} }
+
+func str(v string) *expression.StringValue { return &expression.StringValue{Value: v} }
+
+func anyVal(v string) *expression.AnyValue { return &expression.AnyValue{Value: v} }
+
+func dur(d time.Duration) *expression.DurationValue { return &expression.DurationValue{Value: d} }
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func attrs(kv ...string) pcommon.Map {
+	m := pcommon.NewMap()
+	for i := 0; i < len(kv); i += 2 {
+		m.PutStr(kv[i], kv[i+1])
+	}
+	return m
+}
+
+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := eqCall(attr("k"), anyVal("v"))
+	tests := []struct {
+		name    string
+		query   TraceQueryParams
+		wantErr string
+	}{
+		{name: "no filter", query: TraceQueryParams{ServiceName: "svc", Attributes: attrs("k", "v")}},
+		{name: "filter alone", query: TraceQueryParams{Filter: filter, Attributes: pcommon.NewMap(), SearchDepth: 10}},
+		{name: "filter with zero attributes", query: TraceQueryParams{Filter: filter}},
+		{
+			name:    "filter beside service name",
+			query:   TraceQueryParams{Filter: filter, ServiceName: "svc"},
+			wantErr: "[service_name]",
+		},
+		{
+			name: "filter beside every field",
+			query: TraceQueryParams{
+				Filter:        filter,
+				ServiceName:   "svc",
+				OperationName: "op",
+				Attributes:    attrs("k", "v"),
+				DurationMin:   time.Second,
+				DurationMax:   2 * time.Second,
+			},
+			wantErr: "[service_name operation_name duration_min duration_max attributes]",
+		},
+		{
+			name:    "filter beside attributes",
+			query:   TraceQueryParams{Filter: filter, Attributes: attrs("k", "v")},
+			wantErr: "[attributes]",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.query.EnsureFilterStandsAlone()
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.ErrorContains(t, err, tt.wantErr)
+		})
+	}
+}
+
+func TestForCapabilities(t *testing.T) {
+	native := SearchCapabilities{Filter: &FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelResource},
+		Operators: []expression.Operator{expression.OpEq},
+	}}
+
+	t.Run("no filter is unchanged", func(t *testing.T) {
+		q := TraceQueryParams{ServiceName: "svc", Attributes: attrs("k", "v")}
+		got, err := q.ForCapabilities(native)
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("reader without filter support gets the legacy shape", func(t *testing.T) {
+		q := TraceQueryParams{Filter: eqCall(refService, str("svc")), SearchDepth: 5}
+		for _, caps := range []SearchCapabilities{{}, {Filter: &FilterCapabilities{}}} {
+			got, err := q.ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Nil(t, got.Filter)
+			assert.Equal(t, "svc", got.ServiceName)
+			assert.Equal(t, 5, got.SearchDepth)
+		}
+	})
+
+	t.Run("reader without filter support refuses what the legacy shape cannot say", func(t *testing.T) {
+		q := TraceQueryParams{Filter: call(expression.OpNe, refService, str("svc"))}
+		got, err := q.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("reader with filter support gets the filter", func(t *testing.T) {
+		q := TraceQueryParams{Filter: eqCall(refService, str("svc"))}
+		got, err := q.ForCapabilities(native)
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("reader with filter support refuses what it did not declare", func(t *testing.T) {
+		q := TraceQueryParams{Filter: eqCall(refOperation, str("op"))}
+		got, err := q.ForCapabilities(native)
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		require.ErrorContains(t, err, `it does not index the "span" level`)
+		assert.Equal(t, q, got)
+	})
+}
+
+func TestToFilterShape(t *testing.T) {
+	start := time.Unix(100, 0)
+	end := time.Unix(200, 0)
+
+	t.Run("every field", func(t *testing.T) {
+		q := TraceQueryParams{
+			ServiceName:   "svc",
+			OperationName: "op",
+			Attributes:    attrs("http.method", "GET"),
+			DurationMin:   time.Second,
+			DurationMax:   2 * time.Second,
+			StartTimeMin:  start,
+			StartTimeMax:  end,
+			SearchDepth:   20,
+		}
+		got := q.ToFilterShape()
+		want := TraceQueryParams{
+			Attributes:   pcommon.NewMap(),
+			StartTimeMin: start,
+			StartTimeMax: end,
+			SearchDepth:  20,
+			Filter: andCall(
+				eqCall(refService, str("svc")),
+				eqCall(refOperation, str("op")),
+				eqCall(attr("http.method"), anyVal("GET")),
+				call(expression.OpGte, refDuration, dur(time.Second)),
+				call(expression.OpLte, refDuration, dur(2*time.Second)),
+			),
+		}
+		assert.Equal(t, want, got)
+		assert.Equal(t, 1, q.Attributes.Len(), "the caller's map must not change")
+
+		require.NoError(t, expression.ValidateFilter(got.Filter))
+		resolved, err := expression.ResolveConstants(got.Filter)
+		require.NoError(t, err)
+		assert.Equal(t, got.Filter, resolved)
+	})
+
+	t.Run("attributes keep map order", func(t *testing.T) {
+		q := TraceQueryParams{Attributes: attrs("a", "1", "b", "2")}
+		got := q.ToFilterShape()
+		assert.Equal(t, andCall(eqCall(attr("a"), anyVal("1")), eqCall(attr("b"), anyVal("2"))), got.Filter)
+	})
+
+	t.Run("non-string attribute is written as text", func(t *testing.T) {
+		m := pcommon.NewMap()
+		m.PutInt("http.status_code", 500)
+		got := TraceQueryParams{Attributes: m}.ToFilterShape()
+		assert.Equal(t, eqCall(attr("http.status_code"), anyVal("500")), got.Filter)
+	})
+
+	t.Run("one predicate stands on its own", func(t *testing.T) {
+		got := TraceQueryParams{DurationMax: time.Second, Attributes: pcommon.NewMap()}.ToFilterShape()
+		assert.Equal(t, call(expression.OpLte, refDuration, dur(time.Second)), got.Filter)
+		assert.Zero(t, got.DurationMax)
+	})
+
+	t.Run("no predicates give a nil filter", func(t *testing.T) {
+		got := TraceQueryParams{SearchDepth: 3, Attributes: pcommon.NewMap()}.ToFilterShape()
+		assert.Nil(t, got.Filter)
+		assert.Equal(t, 3, got.SearchDepth)
+	})
+
+	t.Run("zero attributes do not panic", func(t *testing.T) {
+		got := TraceQueryParams{ServiceName: "svc"}.ToFilterShape()
+		assert.Equal(t, eqCall(refService, str("svc")), got.Filter)
+		assert.Equal(t, 0, got.Attributes.Len())
+	})
+
+	t.Run("existing filter is kept", func(t *testing.T) {
+		q := TraceQueryParams{Filter: eqCall(attr("k"), anyVal("v"))}
+		assert.Equal(t, q, q.ToFilterShape())
+	})
+}
+
+func TestToLegacyShapeRoundTrip(t *testing.T) {
+	queries := map[string]TraceQueryParams{
+		"every field": {
+			ServiceName:   "svc",
+			OperationName: "op",
+			Attributes:    attrs("a", "1", "b", "2"),
+			DurationMin:   time.Second,
+			DurationMax:   time.Minute,
+			StartTimeMin:  time.Unix(100, 0),
+			SearchDepth:   7,
+		},
+		"service only": {ServiceName: "svc", Attributes: pcommon.NewMap()},
+		"min only":     {DurationMin: time.Millisecond, Attributes: pcommon.NewMap()},
+	}
+	for name, q := range queries {
+		t.Run(name, func(t *testing.T) {
+			got, err := q.ToFilterShape().ToLegacyShape()
+			require.NoError(t, err)
+			assert.Equal(t, q, got)
+		})
+	}
+}
+
+func TestToLegacyShape(t *testing.T) {
+	t.Run("no filter is unchanged", func(t *testing.T) {
+		q := TraceQueryParams{ServiceName: "svc"}
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("caller's map is not changed", func(t *testing.T) {
+		own := pcommon.NewMap()
+		q := TraceQueryParams{Filter: eqCall(attr("k"), anyVal("v")), Attributes: own}
+		got, err := q.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, 0, own.Len())
+		assert.Equal(t, map[string]any{"k": "v"}, got.Attributes.AsRaw())
+	})
+
+	t.Run("zero attributes do not panic", func(t *testing.T) {
+		got, err := TraceQueryParams{Filter: eqCall(refService, anyVal("svc"))}.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Equal(t, "svc", got.ServiceName)
+		assert.Equal(t, 0, got.Attributes.Len())
+	})
+
+	t.Run("query that also sets legacy fields is refused", func(t *testing.T) {
+		q := TraceQueryParams{Filter: eqCall(refService, str("a")), ServiceName: "b"}
+		got, err := q.ToLegacyShape()
+		require.ErrorIs(t, err, ErrFilterInvalid)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("converts", func(t *testing.T) {
+		filter := andCall(
+			andCall(
+				eqCall(&expression.AttributeRef{Key: "s", Level: expression.LevelSpan}, str("1")),
+				eqCall(&expression.AttributeRef{Key: "r", Level: expression.LevelResource}, anyVal("2")),
+			),
+			eqCall(&expression.AttributeRef{Key: "e", Level: expression.LevelEvent}, str("3")),
+			eqCall(attr("u"), anyVal("4")),
+			eqCall(refService, anyVal("svc")),
+			eqCall(refOperation, str("op")),
+			call(expression.OpGte, refDuration, dur(time.Second)),
+			call(expression.OpLte, refDuration, dur(time.Minute)),
+		)
+		start := time.Unix(1, 0)
+		got, err := TraceQueryParams{Filter: filter, StartTimeMin: start, SearchDepth: 9}.ToLegacyShape()
+		require.NoError(t, err)
+		assert.Nil(t, got.Filter)
+		assert.Equal(t, "svc", got.ServiceName)
+		assert.Equal(t, "op", got.OperationName)
+		assert.Equal(t, time.Second, got.DurationMin)
+		assert.Equal(t, time.Minute, got.DurationMax)
+		assert.Equal(t, start, got.StartTimeMin)
+		assert.Equal(t, 9, got.SearchDepth)
+		assert.Equal(t, map[string]any{"s": "1", "r": "2", "e": "3", "u": "4"}, got.Attributes.AsRaw())
+	})
+
+	linkAttr := &expression.AttributeRef{Key: "k", Level: expression.LevelLink}
+	scopeAttr := &expression.AttributeRef{Key: "k", Level: expression.LevelScope}
+	method := attr("http.method")
+	tests := []struct {
+		name        string
+		filter      *expression.Call
+		wantErr     string
+		wantInvalid bool
+	}{
+		{name: "or", filter: call(expression.OpOr, eqCall(method, str("a")), eqCall(method, str("b"))), wantErr: `does not support the operator "or"`},
+		{name: "not", filter: call(expression.OpNot, eqCall(method, str("a"))), wantErr: `does not support the operator "not"`},
+		{name: "exists", filter: call(expression.OpExists, method), wantErr: `does not support the operator "exists"`},
+		{
+			name:    "or nested in a conjunction",
+			filter:  andCall(eqCall(method, str("a")), call(expression.OpOr, eqCall(method, str("a")), eqCall(method, str("b")))),
+			wantErr: `does not support the operator "or"`,
+		},
+		{name: "wrong arity", filter: call(expression.OpEq, method), wantErr: `does not support the operator "eq"`},
+		{name: "bare reference in a conjunction", filter: andCall(eqCall(method, str("a")), method), wantErr: "conjunction of predicates only"},
+		{name: "ne on attribute", filter: call(expression.OpNe, method, str("GET")), wantErr: `does not support the operator "ne" on "http.method"`},
+		{name: "gt on duration", filter: call(expression.OpGt, refDuration, dur(time.Second)), wantErr: `does not support the operator "gt" on "duration"`},
+		{name: "regex on name", filter: call(expression.OpRegex, refOperation, str("x")), wantErr: `does not support the operator "regex" on "name"`},
+		{name: "ne on service", filter: call(expression.OpNe, refService, str("x")), wantErr: `does not support the operator "ne" on "service"`},
+		{
+			name:    "in on attribute",
+			filter:  call(expression.OpIn, attr("http.status_code"), &expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			wantErr: `does not support the operator "in" on "http.status_code"`,
+		},
+		{name: "link attribute", filter: eqCall(linkAttr, str("v")), wantErr: `does not index the "link" level`},
+		{name: "scope attribute", filter: eqCall(scopeAttr, str("v")), wantErr: `does not index the "scope" level`},
+		{
+			name:    "other built-in field",
+			filter:  eqCall(&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}, str("server")),
+			wantErr: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name:    "attribute against a list",
+			filter:  eqCall(method, &expression.List{Values: []string{"GET"}, Type: expression.ValueTypeString}),
+			wantErr: `compares "http.method" against a string constant only`,
+		},
+		{name: "attribute against an integer", filter: eqCall(method, &expression.IntValue{Value: 1}), wantErr: `compares "http.method" against a string constant only`},
+		{name: "service against a boolean", filter: eqCall(refService, &expression.BoolValue{Value: true}), wantErr: `compares "service" against a string constant only`},
+		{name: "operation against a reference", filter: eqCall(refOperation, method), wantErr: `compares "name" against a string constant only`},
+		{name: "duration against a string", filter: call(expression.OpGte, refDuration, str("2s")), wantErr: `compares "duration" against a duration such as "2s" only`},
+		{name: "duration against a nil duration", filter: call(expression.OpGte, refDuration, (*expression.DurationValue)(nil)), wantErr: `compares "duration" against a duration such as "2s" only`},
+		{name: "duration against a nil untyped constant", filter: call(expression.OpLte, refDuration, (*expression.AnyValue)(nil)), wantErr: `compares "duration" against a duration such as "2s" only`},
+		{name: "untyped duration", filter: call(expression.OpGte, refDuration, anyVal("2s")), wantErr: `the bound "2s" on "duration" was never read as a duration`, wantInvalid: true},
+		{
+			name: "quantifier",
+			filter: call(expression.OpSome,
+				&expression.NestedRef{Level: expression.LevelEvent},
+				eqCall(&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception"))),
+			wantErr: "compares a reference against a constant only",
+		},
+		{name: "constant on the left", filter: eqCall(str("x"), method), wantErr: "compares a reference against a constant only"},
+		{name: "same attribute twice", filter: andCall(eqCall(method, str("a")), eqCall(method, str("b"))), wantErr: `only one predicate on "http.method"`},
+		{
+			name: "same attribute at two levels",
+			filter: andCall(
+				eqCall(&expression.AttributeRef{Key: "k", Level: expression.LevelSpan}, str("a")),
+				eqCall(&expression.AttributeRef{Key: "k", Level: expression.LevelResource}, str("b"))),
+			wantErr: `only one predicate on "k"`,
+		},
+		{name: "service twice", filter: andCall(eqCall(refService, str("a")), eqCall(refService, str("b"))), wantErr: `only one predicate on "service"`},
+		{name: "operation twice", filter: andCall(eqCall(refOperation, str("a")), eqCall(refOperation, str("b"))), wantErr: `only one predicate on "name"`},
+		{
+			name: "min twice",
+			filter: andCall(
+				call(expression.OpGte, refDuration, dur(time.Second)),
+				call(expression.OpGte, refDuration, dur(time.Minute))),
+			wantErr: `only one predicate on "duration"`,
+		},
+		{
+			name: "max twice",
+			filter: andCall(
+				call(expression.OpLte, refDuration, dur(time.Second)),
+				call(expression.OpLte, refDuration, dur(time.Minute))),
+			wantErr: `only one predicate on "duration"`,
+		},
+		{name: "empty conjunction", filter: andCall(), wantErr: `operator "and" takes at least two arguments`, wantInvalid: true},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			q := TraceQueryParams{Filter: tt.filter, SearchDepth: 1}
+			got, err := q.ToLegacyShape()
+			if tt.wantInvalid {
+				require.ErrorIs(t, err, ErrFilterInvalid)
+			} else {
+				require.ErrorIs(t, err, ErrFilterUnsupported)
+			}
+			require.ErrorContains(t, err, tt.wantErr)
+			assert.Equal(t, q, got, "on error the original query is returned")
+		})
+	}
+}
+
+func TestToLegacyShapeAllowsBothDurationBounds(t *testing.T) {
+	filter := andCall(
+		call(expression.OpGte, refDuration, dur(time.Second)),
+		call(expression.OpLte, refDuration, dur(time.Second)),
+	)
+	got, err := TraceQueryParams{Filter: filter}.ToLegacyShape()
+	require.NoError(t, err)
+	assert.Equal(t, time.Second, got.DurationMin)
+	assert.Equal(t, time.Second, got.DurationMax)
+}
+
+func TestToLegacyShapeRefusesCycle(t *testing.T) {
+	cycle := &expression.Call{Op: expression.OpAnd}
+	cycle.Args = []expression.Expression{cycle, cycle}
+	_, err := TraceQueryParams{Filter: cycle}.ToLegacyShape()
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+}
