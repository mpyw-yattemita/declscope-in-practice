@@ -0,0 +1,18 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+// SearchCapabilities describes how a Reader's search methods behave where
+// backends differ. It is returned by Reader.SearchCapabilities.
+//
+// The zero value describes the least capable reader: every field is a
+// capability that defaults to false. A capability added later is therefore a
+// new field that existing implementations inherit as false (not supported)
+// until they declare otherwise.
+type SearchCapabilities struct {
+	// WithoutServiceName is true when FindTraces, FindTraceIDs and
+	// FindTraceSummaries accept a TraceQueryParams whose ServiceName is empty
+	// and read it as "any service", rather than as an error or an empty result.
+	WithoutServiceName bool
+}
diff --git a/internal/storage/v2/api/tracestore/capabilities_test.go b/internal/storage/v2/api/tracestore/capabilities_test.go
new file mode 100644
index 0000000..6ecd648
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/capabilities_test.go
@@ -0,0 +1,26 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"reflect"
+	"testing"
+
+	"github.com/stretchr/testify/assert"
+)
+
+// TestSearchCapabilities_FieldCount fails when a field is added to
+// SearchCapabilities. It is a reminder, not a contract: when it fails, extend
+// the forwarding tests of every Reader decorator, which enumerate each field
+// (tracestoremetrics.TestReadMetricsDecorator_SearchCapabilities and
+// queryinterceptor.TestReader_SearchCapabilities_ForwardsBackendDeclaration),
+// then update the count here.
+func TestSearchCapabilities_FieldCount(t *testing.T) {
+	assert.Equal(t, 1, reflect.TypeFor[SearchCapabilities]().NumField(),
+		"SearchCapabilities gained a field; extend the decorators' forwarding tests to cover it")
+}
+
+func TestSearchCapabilities_ZeroValueIsLeastCapable(t *testing.T) {
+	assert.False(t, SearchCapabilities{}.WithoutServiceName)
+}
