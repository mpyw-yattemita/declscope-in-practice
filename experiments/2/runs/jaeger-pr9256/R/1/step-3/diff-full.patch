+func TestToFilterShape(t *testing.T) {
+	start, end := time.Unix(100, 0), time.Unix(200, 0)
+	tests := []struct {
+		name  string
+		query TraceQueryParams
+		want  *expression.Call
+	}{
+		{name: "no predicates", query: TraceQueryParams{Attributes: pcommon.NewMap()}},
+		{name: "zero-value attributes", query: TraceQueryParams{}},
+		{
+			name:  "one predicate stands alone",
+			query: TraceQueryParams{ServiceName: "svc"},
+			want:  call(expression.OpEq, serviceField, str("svc")),
+		},
+		{
+			name:  "operation name",
+			query: TraceQueryParams{OperationName: "op"},
+			want:  call(expression.OpEq, nameField, str("op")),
+		},
+		{
+			name:  "duration bounds",
+			query: TraceQueryParams{DurationMin: time.Second, DurationMax: time.Minute},
+			want: call(expression.OpAnd,
+				call(expression.OpGte, durationField, dur(time.Second)),
+				call(expression.OpLte, durationField, dur(time.Minute))),
+		},
+		{
+			name: "every field in order",
+			query: TraceQueryParams{
+				ServiceName: "svc", OperationName: "op",
+				Attributes:  attributes("b", "2", "a", "1"),
+				DurationMin: time.Second, DurationMax: time.Minute,
+			},
+			want: call(expression.OpAnd,
+				call(expression.OpEq, serviceField, str("svc")),
+				call(expression.OpEq, nameField, str("op")),
+				call(expression.OpEq, attr("b"), anyValue("2")),
+				call(expression.OpEq, attr("a"), anyValue("1")),
+				call(expression.OpGte, durationField, dur(time.Second)),
+				call(expression.OpLte, durationField, dur(time.Minute))),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			query := tt.query
+			query.StartTimeMin, query.StartTimeMax, query.SearchDepth = start, end, 20
+
+			got := query.ToFilterShape()
+
+			assert.Equal(t, TraceQueryParams{
+				Attributes:   pcommon.NewMap(),
+				StartTimeMin: start,
+				StartTimeMax: end,
+				SearchDepth:  20,
+				Filter:       tt.want,
+			}, got)
+			if tt.want == nil {
+				return
+			}
+			require.NoError(t, expression.ValidateFilter(got.Filter))
+			resolved, err := expression.ResolveConstants(got.Filter)
+			require.NoError(t, err)
+			assert.Equal(t, got.Filter, resolved)
+		})
+	}
+}
