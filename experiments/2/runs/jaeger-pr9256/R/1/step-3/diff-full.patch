+func TestToLegacyShape_Refuses(t *testing.T) {
+	eqService := call(expression.OpEq, serviceField, str("svc"))
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{
+			name:    "or",
+			filter:  call(expression.OpOr, eqService, call(expression.OpEq, nameField, str("op"))),
+			wantErr: `does not support the operator "or"`,
+		},
+		{
+			name:    "not nested in a conjunction",
+			filter:  call(expression.OpAnd, eqService, call(expression.OpNot, eqService)),
+			wantErr: `does not support the operator "not"`,
+		},
+		{
+			name:    "exists",
+			filter:  call(expression.OpExists, attr("k")),
+			wantErr: `does not support the operator "exists"`,
+		},
+		{
+			name:    "predicate with three arguments",
+			filter:  call(expression.OpEq, attr("k"), anyValue("v"), anyValue("w")),
+			wantErr: `does not support the operator "eq"`,
+		},
+		{
+			name:    "bare reference in a conjunction",
+			filter:  call(expression.OpAnd, eqService, attr("k")),
+			wantErr: "conjunction of predicates only",
+		},
+		{
+			name:    "ne on an attribute",
+			filter:  call(expression.OpNe, attr("http.method"), anyValue("GET")),
+			wantErr: `does not support the operator "ne" on "http.method"`,
+		},
+		{
+			name: "in on an attribute",
+			filter: call(expression.OpIn, attr("http.status_code"),
+				&expression.List{Values: []string{"200"}, Type: expression.ValueTypeInt}),
+			wantErr: `does not support the operator "in" on "http.status_code"`,
+		},
+		{
+			name:    "gt on the duration",
+			filter:  call(expression.OpGt, durationField, dur(time.Second)),
+			wantErr: `does not support the operator "gt" on "duration"`,
+		},
+		{
+			name:    "regex on the operation name",
+			filter:  call(expression.OpRegex, nameField, str("^GET")),
+			wantErr: `does not support the operator "regex" on "name"`,
+		},
+		{
+			name:    "ne on the service",
+			filter:  call(expression.OpNe, serviceField, str("svc")),
+			wantErr: `does not support the operator "ne" on "service"`,
+		},
+		{
+			name:    "attribute at the link level",
+			filter:  call(expression.OpEq, &expression.AttributeRef{Key: "k", Level: expression.LevelLink}, str("v")),
+			wantErr: `does not index the "link" level`,
+		},
+		{
+			name:    "attribute at the scope level",
+			filter:  call(expression.OpEq, &expression.AttributeRef{Key: "k", Level: expression.LevelScope}, str("v")),
+			wantErr: `does not index the "scope" level`,
+		},
+		{
+			name: "another built-in field",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}, str("server")),
+			wantErr: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name:    "attribute against an integer",
+			filter:  call(expression.OpEq, attr("http.status_code"), &expression.IntValue{Value: 200}),
+			wantErr: `compares "http.status_code" against a string constant only`,
+		},
+		{
+			name:    "attribute against a boolean",
+			filter:  call(expression.OpEq, attr("error"), &expression.BoolValue{Value: true}),
+			wantErr: `compares "error" against a string constant only`,
+		},
+		{
+			name:    "attribute against a list",
+			filter:  call(expression.OpEq, attr("k"), &expression.List{Values: []string{"v"}}),
+			wantErr: `compares "k" against a string constant only`,
+		},
+		{
+			name:    "service against another reference",
+			filter:  call(expression.OpEq, serviceField, attr("peer.service")),
+			wantErr: `compares "service" against a string constant only`,
+		},
+		{
+			name:    "operation name against an integer",
+			filter:  call(expression.OpEq, nameField, &expression.IntValue{Value: 1}),
+			wantErr: `compares "name" against a string constant only`,
+		},
+		{
+			name:    "duration against a string",
+			filter:  call(expression.OpGte, durationField, str("2s")),
+			wantErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:    "duration against a missing constant",
+			filter:  call(expression.OpLte, durationField, (*expression.DurationValue)(nil)),
+			wantErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:    "bare reference in a nested conjunction",
+			filter:  call(expression.OpAnd, eqService, call(expression.OpAnd, eqService, attr("k"))),
+			wantErr: "conjunction of predicates only",
+		},
+		{
+			name:    "quantifier over the events",
+			filter:  call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent}, eqService),
+			wantErr: "compares a reference against a constant only",
+		},
+		{
+			name:    "constant on the left",
+			filter:  call(expression.OpEq, str("svc"), serviceField),
+			wantErr: "compares a reference against a constant only",
+		},
+		{
+			name: "two predicates on one attribute",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, attr("k"), anyValue("a")),
+				call(expression.OpEq, &expression.AttributeRef{Key: "k", Level: expression.LevelSpan}, str("b"))),
+			wantErr: `only one predicate on "k"`,
+		},
+		{
+			name:    "two predicates on the service",
+			filter:  call(expression.OpAnd, eqService, call(expression.OpEq, serviceField, str("other"))),
+			wantErr: `only one predicate on "service"`,
+		},
+		{
+			name: "two predicates on the operation name",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, nameField, str("a")),
+				call(expression.OpEq, nameField, str("a"))),
+			wantErr: `only one predicate on "name"`,
+		},
+		{
+			name: "two lower duration bounds",
+			filter: call(expression.OpAnd,
+				call(expression.OpGte, durationField, dur(time.Second)),
+				call(expression.OpGte, durationField, dur(time.Minute))),
+			wantErr: `only one predicate on "duration"`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			query := TraceQueryParams{Filter: tt.filter}
+			got, err := query.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			require.ErrorContains(t, err, tt.wantErr)
+			assert.Equal(t, query, got)
+		})
+	}
+}
