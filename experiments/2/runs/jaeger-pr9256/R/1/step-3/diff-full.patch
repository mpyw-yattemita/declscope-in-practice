+func TestForCapabilities(t *testing.T) {
+	native := &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}}
+
+	t.Run("no filter", func(t *testing.T) {
+		query := TraceQueryParams{ServiceName: "svc", Attributes: attributes("k", "v")}
+		got, err := query.ForCapabilities(SearchCapabilities{Filter: native})
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("no filter support converts to the legacy shape", func(t *testing.T) {
+		query := TraceQueryParams{Filter: call(expression.OpEq, serviceField, str("svc"))}
+		for _, caps := range []*FilterCapabilities{nil, {}} {
+			got, err := query.ForCapabilities(SearchCapabilities{Filter: caps})
+			require.NoError(t, err)
+			assert.Equal(t, TraceQueryParams{ServiceName: "svc", Attributes: pcommon.NewMap()}, got)
+		}
+	})
+
+	t.Run("no filter support refuses what the legacy shape cannot express", func(t *testing.T) {
+		query := TraceQueryParams{Filter: call(expression.OpNe, serviceField, str("svc"))}
+		got, err := query.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("supported filter is passed through", func(t *testing.T) {
+		query := TraceQueryParams{Filter: call(expression.OpEq, attr("k"), anyValue("v"))}
+		got, err := query.ForCapabilities(SearchCapabilities{Filter: native})
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("unsupported filter is refused", func(t *testing.T) {
+		query := TraceQueryParams{Filter: call(expression.OpNe, attr("k"), anyValue("v"))}
+		got, err := query.ForCapabilities(SearchCapabilities{Filter: native})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		require.ErrorContains(t, err, `it does not support the operator "ne"`)
+		assert.Equal(t, query, got)
+	})
+}
