 // Copyright (c) 2026 The Jaeger Authors.
 // SPDX-License-Identifier: Apache-2.0
 
 package tracestore
 
 import (
 	"testing"
 
 	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
 	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
 )
 
 func TestFilterCapabilities_IsEmpty(t *testing.T) {
 	tests := []struct {
 		name string
 		caps *FilterCapabilities
 		want bool
 	}{
 		{name: "nil", caps: nil, want: true},
 		{name: "zero value", caps: &FilterCapabilities{}, want: true},
 		{
 			name: "empty non-nil slices",
 			caps: &FilterCapabilities{Levels: []expression.Level{}, Operators: []expression.Operator{}},
 			want: true,
 		},
 		{name: "one level", caps: &FilterCapabilities{Levels: []expression.Level{expression.LevelSpan}}, want: false},
 		{name: "one operator", caps: &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}}, want: false},
 	}
 	for _, tt := range tests {
 		t.Run(tt.name, func(t *testing.T) {
 			assert.Equal(t, tt.want, tt.caps.IsEmpty())
 		})
 	}
 }
 
 func TestFilterCapabilities_SupportsLevel(t *testing.T) {
 	caps := FilterCapabilities{Levels: []expression.Level{expression.LevelSpan, expression.LevelResource}}
 	assert.True(t, caps.SupportsLevel(""), "unqualified reference")
 	assert.True(t, caps.SupportsLevel(expression.LevelSpan))
 	assert.True(t, caps.SupportsLevel(expression.LevelResource))
 	assert.False(t, caps.SupportsLevel(expression.LevelEvent))
 
 	var zero FilterCapabilities
 	assert.True(t, zero.SupportsLevel(""), "unqualified reference on zero value")
 	assert.False(t, zero.SupportsLevel(expression.LevelSpan))
 }
 
 func TestFilterCapabilities_SupportsOperator(t *testing.T) {
 	conjunctive := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd, expression.OpEq}}
 	assert.True(t, conjunctive.SupportsOperator(expression.OpAnd))
 	assert.True(t, conjunctive.SupportsOperator(expression.OpEq))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpOr))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpNot))
 
 	var zero FilterCapabilities
 	assert.False(t, zero.SupportsOperator(expression.OpAnd), "zero value supports no operator, not even and")
 	assert.False(t, zero.SupportsOperator(""))
 }
+
+func TestFilterCapabilities_EnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpSome},
+	}
+	spanName := &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{name: "nil filter"},
+		{
+			name: "supported operators, levels and constants",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, &expression.AttributeRef{Key: "k"}, &expression.AnyValue{Value: "v"}),
+				call(expression.OpEq, spanName, &expression.StringValue{Value: "op"})),
+		},
+		{
+			name:    "unsupported operator at the top",
+			filter:  call(expression.OpOr, call(expression.OpEq, spanName, &expression.StringValue{Value: "a"})),
+			wantErr: `it does not support the operator "or"`,
+		},
+		{
+			name: "unsupported operator nested",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, spanName, &expression.StringValue{Value: "a"}),
+				call(expression.OpNe, spanName, &expression.StringValue{Value: "b"})),
+			wantErr: `it does not support the operator "ne"`,
+		},
+		{
+			name: "unsupported operator on the right side of a comparison",
+			filter: call(expression.OpEq, spanName,
+				call(expression.OpGt, spanName, &expression.StringValue{Value: "b"})),
+			wantErr: `it does not support the operator "gt"`,
+		},
+		{
+			name: "attribute at an unindexed level",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "k", Level: expression.LevelResource}, &expression.AnyValue{Value: "v"}),
+			wantErr: `it does not index the "resource" level`,
+		},
+		{
+			name: "field at an unindexed level",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+				&expression.StringValue{Value: "svc"}),
+			wantErr: `it does not index the "resource" level`,
+		},
+		{
+			name: "nested reference at an unindexed level",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, &expression.AttributeRef{Key: "k"}, &expression.AnyValue{Value: "v"})),
+			wantErr: `it does not index the "event" level`,
+		},
+		{
+			name: "reference on the right side",
+			filter: call(expression.OpEq, &expression.AttributeRef{Key: "k"},
+				&expression.AttributeRef{Key: "j", Level: expression.LevelLink}),
+			wantErr: `it does not index the "link" level`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := caps.EnsureSupported(tt.filter)
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, tt.wantErr)
+		})
+	}
+}
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
diff --git a/internal/storage/v2/api/tracestore/query_shape.go b/internal/storage/v2/api/tracestore/query_shape.go
new file mode 100644
index 0000000..3cbe487
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_shape.go
@@ -0,0 +1,339 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// A query filters in one of two models: the structured Filter, or the legacy
+// predicate fields ServiceName, OperationName, Attributes and the duration
+// bounds. The methods in this file decide which of them a Reader receives, so
+// that every caller gets the same answer instead of each backend's own.
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. The error wraps ErrFilterInvalid
+// and names every conflicting field.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if !isEmptyMap(q.Attributes) {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: the filter replaces the predicate fields %v and cannot be combined with them",
+		ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A Reader that declares no filter support receives
+// the filter expressed in the legacy predicate fields (see ToLegacyShape); any
+// other Reader receives the query as it is, provided caps covers the filter
+// (see FilterCapabilities.EnsureSupported). A query without a filter is
+// returned unchanged.
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates and
+// clears them. It cannot fail, because each legacy field has an exact filter
+// equivalent. A query that already has a Filter is returned as it is.
+//
+// The filter it builds is already finalized: every constant has the type the
+// field it is compared against holds, and every reference comes first.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, eq(
+			&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+			&expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, eq(
+			&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+			&expression.StringValue{Value: q.OperationName}))
+	}
+	if !isEmptyMap(q.Attributes) {
+		q.Attributes.Range(func(key string, value pcommon.Value) bool {
+			predicates = append(predicates, eq(
+				&expression.AttributeRef{Key: key},
+				&expression.AnyValue{Value: value.AsString()}))
+			return true
+		})
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, durationBound(expression.OpGte, q.DurationMin))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, durationBound(expression.OpLte, q.DurationMax))
+	}
+
+	out := q
+	out.ServiceName = ""
+	out.OperationName = ""
+	out.Attributes = pcommon.NewMap()
+	out.DurationMin = 0
+	out.DurationMax = 0
+	out.Filter = conjunction(predicates)
+	return out
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves, and clears the Filter. A query without a filter is returned
+// unchanged. It is the inverse of ToFilterShape.
+//
+// Only what those fields can say exactly converts: a flat conjunction of
+// equalities on attributes, the service and the operation name, and inclusive
+// bounds on the duration. Anything else is refused with ErrFilterUnsupported
+// rather than approximated. On error the original query is returned.
+//
+// The result has a new Attributes map, so the caller's map is never changed. A
+// query whose filter does not stand alone is refused (see
+// EnsureFilterStandsAlone), since converting it would overwrite the fields the
+// caller set.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	conjuncts, err := conjunctsOf(q.Filter)
+	if err != nil {
+		return q, err
+	}
+	out := q
+	out.Filter = nil
+	out.Attributes = pcommon.NewMap()
+	w := legacyWriter{query: &out, written: make(map[string]bool)}
+	for _, predicate := range conjuncts {
+		if err := w.write(predicate); err != nil {
+			return q, err
+		}
+	}
+	return out, nil
+}
+
+// legacyWriter writes the predicates of a conjunction into the legacy fields of
+// query, refusing a second predicate on a field it has already written.
+type legacyWriter struct {
+	query *TraceQueryParams
+	// written holds the slot of every field written so far: "attribute:<key>",
+	// "service", "operation", or "duration:<op>" for a bound.
+	written map[string]bool
+}
+
+func (w legacyWriter) write(predicate *expression.Call) error {
+	switch predicate.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return errOperatorUnsupported(predicate.Op)
+	}
+	if len(predicate.Args) != 2 {
+		return errOperatorUnsupported(predicate.Op)
+	}
+	operand := predicate.Args[1]
+	switch ref := predicate.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return w.writeAttribute(predicate.Op, ref, operand)
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return w.writeField(predicate.Op, ref, operand)
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+func (w legacyWriter) writeAttribute(op expression.Operator, ref *expression.AttributeRef, operand expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+		// The legacy Attributes match a tag at any of these levels, so a qualified
+		// reference widens to an unqualified one.
+	default:
+		return errLevelUnsupported(ref.Level)
+	}
+	value, err := equalString(op, ref.Key, operand)
+	if err != nil {
+		return err
+	}
+	if err := w.claim("attribute:"+ref.Key, ref.Key); err != nil {
+		return err
+	}
+	w.query.Attributes.PutStr(ref.Key, value)
+	return nil
+}
+
+func (w legacyWriter) writeField(op expression.Operator, ref *expression.FieldRef, operand expression.Expression) error {
+	var target *string
+	var slot string
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		target, slot = &w.query.ServiceName, "service"
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		target, slot = &w.query.OperationName, "operation"
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		return w.writeDurationBound(op, ref.Name, operand)
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+	value, err := equalString(op, ref.Name, operand)
+	if err != nil {
+		return err
+	}
+	if err := w.claim(slot, ref.Name); err != nil {
+		return err
+	}
+	*target = value
+	return nil
+}
+
+func (w legacyWriter) writeDurationBound(op expression.Operator, name string, operand expression.Expression) error {
+	var target *time.Duration
+	switch op {
+	case expression.OpGte:
+		target = &w.query.DurationMin
+	case expression.OpLte:
+		target = &w.query.DurationMax
+	default:
+		return errOperatorOnUnsupported(op, name)
+	}
+	switch value := operand.(type) {
+	case *expression.DurationValue:
+		if value != nil {
+			if err := w.claim("duration:"+string(op), name); err != nil {
+				return err
+			}
+			*target = value.Value
+			return nil
+		}
+	case *expression.AnyValue:
+		if value != nil {
+			// expression.Finalize reads such a constant as a duration, so meeting one
+			// here means the filter skipped it. That is the caller's error, not a
+			// limit of the legacy fields.
+			return fmt.Errorf("%w: the bound %q on %q was never read as a duration",
+				ErrFilterInvalid, value.Value, name)
+		}
+	}
+	return fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only", ErrFilterUnsupported, name)
+}
+
+// claim records that slot is written, refusing it if it already was: the legacy
+// fields hold one value each, so a second predicate would silently replace the
+// first.
+func (w legacyWriter) claim(slot, name string) error {
+	if w.written[slot] {
+		return fmt.Errorf("%w: it takes only one predicate on %q", ErrFilterUnsupported, name)
+	}
+	w.written[slot] = true
+	return nil
+}
+
+// equalString returns the text of an equality against a string or untyped
+// constant, which is the only comparison the legacy string fields express.
+func equalString(op expression.Operator, name string, operand expression.Expression) (string, error) {
+	if op != expression.OpEq {
+		return "", errOperatorOnUnsupported(op, name)
+	}
+	switch value := operand.(type) {
+	case *expression.StringValue:
+		if value != nil {
+			return value.Value, nil
+		}
+	case *expression.AnyValue:
+		if value != nil {
+			return value.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+// conjunctsOf flattens filter into the predicates it conjoins. A filter that is
+// not a conjunction is a single predicate.
+func conjunctsOf(filter *expression.Call) ([]*expression.Call, error) {
+	if filter.Op != expression.OpAnd {
+		return []*expression.Call{filter}, nil
+	}
+	var conjuncts []*expression.Call
+	for _, arg := range filter.Args {
+		nested, ok := arg.(*expression.Call)
+		if !ok || nested == nil {
+			return nil, fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+		}
+		flattened, err := conjunctsOf(nested)
+		if err != nil {
+			return nil, err
+		}
+		conjuncts = append(conjuncts, flattened...)
+	}
+	return conjuncts, nil
+}
+
+func errOperatorOnUnsupported(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func eq(ref, value expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpEq, Args: []expression.Expression{ref, value}}
+}
+
+func durationBound(op expression.Operator, bound time.Duration) *expression.Call {
+	return &expression.Call{Op: op, Args: []expression.Expression{
+		&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration},
+		&expression.DurationValue{Value: bound},
+	}}
+}
+
+// conjunction returns nil for no predicates, the predicate itself for one, and
+// an OpAnd call over them for more.
+func conjunction(predicates []*expression.Call) *expression.Call {
+	switch len(predicates) {
+	case 0:
+		return nil
+	case 1:
+		return predicates[0]
+	}
+	args := make([]expression.Expression, len(predicates))
+	for i, predicate := range predicates {
+		args[i] = predicate
+	}
+	return &expression.Call{Op: expression.OpAnd, Args: args}
+}
+
+// isEmptyMap reports whether m holds no entries. Unlike m.Len(), it is safe on
+// a map left at its zero value rather than created with pcommon.NewMap().
+func isEmptyMap(m pcommon.Map) bool {
+	return m == (pcommon.Map{}) || m.Len() == 0
+}
diff --git a/internal/storage/v2/api/tracestore/query_shape_test.go b/internal/storage/v2/api/tracestore/query_shape_test.go
