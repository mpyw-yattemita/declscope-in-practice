+func TestToLegacyShape_Converts(t *testing.T) {
+	tests := []struct {
+		name   string
+		filter *expression.Call
+		want   TraceQueryParams
+	}{
+		{
+			name:   "unqualified attribute against an untyped constant",
+			filter: call(expression.OpEq, attr("k"), anyValue("v")),
+			want:   TraceQueryParams{Attributes: attributes("k", "v")},
+		},
+		{
+			name: "qualified attributes widen to tags",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, &expression.AttributeRef{Key: "s", Level: expression.LevelSpan}, str("1")),
+				call(expression.OpEq, &expression.AttributeRef{Key: "r", Level: expression.LevelResource}, str("2")),
+				call(expression.OpEq, &expression.AttributeRef{Key: "e", Level: expression.LevelEvent}, anyValue("3"))),
+			want: TraceQueryParams{Attributes: attributes("s", "1", "r", "2", "e", "3")},
+		},
+		{
+			name: "service and operation against untyped constants",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, serviceField, anyValue("svc")),
+				call(expression.OpEq, nameField, anyValue("op"))),
+			want: TraceQueryParams{ServiceName: "svc", OperationName: "op", Attributes: pcommon.NewMap()},
+		},
+		{
+			name: "nested conjunction is flattened",
+			filter: call(expression.OpAnd,
+				call(expression.OpAnd,
+					call(expression.OpEq, serviceField, str("svc")),
+					call(expression.OpGte, durationField, dur(time.Second))),
+				call(expression.OpLte, durationField, dur(time.Minute))),
+			want: TraceQueryParams{
+				ServiceName: "svc", DurationMin: time.Second, DurationMax: time.Minute,
+				Attributes: pcommon.NewMap(),
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			got, err := TraceQueryParams{Filter: tt.filter}.ToLegacyShape()
+			require.NoError(t, err)
+			assert.Equal(t, tt.want, got)
+		})
+	}
+}
