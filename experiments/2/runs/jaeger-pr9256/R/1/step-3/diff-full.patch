+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := call(expression.OpEq, attr("k"), anyValue("v"))
+	tests := []struct {
+		name    string
+		query   TraceQueryParams
+		wantErr string
+	}{
+		{name: "no filter", query: TraceQueryParams{ServiceName: "svc", Attributes: attributes("k", "v")}},
+		{name: "filter alone", query: TraceQueryParams{Filter: filter, Attributes: pcommon.NewMap()}},
+		{name: "filter with zero-value attributes", query: TraceQueryParams{Filter: filter}},
+		{
+			name: "filter with time range and depth",
+			query: TraceQueryParams{
+				Filter: filter, Attributes: pcommon.NewMap(),
+				StartTimeMin: time.Unix(1, 0), StartTimeMax: time.Unix(2, 0), SearchDepth: 10,
+			},
+		},
+		{
+			name:    "filter with service name",
+			query:   TraceQueryParams{Filter: filter, ServiceName: "svc"},
+			wantErr: "[service_name]",
+		},
+		{
+			name:    "filter with attributes",
+			query:   TraceQueryParams{Filter: filter, Attributes: attributes("k", "v")},
+			wantErr: "[attributes]",
+		},
+		{
+			name: "filter with every field",
+			query: TraceQueryParams{
+				Filter: filter, ServiceName: "svc", OperationName: "op",
+				DurationMin: time.Second, DurationMax: time.Minute, Attributes: attributes("k", "v"),
+			},
+			wantErr: "[service_name operation_name duration_min duration_max attributes]",
+		},
+		{
+			name:    "filter with duration max",
+			query:   TraceQueryParams{Filter: filter, DurationMax: time.Minute},
+			wantErr: "[duration_max]",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.query.EnsureFilterStandsAlone()
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.ErrorContains(t, err, tt.wantErr)
+		})
+	}
+}
