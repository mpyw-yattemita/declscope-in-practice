index 36884f2..e6d61c9 100644
--- a/internal/storage/v2/api/tracestore/filter.go
+++ b/internal/storage/v2/api/tracestore/filter.go
@@ -1,11 +1,11 @@
 // Copyright (c) 2026 The Jaeger Authors.
 // SPDX-License-Identifier: Apache-2.0
 
-
 package tracestore
 
 import (
 	"errors"
+	"fmt"
 	"slices"
 
 	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
@@ -57,3 +57,71 @@ func (c FilterCapabilities) SupportsLevel(level expression.Level) bool {
 func (c FilterCapabilities) SupportsOperator(op expression.Operator) bool {
 	return slices.Contains(c.Operators, op)
 }
+
+// EnsureSupported walks filter and refuses the first predicate that names an
+// operator or a level c does not declare. Constants need no support. A nil
+// filter is supported.
+func (c FilterCapabilities) EnsureSupported(filter *expression.Call) error {
+	if filter == nil {
+		return nil
+	}
+	return c.ensureCall(filter, 1)
+}
+
+// ensureCall checks one call and its arguments. depth counts the calls it
+// sits in, itself included, so that a tree containing itself is refused
+// rather than walked until the stack runs out.
+func (c FilterCapabilities) ensureCall(call *expression.Call, depth int) error {
+	if depth > expression.MaxNestingDepth {
+		return fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if !c.SupportsOperator(call.Op) {
+		return errOperatorUnsupported(call.Op)
+	}
+	for _, arg := range call.Args {
+		if err := c.ensureArg(arg, depth); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+func (c FilterCapabilities) ensureArg(arg expression.Expression, depth int) error {
+	var level expression.Level
+	switch term := arg.(type) {
+	case *expression.Call:
+		if term == nil {
+			return nil
+		}
+		return c.ensureCall(term, depth+1)
+	case *expression.AttributeRef:
+		if term == nil {
+			return nil
+		}
+		level = term.Level
+	case *expression.FieldRef:
+		if term == nil {
+			return nil
+		}
+		level = term.Level
+	case *expression.NestedRef:
+		if term == nil {
+			return nil
+		}
+		level = term.Level
+	default:
+		return nil
+	}
+	if !c.SupportsLevel(level) {
+		return errLevelUnsupported(level)
+	}
+	return nil
+}
+
+func errOperatorUnsupported(op expression.Operator) error {
+	return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, op)
+}
+
+func errLevelUnsupported(level expression.Level) error {
+	return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, level)
+}
