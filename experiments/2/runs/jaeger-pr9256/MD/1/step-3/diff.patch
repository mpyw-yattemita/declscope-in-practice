+	assert.NoError(t, caps.EnsureSupported(filter))
+}
+
+func TestFilterCapabilitiesEnsureSupported_Refuses(t *testing.T) {
+	spanOnly := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpSome},
+	}
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string
+	}{
+		{
+			name:     "an operator at the top",
+			filter:   call(expression.OpNe, &expression.AttributeRef{Key: "a"}, &expression.AnyValue{Value: "1"}),
+			expected: `it does not support the operator "ne"`,
+		},
+		{
+			name: "an operator nested in a conjunction",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, &expression.AttributeRef{Key: "a"}, &expression.AnyValue{Value: "1"}),
+				call(expression.OpOr,
+					call(expression.OpEq, &expression.AttributeRef{Key: "b"}, &expression.AnyValue{Value: "1"}),
+					call(expression.OpEq, &expression.AttributeRef{Key: "c"}, &expression.AnyValue{Value: "1"}))),
+			expected: `it does not support the operator "or"`,
+		},
+		{
+			name: "a call on the right of a comparison",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a"},
+				call(expression.OpRegex, &expression.AttributeRef{Key: "b"}, &expression.AnyValue{Value: ".*"})),
+			expected: `it does not support the operator "regex"`,
+		},
+		{
+			name: "an attribute level",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a", Level: expression.LevelResource},
+				&expression.AnyValue{Value: "1"}),
+			expected: `it does not index the "resource" level`,
+		},
+		{
+			name: "a field level",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+				&expression.StringValue{Value: "cart"}),
+			expected: `it does not index the "resource" level`,
+		},
+		{
+			name: "a nested level",
+			filter: call(expression.OpSome,
+				&expression.NestedRef{Level: expression.LevelLink},
+				call(expression.OpEq,
+					&expression.FieldRef{Level: expression.LevelLink, Name: expression.LinkFieldTraceID},
+					&expression.StringValue{Value: "abc"})),
+			expected: `it does not index the "link" level`,
+		},
+		{
+			name: "a level on the right of a comparison",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a", Level: expression.LevelSpan},
+				&expression.AttributeRef{Key: "a", Level: expression.LevelEvent}),
+			expected: `it does not index the "event" level`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := spanOnly.EnsureSupported(tt.filter)
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, tt.expected)
+		})
+	}
+}
+
+// TestFilterCapabilitiesEnsureSupported_MissingTerms pins that a missing term is
+// left to expression.ValidateFilter: it names no operator or level to refuse.
+func TestFilterCapabilitiesEnsureSupported_MissingTerms(t *testing.T) {
+	caps := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd, expression.OpEq}}
+	filter := call(expression.OpAnd,
+		(*expression.Call)(nil),
+		call(expression.OpEq, (*expression.AttributeRef)(nil), (*expression.FieldRef)(nil)),
+		call(expression.OpEq, (*expression.NestedRef)(nil), nil))
+	assert.NoError(t, caps.EnsureSupported(filter))
+}
+
+func TestFilterCapabilitiesEnsureSupported_RefusesACycle(t *testing.T) {
+	caps := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd}}
+	cycle := &expression.Call{Op: expression.OpAnd}
+	cycle.Args = []expression.Expression{cycle, cycle}
+	err := caps.EnsureSupported(cycle)
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+}
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func spanDuration() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+}
diff --git a/internal/storage/v2/api/tracestore/query_shape.go b/internal/storage/v2/api/tracestore/query_shape.go
new file mode 100644
index 0000000..8d51252
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_shape.go
@@ -0,0 +1,323 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	"go.opentelemetry.io/collector/pdata/pcommon"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+)
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. The error wraps
+// ErrFilterInvalid and names every conflicting field.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if attributeCount(q.Attributes) > 0 {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: a query with a filter cannot also set %v", ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A Reader that declared no filter support gets the
+// filter expressed in the legacy predicate fields; one that did gets the
+// filter as it is, provided it declared everything the filter uses.
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates.
+// It cannot fail, because each legacy field has an exact filter equivalent.
+// A query that already has a Filter is returned as it is.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, eq(
+			&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+			&expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, eq(
+			&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+			&expression.StringValue{Value: q.OperationName}))
+	}
+	if attributeCount(q.Attributes) > 0 {
+		for key, value := range q.Attributes.All() {
+			predicates = append(predicates, eq(
+				&expression.AttributeRef{Key: key},
+				&expression.AnyValue{Value: value.AsString()}))
+		}
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, durationBound(expression.OpGte, q.DurationMin))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, durationBound(expression.OpLte, q.DurationMax))
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	switch len(predicates) {
+	case 0:
+		q.Filter = nil
+	case 1:
+		q.Filter = predicates[0]
+	default:
+		args := make([]expression.Expression, len(predicates))
+		for i, predicate := range predicates {
+			args[i] = predicate
+		}
+		q.Filter = &expression.Call{Op: expression.OpAnd, Args: args}
+	}
+	return q
+}
+
+func eq(ref, constant expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpEq, Args: []expression.Expression{ref, constant}}
+}
+
+func durationBound(op expression.Operator, d time.Duration) *expression.Call {
+	return &expression.Call{Op: op, Args: []expression.Expression{
+		&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration},
+		&expression.DurationValue{Value: d},
+	}}
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves. Only a flat conjunction of the predicates those fields can
+// hold converts; anything else is refused with ErrFilterUnsupported rather
+// than approximated. On error the original query is returned.
+//
+// The result has a nil Filter and a new Attributes map, so the caller's map
+// is not changed.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	// Writing the filter into fields the query already sets would merge two
+	// questions into one, so only a filter that stands alone is converted.
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	predicates, err := flattenConjunction(q.Filter, nil, 1)
+	if err != nil {
+		return q, err
+	}
+	legacy := q
+	legacy.Filter = nil
+	legacy.Attributes = pcommon.NewMap()
+	w := legacyWriter{query: &legacy}
+	for _, predicate := range predicates {
+		if err := w.write(predicate); err != nil {
+			return q, err
+		}
+	}
+	return legacy, nil
+}
+
+// flattenConjunction appends the predicates of call to out, reading through
+// nested conjunctions, since and is associative. depth bounds the walk the
+// way expression.MaxNestingDepth bounds validation.
+func flattenConjunction(call *expression.Call, out []*expression.Call, depth int) ([]*expression.Call, error) {
+	if depth > expression.MaxNestingDepth {
+		return nil, fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if call.Op != expression.OpAnd {
+		return append(out, call), nil
+	}
+	for _, arg := range call.Args {
+		nested, ok := arg.(*expression.Call)
+		if !ok || nested == nil {
+			return nil, fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+		}
+		var err error
+		if out, err = flattenConjunction(nested, out, depth+1); err != nil {
+			return nil, err
+		}
+	}
+	return out, nil
+}
+
+// legacyWriter writes predicates into the legacy fields of query, refusing a
+// second predicate on a field one has already written.
+type legacyWriter struct {
+	query                    *TraceQueryParams
+	service, operation       bool
+	durationMin, durationMax bool
+}
+
+func (w *legacyWriter) write(predicate *expression.Call) error {
+	switch predicate.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return errOperatorUnsupported(predicate.Op)
+	}
+	if len(predicate.Args) != 2 {
+		return errOperatorUnsupported(predicate.Op)
+	}
+	switch ref := predicate.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return w.writeAttribute(predicate.Op, ref, predicate.Args[1])
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return w.writeField(predicate.Op, ref, predicate.Args[1])
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+// writeAttribute writes an equality on an attribute as a tag. A tag is matched
+// at the span, resource and event levels alike, so a predicate at one of them
+// widens to a plain tag; the link and scope levels have no tag to widen to.
+func (w *legacyWriter) writeAttribute(op expression.Operator, ref *expression.AttributeRef, constant expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+	default:
+		return errLevelUnsupported(ref.Level)
+	}
+	if _, exists := w.query.Attributes.Get(ref.Key); exists {
+		return errDuplicatePredicate(ref.Key)
+	}
+	var value string
+	if err := stringOperand(op, ref.Key, constant, &value); err != nil {
+		return err
+	}
+	w.query.Attributes.PutStr(ref.Key, value)
+	return nil
+}
+
+func (w *legacyWriter) writeField(op expression.Operator, ref *expression.FieldRef, constant expression.Expression) error {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		return writeOnce(&w.service, ref.Name, func() error {
+			return stringOperand(op, ref.Name, constant, &w.query.ServiceName)
+		})
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		return writeOnce(&w.operation, ref.Name, func() error {
+			return stringOperand(op, ref.Name, constant, &w.query.OperationName)
+		})
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		switch op {
+		case expression.OpGte:
+			return writeOnce(&w.durationMin, ref.Name, func() error {
+				return durationOperand(ref.Name, constant, &w.query.DurationMin)
+			})
+		case expression.OpLte:
+			return writeOnce(&w.durationMax, ref.Name, func() error {
+				return durationOperand(ref.Name, constant, &w.query.DurationMax)
+			})
+		default:
+			return errOperatorOnUnsupported(op, ref.Name)
+		}
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+// writeOnce runs write unless written says a predicate already wrote the
+// field, and records that one has.
+func writeOnce(written *bool, name string, write func() error) error {
+	if *written {
+		return errDuplicatePredicate(name)
+	}
+	if err := write(); err != nil {
+		return err
+	}
+	*written = true
+	return nil
+}
+
+// stringOperand reads the constant of an equality on a field that holds text
+// into field.
+func stringOperand(op expression.Operator, name string, constant expression.Expression, field *string) error {
+	if op != expression.OpEq {
+		return errOperatorOnUnsupported(op, name)
+	}
+	switch value := constant.(type) {
+	case *expression.StringValue:
+		if value != nil {
+			*field = value.Value
+			return nil
+		}
+	case *expression.AnyValue:
+		if value != nil {
+			*field = value.Value
+			return nil
+		}
+	}
+	return fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+// durationOperand reads the constant of a duration bound into bound.
+func durationOperand(name string, constant expression.Expression, bound *time.Duration) error {
+	switch value := constant.(type) {
+	case *expression.DurationValue:
+		if value != nil {
+			*bound = value.Value
+			return nil
+		}
+	case *expression.AnyValue:
+		if value != nil {
+			// expression.ResolveConstants reads such a constant as a duration,
+			// so one that is still untyped was never resolved.
+			return fmt.Errorf("%w: the bound %q on %q was never read as a duration",
+				ErrFilterInvalid, value.Value, name)
+		}
+	}
+	return fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only", ErrFilterUnsupported, name)
+}
+
+func errOperatorOnUnsupported(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func errDuplicatePredicate(name string) error {
+	return fmt.Errorf("%w: it holds only one predicate on %q", ErrFilterUnsupported, name)
+}
+
+// attributeCount is the number of entries in m. An Attributes map left at its
+// zero value, rather than created with pcommon.NewMap, has none, and asking
+// it directly would panic.
+func attributeCount(m pcommon.Map) int {
+	if m == (pcommon.Map{}) {
+		return 0
+	}
+	return m.Len()
+}
diff --git a/internal/storage/v2/api/tracestore/query_shape_test.go b/internal/storage/v2/api/tracestore/query_shape_test.go
new file mode 100644
index 0000000..3c7e745
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_shape_test.go
@@ -0,0 +1,572 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+)
+
+func attr(key, value string) *expression.Call {
+	return call(expression.OpEq, &expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value})
+}
+
+func service(value string) *expression.Call {
+	return call(expression.OpEq,
+		&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+		&expression.StringValue{Value: value})
+}
+
+func operation(value string) *expression.Call {
+	return call(expression.OpEq,
+		&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+		&expression.StringValue{Value: value})
+}
+
+func bound(op expression.Operator, d time.Duration) *expression.Call {
+	return call(op, spanDuration(), &expression.DurationValue{Value: d})
+}
+
+func withFilter(filter *expression.Call) TraceQueryParams {
+	return TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}
+}
+
+func attributesOf(kv ...string) pcommon.Map {
+	m := pcommon.NewMap()
+	for i := 0; i < len(kv); i += 2 {
+		m.PutStr(kv[i], kv[i+1])
+	}
+	return m
+}
+
+func TestEnsureFilterStandsAlone_Passes(t *testing.T) {
+	tests := map[string]TraceQueryParams{
+		"no filter, legacy fields set": {
+			ServiceName: "cart", DurationMin: time.Second, Attributes: attributesOf("a", "1"),
+		},
+		"a filter alone": withFilter(attr("a", "1")),
+		"a filter beside an Attributes zero value": {Filter: attr("a", "1")},
+		"a filter beside a time range and depth": {
+			Attributes:   pcommon.NewMap(),
+			StartTimeMin: time.Unix(1, 0),
+			StartTimeMax: time.Unix(2, 0),
+			SearchDepth:  10,
+			Filter:       attr("a", "1"),
+		},
+	}
+	for name, query := range tests {
+		t.Run(name, func(t *testing.T) {
+			assert.NoError(t, query.EnsureFilterStandsAlone())
+		})
+	}
+}
+
