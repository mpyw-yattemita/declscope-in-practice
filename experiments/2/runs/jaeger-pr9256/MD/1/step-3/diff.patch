+func TestToFilterShape(t *testing.T) {
+	start, end := time.Unix(100, 0), time.Unix(200, 0)
+	tests := []struct {
+		name     string
+		query    TraceQueryParams
+		expected *expression.Call
+	}{
+		{
+			name:     "no predicates",
+			query:    TraceQueryParams{Attributes: pcommon.NewMap()},
+			expected: nil,
+		},
+		{
+			name:     "one predicate stands on its own",
+			query:    TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()},
+			expected: service("cart"),
+		},
+		{
+			name:     "an operation",
+			query:    TraceQueryParams{OperationName: "GET /cart", Attributes: pcommon.NewMap()},
+			expected: operation("GET /cart"),
+		},
+		{
+			name:     "a lower duration bound",
+			query:    TraceQueryParams{DurationMin: time.Second, Attributes: pcommon.NewMap()},
+			expected: bound(expression.OpGte, time.Second),
+		},
+		{
+			name:     "an upper duration bound",
+			query:    TraceQueryParams{DurationMax: time.Second, Attributes: pcommon.NewMap()},
+			expected: bound(expression.OpLte, time.Second),
+		},
+		{
+			name:     "an Attributes zero value",
+			query:    TraceQueryParams{ServiceName: "cart"},
+			expected: service("cart"),
+		},
+		{
+			name: "every field, in order",
+			query: TraceQueryParams{
+				ServiceName:   "cart",
+				OperationName: "GET /cart",
+				Attributes:    attributesOf("http.method", "GET", "http.status_code", "500"),
+				DurationMin:   time.Second,
+				DurationMax:   2 * time.Second,
+			},
+			expected: call(expression.OpAnd,
+				service("cart"),
+				operation("GET /cart"),
+				attr("http.method", "GET"),
+				attr("http.status_code", "500"),
+				bound(expression.OpGte, time.Second),
+				bound(expression.OpLte, 2*time.Second)),
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			query := tt.query
+			query.StartTimeMin, query.StartTimeMax, query.SearchDepth = start, end, 20
+
+			got := query.ToFilterShape()
+			assert.Equal(t, TraceQueryParams{
+				Attributes:   pcommon.NewMap(),
+				StartTimeMin: start,
+				StartTimeMax: end,
+				SearchDepth:  20,
+				Filter:       tt.expected,
+			}, got)
+			if tt.expected == nil {
+				return
+			}
+			require.NoError(t, expression.ValidateFilter(got.Filter))
+			resolved, err := expression.ResolveConstants(got.Filter)
+			require.NoError(t, err)
+			assert.Equal(t, got.Filter, resolved, "nothing is left to resolve")
+		})
+	}
+}
