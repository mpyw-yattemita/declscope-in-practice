+func TestToLegacyShape_Refuses(t *testing.T) {
+	durationOf := func(constant expression.Expression) *expression.Call {
+		return call(expression.OpGte, spanDuration(), constant)
+	}
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string
+	}{
+		{
+			name:     "a disjunction",
+			filter:   call(expression.OpOr, attr("a", "1"), attr("b", "2")),
+			expected: `does not support the operator "or"`,
+		},
+		{
+			name:     "a disjunction nested in a conjunction",
+			filter:   call(expression.OpAnd, attr("a", "1"), call(expression.OpOr, attr("b", "2"), attr("c", "3"))),
+			expected: `does not support the operator "or"`,
+		},
+		{
+			name:     "a negation",
+			filter:   call(expression.OpNot, attr("a", "1")),
+			expected: `does not support the operator "not"`,
+		},
+		{
+			name:     "an existence test",
+			filter:   call(expression.OpExists, &expression.AttributeRef{Key: "a"}),
+			expected: `does not support the operator "exists"`,
+		},
+		{
+			name: "a predicate with three arguments",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a"}, &expression.AnyValue{Value: "1"}, &expression.AnyValue{Value: "2"}),
+			expected: `does not support the operator "eq"`,
+		},
+		{
+			name:     "a bare reference in a conjunction",
+			filter:   call(expression.OpAnd, attr("a", "1"), &expression.AttributeRef{Key: "b"}),
+			expected: "conjunction of predicates only",
+		},
+		{
+			name:     "a missing conjunct",
+			filter:   call(expression.OpAnd, attr("a", "1"), (*expression.Call)(nil)),
+			expected: "conjunction of predicates only",
+		},
+		{
+			name: "an inequality on an attribute",
+			filter: call(expression.OpNe,
+				&expression.AttributeRef{Key: "http.method"}, &expression.AnyValue{Value: "GET"}),
+			expected: `does not support the operator "ne" on "http.method"`,
+		},
+		{
+			name: "membership on an attribute",
+			filter: call(expression.OpIn,
+				&expression.AttributeRef{Key: "http.status_code"},
+				&expression.List{Values: []string{"500", "503"}, Type: expression.ValueTypeInt}),
+			expected: `does not support the operator "in" on "http.status_code"`,
+		},
+		{
+			name:     "a strict duration bound",
+			filter:   call(expression.OpGt, spanDuration(), &expression.DurationValue{Value: time.Second}),
+			expected: `does not support the operator "gt" on "duration"`,
+		},
+		{
+			name: "a pattern on the operation",
+			filter: call(expression.OpRegex,
+				&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+				&expression.AnyValue{Value: "GET.*"}),
+			expected: `does not support the operator "regex" on "name"`,
+		},
+		{
+			name: "an inequality on the service",
+			filter: call(expression.OpNe,
+				&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+				&expression.StringValue{Value: "cart"}),
+			expected: `does not support the operator "ne" on "service"`,
+		},
+		{
+			name: "an attribute at the link level",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a", Level: expression.LevelLink}, &expression.AnyValue{Value: "1"}),
+			expected: `does not index the "link" level`,
+		},
+		{
+			name: "an attribute at the scope level",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a", Level: expression.LevelScope}, &expression.AnyValue{Value: "1"}),
+			expected: `does not index the "scope" level`,
+		},
+		{
+			name: "another built-in field",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind},
+				&expression.StringValue{Value: "server"}),
+			expected: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name: "a name at another level",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName},
+				&expression.StringValue{Value: "exception"}),
+			expected: `does not support the built-in field "name" of the "event" level`,
+		},
+		{
+			name: "an attribute against a list",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a"}, &expression.List{Values: []string{"1"}, Type: expression.ValueTypeString}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name: "an attribute against an integer",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a"}, &expression.IntValue{Value: 1}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name: "an attribute against a boolean",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a"}, &expression.BoolValue{Value: true}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name: "an attribute against another reference",
+			filter: call(expression.OpEq,
+				&expression.AttributeRef{Key: "a"}, &expression.AttributeRef{Key: "b"}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name: "the service against an integer",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+				&expression.IntValue{Value: 1}),
+			expected: `compares "service" against a string constant only`,
+		},
+		{
+			name: "the operation against a reference",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+				&expression.AttributeRef{Key: "b"}),
+			expected: `compares "name" against a string constant only`,
+		},
+		{
+			name:     "a duration bound against a string",
+			filter:   durationOf(&expression.StringValue{Value: "2s"}),
+			expected: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:     "a duration bound against an integer",
+			filter:   durationOf(&expression.IntValue{Value: 2}),
+			expected: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name: "a quantifier over the events",
+			filter: call(expression.OpSome,
+				&expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq,
+					&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName},
+					&expression.StringValue{Value: "exception"})),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "a constant on the left",
+			filter:   call(expression.OpEq, &expression.AnyValue{Value: "1"}, &expression.AttributeRef{Key: "a"}),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "two predicates on one attribute",
+			filter:   call(expression.OpAnd, attr("a", "1"), attr("a", "2")),
+			expected: `only one predicate on "a"`,
+		},
+		{
+			name: "two predicates on one attribute at different levels",
+			filter: call(expression.OpAnd, attr("a", "1"), call(expression.OpEq,
+				&expression.AttributeRef{Key: "a", Level: expression.LevelSpan}, &expression.AnyValue{Value: "1"})),
+			expected: `only one predicate on "a"`,
+		},
+		{
+			name:     "two predicates on the service",
+			filter:   call(expression.OpAnd, service("cart"), service("checkout")),
+			expected: `only one predicate on "service"`,
+		},
+		{
+			name:     "two predicates on the operation",
+			filter:   call(expression.OpAnd, operation("GET"), operation("POST")),
+			expected: `only one predicate on "name"`,
+		},
+		{
+			name:     "two lower duration bounds",
+			filter:   call(expression.OpAnd, bound(expression.OpGte, time.Second), bound(expression.OpGte, time.Minute)),
+			expected: `only one predicate on "duration"`,
+		},
+		{
+			name:     "two upper duration bounds",
+			filter:   call(expression.OpAnd, bound(expression.OpLte, time.Second), bound(expression.OpLte, time.Minute)),
+			expected: `only one predicate on "duration"`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			query := withFilter(tt.filter)
+			got, err := query.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, tt.expected)
+			assert.Equal(t, query, got, "the original query is returned")
+			assert.Equal(t, 0, query.Attributes.Len(), "the caller's map is not changed")
+		})
+	}
+}
