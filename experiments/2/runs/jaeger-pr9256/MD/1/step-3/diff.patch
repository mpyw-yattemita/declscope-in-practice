+func TestToLegacyShape_Converts(t *testing.T) {
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected TraceQueryParams
+	}{
+		{
+			name:     "a single predicate",
+			filter:   attr("a", "1"),
+			expected: TraceQueryParams{Attributes: attributesOf("a", "1")},
+		},
+		{
+			name: "a nested conjunction is flattened",
+			filter: call(expression.OpAnd,
+				service("cart"),
+				call(expression.OpAnd, attr("a", "1"), call(expression.OpAnd, attr("b", "2"), operation("GET")))),
+			expected: TraceQueryParams{
+				ServiceName:   "cart",
+				OperationName: "GET",
+				Attributes:    attributesOf("a", "1", "b", "2"),
+			},
+		},
+		{
+			name: "attributes at the span, resource and event levels widen to tags",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq,
+					&expression.AttributeRef{Key: "s", Level: expression.LevelSpan}, &expression.AnyValue{Value: "1"}),
+				call(expression.OpEq,
+					&expression.AttributeRef{Key: "r", Level: expression.LevelResource}, &expression.AnyValue{Value: "2"}),
+				call(expression.OpEq,
+					&expression.AttributeRef{Key: "e", Level: expression.LevelEvent}, &expression.StringValue{Value: "3"})),
+			expected: TraceQueryParams{Attributes: attributesOf("s", "1", "r", "2", "e", "3")},
+		},
+		{
+			name: "untyped constants on the service and the operation",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq,
+					&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+					&expression.AnyValue{Value: "cart"}),
+				call(expression.OpEq,
+					&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+					&expression.AnyValue{Value: "GET"})),
+			expected: TraceQueryParams{ServiceName: "cart", OperationName: "GET", Attributes: pcommon.NewMap()},
+		},
+		{
+			name:   "duration bounds are inclusive",
+			filter: call(expression.OpAnd, bound(expression.OpLte, 2*time.Second), bound(expression.OpGte, time.Second)),
+			expected: TraceQueryParams{
+				DurationMin: time.Second,
+				DurationMax: 2 * time.Second,
+				Attributes:  pcommon.NewMap(),
+			},
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			query := withFilter(tt.filter)
+			got, err := query.ToLegacyShape()
+			require.NoError(t, err)
+			assert.Equal(t, tt.expected, got)
+			assert.Equal(t, 0, query.Attributes.Len(), "the caller's map is not changed")
+		})
+	}
+}
