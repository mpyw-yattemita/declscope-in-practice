@@ -75,6 +75,18 @@ type Reader interface {
 	// summaries, and implementations may yield incrementally rather than buffering all
 	// results first.
 	FindTraceSummaries(ctx context.Context, query TraceQueryParams) iter.Seq2[[]TraceSummary, error]
+
+	// SearchCapabilities reports how this reader's search methods behave.
+	//
+	// A reader that does not support a capability leaves its field false. A
+	// reader that cannot tell, for example because its backend sits behind an
+	// API that cannot be asked, returns an error that wraps
+	// errors.ErrUnsupported, so that callers do not trust a guessed value. The
+	// answer may come over the network, which is why the method takes a
+	// context.
+	//
+	// A Reader that wraps another Reader must forward this call to it.
+	SearchCapabilities(ctx context.Context) (SearchCapabilities, error)
 }
 
