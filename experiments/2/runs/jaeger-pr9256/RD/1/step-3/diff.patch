+func TestToLegacyShape_Refuses(t *testing.T) {
+	a := eq(attr("a"), untyped("1"))
+	tests := []struct {
+		name        string
+		filter      *expression.Call
+		expectedErr string
+	}{
+		{
+			name:        "a disjunction",
+			filter:      call(expression.OpOr, a, eq(attr("b"), untyped("2"))),
+			expectedErr: `does not support the operator "or"`,
+		},
+		{
+			name:        "a negation nested in a conjunction",
+			filter:      and(a, call(expression.OpNot, eq(attr("b"), untyped("2")))),
+			expectedErr: `does not support the operator "not"`,
+		},
+		{
+			name:        "an existence check",
+			filter:      call(expression.OpExists, attr("a")),
+			expectedErr: `does not support the operator "exists"`,
+		},
+		{
+			name:        "a comparison without two arguments",
+			filter:      call(expression.OpEq, attr("a")),
+			expectedErr: `does not support the operator "eq"`,
+		},
+		{
+			name:        "an empty conjunction",
+			filter:      and(),
+			expectedErr: `does not support the operator "and"`,
+		},
+		{
+			name:        "a bare reference as a conjunct",
+			filter:      and(a, attr("b")),
+			expectedErr: "conjunction of predicates only",
+		},
+		{
+			name:        "ne on an attribute",
+			filter:      call(expression.OpNe, attr("http.method"), untyped("GET")),
+			expectedErr: `does not support the operator "ne" on "http.method"`,
+		},
+		{
+			name:        "gt on the duration",
+			filter:      call(expression.OpGt, duration(), &expression.DurationValue{Value: time.Second}),
+			expectedErr: `does not support the operator "gt" on "duration"`,
+		},
+		{
+			name:        "regex on the operation name",
+			filter:      call(expression.OpRegex, operationField(), untyped("GET.*")),
+			expectedErr: `does not support the operator "regex" on "name"`,
+		},
+		{
+			name:        "ne on the service",
+			filter:      call(expression.OpNe, serviceField(), str("cart")),
+			expectedErr: `does not support the operator "ne" on "service"`,
+		},
+		{
+			name: "membership on an attribute",
+			filter: call(expression.OpIn, attr("http.status_code"),
+				&expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			expectedErr: `does not support the operator "in" on "http.status_code"`,
+		},
+		{
+			name:        "an attribute at the link level",
+			filter:      eq(&expression.AttributeRef{Key: "a", Level: expression.LevelLink}, untyped("1")),
+			expectedErr: `does not index the "link" level`,
+		},
+		{
+			name:        "an attribute at the scope level",
+			filter:      eq(&expression.AttributeRef{Key: "a", Level: expression.LevelScope}, untyped("1")),
+			expectedErr: `does not index the "scope" level`,
+		},
+		{
+			name:        "another built-in field",
+			filter:      eq(spanKind(), str("server")),
+			expectedErr: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name: "a field of the same name at another level",
+			filter: eq(&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName},
+				str("exception")),
+			expectedErr: `does not support the built-in field "name" of the "event" level`,
+		},
+		{
+			name: "an attribute against a list",
+			filter: eq(attr("http.method"),
+				&expression.List{Values: []string{"GET"}, Type: expression.ValueTypeString}),
+			expectedErr: `compares "http.method" against a string constant only`,
+		},
+		{
+			name:        "an attribute against an integer",
+			filter:      eq(attr("http.status_code"), &expression.IntValue{Value: 500}),
+			expectedErr: `compares "http.status_code" against a string constant only`,
+		},
+		{
+			name:        "the service against a boolean",
+			filter:      eq(serviceField(), &expression.BoolValue{Value: true}),
+			expectedErr: `compares "service" against a string constant only`,
+		},
+		{
+			name:        "the operation name against another reference",
+			filter:      eq(operationField(), attr("a")),
+			expectedErr: `compares "name" against a string constant only`,
+		},
+		{
+			name:        "a duration bound against a string",
+			filter:      call(expression.OpGte, duration(), str("2s")),
+			expectedErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name:        "a duration bound against another reference",
+			filter:      call(expression.OpLte, duration(), attr("a")),
+			expectedErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name: "a quantifier over the events",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				eq(&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception"))),
+			expectedErr: "compares a reference against a constant only",
+		},
+		{
+			name:        "a constant on the left",
+			filter:      eq(untyped("1"), attr("a")),
+			expectedErr: "compares a reference against a constant only",
+		},
+		{
+			name:        "the same attribute twice",
+			filter:      and(eq(attr("a"), untyped("1")), eq(attr("a"), untyped("2"))),
+			expectedErr: `only one predicate on "a"`,
+		},
+		{
+			name: "the same attribute at two levels that widen to one tag",
+			filter: and(eq(&expression.AttributeRef{Key: "a", Level: expression.LevelSpan}, untyped("1")),
+				eq(&expression.AttributeRef{Key: "a", Level: expression.LevelResource}, untyped("1"))),
+			expectedErr: `only one predicate on "a"`,
+		},
+		{
+			name:        "the service twice",
+			filter:      and(eq(serviceField(), str("a")), eq(serviceField(), str("b"))),
+			expectedErr: `only one predicate on "service"`,
+		},
+		{
+			name:        "the operation name twice",
+			filter:      and(eq(operationField(), str("a")), and(eq(operationField(), str("b")))),
+			expectedErr: `only one predicate on "name"`,
+		},
+		{
+			name:        "the lower duration bound twice",
+			filter:      and(minDuration(time.Second), minDuration(time.Minute)),
+			expectedErr: `only one predicate on "duration"`,
+		},
+		{
+			name:        "the upper duration bound twice",
+			filter:      and(maxDuration(time.Second), maxDuration(time.Minute)),
+			expectedErr: `only one predicate on "duration"`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			query := withFilter(test.filter)
+			got, err := query.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			require.ErrorContains(t, err, test.expectedErr)
+			assert.Equal(t, query, got, "the original query is returned")
+			assert.Zero(t, query.Attributes.Len(), "the caller's map is not written")
+		})
+	}
+}
