+func TestToLegacyShape(t *testing.T) {
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected TraceQueryParams
+	}{
+		{
+			name:     "an unqualified attribute against an untyped constant",
+			filter:   eq(attr("http.method"), untyped("GET")),
+			expected: TraceQueryParams{Attributes: attributes("http.method", "GET")},
+		},
+		{
+			name: "attributes at the levels that widen to a tag",
+			filter: and(
+				eq(&expression.AttributeRef{Key: "a", Level: expression.LevelSpan}, str("1")),
+				eq(&expression.AttributeRef{Key: "b", Level: expression.LevelResource}, untyped("2")),
+				eq(&expression.AttributeRef{Key: "c", Level: expression.LevelEvent}, str("3")),
+			),
+			expected: TraceQueryParams{Attributes: attributes("a", "1", "b", "2", "c", "3")},
+		},
+		{
+			name:     "the service against an untyped constant",
+			filter:   eq(serviceField(), untyped("cart")),
+			expected: TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()},
+		},
+		{
+			name:     "the operation name against a string",
+			filter:   eq(operationField(), str("GET /cart")),
+			expected: TraceQueryParams{OperationName: "GET /cart", Attributes: pcommon.NewMap()},
+		},
+		{
+			name:   "both duration bounds",
+			filter: and(minDuration(time.Second), maxDuration(time.Minute)),
+			expected: TraceQueryParams{
+				DurationMin: time.Second, DurationMax: time.Minute, Attributes: pcommon.NewMap(),
+			},
+		},
+		{
+			name: "a nested conjunction is flattened",
+			filter: and(
+				eq(serviceField(), str("cart")),
+				and(eq(attr("a"), untyped("1")), and(minDuration(time.Second))),
+			),
+			expected: TraceQueryParams{
+				ServiceName: "cart", DurationMin: time.Second, Attributes: attributes("a", "1"),
+			},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := withFilter(test.filter).ToLegacyShape()
+			require.NoError(t, err)
+			assert.Equal(t, test.expected, got)
+		})
+	}
+}
