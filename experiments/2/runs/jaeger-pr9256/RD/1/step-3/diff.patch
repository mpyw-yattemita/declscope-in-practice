+func TestToFilterShape(t *testing.T) {
+	start := time.Unix(100, 0)
+	end := time.Unix(200, 0)
+	tests := []struct {
+		name     string
+		query    TraceQueryParams
+		expected *expression.Call
+	}{
+		{name: "nothing to convert", query: TraceQueryParams{Attributes: pcommon.NewMap()}},
+		{name: "a zero-value map", query: TraceQueryParams{}},
+		{
+			name:     "one predicate stands on its own",
+			query:    TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()},
+			expected: eq(serviceField(), str("cart")),
+		},
+		{
+			name:     "one predicate with a zero-value map",
+			query:    TraceQueryParams{DurationMax: time.Second},
+			expected: maxDuration(time.Second),
+		},
+		{
+			name: "every field, in order",
+			query: TraceQueryParams{
+				ServiceName:   "cart",
+				OperationName: "GET /cart",
+				Attributes:    attributes("http.method", "GET", "http.status_code", "500"),
+				DurationMin:   time.Second,
+				DurationMax:   2 * time.Second,
+			},
+			expected: and(
+				eq(serviceField(), str("cart")),
+				eq(operationField(), str("GET /cart")),
+				eq(attr("http.method"), untyped("GET")),
+				eq(attr("http.status_code"), untyped("500")),
+				minDuration(time.Second),
+				maxDuration(2*time.Second),
+			),
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			test.query.StartTimeMin = start
+			test.query.StartTimeMax = end
+			test.query.SearchDepth = 20
+
+			got := test.query.ToFilterShape()
+			assert.Equal(t, test.expected, got.Filter)
+			assert.Equal(t, TraceQueryParams{
+				Attributes:   pcommon.NewMap(),
+				StartTimeMin: start,
+				StartTimeMax: end,
+				SearchDepth:  20,
+				Filter:       test.expected,
+			}, got, "the converted fields are cleared and the rest is kept")
+			if got.Filter == nil {
+				return
+			}
+			require.NoError(t, expression.ValidateFilter(got.Filter))
+			resolved, err := expression.ResolveConstants(got.Filter)
+			require.NoError(t, err)
+			assert.Equal(t, got.Filter, resolved, "the result needs no further resolution")
+		})
+	}
+}
