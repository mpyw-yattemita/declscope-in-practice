+func TestForCapabilities(t *testing.T) {
+	declared := SearchCapabilities{Filter: &FilterCapabilities{
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq},
+	}}
+
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		query := TraceQueryParams{ServiceName: "cart", Attributes: attributes("a", "1")}
+		for _, caps := range []SearchCapabilities{{}, declared} {
+			got, err := query.ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Equal(t, query, got)
+		}
+	})
+
+	t.Run("no declaration rewrites into the legacy fields", func(t *testing.T) {
+		query := withFilter(and(eq(serviceField(), str("cart")), eq(attr("a"), untyped("1"))))
+		for name, caps := range map[string]SearchCapabilities{
+			"nil":   {},
+			"empty": {Filter: &FilterCapabilities{}},
+		} {
+			t.Run(name, func(t *testing.T) {
+				got, err := query.ForCapabilities(caps)
+				require.NoError(t, err)
+				want, err := query.ToLegacyShape()
+				require.NoError(t, err)
+				assert.Equal(t, want, got)
+				assert.Nil(t, got.Filter)
+				assert.Equal(t, "cart", got.ServiceName)
+			})
+		}
+	})
+
+	t.Run("no declaration refuses what the legacy fields cannot say", func(t *testing.T) {
+		query := withFilter(call(expression.OpOr, eq(attr("a"), untyped("1")), eq(attr("b"), untyped("2"))))
+		got, err := query.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("a declaration gets the filter as it is", func(t *testing.T) {
+		query := withFilter(and(eq(attr("a"), untyped("1")), eq(attr("b"), untyped("2"))))
+		got, err := query.ForCapabilities(declared)
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("a declaration refuses what it did not name", func(t *testing.T) {
+		query := withFilter(call(expression.OpNe, attr("a"), untyped("1")))
+		got, err := query.ForCapabilities(declared)
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		require.ErrorContains(t, err, `it does not support the operator "ne"`)
+		assert.Equal(t, query, got)
+	})
+}
