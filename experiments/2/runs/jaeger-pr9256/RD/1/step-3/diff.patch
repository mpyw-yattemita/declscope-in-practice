 }
+
+func TestFilterCapabilitiesEnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan, expression.LevelEvent},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpNe, expression.OpSome},
+	}
+	spanAttr := &expression.AttributeRef{Key: "http.method", Level: expression.LevelSpan}
+	tests := []struct {
+		name        string
+		filter      *expression.Call
+		expectedErr string
+	}{
+		{name: "nil filter"},
+		{
+			name:   "declared operators and levels, constants included",
+			filter: and(eq(spanAttr, &expression.IntValue{Value: 1}), eq(attr("a"), &expression.AnyValue{Value: "b"})),
+		},
+		{
+			name: "a quantifier over a declared level",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				eq(&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception"))),
+		},
+		{
+			name:        "an operator at the top",
+			filter:      call(expression.OpOr, eq(attr("a"), str("1")), eq(attr("b"), str("2"))),
+			expectedErr: `it does not support the operator "or"`,
+		},
+		{
+			name:        "an operator nested in a conjunction",
+			filter:      and(eq(attr("a"), str("1")), call(expression.OpGt, attr("b"), str("1"))),
+			expectedErr: `it does not support the operator "gt"`,
+		},
+		{
+			name:        "an attribute at an undeclared level",
+			filter:      eq(&expression.AttributeRef{Key: "a", Level: expression.LevelLink}, str("1")),
+			expectedErr: `it does not index the "link" level`,
+		},
+		{
+			name:        "a field at an undeclared level",
+			filter:      eq(serviceField(), str("cart")),
+			expectedErr: `it does not index the "resource" level`,
+		},
+		{
+			name:        "a collection at an undeclared level",
+			filter:      call(expression.OpSome, &expression.NestedRef{Level: expression.LevelScope}, eq(attr("a"), str("1"))),
+			expectedErr: `it does not index the "scope" level`,
+		},
+		{
+			name:        "a reference on the right of a comparison",
+			filter:      call(expression.OpNe, spanAttr, &expression.AttributeRef{Key: "a", Level: expression.LevelResource}),
+			expectedErr: `it does not index the "resource" level`,
+		},
+		{
+			name:        "a nested call on the right of a comparison",
+			filter:      eq(spanAttr, call(expression.OpOr)),
+			expectedErr: `it does not support the operator "or"`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := caps.EnsureSupported(test.filter)
+			if test.expectedErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, test.expectedErr)
+		})
+	}
+}
+
+func TestFilterCapabilitiesEnsureSupported_BoundsItsWalk(t *testing.T) {
+	caps := FilterCapabilities{Operators: []expression.Operator{expression.OpNot}}
+	cycle := call(expression.OpNot)
+	cycle.Args = []expression.Expression{cycle}
+	require.ErrorIs(t, caps.EnsureSupported(cycle), ErrFilterInvalid)
+	require.ErrorIs(t, caps.EnsureSupported(cycle), expression.ErrTooDeeplyNested)
+}
diff --git a/internal/storage/v2/api/tracestore/query_filter.go b/internal/storage/v2/api/tracestore/query_filter.go
new file mode 100644
index 0000000..9a7c55e
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_filter.go
@@ -0,0 +1,337 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. A reader sees one filtering
+// model, so a query mixing the two is malformed whatever the backend can do.
+//
+// The refusal wraps ErrFilterInvalid and names every conflicting field. An
+// empty Attributes map is not a predicate.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if attributeCount(q.Attributes) > 0 {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: a query with a filter cannot also set the predicate fields %v",
+		ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate.
+//
+// A query without a filter is returned unchanged. A Reader that declares no
+// filter support gets the filter rewritten into the legacy predicate fields
+// (see ToLegacyShape). Any other Reader gets the query as it is, provided it
+// declared everything the filter uses (see FilterCapabilities.EnsureSupported).
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates.
+//
+// It cannot fail, because each legacy field has an exact filter equivalent. A
+// query that already has a Filter is returned as it is. Otherwise the
+// converted fields are cleared and every other field is kept. The Filter is
+// nil when there is nothing to convert, a single predicate when there is one,
+// and an OpAnd of the predicates when there are several. The constants are
+// already typed as ResolveConstants would type them, so the result needs no
+// further resolution.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, eqCall(serviceField(), &expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, eqCall(operationField(), &expression.StringValue{Value: q.OperationName}))
+	}
+	if attributeCount(q.Attributes) > 0 {
+		q.Attributes.Range(func(key string, value pcommon.Value) bool {
+			predicates = append(predicates, eqCall(
+				&expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value.AsString()}))
+			return true
+		})
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, durationBound(expression.OpGte, q.DurationMin))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, durationBound(expression.OpLte, q.DurationMax))
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	q.Filter = conjunction(predicates)
+	return q
+}
+
+// conjunction joins predicates, with an OpAnd only when there are several.
+func conjunction(predicates []*expression.Call) *expression.Call {
+	switch len(predicates) {
+	case 0:
+		return nil
+	case 1:
+		return predicates[0]
+	}
+	args := make([]expression.Expression, len(predicates))
+	for i, predicate := range predicates {
+		args[i] = predicate
+	}
+	return &expression.Call{Op: expression.OpAnd, Args: args}
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves.
+//
+// A query without a filter is returned unchanged. Otherwise the result has a
+// nil Filter and its own Attributes map, so the caller's map is not changed.
+// Only a flat conjunction of the predicates the legacy fields can say converts;
+// anything else is refused with ErrFilterUnsupported rather than approximated,
+// because dropping or loosening a predicate would answer a different question.
+// On error the original query is returned.
+//
+// The filter is expected to be finalized (see expression.Finalize). A
+// duration bound that is still untyped, or a query that also sets the
+// predicate fields the filter replaces (see EnsureFilterStandsAlone), is
+// refused with ErrFilterInvalid.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	var predicates []*expression.Call
+	if err := flattenConjunction(q.Filter, 1, &predicates); err != nil {
+		return q, err
+	}
+	legacy := q
+	legacy.Filter = nil
+	legacy.Attributes = pcommon.NewMap()
+	written := map[legacySlot]bool{}
+	for _, predicate := range predicates {
+		slot, err := legacy.writePredicate(predicate)
+		if err != nil {
+			return q, err
+		}
+		if written[slot] {
+			return q, unsupported("it accepts only one predicate on %q", slot.name)
+		}
+		written[slot] = true
+	}
+	return legacy, nil
+}
+
+// legacySlot names the legacy field a predicate writes, so that a second
+// predicate on the same one is refused rather than overwriting the first.
+type legacySlot struct {
+	kind string // "attribute", "service", "operation", "duration_min" or "duration_max"
+	name string // what the refusal calls it
+}
+
+// flattenConjunction appends the predicates of a conjunction to out, flattening
+// nested conjunctions, and refuses anything that is not one.
+func flattenConjunction(call *expression.Call, depth int, out *[]*expression.Call) error {
+	if depth > expression.MaxNestingDepth {
+		return fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if call.Op != expression.OpAnd {
+		*out = append(*out, call)
+		return nil
+	}
+	if len(call.Args) == 0 {
+		return unsupported("it does not support the operator %q without arguments", call.Op)
+	}
+	for _, arg := range call.Args {
+		nested, ok := arg.(*expression.Call)
+		if !ok || nested == nil {
+			return unsupported("it serves a conjunction of predicates only")
+		}
+		if err := flattenConjunction(nested, depth+1, out); err != nil {
+			return err
+		}
+	}
+	return nil
+}
+
+// writePredicate writes one comparison into the legacy field that says the
+// same thing, and returns the slot it wrote.
+func (q *TraceQueryParams) writePredicate(call *expression.Call) (legacySlot, error) {
+	switch call.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return legacySlot{}, unsupported("it does not support the operator %q", call.Op)
+	}
+	if len(call.Args) != 2 {
+		return legacySlot{}, unsupported("it does not support the operator %q", call.Op)
+	}
+	switch ref := call.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return q.writeAttribute(call.Op, ref, call.Args[1])
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return q.writeField(call.Op, ref, call.Args[1])
+		}
+	}
+	return legacySlot{}, unsupported("it compares a reference against a constant only")
+}
+
+// writeAttribute writes a tag. A span-, resource- or event-level attribute
+// widens to a plain tag, which is what the legacy Attributes field searches.
+func (q *TraceQueryParams) writeAttribute(
+	op expression.Operator, ref *expression.AttributeRef, operand expression.Expression,
+) (legacySlot, error) {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+	default:
+		return legacySlot{}, unsupported("it does not index the %q level", ref.Level)
+	}
+	value, err := stringOperand(op, ref.Key, operand)
+	if err != nil {
+		return legacySlot{}, err
+	}
+	q.Attributes.PutStr(ref.Key, value)
+	return legacySlot{kind: "attribute", name: ref.Key}, nil
+}
+
+// writeField writes the service, the operation name or a duration bound, the
+// built-in fields the legacy query has a field for.
+func (q *TraceQueryParams) writeField(
+	op expression.Operator, ref *expression.FieldRef, operand expression.Expression,
+) (legacySlot, error) {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		value, err := stringOperand(op, ref.Name, operand)
+		if err != nil {
+			return legacySlot{}, err
+		}
+		q.ServiceName = value
+		return legacySlot{kind: "service", name: ref.Name}, nil
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		value, err := stringOperand(op, ref.Name, operand)
+		if err != nil {
+			return legacySlot{}, err
+		}
+		q.OperationName = value
+		return legacySlot{kind: "operation", name: ref.Name}, nil
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		return q.writeDuration(op, ref.Name, operand)
+	default:
+		return legacySlot{}, unsupported("it does not support the built-in field %q of the %q level", ref.Name, ref.Level)
+	}
+}
+
+// writeDuration writes an inclusive duration bound.
+func (q *TraceQueryParams) writeDuration(
+	op expression.Operator, name string, operand expression.Expression,
+) (legacySlot, error) {
+	if op != expression.OpGte && op != expression.OpLte {
+		return legacySlot{}, unsupported("it does not support the operator %q on %q", op, name)
+	}
+	if untyped, ok := operand.(*expression.AnyValue); ok && untyped != nil {
+		return legacySlot{}, fmt.Errorf("%w: the bound %q on %q was never read as a duration",
+			ErrFilterInvalid, untyped.Value, name)
+	}
+	constant, ok := operand.(*expression.DurationValue)
+	if !ok || constant == nil {
+		return legacySlot{}, unsupported("it compares %q against a duration such as \"2s\" only", name)
+	}
+	bound := constant.Value
+	if op == expression.OpGte {
+		q.DurationMin = bound
+		return legacySlot{kind: "duration_min", name: name}, nil
+	}
+	q.DurationMax = bound
+	return legacySlot{kind: "duration_max", name: name}, nil
+}
+
+// stringOperand returns the text of an equality against a string or untyped
+// constant, the only comparison the legacy string fields can say.
+func stringOperand(op expression.Operator, name string, operand expression.Expression) (string, error) {
+	if op != expression.OpEq {
+		return "", unsupported("it does not support the operator %q on %q", op, name)
+	}
+	switch constant := operand.(type) {
+	case *expression.StringValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	case *expression.AnyValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	}
+	return "", unsupported("it compares %q against a string constant only", name)
+}
+
+func unsupported(format string, args ...any) error {
+	return fmt.Errorf("%w: "+format, append([]any{ErrFilterUnsupported}, args...)...)
+}
+
+// attributeCount is Attributes.Len, also for a Map left at its zero value,
+// whose Len would panic.
+func attributeCount(attributes pcommon.Map) int {
+	if attributes == (pcommon.Map{}) {
+		return 0
+	}
+	return attributes.Len()
+}
+
+func eqCall(ref, constant expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpEq, Args: []expression.Expression{ref, constant}}
+}
+
+func durationBound(op expression.Operator, bound time.Duration) *expression.Call {
+	return &expression.Call{Op: op, Args: []expression.Expression{
+		&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration},
+		&expression.DurationValue{Value: bound},
+	}}
+}
+
+func serviceField() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func operationField() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
diff --git a/internal/storage/v2/api/tracestore/query_filter_test.go b/internal/storage/v2/api/tracestore/query_filter_test.go
new file mode 100644
index 0000000..199cfd9
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_filter_test.go
@@ -0,0 +1,575 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"testing"
+	"time"
+
+	"github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func and(args ...expression.Expression) *expression.Call {
+	return call(expression.OpAnd, args...)
+}
+
+func eq(ref, constant expression.Expression) *expression.Call {
+	return call(expression.OpEq, ref, constant)
+}
+
+func attr(key string) *expression.AttributeRef {
+	return &expression.AttributeRef{Key: key}
+}
+
+func str(value string) *expression.StringValue {
+	return &expression.StringValue{Value: value}
+}
+
+func untyped(value string) *expression.AnyValue {
+	return &expression.AnyValue{Value: value}
+}
+
+func duration() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+}
+
+func spanKind() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}
+}
+
+func minDuration(d time.Duration) *expression.Call {
+	return call(expression.OpGte, duration(), &expression.DurationValue{Value: d})
+}
+
+func maxDuration(d time.Duration) *expression.Call {
+	return call(expression.OpLte, duration(), &expression.DurationValue{Value: d})
+}
+
+func withFilter(filter *expression.Call) TraceQueryParams {
+	return TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}
+}
+
+func attributes(kv ...string) pcommon.Map {
+	m := pcommon.NewMap()
+	for i := 0; i < len(kv); i += 2 {
+		m.PutStr(kv[i], kv[i+1])
+	}
+	return m
+}
+
+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := eq(attr("a"), untyped("1"))
+	tests := []struct {
+		name        string
+		query       TraceQueryParams
+		expectedErr string
+	}{
+		{name: "no filter", query: TraceQueryParams{ServiceName: "cart", Attributes: attributes("a", "1")}},
+		{name: "a filter alone", query: withFilter(filter)},
+		{name: "a filter beside an empty map", query: TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}},
+		{name: "a filter beside a zero-value map", query: TraceQueryParams{Filter: filter}},
+		{
+			name:        "service name",
+			query:       TraceQueryParams{ServiceName: "cart", Filter: filter},
+			expectedErr: "[service_name]",
+		},
+		{
+			name:        "operation name",
+			query:       TraceQueryParams{OperationName: "GET", Filter: filter},
+			expectedErr: "[operation_name]",
+		},
+		{
+			name:        "duration min",
+			query:       TraceQueryParams{DurationMin: time.Second, Filter: filter},
+			expectedErr: "[duration_min]",
+		},
+		{
+			name:        "duration max",
+			query:       TraceQueryParams{DurationMax: time.Second, Filter: filter},
+			expectedErr: "[duration_max]",
+		},
+		{
+			name:        "attributes",
+			query:       TraceQueryParams{Attributes: attributes("a", "1"), Filter: filter},
+			expectedErr: "[attributes]",
+		},
+		{
+			name: "all of them, in order",
+			query: TraceQueryParams{
+				ServiceName: "cart", OperationName: "GET", DurationMin: 1, DurationMax: 2,
+				Attributes: attributes("a", "1"), Filter: filter,
+			},
+			expectedErr: "[service_name operation_name duration_min duration_max attributes]",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.query.EnsureFilterStandsAlone()
+			if test.expectedErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.ErrorContains(t, err, test.expectedErr)
+		})
+	}
+}
