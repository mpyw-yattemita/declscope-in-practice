diff --git a/internal/storage/v2/api/tracestore/filter.go b/internal/storage/v2/api/tracestore/filter.go
new file mode 100644
index 0000000..54ca126
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/filter.go
@@ -0,0 +1,427 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	"go.opentelemetry.io/collector/pdata/pcommon"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+)
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. A reader sees one filtering
+// model, so a query that mixes the two is malformed whatever the reader can do.
+//
+// The error wraps ErrFilterInvalid and names every conflicting field.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if attributeCount(q.Attributes) > 0 {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: a filter cannot be combined with the predicate fields %v", ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A Reader that declared no filter support receives
+// the filter expressed in the legacy predicate fields; one that declared some
+// receives the filter as it is, provided it declared everything the filter
+// uses. What neither model can answer is refused rather than approximated.
+//
+// The caller is expected to have checked the query with EnsureFilterStandsAlone.
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// EnsureSupported walks the filter and refuses the first predicate the Reader
+// did not declare it can evaluate: an operator it did not list, or a
+// reference to a level it does not index. Constants need no support.
+//
+// A nil filter is supported. Refusals wrap ErrFilterUnsupported.
+func (c FilterCapabilities) EnsureSupported(filter *expression.Call) error {
+	return c.ensureCallSupported(filter, 1)
+}
+
+func (c FilterCapabilities) ensureCallSupported(call *expression.Call, depth int) error {
+	if call == nil {
+		return nil
+	}
+	if depth > expression.MaxNestingDepth {
+		return fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if !c.SupportsOperator(call.Op) {
+		return errOperatorUnsupported(call.Op)
+	}
+	for _, arg := range call.Args {
+		if nested, ok := arg.(*expression.Call); ok {
+			if err := c.ensureCallSupported(nested, depth+1); err != nil {
+				return err
+			}
+			continue
+		}
+		if level, ok := referenceLevel(arg); ok && !c.SupportsLevel(level) {
+			return errLevelUnsupported(level)
+		}
+	}
+	return nil
+}
+
+// referenceLevel returns the level a reference names, and false for anything
+// that is not a reference.
+func referenceLevel(e expression.Expression) (expression.Level, bool) {
+	switch ref := e.(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.NestedRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	}
+	return "", false
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates.
+// It cannot fail, because each legacy field has an exact filter equivalent. A
+// query that already has a Filter is returned as it is.
+//
+// The predicates come in the order service, operation, attributes, minimum and
+// maximum duration, and are already in the form expression.Finalize produces.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, eqString(resourceServiceRef(), q.ServiceName))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, eqString(spanNameRef(), q.OperationName))
+	}
+	if attributeCount(q.Attributes) > 0 {
+		for key, value := range q.Attributes.All() {
+			predicates = append(predicates, &expression.Call{
+				Op:   expression.OpEq,
+				Args: []expression.Expression{&expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value.AsString()}},
+			})
+		}
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, durationBound(expression.OpGte, q.DurationMin))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, durationBound(expression.OpLte, q.DurationMax))
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	switch len(predicates) {
+	case 0:
+		q.Filter = nil
+	case 1:
+		q.Filter = predicates[0]
+	default:
+		args := make([]expression.Expression, len(predicates))
+		for i, predicate := range predicates {
+			args[i] = predicate
+		}
+		q.Filter = &expression.Call{Op: expression.OpAnd, Args: args}
+	}
+	return q
+}
+
+func resourceServiceRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func spanNameRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
+
+func eqString(ref *expression.FieldRef, value string) *expression.Call {
+	return &expression.Call{
+		Op:   expression.OpEq,
+		Args: []expression.Expression{ref, &expression.StringValue{Value: value}},
+	}
+}
+
+func durationBound(op expression.Operator, bound time.Duration) *expression.Call {
+	return &expression.Call{
+		Op: op,
+		Args: []expression.Expression{
+			&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration},
+			&expression.DurationValue{Value: bound},
+		},
+	}
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves. Only a flat conjunction of equalities on attributes, the
+// service and the operation name, and inclusive bounds on the duration
+// converts; everything else is refused with ErrFilterUnsupported rather than
+// approximated. A query without a filter is returned unchanged.
+//
+// The result has a nil Filter and a new Attributes map, so the caller's map is
+// not changed. On error the original query is returned.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	// The conversion writes the legacy fields, so a value already in one of
+	// them would be overwritten or merged with the filter's.
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	predicates, err := flattenConjunction(q.Filter, nil, 1)
+	if err != nil {
+		return q, err
+	}
+	w := legacyWriter{q: q, written: make(map[legacyTarget]bool)}
+	w.q.Filter = nil
+	w.q.Attributes = pcommon.NewMap()
+	for _, predicate := range predicates {
+		if err := w.write(predicate); err != nil {
+			return q, err
+		}
+	}
+	return w.q, nil
+}
+
+// flattenConjunction appends the conjuncts of call to predicates, descending
+// into nested conjunctions, which and's associativity makes equivalent.
+func flattenConjunction(call *expression.Call, predicates []*expression.Call, depth int) ([]*expression.Call, error) {
+	if depth > expression.MaxNestingDepth {
+		return nil, fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if call.Op != expression.OpAnd {
+		return append(predicates, call), nil
+	}
+	for _, arg := range call.Args {
+		nested, ok := arg.(*expression.Call)
+		if !ok || nested == nil {
+			return nil, fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+		}
+		var err error
+		if predicates, err = flattenConjunction(nested, predicates, depth+1); err != nil {
+			return nil, err
+		}
+	}
+	return predicates, nil
+}
+
+// legacyTarget names one legacy field a predicate writes: an attribute key, or
+// one of the scalar fields when attribute is false.
+type legacyTarget struct {
+	attribute bool
+	name      string
+}
+
+const (
+	targetDurationMin = "duration_min"
+	targetDurationMax = "duration_max"
+)
+
+// legacyWriter writes the predicates of a flat conjunction into the legacy
+// fields of q. It remembers which fields it has written, because a second
+// predicate on the same field has no legacy equivalent.
+type legacyWriter struct {
+	q       TraceQueryParams
+	written map[legacyTarget]bool
+}
+
+// claim records that target is written, and refuses a second predicate on it.
+// name is how the refusal names the field.
+func (w *legacyWriter) claim(target legacyTarget, name string) error {
+	if w.written[target] {
+		return fmt.Errorf("%w: it takes only one predicate on %q", ErrFilterUnsupported, name)
+	}
+	w.written[target] = true
+	return nil
+}
+
+func (w *legacyWriter) write(predicate *expression.Call) error {
+	switch predicate.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return errOperatorUnsupported(predicate.Op)
+	}
+	if len(predicate.Args) != 2 {
+		return errOperatorUnsupported(predicate.Op)
+	}
+	switch ref := predicate.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return w.writeAttribute(predicate.Op, ref, predicate.Args[1])
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return w.writeField(predicate.Op, ref, predicate.Args[1])
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+// writeAttribute writes an equality on an attribute as a tag. A tag matches
+// the span, its resource and its events, so an attribute qualified by any of
+// those levels widens to a plain tag.
+func (w *legacyWriter) writeAttribute(op expression.Operator, ref *expression.AttributeRef, operand expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+	default:
+		return errLevelUnsupported(ref.Level)
+	}
+	value, err := equalString(op, ref.Key, operand)
+	if err != nil {
+		return err
+	}
+	if err := w.claim(legacyTarget{attribute: true, name: ref.Key}, ref.Key); err != nil {
+		return err
+	}
+	w.q.Attributes.PutStr(ref.Key, value)
+	return nil
+}
+
+// writeField writes a predicate on one of the built-in fields that have a
+// legacy equivalent: the service, the operation name and the duration.
+func (w *legacyWriter) writeField(op expression.Operator, ref *expression.FieldRef, operand expression.Expression) error {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		return w.writeString(&w.q.ServiceName, op, ref.Name, operand)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		return w.writeString(&w.q.OperationName, op, ref.Name, operand)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		return w.writeDuration(op, operand)
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+func (w *legacyWriter) writeString(field *string, op expression.Operator, name string, operand expression.Expression) error {
+	value, err := equalString(op, name, operand)
+	if err != nil {
+		return err
+	}
+	if err := w.claim(legacyTarget{name: name}, name); err != nil {
+		return err
+	}
+	*field = value
+	return nil
+}
+
+// writeDuration writes gte and lte on the duration as the inclusive bounds
+// DurationMin and DurationMax.
+func (w *legacyWriter) writeDuration(op expression.Operator, operand expression.Expression) error {
+	var bound *time.Duration
+	var target string
+	switch op {
+	case expression.OpGte:
+		bound, target = &w.q.DurationMin, targetDurationMin
+	case expression.OpLte:
+		bound, target = &w.q.DurationMax, targetDurationMax
+	default:
+		return errOperatorOnUnsupported(op, expression.SpanFieldDuration)
+	}
+	value, err := durationConstant(operand)
+	if err != nil {
+		return err
+	}
+	if err := w.claim(legacyTarget{name: target}, expression.SpanFieldDuration); err != nil {
+		return err
+	}
+	*bound = value
+	return nil
+}
+
+// durationConstant returns the length of time a duration bound names.
+func durationConstant(operand expression.Expression) (time.Duration, error) {
+	switch constant := operand.(type) {
+	case *expression.DurationValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	case *expression.AnyValue:
+		if constant != nil {
+			// Finalizing a filter reads every constant beside the duration as
+			// a duration, so an untyped one means it was never finalized.
+			return 0, fmt.Errorf("%w: the bound %q on %q was never read as a duration",
+				ErrFilterInvalid, constant.Value, expression.SpanFieldDuration)
+		}
+	}
+	return 0, fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only",
+		ErrFilterUnsupported, expression.SpanFieldDuration)
+}
+
+// equalString returns the text of an equality against a string or untyped
+// constant, which is the only comparison a legacy string field expresses.
+func equalString(op expression.Operator, name string, operand expression.Expression) (string, error) {
+	if op != expression.OpEq {
+		return "", errOperatorOnUnsupported(op, name)
+	}
+	switch constant := operand.(type) {
+	case *expression.StringValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	case *expression.AnyValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+// attributeCount is the number of entries in m, and zero for a map left at
+// its zero value, on which pcommon.Map's own methods panic.
+func attributeCount(m pcommon.Map) int {
+	if m == (pcommon.Map{}) {
+		return 0
+	}
+	return m.Len()
+}
+
+func errOperatorUnsupported(op expression.Operator) error {
+	return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, op)
+}
+
+func errOperatorOnUnsupported(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func errLevelUnsupported(level expression.Level) error {
+	return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, level)
+}
diff --git a/internal/storage/v2/api/tracestore/filter_test.go b/internal/storage/v2/api/tracestore/filter_test.go
new file mode 100644
index 0000000..ae65451
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/filter_test.go
@@ -0,0 +1,507 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"testing"
+	"time"
+
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+)
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func tag(op expression.Operator, key, value string) *expression.Call {
+	return call(op, &expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value})
+}
+
+func serviceRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func operationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
+
+func durationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+}
+
+func str(v string) *expression.StringValue { return &expression.StringValue{Value: v} }
+
+func dur(d time.Duration) *expression.DurationValue { return &expression.DurationValue{Value: d} }
+
+func withFilter(filter *expression.Call) TraceQueryParams {
+	return TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}
+}
+
+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := tag(expression.OpEq, "http.method", "GET")
+	tests := []struct {
+		name     string
+		query    TraceQueryParams
+		expected string
+	}{
+		{name: "no filter", query: TraceQueryParams{ServiceName: "cart", DurationMin: time.Second}},
+		{name: "filter alone", query: withFilter(filter)},
+		{name: "filter with zero-value attributes", query: TraceQueryParams{Filter: filter}},
+		{name: "service name", query: TraceQueryParams{Filter: filter, ServiceName: "cart"}, expected: "[service_name]"},
+		{name: "operation name", query: TraceQueryParams{Filter: filter, OperationName: "op"}, expected: "[operation_name]"},
+		{name: "duration min", query: TraceQueryParams{Filter: filter, DurationMin: 1}, expected: "[duration_min]"},
+		{name: "duration max", query: TraceQueryParams{Filter: filter, DurationMax: 1}, expected: "[duration_max]"},
+		{
+			name: "attributes",
+			query: func() TraceQueryParams {
+				q := withFilter(filter)
+				q.Attributes.PutStr("a", "1")
+				return q
+			}(),
+			expected: "[attributes]",
+		},
+		{
+			name: "every field",
+			query: func() TraceQueryParams {
+				q := withFilter(filter)
+				q.ServiceName, q.OperationName = "cart", "op"
+				q.DurationMin, q.DurationMax = 1, 2
+				q.Attributes.PutStr("a", "1")
+				return q
+			}(),
+			expected: "[service_name operation_name duration_min duration_max attributes]",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.query.EnsureFilterStandsAlone()
+			if test.expected == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.Contains(t, err.Error(), test.expected)
+		})
+	}
+}
+
+func TestForCapabilities(t *testing.T) {
+	filter := tag(expression.OpEq, "http.method", "GET")
+
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		query := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		got, err := query.ForCapabilities(SearchCapabilities{})
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	for name, caps := range map[string]SearchCapabilities{
+		"no declaration":    {},
+		"empty declaration": {Filter: &FilterCapabilities{}},
+	} {
+		t.Run(name+" rewrites into legacy fields", func(t *testing.T) {
+			got, err := withFilter(filter).ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Nil(t, got.Filter)
+			value, ok := got.Attributes.Get("http.method")
+			require.True(t, ok)
+			assert.Equal(t, "GET", value.Str())
+		})
+	}
+
+	t.Run("empty declaration refuses what legacy cannot express", func(t *testing.T) {
+		query := withFilter(call(expression.OpOr, filter, filter))
+		got, err := query.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("declaring reader gets the filter as it is", func(t *testing.T) {
+		query := withFilter(filter)
+		got, err := query.ForCapabilities(SearchCapabilities{
+			Filter: &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}},
+		})
+		require.NoError(t, err)
+		assert.Equal(t, query, got)
+	})
+
+	t.Run("declaring reader refuses what it did not declare", func(t *testing.T) {
+		query := withFilter(filter)
+		got, err := query.ForCapabilities(SearchCapabilities{
+			Filter: &FilterCapabilities{Operators: []expression.Operator{expression.OpNe}},
+		})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Contains(t, err.Error(), `it does not support the operator "eq"`)
+		assert.Equal(t, query, got)
+	})
+}
+
+func TestEnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels: []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{
+			expression.OpAnd, expression.OpEq, expression.OpNe, expression.OpSome,
+		},
+	}
+	eventName := call(expression.OpEq,
+		&expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception"))
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string
+	}{
+		{name: "nil filter"},
+		{name: "unqualified attribute", filter: tag(expression.OpEq, "a", "1")},
+		{
+			name: "declared level and operators, nested",
+			filter: call(expression.OpAnd,
+				tag(expression.OpEq, "a", "1"),
+				call(expression.OpNe, &expression.AttributeRef{Key: "b", Level: expression.LevelSpan}, str("x")),
+				call(expression.OpEq, operationRef(), str("GET"))),
+		},
+		{name: "operator", filter: tag(expression.OpGt, "a", "1"), expected: `it does not support the operator "gt"`},
+		{
+			name:     "nested operator",
+			filter:   call(expression.OpAnd, tag(expression.OpEq, "a", "1"), call(expression.OpOr, tag(expression.OpEq, "b", "1"), tag(expression.OpEq, "c", "1"))),
+			expected: `it does not support the operator "or"`,
+		},
+		{
+			name:     "attribute level",
+			filter:   call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelLink}, str("1")),
+			expected: `it does not index the "link" level`,
+		},
+		{
+			name:     "field level",
+			filter:   call(expression.OpEq, serviceRef(), str("cart")),
+			expected: `it does not index the "resource" level`,
+		},
+		{
+			name:     "nested reference level",
+			filter:   call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent}, eventName),
+			expected: `it does not index the "event" level`,
+		},
+		{
+			name: "level on the right of a comparison",
+			filter: call(expression.OpNe,
+				&expression.AttributeRef{Key: "a", Level: expression.LevelSpan},
+				&expression.AttributeRef{Key: "a", Level: expression.LevelResource}),
+			expected: `it does not index the "resource" level`,
+		},
+		{
+			name:     "call on the right of a comparison",
+			filter:   call(expression.OpEq, &expression.AttributeRef{Key: "a"}, call(expression.OpRegex)),
+			expected: `it does not support the operator "regex"`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := caps.EnsureSupported(test.filter)
+			if test.expected == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.Contains(t, err.Error(), test.expected)
+		})
+	}
+}
