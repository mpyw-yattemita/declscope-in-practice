+func TestToLegacyShape_Refuses(t *testing.T) {
+	ok := tag(expression.OpEq, "a", "1")
+	attrAt := func(level expression.Level) *expression.AttributeRef {
+		return &expression.AttributeRef{Key: "a", Level: level}
+	}
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected string
+	}{
+		{name: "or", filter: call(expression.OpOr, ok, ok), expected: `does not support the operator "or"`},
+		{name: "not", filter: call(expression.OpNot, ok), expected: `does not support the operator "not"`},
+		{
+			name:     "exists",
+			filter:   call(expression.OpExists, &expression.AttributeRef{Key: "a"}),
+			expected: `does not support the operator "exists"`,
+		},
+		{
+			name:     "or nested in a conjunction",
+			filter:   call(expression.OpAnd, ok, call(expression.OpOr, ok, ok)),
+			expected: `does not support the operator "or"`,
+		},
+		{
+			name:     "predicate with three arguments",
+			filter:   call(expression.OpEq, &expression.AttributeRef{Key: "a"}, str("1"), str("2")),
+			expected: `does not support the operator "eq"`,
+		},
+		{
+			name:     "bare reference in a conjunction",
+			filter:   call(expression.OpAnd, ok, &expression.AttributeRef{Key: "b"}),
+			expected: "conjunction of predicates only",
+		},
+		{
+			name:     "nil call in a conjunction",
+			filter:   call(expression.OpAnd, ok, (*expression.Call)(nil)),
+			expected: "conjunction of predicates only",
+		},
+		{name: "ne on an attribute", filter: tag(expression.OpNe, "http.method", "GET"), expected: `does not support the operator "ne" on "http.method"`},
+		{
+			name:     "in on an attribute",
+			filter:   call(expression.OpIn, &expression.AttributeRef{Key: "http.status_code"}, &expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			expected: `does not support the operator "in" on "http.status_code"`,
+		},
+		{name: "gt on duration", filter: call(expression.OpGt, durationRef(), dur(time.Second)), expected: `does not support the operator "gt" on "duration"`},
+		{name: "regex on name", filter: call(expression.OpRegex, operationRef(), str("GET.*")), expected: `does not support the operator "regex" on "name"`},
+		{name: "ne on service", filter: call(expression.OpNe, serviceRef(), str("cart")), expected: `does not support the operator "ne" on "service"`},
+		{name: "link attribute", filter: call(expression.OpEq, attrAt(expression.LevelLink), str("1")), expected: `does not index the "link" level`},
+		{name: "scope attribute", filter: call(expression.OpEq, attrAt(expression.LevelScope), str("1")), expected: `does not index the "scope" level`},
+		{
+			name:     "other built-in field",
+			filter:   call(expression.OpEq, &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}, str("server")),
+			expected: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name:     "attribute against a list",
+			filter:   call(expression.OpEq, &expression.AttributeRef{Key: "a"}, &expression.List{Values: []string{"1"}}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name:     "attribute against an integer",
+			filter:   call(expression.OpEq, &expression.AttributeRef{Key: "a"}, &expression.IntValue{Value: 1}),
+			expected: `compares "a" against a string constant only`,
+		},
+		{
+			name:     "service against a boolean",
+			filter:   call(expression.OpEq, serviceRef(), &expression.BoolValue{Value: true}),
+			expected: `compares "service" against a string constant only`,
+		},
+		{
+			name:     "operation against a reference",
+			filter:   call(expression.OpEq, operationRef(), &expression.AttributeRef{Key: "b"}),
+			expected: `compares "name" against a string constant only`,
+		},
+		{
+			name:     "duration against a string",
+			filter:   call(expression.OpGte, durationRef(), str("2s")),
+			expected: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name: "quantifier over the events",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, &expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception"))),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "constant on the left",
+			filter:   call(expression.OpEq, str("1"), &expression.AttributeRef{Key: "a"}),
+			expected: "compares a reference against a constant only",
+		},
+		{
+			name:     "same attribute twice",
+			filter:   call(expression.OpAnd, ok, call(expression.OpEq, attrAt(expression.LevelSpan), str("2"))),
+			expected: `only one predicate on "a"`,
+		},
+		{
+			name:     "service twice",
+			filter:   call(expression.OpAnd, call(expression.OpEq, serviceRef(), str("a")), call(expression.OpEq, serviceRef(), str("b"))),
+			expected: `only one predicate on "service"`,
+		},
+		{
+			name:     "operation twice, the first empty",
+			filter:   call(expression.OpAnd, call(expression.OpEq, operationRef(), str("")), call(expression.OpEq, operationRef(), str("b"))),
+			expected: `only one predicate on "name"`,
+		},
+		{
+			name:     "same duration bound twice, the first zero",
+			filter:   call(expression.OpAnd, call(expression.OpGte, durationRef(), dur(0)), call(expression.OpGte, durationRef(), dur(time.Second))),
+			expected: `only one predicate on "duration"`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			query := withFilter(test.filter)
+			got, err := query.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.Contains(t, err.Error(), test.expected)
+			assert.Equal(t, query, got, "the original query is returned")
+		})
+	}
+}
