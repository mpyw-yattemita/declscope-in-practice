+func TestToFilterShape(t *testing.T) {
+	start := time.Unix(100, 0)
+	attrs := pcommon.NewMap()
+	attrs.PutStr("http.method", "GET")
+	attrs.PutInt("http.status_code", 500)
+
+	tests := []struct {
+		name     string
+		query    TraceQueryParams
+		expected *expression.Call
+	}{
+		{name: "no predicates", query: TraceQueryParams{Attributes: pcommon.NewMap()}},
+		{name: "zero-value attributes", query: TraceQueryParams{}},
+		{
+			name:     "one predicate stands on its own",
+			query:    TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()},
+			expected: call(expression.OpEq, serviceRef(), str("cart")),
+		},
+		{
+			name: "every field, in order",
+			query: TraceQueryParams{
+				ServiceName:   "cart",
+				OperationName: "GET /cart",
+				Attributes:    attrs,
+				DurationMin:   time.Second,
+				DurationMax:   2 * time.Second,
+			},
+			expected: call(expression.OpAnd,
+				call(expression.OpEq, serviceRef(), str("cart")),
+				call(expression.OpEq, operationRef(), str("GET /cart")),
+				tag(expression.OpEq, "http.method", "GET"),
+				tag(expression.OpEq, "http.status_code", "500"),
+				call(expression.OpGte, durationRef(), dur(time.Second)),
+				call(expression.OpLte, durationRef(), dur(2*time.Second))),
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			query := test.query
+			query.StartTimeMin = start
+			query.SearchDepth = 20
+			got := query.ToFilterShape()
+
+			assert.Equal(t, test.expected, got.Filter)
+			assert.Equal(t, TraceQueryParams{
+				Attributes:   pcommon.NewMap(),
+				StartTimeMin: start,
+				SearchDepth:  20,
+				Filter:       test.expected,
+			}, got)
+			if got.Filter != nil {
+				require.NoError(t, expression.ValidateFilter(got.Filter))
+				resolved, err := expression.ResolveConstants(got.Filter)
+				require.NoError(t, err)
+				assert.Equal(t, got.Filter, resolved)
+			}
+		})
+	}
+	assert.Equal(t, 2, attrs.Len(), "the caller's map is not changed")
+}
