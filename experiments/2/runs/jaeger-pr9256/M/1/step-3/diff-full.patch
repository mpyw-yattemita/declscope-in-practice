+func TestToLegacyShape_Converts(t *testing.T) {
+	query := withFilter(call(expression.OpAnd,
+		call(expression.OpAnd,
+			call(expression.OpEq, serviceRef(), &expression.AnyValue{Value: "cart"}),
+			call(expression.OpEq, operationRef(), str("GET /cart"))),
+		call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelSpan}, str("1")),
+		call(expression.OpEq, &expression.AttributeRef{Key: "b", Level: expression.LevelResource}, str("2")),
+		call(expression.OpEq, &expression.AttributeRef{Key: "c", Level: expression.LevelEvent}, str("3")),
+		tag(expression.OpEq, "d", "4"),
+		call(expression.OpLte, durationRef(), dur(time.Minute)),
+		call(expression.OpGte, durationRef(), dur(time.Second))))
+	query.SearchDepth = 10
+	callerAttrs := query.Attributes
+
+	got, err := query.ToLegacyShape()
+	require.NoError(t, err)
+
+	expectedAttrs := pcommon.NewMap()
+	for _, kv := range [][2]string{{"a", "1"}, {"b", "2"}, {"c", "3"}, {"d", "4"}} {
+		expectedAttrs.PutStr(kv[0], kv[1])
+	}
+	assert.Equal(t, TraceQueryParams{
+		ServiceName:   "cart",
+		OperationName: "GET /cart",
+		Attributes:    expectedAttrs,
+		DurationMin:   time.Second,
+		DurationMax:   time.Minute,
+		SearchDepth:   10,
+	}, got)
+	assert.Equal(t, 0, callerAttrs.Len(), "the caller's map is not changed")
+}
