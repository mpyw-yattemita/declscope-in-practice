+func (p *Provider) loadHTTPRouteRetry(ctx context.Context, retry *gatev1.HTTPRouteRetry) *dynamic.Retry {
+	// The Gateway API defaults attempts to 1.
+	// Traefik counts the initial request as an attempt, while the Gateway API only counts the retries.
+	attempts := 1
+	if retry.Attempts != nil {
+		attempts = *retry.Attempts
+	}
+
+	conf := &dynamic.Retry{
+		Attempts:            attempts + 1,
+		MaxRequestBodyBytes: new(p.RetryMaxRequestBodyBytes),
+	}
+
+	for _, code := range retry.Codes {
+		conf.Status = append(conf.Status, strconv.Itoa(int(code)))
+	}
+
+	if retry.Backoff != nil {
+		// The CRD CEL validation guarantees a valid GEP-2257 duration string.
+		if d, err := time.ParseDuration(string(*retry.Backoff)); err != nil {
+			log.Ctx(ctx).Error().Err(err).Msg("Ignoring HTTPRoute retry.backoff: invalid duration")
+		} else {
+			conf.InitialInterval = ptypes.Duration(d)
+		}
+	}
+
+	return conf
+}
