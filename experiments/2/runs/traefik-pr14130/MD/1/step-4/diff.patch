+// loadHTTPRouteRequestMirror returns nil when the mirror is invalid:
+// as per the spec, an invalid mirror is dropped without failing the request.
+func (p *Provider) loadHTTPRouteRequestMirror(ctx context.Context, gatewayName, gatewayNamespace string, listener gatewayListener, conf *dynamic.Configuration, route *gatev1.HTTPRoute, name string, filter *gatev1.HTTPRequestMirrorFilter, statusReport *statusReport) *dynamic.Middleware {
+	if filter == nil {
+		log.Ctx(ctx).Debug().Msg("Ignoring HTTPRoute RequestMirror filter: empty configuration")
+		return nil
+	}
+
+	backendRef := gatev1.HTTPBackendRef{BackendRef: gatev1.BackendRef{BackendObjectReference: filter.BackendRef}}
+	// The rule timeouts.backendRequest only applies to the rule backends, not to the mirror backends.
+	serviceName, condition := p.loadService(ctx, gatewayName, gatewayNamespace, listener, conf, name, route, 0, backendRef, nil, nil, statusReport)
+	if condition != nil {
+		log.Ctx(ctx).Debug().Msgf("Ignoring HTTPRoute RequestMirror filter: %s", condition.Message)
+		return nil
+	}
+
+	numerator, denominator := httpRouteMirrorRatio(filter)
+
+	return &dynamic.Middleware{
+		RequestMirror: &dynamic.RequestMirror{
+			Service:     serviceName,
+			Numerator:   numerator,
+			Denominator: denominator,
+		},
+	}
+}
+
+func httpRouteMirrorRatio(filter *gatev1.HTTPRequestMirrorFilter) (int64, int64) {
+	switch {
+	case filter.Percent != nil:
+		return int64(min(max(*filter.Percent, 0), 100)), 100
+
+	case filter.Fraction != nil:
+		denominator := int64(ptr.Deref(filter.Fraction.Denominator, 100))
+		if denominator <= 0 {
+			return 0, 1
+		}
+		return min(max(int64(filter.Fraction.Numerator), 0), denominator), denominator
+
+	default:
+		return 1, 1
+	}
+}
+
