+// detectClusterTrustBundles returns why ClusterTrustBundles cannot be watched, or an empty string when they can.
+func (c *clientWrapper) detectClusterTrustBundles(ctx context.Context) (string, error) {
+	groupVersion := certificatesv1.SchemeGroupVersion.String()
+	resources, err := c.csKube.Discovery().ServerResourcesForGroupVersion(groupVersion)
+	if kerror.IsNotFound(err) {
+		return msgClusterTrustBundlesNotServed, nil
+	}
+	if err != nil {
+		return "", fmt.Errorf("discovering %s resources: %w", groupVersion, err)
+	}
+
+	served := slices.ContainsFunc(resources.APIResources, func(resource metav1.APIResource) bool {
+		return resource.Name == resourceClusterTrustBundles
+	})
+	if !served {
+		return msgClusterTrustBundlesNotServed, nil
+	}
+
+	for _, verb := range []string{"list", "watch"} {
+		review := &authorizationv1.SelfSubjectAccessReview{
+			Spec: authorizationv1.SelfSubjectAccessReviewSpec{
+				ResourceAttributes: &authorizationv1.ResourceAttributes{
+					Group:    certificatesv1.GroupName,
+					Resource: resourceClusterTrustBundles,
+					Verb:     verb,
+				},
+			},
+		}
+
+		review, err = c.csKube.AuthorizationV1().SelfSubjectAccessReviews().Create(ctx, review, metav1.CreateOptions{})
+		if err != nil {
+			return "", fmt.Errorf("reviewing access to %s %s: %w", verb, resourceClusterTrustBundles, err)
+		}
+		if !review.Status.Allowed {
+			return msgClusterTrustBundlesNotPermitted, nil
+		}
+	}
+
+	return "", nil
+}
