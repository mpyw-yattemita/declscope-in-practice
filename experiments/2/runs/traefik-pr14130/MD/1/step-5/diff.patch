+// newClusterTrustBundleClientset returns a constructor of fake clientsets serving the ClusterTrustBundle API,
+// where Traefik is only allowed the given verbs on clustertrustbundles.
+func newClusterTrustBundleClientset(allowedVerbs ...string) func(objects ...runtime.Object) *kubefake.Clientset {
+	return func(objects ...runtime.Object) *kubefake.Clientset {
+		client := kubefake.NewClientset(objects...)
+		client.Resources = []*metav1.APIResourceList{{
+			GroupVersion: certificatesv1.SchemeGroupVersion.String(),
+			APIResources: []metav1.APIResource{{Name: "clustertrustbundles", Kind: kindClusterTrustBundle}},
+		}}
+		client.PrependReactor("create", "selfsubjectaccessreviews", func(action ktesting.Action) (bool, runtime.Object, error) {
+			review := action.(ktesting.CreateAction).GetObject().(*authorizationv1.SelfSubjectAccessReview).DeepCopy()
+			attributes := review.Spec.ResourceAttributes
+			review.Status.Allowed = attributes != nil &&
+				attributes.Group == groupCertificates &&
+				attributes.Resource == "clustertrustbundles" &&
+				slices.Contains(allowedVerbs, attributes.Verb)
+			return true, review, nil
+		})
+		return client
+	}
+}
