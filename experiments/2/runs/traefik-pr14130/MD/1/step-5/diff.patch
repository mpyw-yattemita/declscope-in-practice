+// resolveBackendCACertificateRef returns the CA certificate of a BackendTLSPolicy reference,
+// or the ResolvedRefs condition explaining why it cannot.
+func (p *Provider) resolveBackendCACertificateRef(namespace string, policy *gatev1.BackendTLSPolicy, ref gatev1.LocalObjectReference) (string, *metav1.Condition) {
+	errCondition := func(reason gatev1.PolicyConditionReason, message string) *metav1.Condition {
+		return &metav1.Condition{
+			Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: policy.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(reason),
+			Message:            message,
+		}
+	}
+
+	isCore := ref.Group == "" || ref.Group == groupCore
+
+	var caCRT string
+	switch {
+	case isCore && ref.Kind == kindConfigMap:
+		configmap, err := p.client.GetConfigMap(namespace, string(ref.Name))
+		if err != nil {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting configmap %s/%s: %s", namespace, string(ref.Name), err))
+		}
+		caCRT = configmap.Data["ca.crt"]
+
+	case isCore && ref.Kind == kindSecret:
+		secret, err := p.client.GetSecret(namespace, string(ref.Name))
+		if err != nil {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting secret %s/%s: %s", namespace, string(ref.Name), err))
+		}
+		caCRT = string(secret.Data["ca.crt"])
+
+	case ref.Group == groupCertificates && ref.Kind == kindClusterTrustBundle:
+		if msg := p.client.clusterTrustBundlesUnsupported; msg != "" {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidKind, msg)
+		}
+
+		bundle, err := p.client.GetClusterTrustBundle(string(ref.Name))
+		if err != nil {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("Cannot get ClusterTrustBundle %s: %s", ref.Name, err))
+		}
+		if bundle.Spec.TrustBundle == "" {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("ClusterTrustBundle %s has an empty trustBundle", ref.Name))
+		}
+		return bundle.Spec.TrustBundle, nil
+
+	default:
+		return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidKind, "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported")
+	}
+
+	if caCRT == "" {
+		return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("%s %s/%s does not have a ca.crt", ref.Kind, namespace, string(ref.Name)))
+	}
+
+	return caCRT, nil
+}
