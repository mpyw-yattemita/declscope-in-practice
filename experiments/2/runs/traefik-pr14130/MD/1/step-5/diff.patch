+// resolveClusterTrustBundleCACertificateRef resolves a reference to a cluster-scoped ClusterTrustBundle,
+// which needs no ReferenceGrant (GEP-5075).
+func (p *Provider) resolveClusterTrustBundleCACertificateRef(gateway *gatev1.Gateway, ref gatev1.ObjectReference) (string, *metav1.Condition) {
+	errCondition := func(reason gatev1.ListenerConditionReason, message string) *metav1.Condition {
+		return &metav1.Condition{
+			Type:               string(gatev1.ListenerConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: gateway.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(reason),
+			Message:            message,
+		}
+	}
+
+	if msg := p.client.clusterTrustBundlesUnsupported; msg != "" {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateKind, msg)
+	}
+
+	if ref.Namespace != nil {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateRef,
+			fmt.Sprintf("Unsupported namespace on cluster-scoped CACertificateRef: %s %s", ref.Kind, ref.Name))
+	}
+
+	bundle, err := p.client.GetClusterTrustBundle(string(ref.Name))
+	if err != nil {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateRef,
+			fmt.Sprintf("Cannot resolve ClusterTrustBundle: %s: %s", ref.Name, err))
+	}
+
+	if bundle.Spec.TrustBundle == "" {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateRef,
+			fmt.Sprintf("Cannot find trustBundle: %s %s", ref.Kind, ref.Name))
+	}
+
+	return bundle.Spec.TrustBundle, nil
+}
