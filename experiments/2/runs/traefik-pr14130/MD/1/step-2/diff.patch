+			wantCommonNames: map[string][]string{
+				"httproute-default-http-app-1-gw-default-my-gateway-ep-web-0-799bcbf0c2317c5d1c93-svc-default-whoami-0":  {"example.com"},
+				"httproute-default-http-app-1-gw-default-my-gateway-ep-web-1-6bebfd4e0e692b59df74-svc-default-whoami2-0": nil,
+			},
+			wantResolvedRefs: map[string]string{"my-gateway": string(gatev1.GatewayReasonResolvedRefs)},
+		},
+		{
+			desc:        "GRPCRoute",
+			path:        "grpcroute/with_backend_client_certificate.yml",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			wantCommonNames: map[string][]string{
+				"grpcroute-default-grpc-app-1-gw-default-my-gateway-ep-web-0-0abda411573f19f36296-svc-default-whoami-0": {"example.com"},
+			},
+			wantResolvedRefs: map[string]string{"my-gateway": string(gatev1.GatewayReasonResolvedRefs)},
+		},
+		{
+			desc:        "TLSRoute",
+			path:        "tlsroute/with_backend_client_certificate.yml",
+			entryPoints: map[string]Entrypoint{"tls": {Address: ":9001"}},
+			wantCommonNames: map[string][]string{
+				"tlsroute-default-tls-app-1-gw-default-my-gateway-ep-tls-0-5c999a999d12ac0531c5-svc-default-whoami-0": {"example.com"},
+				"deny-unknown-host": nil,
+			},
+			wantResolvedRefs: map[string]string{"my-gateway": string(gatev1.GatewayReasonResolvedRefs)},
+		},
+		{
+			desc:        "ListenerSet uses the client certificate of its parent Gateway",
+			path:        "mixed/with_listenerset_backend_client_certificate.yml",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			wantCommonNames: map[string][]string{
+				"httproute-default-http-app-1-gw-default-my-gateway-ep-web-0-799bcbf0c2317c5d1c93-svc-default-whoami-0": {"example.com"},
+			},
+			wantResolvedRefs: map[string]string{"my-gateway": string(gatev1.GatewayReasonResolvedRefs)},
+		},
