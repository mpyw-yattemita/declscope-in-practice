+func (p *Provider) resolveBackendClientCertificate(gateway *gatev1.Gateway) (*tls.Certificate, *metav1.Condition) {
+	if gateway.Spec.TLS == nil || gateway.Spec.TLS.Backend == nil || gateway.Spec.TLS.Backend.ClientCertificateRef == nil {
+		return nil, nil
+	}
+
+	ref := gateway.Spec.TLS.Backend.ClientCertificateRef
+	unresolved := func(reason gatev1.GatewayConditionReason, message string) *metav1.Condition {
+		return &metav1.Condition{
+			Type:               string(gatev1.GatewayConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: gateway.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(reason),
+			Message:            message,
+		}
+	}
+
+	group, kind := ptr.Deref(ref.Group, ""), ptr.Deref(ref.Kind, kindSecret)
+	if (group != "" && group != groupCore) || kind != kindSecret {
+		return nil, unresolved(gatev1.GatewayReasonInvalidClientCertificateRef, fmt.Sprintf("Unsupported ClientCertificateRef group/kind: %s/%s", group, kind))
+	}
+
+	refNamespace := string(ptr.Deref(ref.Namespace, gatev1.Namespace(gateway.Namespace)))
+	if err := p.isReferenceGranted(kindGateway, gateway.Namespace, groupCore, kindSecret, string(ref.Name), refNamespace); err != nil {
+		return nil, unresolved(gatev1.GatewayReasonRefNotPermitted, fmt.Sprintf("Cannot reference ClientCertificateRef %s/%s: %s", refNamespace, ref.Name, err))
+	}
+
+	cert, err := p.getTLSCert(ref.Name, refNamespace)
+	if err != nil {
+		return nil, unresolved(gatev1.GatewayReasonInvalidClientCertificateRef, fmt.Sprintf("Cannot load ClientCertificateRef %s/%s: %s", refNamespace, ref.Name, err))
+	}
+
+	return &cert.Certificate, nil
+}
