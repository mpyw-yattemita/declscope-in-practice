+// clientCertificatesCommonName returns the CommonName of the single given client certificate, empty when there is none.
+func clientCertificatesCommonName(t *testing.T, certs tls.Certificates) string {
+	t.Helper()
+
+	if len(certs) == 0 {
+		return ""
+	}
+	require.Len(t, certs, 1)
+
+	return certificateCommonName(t, certs[0].CertFile)
+}
