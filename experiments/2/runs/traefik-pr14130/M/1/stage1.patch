+func Test_makeGatewayStatus_resolvedRefs(t *testing.T) {
+	unresolvedListener := func(listenerSet *gatev1.ListenerSet) gatewayListener {
+		return gatewayListener{
+			ListenerSet: listenerSet,
+			Status: &gatev1.ListenerStatus{
+				Name: "unresolved",
+				Conditions: []metav1.Condition{{
+					Type:   string(gatev1.ListenerConditionResolvedRefs),
+					Status: metav1.ConditionFalse,
+					Reason: string(gatev1.ListenerReasonInvalidCertificateRef),
+				}},
+			},
+		}
+	}
+	clientCertCondition := &metav1.Condition{
+		Type:               string(gatev1.GatewayConditionResolvedRefs),
+		Status:             metav1.ConditionFalse,
+		ObservedGeneration: 2,
+		Reason:             string(gatev1.GatewayReasonInvalidClientCertificateRef),
+		Message:            "Cannot load ClientCertificateRef default/missing: not found",
+	}
+
+	testCases := []struct {
+		desc                string
+		listeners           []gatewayListener
+		clientCertCondition *metav1.Condition
+		expected            metav1.Condition
+	}{
+		{
+			desc:      "all references resolved",
+			listeners: []gatewayListener{{Status: &gatev1.ListenerStatus{Name: "valid"}}},
+			expected: metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionTrue,
+				ObservedGeneration: 2,
+				Reason:             string(gatev1.GatewayReasonResolvedRefs),
+				Message:            "No error found",
+			},
+		},
+		{
+			desc:      "Gateway listener with unresolved references",
+			listeners: []gatewayListener{{Status: &gatev1.ListenerStatus{Name: "valid"}}, unresolvedListener(nil)},
+			expected: metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 2,
+				Reason:             string(gatev1.GatewayReasonListenersNotResolved),
+				Message:            "At least one Listener has unresolved references",
+			},
+		},
+		{
+			desc:      "ListenerSet listener with unresolved references",
+			listeners: []gatewayListener{{Status: &gatev1.ListenerStatus{Name: "valid"}}, unresolvedListener(&gatev1.ListenerSet{})},
+			expected: metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionTrue,
+				ObservedGeneration: 2,
+				Reason:             string(gatev1.GatewayReasonResolvedRefs),
+				Message:            "No error found",
+			},
+		},
+		{
+			desc:                "unresolved client certificate takes precedence over the listeners",
+			listeners:           []gatewayListener{unresolvedListener(nil)},
+			clientCertCondition: clientCertCondition,
+			expected:            *clientCertCondition,
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			p := Provider{}
+			gateway := &gatev1.Gateway{Generation: 2}
+
+			status, _ := p.makeGatewayStatus(gateway, test.listeners, test.clientCertCondition, nil, true)
+
+			condition := meta.FindStatusCondition(status.Conditions, string(gatev1.GatewayConditionResolvedRefs))
+			require.NotNil(t, condition)
+
+			// LastTransitionTime is set with metav1.Now() and is not relevant to this test.
+			condition.LastTransitionTime = metav1.Time{}
+			assert.Equal(t, test.expected, *condition)
+
+			accepted := meta.FindStatusCondition(status.Conditions, string(gatev1.GatewayConditionAccepted))
+			require.NotNil(t, accepted)
+			assert.Equal(t, metav1.ConditionTrue, accepted.Status)
+		})
+	}
+}
