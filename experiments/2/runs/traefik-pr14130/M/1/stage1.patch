+func Test_resolveBackendClientCertificate(t *testing.T) {
+	k8sObjects, gwObjects := readResources(t, []string{"backend_client_certificate_refs.yml"})
+
+	client := newClientImpl(kubefake.NewClientset(k8sObjects...), newGatewaySimpleClientSet(t, gwObjects...))
+
+	eventCh, err := client.WatchAll(nil, make(chan struct{}))
+	require.NoError(t, err)
+
+	// just wait for the first event
+	<-eventCh
+
+	p := Provider{client: client}
+
+	testCases := []struct {
+		desc              string
+		ref               *gatev1.SecretObjectReference
+		expectedCN        string
+		expectedCondition *metav1.Condition
+	}{
+		{
+			desc: "no client certificate",
+		},
+		{
+			desc:       "Secret in the Gateway namespace",
+			ref:        &gatev1.SecretObjectReference{Name: "client-cert"},
+			expectedCN: "example.com",
+		},
+		{
+			desc: "Secret with explicit core group and kind",
+			ref: &gatev1.SecretObjectReference{
+				Group: new(gatev1.Group("core")),
+				Kind:  new(gatev1.Kind("Secret")),
+				Name:  "client-cert",
+			},
+			expectedCN: "example.com",
+		},
+		{
+			desc:       "Secret in another namespace with a ReferenceGrant",
+			ref:        &gatev1.SecretObjectReference{Name: "client-cert-granted", Namespace: new(gatev1.Namespace("other-ns"))},
+			expectedCN: "bar.example.com",
+		},
+		{
+			desc: "unsupported kind",
+			ref:  &gatev1.SecretObjectReference{Kind: new(gatev1.Kind("ConfigMap")), Name: "client-cert"},
+			expectedCondition: &metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 1,
+				Reason:             string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message:            "Unsupported ClientCertificateRef group/kind: /ConfigMap",
+			},
+		},
+		{
+			desc: "unsupported group",
+			ref:  &gatev1.SecretObjectReference{Group: new(gatev1.Group("example.com")), Name: "client-cert"},
+			expectedCondition: &metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 1,
+				Reason:             string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message:            "Unsupported ClientCertificateRef group/kind: example.com/Secret",
+			},
+		},
+		{
+			desc: "Secret in another namespace without a ReferenceGrant",
+			ref:  &gatev1.SecretObjectReference{Name: "client-cert-not-granted", Namespace: new(gatev1.Namespace("other-ns"))},
+			expectedCondition: &metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 1,
+				Reason:             string(gatev1.GatewayReasonRefNotPermitted),
+				Message:            "Cannot reference ClientCertificateRef other-ns/client-cert-not-granted: missing ReferenceGrant",
+			},
+		},
+		{
+			desc: "missing Secret",
+			ref:  &gatev1.SecretObjectReference{Name: "missing-cert"},
+			expectedCondition: &metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 1,
+				Reason:             string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message:            `Cannot load ClientCertificateRef default/missing-cert: getting secret: secret "missing-cert" not found`,
+			},
+		},
+		{
+			desc: "malformed Secret",
+			ref:  &gatev1.SecretObjectReference{Name: "malformed-cert"},
+			expectedCondition: &metav1.Condition{
+				Type:               string(gatev1.GatewayConditionResolvedRefs),
+				Status:             metav1.ConditionFalse,
+				ObservedGeneration: 1,
+				Reason:             string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message:            "Cannot load ClientCertificateRef default/malformed-cert: validating certificate: unable to parse TLS certificate: tls: failed to find any PEM data in certificate input",
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			gateway := &gatev1.Gateway{
+				ObjectMeta: metav1.ObjectMeta{Name: "my-gateway", Namespace: "default", Generation: 1},
+			}
+			if test.ref != nil {
+				gateway.Spec.TLS = &gatev1.GatewayTLSConfig{Backend: &gatev1.GatewayBackendTLS{ClientCertificateRef: test.ref}}
+			}
+
+			cert, condition := p.resolveBackendClientCertificate(gateway)
+
+			// LastTransitionTime is set with metav1.Now() and is not relevant to this test.
+			if condition != nil {
+				condition.LastTransitionTime = metav1.Time{}
+			}
+			assert.Equal(t, test.expectedCondition, condition)
+
+			if test.expectedCN == "" {
+				assert.Nil(t, cert)
