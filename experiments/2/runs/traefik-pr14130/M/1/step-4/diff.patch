+func (p *Provider) loadRequestMirror(ctx context.Context, gatewayName, gatewayNamespace string, listener gatewayListener, conf *dynamic.Configuration, route *gatev1.HTTPRoute, name string, filter *gatev1.HTTPRequestMirrorFilter, statusReport *statusReport) (*dynamic.Middleware, *metav1.Condition) {
+	backendRef := gatev1.HTTPBackendRef{
+		BackendRef: gatev1.BackendRef{BackendObjectReference: filter.BackendRef},
+	}
+
+	// The rule backendRequest timeout bounds the request to the rule backends, not to the mirror.
+	serviceName, errCondition := p.loadService(ctx, gatewayName, gatewayNamespace, listener, conf, name, route, 0, backendRef, nil, 0, statusReport)
+	if errCondition != nil {
+		return nil, errCondition
+	}
+
+	numerator, denominator := requestMirrorRatio(filter)
+
+	return &dynamic.Middleware{
+		RequestMirror: &dynamic.RequestMirror{
+			Service:     serviceName,
+			Numerator:   numerator,
+			Denominator: denominator,
+		},
+	}, nil
+}
+
+func requestMirrorRatio(filter *gatev1.HTTPRequestMirrorFilter) (int64, int64) {
+	switch {
+	case filter.Percent != nil:
+		return min(max(int64(*filter.Percent), 0), 100), 100
+
+	case filter.Fraction != nil:
+		denominator := int64(ptr.Deref(filter.Fraction.Denominator, 100))
+		if denominator <= 0 {
+			return 0, 1
+		}
+		return min(max(int64(filter.Fraction.Numerator), 0), denominator), denominator
+
+	default:
+		return 1, 1
+	}
+}
