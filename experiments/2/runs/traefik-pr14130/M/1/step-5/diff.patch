+// resolveClusterTrustBundleCACertificateRef returns the trust bundle of the referenced ClusterTrustBundle,
+// or the ResolvedRefs condition explaining why it cannot.
+// No ReferenceGrant is needed, as a ClusterTrustBundle is cluster-scoped.
+func (p *Provider) resolveClusterTrustBundleCACertificateRef(gateway *gatev1.Gateway, ref gatev1.ObjectReference) (string, *metav1.Condition) {
+	errCondition := func(reason gatev1.ListenerConditionReason, message string) *metav1.Condition {
+		return &metav1.Condition{
+			Type:               string(gatev1.ListenerConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: gateway.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(reason),
+			Message:            message,
+		}
+	}
+
+	if err := p.client.ClusterTrustBundleSupport(); err != nil {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateKind, err.Error())
+	}
+
+	if ref.Namespace != nil {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateRef, fmt.Sprintf("Unsupported namespace on cluster-scoped CACertificateRef: %s %s", ref.Kind, ref.Name))
+	}
+
+	bundle, err := p.client.GetClusterTrustBundle(string(ref.Name))
+	if err != nil {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateRef, fmt.Sprintf("Cannot resolve ClusterTrustBundle: %s: %s", ref.Name, err))
+	}
+
+	if bundle.Spec.TrustBundle == "" {
+		return "", errCondition(gatev1.ListenerReasonInvalidCACertificateRef, fmt.Sprintf("Cannot find trustBundle: ClusterTrustBundle %s", ref.Name))
+	}
+
+	return bundle.Spec.TrustBundle, nil
+}
