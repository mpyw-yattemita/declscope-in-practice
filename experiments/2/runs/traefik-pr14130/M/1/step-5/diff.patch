+				ObservedGeneration: 1,
+				Reason:             string(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef),
+				Message:            "ClusterTrustBundle ca-bundle-empty has an empty trustBundle",
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			p := Provider{client: newClusterTrustBundleClient(t, test.served, test.allowed, "frontend_validation_ca_refs.yml")}
+
+			policy := &gatev1.BackendTLSPolicy{
+				Name:       "policy",
+				Namespace:  "default",
+				Generation: 1,
+			}
+
+			caCert, errCondition := p.resolveBackendCACertificateRef("default", policy, test.ref)
+
+			// LastTransitionTime is set with metav1.Now() and is not relevant to this test.
+			if errCondition != nil {
+				errCondition.LastTransitionTime = metav1.Time{}
+			}
+
+			assert.Equal(t, test.expected, caCert)
+			assert.Equal(t, test.expectedError, errCondition)
+		})
+	}
