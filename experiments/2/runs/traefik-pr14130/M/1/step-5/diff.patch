+// clusterTrustBundleSupport returns errClusterTrustBundleNotServed or errClusterTrustBundleNotAllowed when ClusterTrustBundles cannot be watched,
+// because an informer that cannot list or watch its resource blocks the cache sync.
+// The returned error is set when the check itself fails.
+func (c *clientWrapper) clusterTrustBundleSupport(ctx context.Context) (unsupported, err error) {
+	resources, err := c.csKube.Discovery().ServerResourcesForGroupVersionWithContext(ctx, certificatesv1.SchemeGroupVersion.String())
+	if kerrors.IsNotFound(err) {
+		return errClusterTrustBundleNotServed, nil
+	}
+	if err != nil {
+		return nil, fmt.Errorf("discovering %s resources: %w", certificatesv1.SchemeGroupVersion, err)
+	}
+
+	if !slices.ContainsFunc(resources.APIResources, func(resource metav1.APIResource) bool {
+		return resource.Name == "clustertrustbundles"
+	}) {
+		return errClusterTrustBundleNotServed, nil
+	}
+
+	for _, verb := range []string{"list", "watch"} {
+		review := &authorizationv1.SelfSubjectAccessReview{
+			Spec: authorizationv1.SelfSubjectAccessReviewSpec{
+				ResourceAttributes: &authorizationv1.ResourceAttributes{
+					Group:    certificatesv1.GroupName,
+					Resource: "clustertrustbundles",
+					Verb:     verb,
+				},
+			},
+		}
+
+		review, err = c.csKube.AuthorizationV1().SelfSubjectAccessReviews().Create(ctx, review, metav1.CreateOptions{})
+		if err != nil {
+			return nil, fmt.Errorf("reviewing access to %s clustertrustbundles: %w", verb, err)
+		}
+
+		if !review.Status.Allowed {
+			return errClusterTrustBundleNotAllowed, nil
+		}
+	}
+
+	return nil, nil
+}
