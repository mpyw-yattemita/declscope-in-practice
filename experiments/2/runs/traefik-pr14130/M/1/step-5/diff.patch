+func Test_clusterTrustBundleSupport(t *testing.T) {
+	testCases := []struct {
+		desc                string
+		served              bool
+		allowed             bool
+		withoutResource     bool
+		discoveryErr        error
+		reviewErr           error
+		expectedUnsupported error
+		expectedErr         string
+	}{
+		{
+			desc:    "API served and access allowed",
+			served:  true,
+			allowed: true,
+		},
+		{
+			desc:                "API not served",
+			allowed:             true,
+			expectedUnsupported: errClusterTrustBundleNotServed,
+		},
+		{
+			desc:                "group version served without clustertrustbundles",
+			served:              true,
+			allowed:             true,
+			withoutResource:     true,
+			expectedUnsupported: errClusterTrustBundleNotServed,
+		},
+		{
+			desc:                "access not allowed",
+			served:              true,
+			expectedUnsupported: errClusterTrustBundleNotAllowed,
+		},
+		{
+			desc:         "discovery failure",
+			served:       true,
+			allowed:      true,
+			discoveryErr: errors.New("boom"),
+			expectedErr:  "discovering certificates.k8s.io/v1 resources: boom",
+		},
+		{
+			desc:        "access review failure",
+			served:      true,
+			allowed:     true,
+			reviewErr:   errors.New("boom"),
+			expectedErr: "reviewing access to list clustertrustbundles: boom",
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			kubeClient := newClusterTrustBundleClientset(test.served, test.allowed)
+			if test.withoutResource {
+				kubeClient.Resources[len(kubeClient.Resources)-1].APIResources = nil
+			}
+			if test.discoveryErr != nil {
+				kubeClient.PrependReactor("get", "resource", func(ktesting.Action) (bool, runtime.Object, error) {
+					return true, nil, test.discoveryErr
+				})
+			}
+			if test.reviewErr != nil {
+				kubeClient.PrependReactor("create", "selfsubjectaccessreviews", func(ktesting.Action) (bool, runtime.Object, error) {
+					return true, nil, test.reviewErr
+				})
+			}
+
+			client := newClientImpl(kubeClient, gatefake.NewSimpleClientset())
+
+			unsupported, err := client.clusterTrustBundleSupport(t.Context())
+			if test.expectedErr != "" {
+				require.EqualError(t, err, test.expectedErr)
+				return
+			}
+			require.NoError(t, err)
+
+			assert.Equal(t, test.expectedUnsupported, unsupported)
+		})
+	}
+}
