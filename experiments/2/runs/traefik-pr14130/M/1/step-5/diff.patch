+// resolveBackendCACertificateRef returns the CA certificate referenced by a BackendTLSPolicy,
+// or the ResolvedRefs condition explaining why it cannot.
+func (p *Provider) resolveBackendCACertificateRef(namespace string, policy *gatev1.BackendTLSPolicy, caCertRef gatev1.LocalObjectReference) (string, *metav1.Condition) {
+	errCondition := func(reason gatev1.PolicyConditionReason, message string) *metav1.Condition {
+		return &metav1.Condition{
+			Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: policy.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(reason),
+			Message:            message,
+		}
+	}
+
+	if caCertRef.Group == groupCertificates && caCertRef.Kind == kindClusterTrustBundle {
+		if err := p.client.ClusterTrustBundleSupport(); err != nil {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidKind, err.Error())
+		}
+
+		bundle, err := p.client.GetClusterTrustBundle(string(caCertRef.Name))
+		if err != nil {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("Cannot get ClusterTrustBundle %s: %s", caCertRef.Name, err))
+		}
+
+		if bundle.Spec.TrustBundle == "" {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("ClusterTrustBundle %s has an empty trustBundle", caCertRef.Name))
+		}
+
+		return bundle.Spec.TrustBundle, nil
+	}
+
+	if (caCertRef.Group != "" && caCertRef.Group != groupCore) || (caCertRef.Kind != kindConfigMap && caCertRef.Kind != kindSecret) {
+		return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidKind, "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported")
+	}
+
+	var caCRT string
+	switch caCertRef.Kind {
+	case kindConfigMap:
+		configmap, err := p.client.GetConfigMap(namespace, string(caCertRef.Name))
+		if err != nil {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting configmap %s/%s: %s", namespace, string(caCertRef.Name), err))
+		}
+		caCRT = configmap.Data["ca.crt"]
+	case kindSecret:
+		secret, err := p.client.GetSecret(namespace, string(caCertRef.Name))
+		if err != nil {
+			return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("getting secret %s/%s: %s", namespace, string(caCertRef.Name), err))
+		}
+		caCRT = string(secret.Data["ca.crt"])
+	}
+
+	if caCRT == "" {
+		return "", errCondition(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef, fmt.Sprintf("%s %s/%s does not have a ca.crt", caCertRef.Kind, namespace, string(caCertRef.Name)))
+	}
+
+	return caCRT, nil
+}
