+// detectClusterTrustBundleSupport records why ClusterTrustBundles cannot be watched, if they cannot,
+// and returns an error when this cannot be determined.
+func (c *clientWrapper) detectClusterTrustBundleSupport(ctx context.Context) error {
+	resources, err := c.csKube.Discovery().ServerResourcesForGroupVersion(certificatesv1.SchemeGroupVersion.String())
+	if kerror.IsNotFound(err) {
+		c.errClusterTrustBundles = errClusterTrustBundleAPINotServed
+		return nil
+	}
+	if err != nil {
+		return fmt.Errorf("discovering %s resources: %w", certificatesv1.SchemeGroupVersion, err)
+	}
+
+	if !slices.ContainsFunc(resources.APIResources, func(r metav1.APIResource) bool { return r.Name == resourceClusterTrustBundles }) {
+		c.errClusterTrustBundles = errClusterTrustBundleAPINotServed
+		return nil
+	}
+
+	for _, verb := range []string{"list", "watch"} {
+		review := &authorizationv1.SelfSubjectAccessReview{
+			Spec: authorizationv1.SelfSubjectAccessReviewSpec{
+				ResourceAttributes: &authorizationv1.ResourceAttributes{
+					Group:    certificatesv1.GroupName,
+					Resource: resourceClusterTrustBundles,
+					Verb:     verb,
+				},
+			},
+		}
+
+		review, err = c.csKube.AuthorizationV1().SelfSubjectAccessReviews().Create(ctx, review, metav1.CreateOptions{})
+		if err != nil {
+			return fmt.Errorf("reviewing access to %s %s: %w", verb, resourceClusterTrustBundles, err)
+		}
+
+		if !review.Status.Allowed {
+			c.errClusterTrustBundles = errClusterTrustBundleNotAllowed
+			return nil
+		}
+	}
+
