+func Test_resolveFrontendValidation_clusterTrustBundle(t *testing.T) {
+	bundles := []runtime.Object{
+		&certificatesv1.ClusterTrustBundle{
+			ObjectMeta: metav1.ObjectMeta{Name: "bundle"},
+			Spec:       certificatesv1.ClusterTrustBundleSpec{TrustBundle: "CA-bundle"},
+		},
+		&certificatesv1.ClusterTrustBundle{
+			ObjectMeta: metav1.ObjectMeta{Name: "empty-bundle"},
+		},
+	}
+
+	testCases := []struct {
+		desc         string
+		served       bool
+		allowedVerbs []string
+		ref          gatev1.ObjectReference
+		expected     frontendValidation
+	}{
+		{
+			desc:         "ClusterTrustBundle ref is resolved",
+			served:       true,
+			allowedVerbs: []string{"list", "watch"},
+			ref:          gatev1.ObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "bundle"},
+			expected: frontendValidation{
+				clientAuth: &tls.ClientAuth{
+					CAFiles:        []types.FileOrContent{"CA-bundle"},
+					ClientAuthType: tls.RequireAndVerifyClientCert,
+				},
+			},
+		},
+		{
+			desc: "API not served",
+			ref:  gatev1.ObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "bundle"},
+			expected: frontendValidation{
+				errCondition: &metav1.Condition{
+					Type:               string(gatev1.ListenerConditionResolvedRefs),
+					Status:             metav1.ConditionFalse,
+					ObservedGeneration: 1,
+					Reason:             string(gatev1.ListenerReasonInvalidCACertificateKind),
+					Message:            "ClusterTrustBundles are not supported, the cluster does not serve the certificates.k8s.io/v1 API",
+				},
+			},
+		},
+		{
+			desc:         "list and watch not allowed",
+			served:       true,
+			allowedVerbs: []string{"watch"},
+			ref:          gatev1.ObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "bundle"},
+			expected: frontendValidation{
+				errCondition: &metav1.Condition{
+					Type:               string(gatev1.ListenerConditionResolvedRefs),
+					Status:             metav1.ConditionFalse,
+					ObservedGeneration: 1,
+					Reason:             string(gatev1.ListenerReasonInvalidCACertificateKind),
+					Message:            "ClusterTrustBundles are not supported, Traefik is not allowed to list and watch clustertrustbundles",
+				},
+			},
+		},
+		{
+			desc:         "namespace set on the ref",
+			served:       true,
+			allowedVerbs: []string{"list", "watch"},
+			ref:          gatev1.ObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "bundle", Namespace: new(gatev1.Namespace("default"))},
+			expected: frontendValidation{
+				errCondition: &metav1.Condition{
+					Type:               string(gatev1.ListenerConditionResolvedRefs),
+					Status:             metav1.ConditionFalse,
+					ObservedGeneration: 1,
+					Reason:             string(gatev1.ListenerReasonInvalidCACertificateRef),
+					Message:            "Unsupported namespace on cluster-scoped CACertificateRef: ClusterTrustBundle bundle",
+				},
+			},
+		},
+		{
+			desc:         "ClusterTrustBundle not found",
+			served:       true,
+			allowedVerbs: []string{"list", "watch"},
+			ref:          gatev1.ObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "missing"},
+			expected: frontendValidation{
+				errCondition: &metav1.Condition{
+					Type:               string(gatev1.ListenerConditionResolvedRefs),
+					Status:             metav1.ConditionFalse,
+					ObservedGeneration: 1,
+					Reason:             string(gatev1.ListenerReasonInvalidCACertificateRef),
+					Message:            `Cannot resolve ClusterTrustBundle: missing: clustertrustbundle.certificates.k8s.io "missing" not found`,
+				},
+			},
+		},
+		{
+			desc:         "ClusterTrustBundle with an empty trustBundle",
+			served:       true,
+			allowedVerbs: []string{"list", "watch"},
+			ref:          gatev1.ObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "empty-bundle"},
+			expected: frontendValidation{
+				errCondition: &metav1.Condition{
+					Type:               string(gatev1.ListenerConditionResolvedRefs),
+					Status:             metav1.ConditionFalse,
+					ObservedGeneration: 1,
+					Reason:             string(gatev1.ListenerReasonInvalidCACertificateRef),
+					Message:            "Cannot find trustBundle: ClusterTrustBundle empty-bundle",
+				},
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			kubeClient := kubefake.NewClientset(bundles...)
+			if test.served {
+				kubeClient = newClusterTrustBundleClientset(test.allowedVerbs, bundles...)
+			}
+
+			client := newClientImpl(kubeClient, newGatewaySimpleClientSet(t))
+
+			_, err := client.WatchAll(nil, t.Context().Done())
+			require.NoError(t, err)
+
+			p := Provider{client: client}
+
+			gateway := &gatev1.Gateway{
+				Name:       "my-gateway",
+				Namespace:  "default",
+				Generation: 1,
+			}
+
+			got := p.resolveFrontendValidation(gateway, &gatev1.FrontendTLSValidation{
+				Mode:              gatev1.AllowValidOnly,
+				CACertificateRefs: []gatev1.ObjectReference{test.ref},
+			})
+
+			// LastTransitionTime is set with metav1.Now() and is not relevant to this test.
+			if got.errCondition != nil {
+				got.errCondition.LastTransitionTime = metav1.Time{}
+			}
+
+			assert.Equal(t, test.expected, got)
+		})
+	}
+}
