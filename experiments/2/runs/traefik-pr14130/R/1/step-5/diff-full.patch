+			rootCAs:     httpRootCAs,
+		},
+		{
+			desc:        "TLSRoute",
+			path:        "tlsroute/with_backend_tls_policy_cluster_trust_bundle.yml",
+			entryPoints: map[string]Entrypoint{"tls": {Address: ":9001"}},
+			rootCAs: func(conf *dynamic.Configuration) []types.FileOrContent {
+				var rootCAs []types.FileOrContent
+				for _, st := range conf.TCP.ServersTransports {
+					rootCAs = append(rootCAs, st.TLS.RootCAs...)
