 func createClientFromConfig(c *rest.Config, qps, burst int) (*clientWrapper, error) {
 	c.QPS = float32(qps)
 	c.Burst = burst
 
 	csGateway, err := gateclientset.NewForConfig(c)
 	if err != nil {
 		return nil, err
 	}
 
 	csKube, err := kclientset.NewForConfig(c)
