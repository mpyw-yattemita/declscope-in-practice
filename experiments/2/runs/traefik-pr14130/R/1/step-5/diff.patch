+// loadClusterTrustBundle returns the trust anchors of the named ClusterTrustBundle,
+// or the BackendTLSPolicy ResolvedRefs condition explaining why they cannot be loaded.
+func (p *Provider) loadClusterTrustBundle(policy *gatev1.BackendTLSPolicy, name string) (string, *metav1.Condition) {
+	if err := p.client.ClusterTrustBundlesUnsupported(); err != nil {
+		return "", &metav1.Condition{
+			Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: policy.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(gatev1.BackendTLSPolicyReasonInvalidKind),
+			Message:            err.Error(),
+		}
+	}
+
+	bundle, err := p.client.GetClusterTrustBundle(name)
+	if err != nil {
+		return "", &metav1.Condition{
+			Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: policy.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef),
+			Message:            fmt.Sprintf("Cannot get ClusterTrustBundle %s: %s", name, err),
+		}
+	}
+
+	if bundle.Spec.TrustBundle == "" {
+		return "", &metav1.Condition{
+			Type:               string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+			Status:             metav1.ConditionFalse,
+			ObservedGeneration: policy.Generation,
+			LastTransitionTime: metav1.Now(),
+			Reason:             string(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef),
+			Message:            fmt.Sprintf("ClusterTrustBundle %s has an empty trustBundle", name),
+		}
+	}
+
+	return bundle.Spec.TrustBundle, nil
+}
