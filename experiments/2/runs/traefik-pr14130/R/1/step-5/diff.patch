+func Test_loadBackendTLSPolicyClientConfig_caCertificateRefs(t *testing.T) {
+	kubeClient := newClusterTrustBundleClientset([]string{"list", "watch"},
+		&certificatesv1.ClusterTrustBundle{
+			ObjectMeta: metav1.ObjectMeta{Name: "bundle"},
+			Spec:       certificatesv1.ClusterTrustBundleSpec{TrustBundle: "CA-bundle"},
+		},
+		&certificatesv1.ClusterTrustBundle{
+			ObjectMeta: metav1.ObjectMeta{Name: "empty-bundle"},
+		},
+	)
+
+	client := newClientImpl(kubeClient, newGatewaySimpleClientSet(t))
+
+	_, err := client.WatchAll(nil, t.Context().Done())
+	require.NoError(t, err)
+
+	p := Provider{client: client}
+
+	testCases := []struct {
+		desc          string
+		ref           gatev1.LocalObjectReference
+		wantRootCAs   []types.FileOrContent
+		wantCondition metav1.Condition
+	}{
+		{
+			desc:        "ClusterTrustBundle",
+			ref:         gatev1.LocalObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "bundle"},
+			wantRootCAs: []types.FileOrContent{"CA-bundle"},
+			wantCondition: metav1.Condition{
+				Type:   string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status: metav1.ConditionTrue,
+				Reason: string(gatev1.BackendTLSPolicyReasonResolvedRefs),
+			},
+		},
+		{
+			desc: "ClusterTrustBundle not found",
+			ref:  gatev1.LocalObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "missing"},
+			wantCondition: metav1.Condition{
+				Type:    string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef),
+				Message: `Cannot get ClusterTrustBundle missing: clustertrustbundle.certificates.k8s.io "missing" not found`,
+			},
+		},
+		{
+			desc: "ClusterTrustBundle with an empty trustBundle",
+			ref:  gatev1.LocalObjectReference{Group: "certificates.k8s.io", Kind: "ClusterTrustBundle", Name: "empty-bundle"},
+			wantCondition: metav1.Condition{
+				Type:    string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.BackendTLSPolicyReasonInvalidCACertificateRef),
+				Message: "ClusterTrustBundle empty-bundle has an empty trustBundle",
+			},
+		},
+		{
+			desc: "ClusterTrustBundle in the core group",
+			ref:  gatev1.LocalObjectReference{Kind: "ClusterTrustBundle", Name: "bundle"},
+			wantCondition: metav1.Condition{
+				Type:    string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.BackendTLSPolicyReasonInvalidKind),
+				Message: "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported",
+			},
+		},
+		{
+			desc: "unsupported kind",
+			ref:  gatev1.LocalObjectReference{Group: "certificates.k8s.io", Kind: "CertificateSigningRequest", Name: "bundle"},
+			wantCondition: metav1.Condition{
+				Type:    string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.BackendTLSPolicyReasonInvalidKind),
+				Message: "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported",
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			policy := &gatev1.BackendTLSPolicy{
+				Spec: gatev1.BackendTLSPolicySpec{
+					Validation: gatev1.BackendTLSPolicyValidation{
+						Hostname:          "whoami",
+						CACertificateRefs: []gatev1.LocalObjectReference{test.ref},
+					},
+				},
+			}
+
+			tlsConfig, condition := p.loadBackendTLSPolicyClientConfig("default", policy)
+
+			var rootCAs []types.FileOrContent
+			if tlsConfig != nil {
+				rootCAs = tlsConfig.RootCAs
+			}
+			assert.Equal(t, test.wantRootCAs, rootCAs)
+
+			condition.LastTransitionTime = metav1.Time{}
+			assert.Equal(t, test.wantCondition, condition)
+		})
+	}
