+func Test_loadConfigurationFromGateways_BackendTLSPolicyClusterTrustBundle(t *testing.T) {
+	routes := []struct {
+		desc        string
+		path        string
+		entryPoints map[string]Entrypoint
+		rootCAs     func(conf *dynamic.Configuration) []types.FileOrContent
+	}{
+		{
+			desc:        "HTTPRoute",
+			path:        "httproute/with_backend_tls_policy_cluster_trust_bundle.yml",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			rootCAs:     httpRootCAs,
+		},
+		{
+			desc:        "GRPCRoute",
+			path:        "grpcroute/with_backend_tls_policy_cluster_trust_bundle.yml",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			rootCAs:     httpRootCAs,
+		},
+		{
+			desc:        "TLSRoute",
+			path:        "tlsroute/with_backend_tls_policy_cluster_trust_bundle.yml",
+			entryPoints: map[string]Entrypoint{"tls": {Address: ":9001"}},
+			rootCAs: func(conf *dynamic.Configuration) []types.FileOrContent {
+				var rootCAs []types.FileOrContent
+				for _, st := range conf.TCP.ServersTransports {
+					rootCAs = append(rootCAs, st.TLS.RootCAs...)
+				}
+				return rootCAs
+			},
+		},
+	}
+
+	clusterSupports := []struct {
+		desc          string
+		allowedVerbs  []string
+		served        bool
+		wantRootCAs   []types.FileOrContent
+		wantCondition metav1.Condition
+	}{
+		{
+			desc:         "supported",
+			served:       true,
+			allowedVerbs: []string{"list", "watch"},
+			wantRootCAs:  []types.FileOrContent{"CA-bundle"},
+			wantCondition: metav1.Condition{
+				Type:   string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status: metav1.ConditionTrue,
+				Reason: string(gatev1.BackendTLSPolicyReasonResolvedRefs),
+			},
+		},
+		{
+			desc: "API not served",
+			wantCondition: metav1.Condition{
+				Type:    string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.BackendTLSPolicyReasonInvalidKind),
+				Message: "ClusterTrustBundles are not supported, the cluster does not serve the certificates.k8s.io/v1 API",
+			},
+		},
+		{
+			desc:         "list and watch not allowed",
+			served:       true,
+			allowedVerbs: []string{"list"},
+			wantCondition: metav1.Condition{
+				Type:    string(gatev1.BackendTLSPolicyConditionResolvedRefs),
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.BackendTLSPolicyReasonInvalidKind),
+				Message: "ClusterTrustBundles are not supported, Traefik is not allowed to list and watch clustertrustbundles",
+			},
+		},
+	}
+
+	for _, route := range routes {
+		for _, support := range clusterSupports {
+			t.Run(route.desc+" "+support.desc, func(t *testing.T) {
+				t.Parallel()
+
+				k8sObjects, gwObjects := readResources(t, []string{"services.yml", route.path})
+
+				kubeClient := kubefake.NewClientset(k8sObjects...)
+				if support.served {
+					kubeClient = newClusterTrustBundleClientset(support.allowedVerbs, k8sObjects...)
+				}
+
+				gwClient := newGatewaySimpleClientSet(t, gwObjects...)
+				client := newClientImpl(kubeClient, gwClient)
+
+				eventCh, err := client.WatchAll(nil, make(chan struct{}))
+				require.NoError(t, err)
+
+				// just wait for the first event
+				<-eventCh
+
+				p := Provider{
+					EntryPoints: route.entryPoints,
+					client:      client,
+				}
+
+				conf, statusReport, err := p.loadConfigurationFromGateways(t.Context())
+				require.NoError(t, err)
+
+				assert.Equal(t, support.wantRootCAs, route.rootCAs(conf))
+
+				statusReport.Flush(t.Context(), client)
+
+				policy, err := gwClient.GatewayV1().BackendTLSPolicies("bar").Get(t.Context(), "policy-1", metav1.GetOptions{})
+				require.NoError(t, err)
+				require.Len(t, policy.Status.Ancestors, 1)
+
+				condition := meta.FindStatusCondition(policy.Status.Ancestors[0].Conditions, string(gatev1.BackendTLSPolicyConditionResolvedRefs))
+				require.NotNil(t, condition)
+
+				condition.LastTransitionTime = metav1.Time{}
+				assert.Equal(t, support.wantCondition, *condition)
+			})
+		}
+	}
+}
