+func Test_loadConfigurationFromGateways_BackendClientCertificate(t *testing.T) {
+	k8sObjects, gwObjects := readResources(t, []string{"services.yml", "httproute/with_backend_client_certificate.yml"})
+
+	client := newClientImpl(kubefake.NewClientset(k8sObjects...), newGatewaySimpleClientSet(t, gwObjects...))
+
+	eventCh, err := client.WatchAll(nil, make(chan struct{}))
+	require.NoError(t, err)
+
+	// just wait for the first event
+	<-eventCh
+
+	p := Provider{
+		EntryPoints: map[string]Entrypoint{
+			"web":      {Address: ":80"},
+			"web-8080": {Address: ":8080"},
+		},
+		client: client,
+	}
+
+	conf, _, err := p.loadConfigurationFromGateways(t.Context())
+	require.NoError(t, err)
+
+	// The route without a BackendTLSPolicy has no ServersTransport, and the ListenerSet route uses the certificate of its parent Gateway.
+	commonNames := make(map[string]string)
+	for name, st := range conf.HTTP.ServersTransports {
+		require.Len(t, st.Certificates, 1)
+		commonNames[name] = certificateCommonName(t, st.Certificates[0].CertFile)
+	}
+
+	assert.Equal(t, map[string]string{
+		"httproute-default-route-a-gw-default-gateway-a-ep-web-0-13967ea449601cc2a3ec-svc-default-whoami-0":                  "default-a.example.com",
+		"httproute-default-route-b-gw-default-gateway-b-ep-web-0-eb9db01f927ccd20ece7-svc-default-whoami-0":                  "default-b.example.com",
+		"httproute-default-route-listenerset-a-gw-default-gateway-a-ep-web-8080-0-172b01e693598f0fcd16-svc-default-whoami-0": "default-a.example.com",
+	}, commonNames)
+}
