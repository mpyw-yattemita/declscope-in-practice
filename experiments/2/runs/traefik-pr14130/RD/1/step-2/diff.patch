+func Test_makeGatewayStatus_resolvedRefs(t *testing.T) {
+	resolvedListener := gatewayListener{Status: &gatev1.ListenerStatus{Name: "resolved"}}
+	unresolvedListener := func(listenerSet *gatev1.ListenerSet) gatewayListener {
+		return gatewayListener{
+			ListenerSet: listenerSet,
+			Status: &gatev1.ListenerStatus{
+				Name: "unresolved",
+				Conditions: []metav1.Condition{{
+					Type:   string(gatev1.ListenerConditionResolvedRefs),
+					Status: metav1.ConditionFalse,
+					Reason: string(gatev1.ListenerReasonInvalidCertificateRef),
+				}},
+			},
+		}
+	}
+	clientCertificateCondition := &metav1.Condition{
+		Type:    string(gatev1.GatewayConditionResolvedRefs),
+		Status:  metav1.ConditionFalse,
+		Reason:  string(gatev1.GatewayReasonInvalidClientCertificateRef),
+		Message: "Cannot load ClientCertificateRef default/missing: getting secret: not found",
+	}
+
+	testCases := []struct {
+		desc                       string
+		listeners                  []gatewayListener
+		clientCertificateCondition *metav1.Condition
+		wantStatus                 metav1.ConditionStatus
+		wantReason                 gatev1.GatewayConditionReason
+		wantMessage                string
+	}{
+		{
+			desc:        "all references resolved",
+			listeners:   []gatewayListener{resolvedListener},
+			wantStatus:  metav1.ConditionTrue,
+			wantReason:  gatev1.GatewayReasonResolvedRefs,
+			wantMessage: "No error found",
+		},
+		{
+			desc:        "Gateway listener with unresolved references",
+			listeners:   []gatewayListener{resolvedListener, unresolvedListener(nil)},
+			wantStatus:  metav1.ConditionFalse,
+			wantReason:  gatev1.GatewayReasonListenersNotResolved,
+			wantMessage: "At least one Listener has unresolved references",
+		},
+		{
+			desc:        "ListenerSet listener with unresolved references",
+			listeners:   []gatewayListener{resolvedListener, unresolvedListener(&gatev1.ListenerSet{})},
+			wantStatus:  metav1.ConditionTrue,
+			wantReason:  gatev1.GatewayReasonResolvedRefs,
+			wantMessage: "No error found",
+		},
+		{
+			desc:                       "unresolved client certificate takes precedence over the listeners",
+			listeners:                  []gatewayListener{resolvedListener, unresolvedListener(nil)},
+			clientCertificateCondition: clientCertificateCondition,
+			wantStatus:                 metav1.ConditionFalse,
+			wantReason:                 gatev1.GatewayReasonInvalidClientCertificateRef,
+			wantMessage:                clientCertificateCondition.Message,
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			p := Provider{}
+			gateway := &gatev1.Gateway{ObjectMeta: metav1.ObjectMeta{Generation: 3}}
+
+			status, _ := p.makeGatewayStatus(gateway, test.listeners, test.clientCertificateCondition, nil, true)
+
+			condition := meta.FindStatusCondition(status.Conditions, string(gatev1.GatewayConditionResolvedRefs))
+			require.NotNil(t, condition)
+			assert.Equal(t, test.wantStatus, condition.Status)
+			assert.Equal(t, string(test.wantReason), condition.Reason)
+			assert.Equal(t, test.wantMessage, condition.Message)
+			if test.clientCertificateCondition == nil {
+				assert.Equal(t, int64(3), condition.ObservedGeneration)
+			}
+
+			// ResolvedRefs does not change the Accepted condition.
+			accepted := meta.FindStatusCondition(status.Conditions, string(gatev1.GatewayConditionAccepted))
+			require.NotNil(t, accepted)
+			assert.Equal(t, metav1.ConditionTrue, accepted.Status)
+		})
+	}
+}
