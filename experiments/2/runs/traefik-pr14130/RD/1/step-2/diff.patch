+func Test_loadConfigurationFromGateways_BackendClientCertificateRef(t *testing.T) {
+	testCases := []struct {
+		desc            string
+		ref             gatev1.SecretObjectReference
+		wantCertificate bool
+		wantCondition   metav1.Condition
+	}{
+		{
+			desc:            "Secret in the Gateway namespace",
+			ref:             gatev1.SecretObjectReference{Name: "client-cert"},
+			wantCertificate: true,
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionTrue,
+				Reason:  string(gatev1.GatewayReasonResolvedRefs),
+				Message: "No error found",
+			},
+		},
+		{
+			desc: "Secret with the core group and Secret kind",
+			ref: gatev1.SecretObjectReference{
+				Group: new(gatev1.Group(groupCore)),
+				Kind:  new(gatev1.Kind(kindSecret)),
+				Name:  "client-cert",
+			},
+			wantCertificate: true,
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionTrue,
+				Reason:  string(gatev1.GatewayReasonResolvedRefs),
+				Message: "No error found",
+			},
+		},
+		{
+			desc: "Secret in another namespace with a ReferenceGrant",
+			ref: gatev1.SecretObjectReference{
+				Namespace: new(gatev1.Namespace("granted")),
+				Name:      "client-cert",
+			},
+			wantCertificate: true,
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionTrue,
+				Reason:  string(gatev1.GatewayReasonResolvedRefs),
+				Message: "No error found",
+			},
+		},
+		{
+			desc: "Secret in another namespace without a ReferenceGrant",
+			ref: gatev1.SecretObjectReference{
+				Namespace: new(gatev1.Namespace("not-granted")),
+				Name:      "client-cert",
+			},
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.GatewayReasonRefNotPermitted),
+				Message: "Cannot reference ClientCertificateRef not-granted/client-cert: missing ReferenceGrant",
+			},
+		},
+		{
+			desc: "unsupported kind",
+			ref: gatev1.SecretObjectReference{
+				Kind: new(gatev1.Kind(kindConfigMap)),
+				Name: "client-cert",
+			},
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message: "Unsupported ClientCertificateRef group/kind: /ConfigMap",
+			},
+		},
+		{
+			desc: "unsupported group",
+			ref: gatev1.SecretObjectReference{
+				Group: new(gatev1.Group("example.com")),
+				Name:  "client-cert",
+			},
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message: "Unsupported ClientCertificateRef group/kind: example.com/Secret",
+			},
+		},
+		{
+			desc: "missing Secret",
+			ref:  gatev1.SecretObjectReference{Name: "missing-cert"},
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message: `Cannot load ClientCertificateRef default/missing-cert: getting secret: secret "missing-cert" not found`,
+			},
+		},
+		{
+			desc: "malformed Secret",
+			ref:  gatev1.SecretObjectReference{Name: "malformed-cert"},
+			wantCondition: metav1.Condition{
+				Status:  metav1.ConditionFalse,
+				Reason:  string(gatev1.GatewayReasonInvalidClientCertificateRef),
+				Message: "Cannot load ClientCertificateRef default/malformed-cert: getting certificate blocks: secret default/malformed-cert is missing the following TLS data entries: tls.key",
+			},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			k8sObjects, gwObjects := readResources(t, []string{"services.yml", "httproute/with_backend_client_certificate_refs.yml"})
+			gwObjects = append(gwObjects, &gatev1.Gateway{
+				ObjectMeta: metav1.ObjectMeta{Name: "my-gateway", Namespace: "default", Generation: 2},
+				Spec: gatev1.GatewaySpec{
+					GatewayClassName: "my-gateway-class",
+					TLS: &gatev1.GatewayTLSConfig{
+						Backend: &gatev1.GatewayBackendTLS{ClientCertificateRef: &test.ref},
+					},
+					Listeners: []gatev1.Listener{{Name: "web", Protocol: gatev1.HTTPProtocolType, Port: 80}},
+				},
+			})
+
+			gwClient := newGatewaySimpleClientSet(t, gwObjects...)
+			client := newClientImpl(kubefake.NewClientset(k8sObjects...), gwClient)
+
+			eventCh, err := client.WatchAll(nil, make(chan struct{}))
+			require.NoError(t, err)
+
+			// just wait for the first event
+			<-eventCh
+
+			p := Provider{
+				EntryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+				client:      client,
+			}
+
+			conf, statusReport, err := p.loadConfigurationFromGateways(t.Context())
+			require.NoError(t, err)
+
+			// The ServersTransport is still created from the BackendTLSPolicy when the reference cannot be resolved.
+			require.Len(t, conf.HTTP.ServersTransports, 1)
+			for _, st := range conf.HTTP.ServersTransports {
+				if test.wantCertificate {
+					require.Len(t, st.Certificates, 1)
+					assert.Equal(t, "default-a.example.com", certificateCommonName(t, st.Certificates[0].CertFile))
+				} else {
+					assert.Empty(t, st.Certificates)
+				}
+			}
+
+			statusReport.Flush(t.Context(), client)
+
+			gateway, err := gwClient.GatewayV1().Gateways("default").Get(t.Context(), "my-gateway", metav1.GetOptions{})
+			require.NoError(t, err)
+
+			condition := meta.FindStatusCondition(gateway.Status.Conditions, string(gatev1.GatewayConditionResolvedRefs))
+			require.NotNil(t, condition)
+			assert.Equal(t, test.wantCondition.Status, condition.Status)
+			assert.Equal(t, test.wantCondition.Reason, condition.Reason)
+			assert.Equal(t, test.wantCondition.Message, condition.Message)
+			assert.Equal(t, int64(2), condition.ObservedGeneration)
+
+			// The client certificate does not change whether the Gateway is accepted and programmed.
+			assert.True(t, meta.IsStatusConditionTrue(gateway.Status.Conditions, string(gatev1.GatewayConditionAccepted)))
+			assert.True(t, meta.IsStatusConditionTrue(gateway.Status.Conditions, string(gatev1.GatewayConditionProgrammed)))
+		})
+	}
+}
