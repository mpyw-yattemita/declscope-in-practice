+---
+kind: GatewayClass
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: my-gateway-class
+spec:
+  controllerName: traefik.io/gateway-controller
+
+---
+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: gateway-a
+  namespace: default
+spec:
+  gatewayClassName: my-gateway-class
+  allowedListeners:
+    namespaces:
+      from: Same
+  tls:
+    backend:
+      clientCertificateRef:
+        name: client-cert-a
+  listeners:
+    - name: web
+      protocol: HTTP
+      port: 80
+      allowedRoutes:
+        namespaces:
+          from: Same
+
+---
+kind: Gateway
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: gateway-b
+  namespace: default
+spec:
+  gatewayClassName: my-gateway-class
+  tls:
+    backend:
+      clientCertificateRef:
+        name: client-cert-b
+  listeners:
+    - name: web
+      protocol: HTTP
+      port: 80
+      allowedRoutes:
+        namespaces:
+          from: Same
+
+---
+kind: ListenerSet
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: listenerset-a
+  namespace: default
+spec:
+  parentRef:
+    name: gateway-a
+    kind: Gateway
+    group: gateway.networking.k8s.io
+  listeners:
+    - name: web-8080
+      protocol: HTTP
+      port: 8080
+      allowedRoutes:
+        namespaces:
+          from: Same
+
+---
+kind: HTTPRoute
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: route-a
+  namespace: default
+spec:
+  parentRefs:
+    - name: gateway-a
+      kind: Gateway
+      group: gateway.networking.k8s.io
+  hostnames:
+    - "a.example.com"
+  rules:
+    - matches:
+        - path:
+            type: PathPrefix
+            value: /
