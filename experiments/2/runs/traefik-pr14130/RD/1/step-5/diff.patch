+// checkClusterTrustBundleSupport returns why ClusterTrustBundles cannot be watched, or an empty message when they can.
+func (c *clientWrapper) checkClusterTrustBundleSupport(ctx context.Context) (string, error) {
+	resources, err := c.csKube.Discovery().ServerResourcesForGroupVersionWithContext(ctx, certificatesv1.SchemeGroupVersion.String())
+	if kerrors.IsNotFound(err) {
+		return messageClusterTrustBundleAPINotServed, nil
+	}
+	if err != nil {
+		return "", fmt.Errorf("discovering %s resources: %w", certificatesv1.SchemeGroupVersion, err)
+	}
+
+	served := slices.ContainsFunc(resources.APIResources, func(resource metav1.APIResource) bool {
+		return resource.Name == resourceClusterTrustBundles
+	})
+	if !served {
+		return messageClusterTrustBundleAPINotServed, nil
+	}
+
+	for _, verb := range []string{"list", "watch"} {
+		review := &authorizationv1.SelfSubjectAccessReview{
+			Spec: authorizationv1.SelfSubjectAccessReviewSpec{
+				ResourceAttributes: &authorizationv1.ResourceAttributes{
+					Verb:     verb,
+					Group:    certificatesv1.GroupName,
+					Resource: resourceClusterTrustBundles,
+				},
+			},
+		}
+
+		review, err = c.csKube.AuthorizationV1().SelfSubjectAccessReviews().Create(ctx, review, metav1.CreateOptions{})
+		if err != nil {
+			return "", fmt.Errorf("checking permission to %s %s: %w", verb, resourceClusterTrustBundles, err)
+		}
+
+		if !review.Status.Allowed {
+			return messageClusterTrustBundleNotAllowed, nil
+		}
+	}
+
+	return "", nil
+}
