+			expectedMessage: "ClusterTrustBundles are not supported, Traefik is not allowed to list and watch clustertrustbundles",
+		},
+	}
+
+	for _, route := range routes {
+		for _, api := range apis {
+			t.Run(route.desc+" "+api.desc, func(t *testing.T) {
+				t.Parallel()
+
+				k8sObjects, gwObjects := readResources(t, []string{"services.yml", route.path})
+
+				gwClient := newGatewaySimpleClientSet(t, gwObjects...)
+				client := newClientImpl(newKubeClientSet(t, api.api, k8sObjects...), gwClient)
+
+				eventCh, err := client.WatchAll(nil, make(chan struct{}))
+				require.NoError(t, err)
+
+				// just wait for the first event
+				<-eventCh
+
+				p := Provider{
+					EntryPoints: route.entryPoints,
+					client:      client,
+				}
+
+				conf, statusReport, err := p.loadConfigurationFromGateways(t.Context())
+				require.NoError(t, err)
+
+				statusReport.Flush(t.Context(), client)
+
+				var rootCAs []types.FileOrContent
+				for _, st := range conf.HTTP.ServersTransports {
+					rootCAs = append(rootCAs, st.RootCAs...)
+				}
+				for _, st := range conf.TCP.ServersTransports {
+					rootCAs = append(rootCAs, st.TLS.RootCAs...)
+				}
+				assert.Equal(t, api.expectedRootCAs, rootCAs)
+
+				policy, err := gwClient.GatewayV1().BackendTLSPolicies("default").Get(t.Context(), route.policyName, metav1.GetOptions{})
+				require.NoError(t, err)
+				require.Len(t, policy.Status.Ancestors, 1)
+
+				resolvedRefs := meta.FindStatusCondition(policy.Status.Ancestors[0].Conditions, string(gatev1.BackendTLSPolicyConditionResolvedRefs))
+				require.NotNil(t, resolvedRefs)
+
+				assert.Equal(t, api.expectedMessage == "", resolvedRefs.Status == metav1.ConditionTrue)
+				assert.Equal(t, string(api.expectedReason), resolvedRefs.Reason)
+				assert.Equal(t, api.expectedMessage, resolvedRefs.Message)
+			})
+		}
+	}
+}
