+func Test_buildBackendTLSPolicyClientConfig_ClusterTrustBundle(t *testing.T) {
+	k8sObjects, gwObjects := readResources(t, []string{"services.yml", "httproute/with_backend_tls_policy_cluster_trust_bundle.yml"})
+
+	providers := make(map[clusterTrustBundleAPI]Provider)
+	for _, api := range []clusterTrustBundleAPI{clusterTrustBundleAPIAllowed, clusterTrustBundleAPINotServed, clusterTrustBundleAPINotAllowed} {
+		providers[api] = Provider{client: newWatchingClient(t, api, k8sObjects, gwObjects)}
+	}
+
+	testCases := []struct {
+		desc                  string
+		clusterTrustBundleAPI clusterTrustBundleAPI
+		ref                   gatev1.LocalObjectReference
+		expectedRootCAs       []types.FileOrContent
+		expectedReason        gatev1.PolicyConditionReason
+		expectedMessage       string
+	}{
+		{
+			desc:            "valid ClusterTrustBundle",
+			ref:             gatev1.LocalObjectReference{Group: groupCertificates, Kind: kindClusterTrustBundle, Name: "my-ca-bundle"},
+			expectedRootCAs: []types.FileOrContent{"CTB1"},
+			expectedReason:  gatev1.BackendTLSPolicyReasonResolvedRefs,
+		},
+		{
+			desc:                  "API not served",
+			clusterTrustBundleAPI: clusterTrustBundleAPINotServed,
+			ref:                   gatev1.LocalObjectReference{Group: groupCertificates, Kind: kindClusterTrustBundle, Name: "my-ca-bundle"},
+			expectedReason:        gatev1.BackendTLSPolicyReasonInvalidKind,
+			expectedMessage:       "ClusterTrustBundles are not supported, the cluster does not serve the certificates.k8s.io/v1 API",
+		},
+		{
+			desc:                  "API not allowed",
+			clusterTrustBundleAPI: clusterTrustBundleAPINotAllowed,
+			ref:                   gatev1.LocalObjectReference{Group: groupCertificates, Kind: kindClusterTrustBundle, Name: "my-ca-bundle"},
+			expectedReason:        gatev1.BackendTLSPolicyReasonInvalidKind,
+			expectedMessage:       "ClusterTrustBundles are not supported, Traefik is not allowed to list and watch clustertrustbundles",
+		},
+		{
+			desc:            "ClusterTrustBundle not found",
+			ref:             gatev1.LocalObjectReference{Group: groupCertificates, Kind: kindClusterTrustBundle, Name: "does-not-exist"},
+			expectedReason:  gatev1.BackendTLSPolicyReasonInvalidCACertificateRef,
+			expectedMessage: `Cannot get ClusterTrustBundle does-not-exist: clustertrustbundle.certificates.k8s.io "does-not-exist" not found`,
+		},
+		{
+			desc:            "ClusterTrustBundle with an empty trustBundle",
+			ref:             gatev1.LocalObjectReference{Group: groupCertificates, Kind: kindClusterTrustBundle, Name: "empty-ca-bundle"},
+			expectedReason:  gatev1.BackendTLSPolicyReasonInvalidCACertificateRef,
+			expectedMessage: "ClusterTrustBundle empty-ca-bundle has an empty trustBundle",
+		},
+		{
+			desc:            "ClusterTrustBundle kind in the core group",
+			ref:             gatev1.LocalObjectReference{Kind: kindClusterTrustBundle, Name: "my-ca-bundle"},
+			expectedReason:  gatev1.BackendTLSPolicyReasonInvalidKind,
+			expectedMessage: "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported",
+		},
+		{
+			desc:            "ConfigMap kind in the certificates group",
+			ref:             gatev1.LocalObjectReference{Group: groupCertificates, Kind: kindConfigMap, Name: "my-ca-bundle"},
+			expectedReason:  gatev1.BackendTLSPolicyReasonInvalidKind,
+			expectedMessage: "Only ConfigMaps, Secrets, and ClusterTrustBundles are supported",
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			policy := &gatev1.BackendTLSPolicy{
+				ObjectMeta: metav1.ObjectMeta{Name: "policy", Namespace: "default", Generation: 1},
+				Spec: gatev1.BackendTLSPolicySpec{
+					Validation: gatev1.BackendTLSPolicyValidation{
+						CACertificateRefs: []gatev1.LocalObjectReference{test.ref},
+						Hostname:          "whoami",
+					},
+				},
+			}
+
+			p := providers[test.clusterTrustBundleAPI]
+			clientConfig, condition := p.buildBackendTLSPolicyClientConfig("default", policy)
+
+			if test.expectedMessage == "" {
+				require.NotNil(t, clientConfig)
+				assert.Equal(t, test.expectedRootCAs, clientConfig.RootCAs)
+				assert.Equal(t, metav1.ConditionTrue, condition.Status)
+			} else {
+				assert.Nil(t, clientConfig)
+				assert.Equal(t, metav1.ConditionFalse, condition.Status)
+			}
+
+			assert.Equal(t, string(gatev1.BackendTLSPolicyConditionResolvedRefs), condition.Type)
+			assert.Equal(t, string(test.expectedReason), condition.Reason)
+			assert.Equal(t, test.expectedMessage, condition.Message)
+		})
+	}
+}
