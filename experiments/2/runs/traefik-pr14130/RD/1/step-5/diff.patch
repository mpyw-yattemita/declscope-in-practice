+func Test_checkClusterTrustBundleSupport(t *testing.T) {
+	servedResources := []*metav1.APIResourceList{{
+		GroupVersion: "certificates.k8s.io/v1",
+		APIResources: []metav1.APIResource{{Name: "clustertrustbundles"}},
+	}}
+
+	testCases := []struct {
+		desc            string
+		resources       []*metav1.APIResourceList
+		discoveryErr    error
+		allowedVerbs    []string
+		reviewErr       error
+		expectedMessage string
+		expectedErr     string
+	}{
+		{
+			desc:         "API served and list and watch allowed",
+			resources:    servedResources,
+			allowedVerbs: []string{"list", "watch"},
+		},
+		{
+			desc:            "group version not served",
+			expectedMessage: messageClusterTrustBundleAPINotServed,
+		},
+		{
+			desc: "group version served without clustertrustbundles",
+			resources: []*metav1.APIResourceList{{
+				GroupVersion: "certificates.k8s.io/v1",
+				APIResources: []metav1.APIResource{{Name: "certificatesigningrequests"}},
+			}},
+			allowedVerbs:    []string{"list", "watch"},
+			expectedMessage: messageClusterTrustBundleAPINotServed,
+		},
+		{
+			desc:            "watch not allowed",
+			resources:       servedResources,
+			allowedVerbs:    []string{"list"},
+			expectedMessage: messageClusterTrustBundleNotAllowed,
+		},
+		{
+			desc:            "list not allowed",
+			resources:       servedResources,
+			allowedVerbs:    []string{"watch"},
+			expectedMessage: messageClusterTrustBundleNotAllowed,
+		},
+		{
+			desc:         "discovery error",
+			discoveryErr: errors.New("boom"),
+			expectedErr:  "discovering certificates.k8s.io/v1 resources: boom",
+		},
+		{
+			desc:        "review error",
+			resources:   servedResources,
+			reviewErr:   errors.New("boom"),
+			expectedErr: "checking permission to list clustertrustbundles: boom",
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			kubeClient := kubefake.NewClientset()
+			kubeClient.Resources = test.resources
+
+			if test.discoveryErr != nil {
+				kubeClient.PrependReactor("get", "resource", func(ktesting.Action) (bool, runtime.Object, error) {
+					return true, nil, test.discoveryErr
+				})
+			}
+
+			kubeClient.PrependReactor("create", "selfsubjectaccessreviews", func(action ktesting.Action) (bool, runtime.Object, error) {
+				if test.reviewErr != nil {
+					return true, nil, test.reviewErr
+				}
+
+				review := action.(ktesting.CreateAction).GetObject().(*authorizationv1.SelfSubjectAccessReview).DeepCopy()
+				attributes := review.Spec.ResourceAttributes
+				review.Status.Allowed = attributes.Group == "certificates.k8s.io" && attributes.Resource == "clustertrustbundles" &&
+					slices.Contains(test.allowedVerbs, attributes.Verb)
+
+				return true, review, nil
+			})
+
+			client := newClientImpl(kubeClient, nil)
+
+			message, err := client.checkClusterTrustBundleSupport(t.Context())
+			if test.expectedErr != "" {
+				require.EqualError(t, err, test.expectedErr)
+				return
+			}
+
+			require.NoError(t, err)
+			assert.Equal(t, test.expectedMessage, message)
+		})
+	}
