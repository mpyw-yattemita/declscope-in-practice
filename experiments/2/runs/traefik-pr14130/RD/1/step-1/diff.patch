+        backendRequest: 5s
+      backendRefs:
+        - name: whoami
+          port: 80
+          weight: 1
+          kind: Service
+          group: ""
+        - name: whoami2
+          port: 8080
+          weight: 1
+          kind: Service
+          group: ""
+    - matches:
+        - path:
+            type: Exact
+            value: /baz
+      timeouts:
+        backendRequest: 0s
+      backendRefs:
+        - name: whoami
+          port: 80
+          weight: 1
+          kind: Service
+          group: ""
+
+---
+kind: BackendTLSPolicy
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: policy-1
+  namespace: default
+spec:
+  targetRefs:
+    - group: core
+      kind: Service
+      name: whoami2
+  validation:
+    hostname: whoami2
+    wellKnownCACertificates: System
