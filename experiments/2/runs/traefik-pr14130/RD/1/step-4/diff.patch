+---
+kind: HTTPRoute
+apiVersion: gateway.networking.k8s.io/v1
+metadata:
+  name: http-app-1
+  namespace: default
+spec:
+  parentRefs:
+    - name: my-gateway
+      kind: Gateway
+      group: gateway.networking.k8s.io
+  hostnames:
+    - "foo.com"
+  rules:
+    - matches:
+        - path:
+            type: PathPrefix
+            value: /bar
+      timeouts:
+        backendRequest: 5s
+      filters:
+        - type: RequestHeaderModifier
+          requestHeaderModifier:
+            set:
+              - name: X-Foo
+                value: Bar
+        - type: RequestMirror
+          requestMirror:
+            backendRef:
+              name: whoami2
+              port: 8080
+        - type: ResponseHeaderModifier
+          responseHeaderModifier:
+            set:
+              - name: X-Bar
+                value: Foo
+        - type: RequestMirror
+          requestMirror:
+            backendRef:
+              name: whoami
+              port: 8000
+            percent: 25
+      backendRefs:
+        - name: whoami
+          port: 80
+          weight: 1
+          kind: Service
+          group: ""
+          filters:
+            - type: RequestMirror
+              requestMirror:
+                backendRef:
+                  name: whoami2
+                  port: 8080
+                fraction:
+                  numerator: 1
+                  denominator: 4
