@@ -323,3 +323,89 @@ func Test_createCORS(t *testing.T) {
 		})
 	}
 }
+
+func Test_httpRouteMirrorFraction(t *testing.T) {
+	testCases := []struct {
+		desc                string
+		filter              *gatev1.HTTPRequestMirrorFilter
+		expectedNumerator   int64
+		expectedDenominator int64
+	}{
+		{
+			desc:                "Neither percent nor fraction",
+			filter:              &gatev1.HTTPRequestMirrorFilter{},
+			expectedNumerator:   1,
+			expectedDenominator: 1,
+		},
+		{
+			desc:                "Percent",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Percent: new(int32(25))},
+			expectedNumerator:   25,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "Percent zero",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Percent: new(int32(0))},
+			expectedNumerator:   0,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "Percent above 100",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Percent: new(int32(150))},
+			expectedNumerator:   100,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "Percent below 0",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Percent: new(int32(-10))},
+			expectedNumerator:   0,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "Fraction",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 1, Denominator: new(int32(4))}},
+			expectedNumerator:   1,
+			expectedDenominator: 4,
+		},
+		{
+			desc:                "Fraction without denominator",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 30}},
+			expectedNumerator:   30,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "Fraction with zero denominator",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 1, Denominator: new(int32(0))}},
+			expectedNumerator:   0,
+			expectedDenominator: 1,
+		},
+		{
+			desc:                "Fraction with negative denominator",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 1, Denominator: new(int32(-2))}},
+			expectedNumerator:   0,
+			expectedDenominator: 1,
+		},
+		{
+			desc:                "Fraction with numerator above denominator",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 3, Denominator: new(int32(2))}},
+			expectedNumerator:   2,
+			expectedDenominator: 2,
+		},
+		{
+			desc:                "Fraction with negative numerator",
+			filter:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: -1, Denominator: new(int32(2))}},
+			expectedNumerator:   0,
+			expectedDenominator: 2,
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			numerator, denominator := httpRouteMirrorFraction(test.filter)
+			assert.Equal(t, test.expectedNumerator, numerator)
+			assert.Equal(t, test.expectedDenominator, denominator)
+		})
+	}
+}
