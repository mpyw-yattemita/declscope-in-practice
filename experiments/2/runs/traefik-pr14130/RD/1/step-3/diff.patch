+// buildHTTPRouteRetry returns the Retry middleware configuration for the retry of an HTTPRoute rule.
+func (p *Provider) buildHTTPRouteRetry(ctx context.Context, routeRetry *gatev1.HTTPRouteRetry) *dynamic.Retry {
+	retry := &dynamic.Retry{
+		// Traefik counts the initial request as an attempt, and the Gateway API does not.
+		// An unset attempts takes the Gateway API default of 1.
+		Attempts:            ptr.Deref(routeRetry.Attempts, 1) + 1,
+		MaxRequestBodyBytes: new(p.RetryMaxRequestBodyBytes),
+	}
+
+	for _, code := range routeRetry.Codes {
+		retry.Status = append(retry.Status, strconv.Itoa(int(code)))
+	}
+
+	if routeRetry.Backoff != nil {
+		// The CRD CEL validation guarantees a valid GEP-2257 duration string.
+		if d, err := time.ParseDuration(string(*routeRetry.Backoff)); err != nil {
+			log.Ctx(ctx).Error().Err(err).Msg("Ignoring HTTPRoute retry.backoff: invalid duration")
+		} else {
+			retry.InitialInterval = ptypes.Duration(d)
+		}
+	}
+
+	return retry
+}
