+
+package hclwrite
+
+import (
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/hcl/v2"
+	"github.com/zclconf/go-cty/cty"
+)
+
+func TestParseExpression(t *testing.T) {
+	type kind int
+	const (
+		kindOther kind = iota
+		kindObject
+		kindCall
+		kindTuple
+	)
+	tests := []struct {
+		src  string
+		kind kind
+	}{
+		// Literals
+		{`1`, kindOther},
+		{`true`, kindOther},
+		{`null`, kindOther},
+		{`"hello"`, kindOther},
+
+		// Templates
+		{`"hello ${name}"`, kindOther},
+		{`"%{ if x }yes%{ else }no%{ endif }"`, kindOther},
+
+		// Traversals and other expressions kept as tokens
+		{`foo`, kindOther},
+		{`foo.bar[0].baz`, kindOther},
+		{`a + b * c`, kindOther},
+		{`x ? y : z`, kindOther},
+		{`[for v in vs : v]`, kindOther},
+		{`f(1)[0]`, kindOther},
+
+		// Object-construct expressions with different kinds of keys
+		{`{}`, kindObject},
+		{`{ hat = "derby" }`, kindObject},
+		{`{ "quoted" = 1 }`, kindObject},
+		{`{ (var.key) = 1 }`, kindObject},
+		{`{ "${prefix}-key" = 1 }`, kindObject},
+		{`{ a.b = 1 }`, kindObject},
+		{`{ hat: "derby", "shoe": "boot" }`, kindObject},
+		{"{\n  a = 1\n  b = 2\n}", kindObject},
+
+		// Nested objects
+		{`{ outer = { inner = { leaf = true } } }`, kindObject},
+		{"{\n  a = {\n    b = [1, { c = f(d) }]\n  }\n}", kindObject},
+
+		// Function calls
+		{`f()`, kindCall},
+		{`f(1, "two", three)`, kindCall},
+		{`f(xs...)`, kindCall},
+		{`provider::ns::fn(1)`, kindCall},
+		{`f(g(1), { a = 1 })`, kindCall},
+
+		// Tuples
+		{`[]`, kindTuple},
+		{`[1, "two", three]`, kindTuple},
+		{"[\n  1,\n  [2, 3],\n]", kindTuple},
+	}
+
+	for _, test := range tests {
+		t.Run(test.src, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(test.src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags.Error())
+			}
+
+			if got, want := string(expr.BuildTokens(nil).Bytes()), test.src; got != want {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, want)
+			}
+
+			if got, want := expr.AsObjectConsExpr() != nil, test.kind == kindObject; got != want {
+				t.Errorf("AsObjectConsExpr non-nil = %t, want %t", got, want)
+			}
+			if got, want := expr.AsFunctionCallExpr() != nil, test.kind == kindCall; got != want {
+				t.Errorf("AsFunctionCallExpr non-nil = %t, want %t", got, want)
+			}
+			if got, want := expr.AsTupleConsExpr() != nil, test.kind == kindTuple; got != want {
+				t.Errorf("AsTupleConsExpr non-nil = %t, want %t", got, want)
+			}
+
+			// The tree must match the one ParseConfig builds for the same
+			// expression as an attribute value. Using "a =" with no space
+			// after it gives the first token the same leading spaces.
+			f, diags := ParseConfig([]byte("a ="+test.src+"\n"), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics from ParseConfig: %s", diags.Error())
+			}
+			want := makeTestTree(f.Body().GetAttribute("a").expr)
+			got := makeTestTree(expr.holder)
+			if diff := cmp.Diff(want, got); diff != "" {
+				t.Errorf("tree differs from ParseConfig (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestParseExpressionSurroundingTokens(t *testing.T) {
+	tests := map[string]struct {
+		src  string
+		want string
+	}{
+		"comments and blank lines": {
+			src:  "# foo\n\n1\n# bar",
+			want: "1",
+		},
+		"newlines": {
+			src:  "\n\n[1, 2]\n\n",
+			want: "[1, 2]",
+		},
+		// A heredoc must end with a newline, but it is not part of the
+		// expression.
+		"heredoc": {
+			src:  "<<EOT\nhello ${name}\nEOT\n",
+			want: "<<EOT\nhello ${name}\nEOT",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(test.src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags.Error())
+			}
+			if got := string(expr.BuildTokens(nil).Bytes()); got != test.want {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestParseExpressionInvalid(t *testing.T) {
+	for _, src := range []string{
+		``,
+		`{`,
+		`1 +`,
+		`a = 1`,
+		`f(`,
+	} {
+		t.Run(src, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(src), "", hcl.InitialPos)
+			if !diags.HasErrors() {
+				t.Errorf("expected error diagnostics, got none")
+			}
+			if expr != nil {
+				t.Errorf("expected nil expression, got %q", expr.BuildTokens(nil).Bytes())
+			}
+		})
+	}
+}
+
+func TestBodySetAttribute(t *testing.T) {
+	tests := map[string]struct {
+		src  string
+		want string
+	}{
+		"new attribute": {
+			src:  "b = 1\n",
+			want: "b = 1\na = { hat = \"fedora\" }\n",
+		},
+		"existing attribute": {
+			src:  "a = 1 # comment\nb = 2\n",
+			want: "a = { hat = \"fedora\" } # comment\nb = 2\n",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			f, diags := ParseConfig([]byte(test.src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags.Error())
+			}
+			expr, diags := ParseExpression([]byte(`{ hat = "derby" }`), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags.Error())
+			}
+
+			attr := f.Body().SetAttribute("a", expr)
+			if attr != f.Body().GetAttribute("a") {
+				t.Fatalf("returned attribute is not the body's attribute a")
+			}
+			if attr.Expr() != expr {
+				t.Errorf("Attribute.Expr did not return the given expression")
+			}
+			obj := attr.Expr().AsObjectConsExpr()
+			if obj == nil {
+				t.Fatalf("AsObjectConsExpr returned nil")
+			}
+
+			// Edits to the structured expression show up in the file.
+			obj.SetItemValue("hat", cty.StringVal("fedora"))
+			if got := string(f.Bytes()); got != test.want {
+				t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, test.want)
+			}
+		})
+	}
+}
+
+func TestBodySetAttributeAttachedExpr(t *testing.T) {
+	for _, name := range []string{"a", "b"} {
+		t.Run(name, func(t *testing.T) {
+			f, diags := ParseConfig([]byte("a = 1\n"), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags.Error())
+			}
+			attached := f.Body().GetAttribute("a").Expr()
+
+			defer func() {
+				if recover() == nil {
+					t.Errorf("SetAttribute did not panic")
+				}
+			}()
+			f.Body().SetAttribute(name, attached)
+		})
+	}
+}
