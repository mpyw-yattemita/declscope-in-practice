+	stepNodes := t.steps.List()
+	for i, name := range search {
+		step, isName := stepNodes[i].content.(*TraverseName)
+		if !isName {
+			return // only name nodes can match
+		}
+		if string(step.name.content.(*identifier).token.Bytes) != name {
