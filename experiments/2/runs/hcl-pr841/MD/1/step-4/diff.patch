+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package hclwrite
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/hashicorp/hcl/v2"
+	"github.com/hashicorp/hcl/v2/hclsyntax"
+	"github.com/zclconf/go-cty/cty"
+)
+
+func TestParseExpression(t *testing.T) {
+	const (
+		kindTokens = "tokens"
+		kindObject = "object"
+		kindCall   = "call"
+		kindTuple  = "tuple"
+	)
+
+	tests := []struct {
+		name string
+		src  string
+		want string // the expected source of the result; src when empty
+		kind string
+	}{
+		// Literals
+		{name: "number", src: `1`, kind: kindTokens},
+		{name: "bool", src: `true`, kind: kindTokens},
+		{name: "null", src: `null`, kind: kindTokens},
+		{name: "string", src: `"derby"`, kind: kindTokens},
+		{name: "heredoc", src: "<<EOT\nhello\nEOT\n", want: "<<EOT\nhello\nEOT", kind: kindTokens},
+
+		// Templates
+		{name: "template", src: `"hello ${name}!"`, kind: kindTokens},
+		{name: "template directive", src: `"%{ if a }yes%{ else }no%{ endif }"`, kind: kindTokens},
+
+		// Traversals and other expressions kept as tokens
+		{name: "variable", src: `foo`, kind: kindTokens},
+		{name: "traversal", src: `foo.bar[0].baz`, kind: kindTokens},
+		{name: "splat", src: `foo[*].bar`, kind: kindTokens},
+		{name: "operation", src: `a + b * 2`, kind: kindTokens},
+		{name: "conditional", src: `a ? b : c`, kind: kindTokens},
+		{name: "for", src: `[for x in xs : x.name]`, kind: kindTokens},
+		{name: "parens", src: `(a)`, kind: kindTokens},
+
+		// Object-construct expressions
+		{name: "empty object", src: `{}`, kind: kindObject},
+		{name: "object identifier key", src: `{ hat = "derby" }`, kind: kindObject},
+		{name: "object quoted key", src: `{ "hat" = "derby" }`, kind: kindObject},
+		{name: "object colon", src: `{ hat: "derby" }`, kind: kindObject},
+		{name: "object parens key", src: `{ (hat) = "derby" }`, kind: kindObject},
+		{name: "object traversal key", src: `{ hat.band = "derby" }`, kind: kindObject},
+		{name: "object template key", src: `{ "${hat}" = "derby" }`, kind: kindObject},
+		{name: "object keyword key", src: `{ true = "yes" }`, kind: kindObject},
+		{
+			name: "object multiline",
+			src:  "{\n  hat = \"derby\" # comment\n  cat = foo.bar\n}",
+			kind: kindObject,
+		},
+		{
+			name: "nested object",
+			src:  "{\n  a = {\n    b = { c = 1 }\n  }\n}",
+			kind: kindObject,
+		},
+
+		// Function calls
+		{name: "call no args", src: `timestamp()`, kind: kindCall},
+		{name: "call args", src: `max(1, foo, "x")`, kind: kindCall},
+		{name: "call expand", src: `max(xs...)`, kind: kindCall},
+		{name: "call namespaced", src: `provider::local::foo(1)`, kind: kindCall},
+		{name: "call nested", src: `merge({ a = 1 }, [b], f(c))`, kind: kindCall},
+
+		// Tuples
+		{name: "empty tuple", src: `[]`, kind: kindTuple},
+		{name: "tuple", src: `[1, foo, "x"]`, kind: kindTuple},
+		{name: "tuple multiline", src: "[\n  1, # one\n  2,\n]", kind: kindTuple},
+
+		// Surrounding tokens
+		{name: "leading spaces", src: `   1`, want: `1`, kind: kindTokens},
+		{name: "comments", src: "# foo\n\n1\n# bar", want: `1`, kind: kindTokens},
+		{name: "line comment", src: "{ a = 1 } # bar\n", want: `{ a = 1 }`, kind: kindObject},
+		{name: "block comments", src: "/* foo */ f(1) /* bar */", want: `f(1)`, kind: kindCall},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			want := test.want
+			if want == "" {
+				want = test.src
+			}
+
+			expr, diags := ParseExpression([]byte(test.src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatal(diags)
+			}
+
+			if got := string(expr.BuildTokens(nil).Bytes()); got != want {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, want)
+			}
+
+			var kind string
+			switch {
+			case expr.AsObjectConsExpr() != nil:
+				kind = kindObject
+			case expr.AsFunctionCallExpr() != nil:
+				kind = kindCall
+			case expr.AsTupleConsExpr() != nil:
+				kind = kindTuple
+			default:
+				kind = kindTokens
+			}
+			if kind != test.kind {
+				t.Errorf("wrong kind %s, want %s", kind, test.kind)
+			}
+
+			// The tree must match the one ParseConfig builds for the same
+			// expression as an attribute value. No space after "=" keeps
+			// the first token's spaces the same.
+			f, diags := ParseConfig([]byte("a ="+want+"\n"), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatal(diags)
+			}
+			wantTree := makeTestTree(newNode(f.Body().GetAttribute("a").Expr()))
+			gotTree := makeTestTree(newNode(expr))
+			if diff := cmp.Diff(wantTree, gotTree); diff != "" {
+				t.Errorf("wrong tree (-want +got):\n%s", diff)
+			}
+		})
+	}
+}
+
+func TestParseExpressionComments(t *testing.T) {
+	expr, diags := ParseExpression([]byte("# foo\n\n1\n# bar"), "", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatal(diags)
+	}
+	want := Tokens{
+		{Type: hclsyntax.TokenNumberLit, Bytes: []byte(`1`)},
+	}
+	if diff := cmp.Diff(want, expr.BuildTokens(nil)); diff != "" {
+		t.Errorf("wrong tokens (-want +got):\n%s", diff)
+	}
+}
+
+func TestParseExpressionVariables(t *testing.T) {
+	expr, diags := ParseExpression([]byte(`{ a = foo.bar, (b) = [baz, f(qux)] }`), "", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatal(diags)
+	}
+	var got []string
+	for _, v := range expr.Variables() {
+		got = append(got, strings.TrimSpace(string(v.BuildTokens(nil).Bytes())))
+	}
+	want := []string{"foo.bar", "b", "baz", "qux"}
+	if diff := cmp.Diff(want, got); diff != "" {
+		t.Errorf("wrong variables (-want +got):\n%s", diff)
+	}
+}
+
+func TestParseExpressionInvalid(t *testing.T) {
+	tests := map[string]string{
+		"empty":            ``,
+		"unclosed object":  `{ a = 1`,
+		"extra characters": `1 2`,
+		"attribute":        `a = 1`,
+		"invalid token":    "\x00",
+	}
+	for name, src := range tests {
+		t.Run(name, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(src), "", hcl.InitialPos)
+			if !diags.HasErrors() {
+				t.Fatal("got no errors")
+			}
+			if expr != nil {
+				t.Errorf("got expression %q, want nil", expr.BuildTokens(nil).Bytes())
+			}
+		})
+	}
+}
+
+func mustParseExpression(t *testing.T, src string) *Expression {
+	t.Helper()
+	expr, diags := ParseExpression([]byte(src), "", hcl.InitialPos)
+	if diags.HasErrors() {
+		t.Fatal(diags)
+	}
+	return expr
+}
+
+func TestBodySetAttribute(t *testing.T) {
+	tests := map[string]struct {
+		src  string
+		want string
+	}{
+		"new attribute": {
+			src:  "b = 1\n",
+			want: "b = 1\na = { hat = \"derby\" }\n",
+		},
+		"existing attribute": {
+			src:  "# lead\na = 1 # line\nb = 2\n",
+			want: "# lead\na = { hat = \"derby\" } # line\nb = 2\n",
+		},
+	}
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			f := mustParseConfig(test.src)
+			expr := mustParseExpression(t, `{ hat = "derby" }`)
+
+			attr := f.Body().SetAttribute("a", expr)
+			if attr != f.Body().GetAttribute("a") {
+				t.Error("returned attribute is not the one in the body")
+			}
+			if attr.Expr() != expr {
+				t.Error("attribute does not keep the given expression")
+			}
+			object := attr.Expr().AsObjectConsExpr()
+			if object == nil {
+				t.Fatal("expression is not an object-construct expression")
+			}
+
+			// The structure can still be changed after it is set.
+			object.SetItemValue("cat", cty.StringVal("calico"))
+			want := strings.Replace(test.want, `{ hat = "derby" }`, `{ hat = "derby", cat = "calico" }`, 1)
+			if got := string(f.Bytes()); got != want {
+				t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, want)
+			}
+		})
+	}
+}
+
+func TestBodySetAttributeReplacedExprIsDetached(t *testing.T) {
+	f := mustParseConfig("a = { hat = \"derby\" }\n")
+	old := f.Body().GetAttribute("a").Expr()
+
+	f.Body().SetAttribute("a", mustParseExpression(t, `1`))
+
+	// The replaced expression is no longer in the tree, so it can be used
+	// again.
+	f.Body().SetAttribute("b", old)
+	want := "a = 1\nb = { hat = \"derby\" }\n"
+	if got := string(f.Bytes()); got != want {
+		t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestBodySetAttributePanics(t *testing.T) {
+	tests := map[string]func(f *File) *Expression{
+		"expression of an attribute": func(f *File) *Expression {
+			return f.Body().GetAttribute("a").Expr()
+		},
+		"value of an object item": func(f *File) *Expression {
+			return f.Body().GetAttribute("a").Expr().AsObjectConsExpr().ValueExprFor("hat").Expr()
+		},
+		"expression set by SetAttribute": func(f *File) *Expression {
+			return f.Body().SetAttribute("c", NewExpressionLiteral(cty.True)).Expr()
+		},
+		"expression replaced by SetAttribute": func(f *File) *Expression {
+			return f.Body().SetAttribute("a", NewExpressionLiteral(cty.True)).Expr()
+		},
+	}
+	for name, attached := range tests {
+		t.Run(name, func(t *testing.T) {
+			f := mustParseConfig("a = { hat = \"derby\" }\n")
+			expr := attached(f)
+			defer func() {
+				if recover() == nil {
+					t.Error("SetAttribute did not panic")
+				}
+			}()
+			f.Body().SetAttribute("b", expr)
+		})
+	}
+}
