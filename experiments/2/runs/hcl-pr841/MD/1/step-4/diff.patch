+// parseExpressionSource is the expression counterpart of parse. It uses the
+// same strategy, so the returned Expression has the same structure as the
+// expression of an attribute parsed by parse.
+//
+// Any tokens before or after the expression itself, such as comments and
+// newlines, are not included in the result.
+//
+// If the parsing step produces any errors, the returned Expression is nil.
+func parseExpressionSource(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	nativeTokens, lexDiags := hclsyntax.LexExpression(src, filename, start)
+	if lexDiags.HasErrors() {
+		// should never happen, since we would've caught these diags in
+		// the first call above.
+		return nil, diags.Extend(lexDiags)
+	}
+	from := newInputTokens(nativeTokens)
+
+	_, within, _ := from.Partition(nativeExpr.Range())
+	return parseExpression(nativeExpr, within).content.(*Expression), diags
+}
+
 type inputTokens struct {
 	nativeTokens hclsyntax.Tokens
 	writerTokens Tokens
 }
 
+// newInputTokens pairs the given native tokens with an equivalent sequence
+// of writer tokens.
+func newInputTokens(nativeTokens hclsyntax.Tokens) inputTokens {
+	return inputTokens{
+		nativeTokens: nativeTokens,
+		writerTokens: writerTokens(nativeTokens),
+	}
+}
+
 func (it inputTokens) Partition(rng hcl.Range) (before, within, after inputTokens) {
 	start, end := partitionTokens(it.nativeTokens, rng)
 	before = it.Slice(0, start)
