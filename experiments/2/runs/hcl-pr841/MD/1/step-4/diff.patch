+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package hclwrite
+
+import (
+	"strings"
+	"testing"
+
+	"github.com/google/go-cmp/cmp"
+	"github.com/hashicorp/hcl/v2"
+)
+
+func TestParseExpression(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		// want is the source of the parsed expression, which excludes any
+		// comments and blank lines around it.
+		want string
+		// wantObject is true if the expression is an object-construct
+		// expression, so AsObjectConsExpr must not return nil.
+		wantObject bool
+		// wantVars is the root names of the variables in the expression.
+		wantVars []string
+		// attrSrc is a config with an attribute "a" whose expression must
+		// have the same tree as the result. It defaults to "a =" followed
+		// by src, without a space so that both trees start with the same
+		// spacing.
+		attrSrc string
+	}{
+		// Literals
+		{name: "number", src: "1", want: "1"},
+		{name: "bool", src: "true", want: "true"},
+		{name: "null", src: "null", want: "null"},
+		{name: "unary", src: "-1", want: "-1"},
+
+		// Templates
+		{name: "string", src: `"hello"`, want: `"hello"`},
+		{name: "template", src: `"hello ${name}"`, want: `"hello ${name}"`, wantVars: []string{"name"}},
+		{name: "heredoc", src: "<<EOT\nhello\nEOT\n", want: "<<EOT\nhello\nEOT"},
+
+		// Traversals
+		{name: "root", src: "foo", want: "foo", wantVars: []string{"foo"}},
+		{name: "attribute", src: "foo.bar", want: "foo.bar", wantVars: []string{"foo"}},
+		{name: "index", src: `foo["bar"][0].baz`, want: `foo["bar"][0].baz`, wantVars: []string{"foo"}},
+		{name: "legacy index", src: "foo.0", want: "foo.0", wantVars: []string{"foo"}},
+		{name: "operation", src: "a + b.c", want: "a + b.c", wantVars: []string{"a", "b"}},
+
+		// Object-construct expressions
+		{name: "empty object", src: "{}", want: "{}", wantObject: true},
+		{name: "identifier key", src: "{ a = 1 }", want: "{ a = 1 }", wantObject: true},
+		{name: "colon", src: "{ a: 1 }", want: "{ a: 1 }", wantObject: true},
+		{name: "quoted key", src: `{ "a b" = 1 }`, want: `{ "a b" = 1 }`, wantObject: true},
+		{name: "template key", src: `{ "${k}" = 1 }`, want: `{ "${k}" = 1 }`, wantObject: true, wantVars: []string{"k"}},
+		{name: "parenthesized key", src: "{ (k) = 1 }", want: "{ (k) = 1 }", wantObject: true, wantVars: []string{"k"}},
+		{name: "traversal key", src: "{ (k.v) = 1 }", want: "{ (k.v) = 1 }", wantObject: true, wantVars: []string{"k"}},
+		{name: "traversal value", src: "{ a = b.c }", want: "{ a = b.c }", wantObject: true, wantVars: []string{"b"}},
+		{
+			name:       "multi-line object",
+			src:        "{\n  a = 1\n  # comment\n  b = 2 # line comment\n}",
+			want:       "{\n  a = 1\n  # comment\n  b = 2 # line comment\n}",
+			wantObject: true,
+		},
+		{
+			name:       "nested object",
+			src:        "{\n  a = {\n    b = { c = d }\n  }\n}",
+			want:       "{\n  a = {\n    b = { c = d }\n  }\n}",
+			wantObject: true,
+			wantVars:   []string{"d"},
+		},
+
+		// Function calls
+		{name: "call without arguments", src: "timestamp()", want: "timestamp()"},
+		{name: "call", src: "max(a, 2)", want: "max(a, 2)", wantVars: []string{"a"}},
+		{name: "call with object", src: `merge(a, { b = "c" })`, want: `merge(a, { b = "c" })`, wantVars: []string{"a"}},
+		{name: "call with expansion", src: "max(a...)", want: "max(a...)", wantVars: []string{"a"}},
+
+		// Tuples
+		{name: "empty tuple", src: "[]", want: "[]"},
+		{name: "tuple", src: `[1, "two", c]`, want: `[1, "two", c]`, wantVars: []string{"c"}},
+		{name: "tuple of objects", src: "[{ a = b }, {}]", want: "[{ a = b }, {}]", wantVars: []string{"b"}},
+		{name: "for", src: "[for x in xs : x]", want: "[for x in xs : x]", wantVars: []string{"xs"}},
+
+		// Surrounding comments and whitespace
+		{name: "comments around", src: "# foo\n\n1\n# bar", want: "1", attrSrc: "a =1\n"},
+		{name: "newlines around", src: "\n\n{ a = 1 }\n\n", want: "{ a = 1 }", wantObject: true, attrSrc: "a ={ a = 1 }\n"},
+		{name: "inline comments", src: "/* foo */ a /* bar */", want: "a", wantVars: []string{"a"}},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(test.src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags)
+			}
+
+			got := strings.TrimLeft(string(expr.BuildTokens(nil).Bytes()), " ")
+			if got != test.want {
+				t.Errorf("wrong source\ngot:  %q\nwant: %q", got, test.want)
+			}
+
+			if gotObject := expr.AsObjectConsExpr() != nil; gotObject != test.wantObject {
+				t.Errorf("wrong AsObjectConsExpr result: got object %t, want %t", gotObject, test.wantObject)
+			}
+
+			var gotVars []string
+			for _, v := range expr.Variables() {
+				root := v.steps.List()[0].content.(*TraverseName)
+				gotVars = append(gotVars, string(root.name.content.(*identifier).token.Bytes))
+			}
+			if diff := cmp.Diff(test.wantVars, gotVars); diff != "" {
+				t.Errorf("wrong variables (-want +got):\n%s", diff)
+			}
+
+			// The tree must match the one that ParseConfig builds for the
+			// same expression as an attribute value.
+			attrSrc := test.attrSrc
+			if attrSrc == "" {
+				attrSrc = "a =" + test.src + "\n"
+			}
+			f, diags := ParseConfig([]byte(attrSrc), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics from ParseConfig: %s", diags)
+			}
+			attrExpr := f.Body().GetAttribute("a").Expr()
+			if diff := cmp.Diff(makeTestTree(attrExpr.holder), makeTestTree(expr.holder)); diff != "" {
+				t.Errorf("tree differs from ParseConfig (-ParseConfig +ParseExpression):\n%s", diff)
+			}
+		})
+	}
+}
+
