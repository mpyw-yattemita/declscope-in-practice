+			},
+		},
+		{
+			`{ a = 1, "b" = c }`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{
+						Type: "ObjectConsExpr",
+						Children: []TestTreeNode{
+							{Type: "Tokens", Val: "{"},
+							{
