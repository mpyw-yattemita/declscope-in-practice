diff --git a/hclwrite/parser.go b/hclwrite/parser.go
index 746369d..f1da8cf 100644
--- a/hclwrite/parser.go
+++ b/hclwrite/parser.go
@@ -69,6 +69,37 @@ func parse(src []byte, filename string, start hcl.Pos) (*File, hcl.Diagnostics)
 	return ret, diags
 }
 
+// parseExpressionSrc is like parse, but for a standalone expression. The
+// tokens before and after the expression, such as comments and newlines, are
+// dropped.
+func parseExpressionSrc(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	nativeTokens, lexDiags := hclsyntax.LexExpression(src, filename, start)
+	if lexDiags.HasErrors() {
+		// should never happen, since we would've caught these diags in
+		// the first call above.
+		return nil, lexDiags
+	}
+
+	from := inputTokens{
+		nativeTokens: nativeTokens,
+		writerTokens: writerTokens(nativeTokens),
+	}
+	_, within, _ := from.Partition(nativeExpr.Range())
+	if within.Len() > 0 {
+		// The expression no longer follows the dropped tokens, so the
+		// spaces before its first token are meaningless.
+		within.writerTokens[0].SpacesBefore = 0
+	}
+
+	exprNode := parseExpression(nativeExpr, within)
+	return exprNode.content.(*Expression), diags
+}
+
 type inputTokens struct {
 	nativeTokens hclsyntax.Tokens
 	writerTokens Tokens
diff --git a/hclwrite/public.go b/hclwrite/public.go
index 7c38ee1..15d0c83 100644
--- a/hclwrite/public.go
+++ b/hclwrite/public.go
@@ -30,6 +30,20 @@ func ParseConfig(src []byte, filename string, start hcl.Pos) (*File, hcl.Diagnos
 	return parse(src, filename, start)
 }
 
+// ParseExpression attempts to parse the given buffer as a HCL expression,
+// returning the resulting syntax element if successful.
+//
+// The result has the same structure that ParseConfig would build for the
+// expression as an attribute value, so it can be cast with methods such as
+// Expression.AsObjectConsExpr. Comments and blank lines before or after the
+// expression are not part of the result.
+//
+// If the source is not a valid expression, the returned expression is nil
+// and the diagnostics describe the errors.
+func ParseExpression(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	return parseExpressionSrc(src, filename, start)
+}
