+// SetAttribute either replaces the expression of an existing attribute of the
+// given name or adds a new attribute definition to the end of the block,
+// using the given expression. The return value is the attribute that was
+// either modified in-place or created.
+//
+// The attribute keeps the given expression itself, so Attribute.Expr returns
+// it with its structure, such as an expression from ParseExpression that
+// Expression.AsObjectConsExpr can cast.
+//
+// SetAttribute panics if the expression is already part of a syntax tree,
+// such as one returned by Attribute.Expr or ObjectConsValue.Expr. Two
+// attributes sharing one expression would change together.
+func (b *Body) SetAttribute(name string, expr *Expression) *Attribute {
+	expr.assertUnattached()
+
+	if n := b.getAttributeNode(name); n != nil {
+		attr := n.content.(*Attribute)
+		attr.Expr().setParent(nil)
+		attr.expr = attr.expr.ReplaceWith(expr)
+		expr.setParent(n)
+		return attr
+	}
+
+	attr := newAttribute()
+	attr.init(name, expr)
+	n := b.appendItem(attr)
+	expr.setParent(n)
+	return attr
+}
