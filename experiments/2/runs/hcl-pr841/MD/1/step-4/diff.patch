+func TestBodySetAttribute(t *testing.T) {
+	tests := map[string]struct {
+		config string
+		expr   string
+		want   string
+	}{
+		"add to empty body": {
+			config: ``,
+			expr:   `{ hat = "derby" }`,
+			want:   `a = { hat = "derby" }` + "\n",
+		},
+		"add after other attribute": {
+			config: "b = 2\n",
+			expr:   `{ hat = "derby" }`,
+			want:   "b = 2\na = { hat = \"derby\" }\n",
+		},
+		"replace existing attribute": {
+			config: "# lead\na = 1 # line\nb = 2\n",
+			expr:   "{\n  hat = \"derby\"\n}",
+			want:   "# lead\na = {\n  hat = \"derby\"\n} # line\nb = 2\n",
+		},
+		"comments around expression are dropped": {
+			config: "a = 1\n",
+			expr:   "# foo\n\n{ hat = \"derby\" }\n# bar",
+			want:   `a = { hat = "derby" }` + "\n",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			f := testFn[*File](t)(ParseConfig([]byte(test.config), "", hcl.InitialPos))
+			expr := testFn[*Expression](t)(ParseExpression([]byte(test.expr), "", hcl.InitialPos))
+
+			attr := f.Body().SetAttribute("a", expr)
+			if attr != f.Body().GetAttribute("a") {
+				t.Errorf("returned attribute is not the attribute in the body")
+			}
+			if attr.Expr() != expr {
+				t.Errorf("attribute does not keep the given expression")
+			}
+			obj := f.Body().GetAttribute("a").Expr().AsObjectConsExpr()
+			if obj == nil {
+				t.Fatalf("attribute is not an object-construct expression")
+			}
+			if obj.ItemFor("hat") == nil {
+				t.Errorf("object has no item hat")
+			}
+
+			if got := string(f.Bytes()); got != test.want {
+				t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, test.want)
+			}
+		})
+	}
+}
+
+func TestBodySetAttributeEditAfterSet(t *testing.T) {
+	f := NewFile()
+	expr := testFn[*Expression](t)(ParseExpression([]byte(`{ hat = "derby" }`), "", hcl.InitialPos))
+	f.Body().SetAttribute("a", expr)
+
+	f.Body().GetAttribute("a").Expr().AsObjectConsExpr().SetItemValue("shoes", cty.StringVal("boots"))
+
+	want := `a = { hat = "derby", shoes = "boots" }` + "\n"
+	if got := string(f.Bytes()); got != want {
+		t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestBodySetAttributePanics(t *testing.T) {
+	f := NewFile()
+	expr := testFn[*Expression](t)(ParseExpression([]byte("1"), "", hcl.InitialPos))
+	f.Body().SetAttribute("a", expr)
+
+	defer func() {
+		if recover() == nil {
+			t.Errorf("did not panic")
+		}
+	}()
+	// The expression is already part of attribute "a", so it can't also be
+	// used for attribute "b".
+	f.Body().SetAttribute("b", expr)
+}
