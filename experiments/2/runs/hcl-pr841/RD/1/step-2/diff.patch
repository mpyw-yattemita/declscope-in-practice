+		},
+		{
+			"a = {\n  hat = \"derby\" # felt\n  cat = 1\n}\n",
+			"hat",
+			"a = {\n  hat = \"bowler\" # felt\n  cat = 1\n}\n",
+		},
+		{
+			// A key from a variable is not the one that is set.
+			"a = { (hat) = \"derby\" }\n",
+			"hat",
