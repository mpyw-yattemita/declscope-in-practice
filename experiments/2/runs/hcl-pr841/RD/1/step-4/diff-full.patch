+func TestParseExpression(t *testing.T) {
+	tests := []struct {
+		src  string
+		want TestTreeNode
+	}{
+		{
+			`1`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{Type: "Tokens", Val: "1"},
+				},
+			},
+		},
+		{
+			`"hello"`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{Type: "quoted", Val: `"hello"`},
+				},
+			},
+		},
+		{
+			`"hello ${name}"`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{Type: "Tokens", Val: `"hello ${`},
+					{
+						Type: "Traversal",
+						Children: []TestTreeNode{
+							{
+								Type: "TraverseName",
+								Children: []TestTreeNode{
+									{Type: "identifier", Val: "name"},
+								},
+							},
+						},
+					},
+					{Type: "Tokens", Val: `}"`},
+				},
+			},
+		},
+		{
+			`a.b`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{
+						Type: "Traversal",
+						Children: []TestTreeNode{
+							{
+								Type: "TraverseName",
+								Children: []TestTreeNode{
+									{Type: "identifier", Val: "a"},
+								},
+							},
+							{
+								Type: "TraverseName",
+								Children: []TestTreeNode{
+									{Type: "Tokens", Val: "."},
+									{Type: "identifier", Val: "b"},
+								},
+							},
+						},
+					},
+				},
+			},
+		},
+		{
+			`{ hat = "derby" }`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{
+						Type: "ObjectConsExpr",
+						Children: []TestTreeNode{
+							{Type: "Tokens", Val: "{"},
+							{
+								Type: "ObjectConsItem",
+								Children: []TestTreeNode{
+									{
+										Type: "ObjectConsKeyExpr",
+										Children: []TestTreeNode{
+											{
+												Type: "Expression",
+												Children: []TestTreeNode{
+													{
+														Type: "Traversal",
+														Children: []TestTreeNode{
+															{
+																Type: "TraverseName",
+																Children: []TestTreeNode{
+																	{Type: "identifier", Val: " hat"},
+																},
+															},
+														},
+													},
+												},
+											},
+										},
+									},
+									{Type: "Tokens", Val: " ="},
+									{
+										Type: "ObjectConsValue",
+										Children: []TestTreeNode{
+											{
+												Type: "Expression",
+												Children: []TestTreeNode{
+													{Type: "quoted", Val: ` "derby"`},
+												},
+											},
+										},
+									},
+								},
+							},
+							{Type: "Tokens", Val: " }"},
+						},
+					},
+				},
+			},
+		},
+		{
+			`f(1)`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{
+						Type: "FunctionCallExpr",
+						Children: []TestTreeNode{
+							{Type: "Tokens", Val: "f("},
+							{
+								Type: "Expression",
+								Children: []TestTreeNode{
+									{Type: "Tokens", Val: "1"},
+								},
+							},
+							{Type: "Tokens", Val: ")"},
+						},
+					},
+				},
+			},
+		},
+		{
+			`[1, 2]`,
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{
+						Type: "TupleConsExpr",
+						Children: []TestTreeNode{
+							{Type: "Tokens", Val: "["},
+							{
+								Type: "Expression",
+								Children: []TestTreeNode{
+									{Type: "Tokens", Val: "1"},
+								},
+							},
+							{Type: "Tokens", Val: ","},
+							{
+								Type: "Expression",
+								Children: []TestTreeNode{
+									{Type: "Tokens", Val: " 2"},
+								},
+							},
+							{Type: "Tokens", Val: "]"},
+						},
+					},
+				},
+			},
+		},
+		{
+			"# foo\n\n1\n# bar",
+			TestTreeNode{
+				Type: "Expression",
+				Children: []TestTreeNode{
+					{Type: "Tokens", Val: "1"},
+				},
+			},
+		},
+		{
+			"/* foo */ 1 // bar\n",
+			TestTreeNode{
