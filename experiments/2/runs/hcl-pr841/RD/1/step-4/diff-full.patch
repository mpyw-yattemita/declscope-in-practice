+// TestParseExpressionMatchesParseConfig checks that ParseExpression builds
+// the same tree that ParseConfig builds for the expression as an attribute
+// value.
+func TestParseExpressionMatchesParseConfig(t *testing.T) {
+	tests := []string{
+		// literals
+		`1`,
+		`1.5`,
+		`true`,
+		`null`,
+		`"hello"`,
+		`"a\nb"`,
+		// templates
+		`"hello ${name}"`,
+		`"%{ if a }b%{ endif }"`,
+		"<<EOT\nhello ${name}\nEOT\n",
+		// traversals
+		`a`,
+		`a.b.c`,
+		`a[0].b["c"]`,
+		`a.0`,
+		// other expressions kept as tokens
+		`a + b * 2`,
+		`!a`,
+		`a ? b : c`,
+		`(a)`,
+		`[for x in xs : x.y]`,
+		`{ for k, v in m : k => v }`,
+		`a[*].b`,
+		// object-construct expressions with different kinds of keys
+		`{}`,
+		`{ hat = "derby" }`,
+		`{ "hat" = "derby" }`,
+		`{ hat: "derby" }`,
+		`{ (hat) = "derby" }`,
+		`{ hat.band = "derby" }`,
+		`{ "${hat}" = "derby" }`,
+		`{ null = 1 }`,
+		`{ a = 1, "b" = 2, (c) = 3, d: 4 }`,
+		"{\n  a = 1\n  b = 2\n}",
+		"{\n  # lead\n  a = 1 # line\n  b = 2,\n}",
+		// nested objects
+		`{ a = { b = { c = x.y } } }`,
+		`{ a = [{ b = 1 }] }`,
+		// function calls
+		`f()`,
+		`f(1, a.b, "c")`,
+		`f(xs...)`,
+		`provider::p::f(1)`,
+		`f(g(1), { a = 1 }, [2])`,
+		"f(\n  1, # one\n  2,\n)",
+		// tuples
+		`[]`,
+		`[1, a.b, "c"]`,
+		`[[1], [2, 3]]`,
+		`[{ a = 1 }, f(x)]`,
+		"[\n  1,\n  2,\n]",
+	}
+
+	for _, src := range tests {
+		t.Run(src, func(t *testing.T) {
+			// The leading space matches the space after "=" in the config.
+			expr, diags := ParseExpression([]byte(" "+src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics from ParseExpression: %s", diags.Error())
+			}
+			f, diags := ParseConfig([]byte("a = "+src+"\n"), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics from ParseConfig: %s", diags.Error())
+			}
+
+			got := makeTestTree(newNode(expr))
+			want := makeTestTree(f.Body().GetAttribute("a").expr)
+			if !cmp.Equal(got, want) {
+				t.Errorf("wrong result\ndiff:\n%s", cmp.Diff(want, got))
+			}
+		})
+	}
+}
+
+func TestParseExpressionInvalid(t *testing.T) {
+	tests := []string{
+		``,
+		`1 +`,
+		`{ a = }`,
+		`1 2`,
+		`a = 1`,
+		`"unterminated`,
+	}
+
+	for _, src := range tests {
+		t.Run(src, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(src), "", hcl.InitialPos)
+			if !diags.HasErrors() {
+				t.Errorf("expected errors, got none")
+			}
+			if expr != nil {
+				t.Errorf("expected nil expression, got %q", expr.BuildTokens(nil).Bytes())
+			}
+		})
+	}
+}
