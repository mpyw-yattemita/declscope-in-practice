--- a/hclwrite/ast_body_test.go
+++ b/hclwrite/ast_body_test.go
@@ -2193,3 +2193,65 @@ func testFn[E any](t *testing.T) func(value E, diags hcl.Diagnostics) E {
 		return value
 	}
 }
+
+func TestBodySetAttribute(t *testing.T) {
+	tests := map[string]struct {
+		config string
+		expr   string
+		want   string // after setting the attribute and adding a "size" item to it
+	}{
+		"new attribute": {
+			config: "b = 1\n",
+			expr:   `{ hat = "derby" }`,
+			want:   "b = 1\na = { hat = \"derby\", size = 7 }\n",
+		},
+		"existing attribute": {
+			config: "a = 1 # keep\nb = 2\n",
+			expr:   `{ hat = "derby" }`,
+			want:   "a = { hat = \"derby\", size = 7 } # keep\nb = 2\n",
+		},
+		"comments around expression": {
+			config: "",
+			expr:   "# foo\n\n{ hat = \"derby\" }\n# bar",
+			want:   "a = { hat = \"derby\", size = 7 }\n",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			f := testFn[*File](t)(ParseConfig([]byte(test.config), "", hcl.InitialPos))
+			expr := testFn[*Expression](t)(ParseExpression([]byte(test.expr), "", hcl.InitialPos))
+
+			attr := f.Body().SetAttribute("a", expr)
+			if attr != f.Body().GetAttribute("a") {
+				t.Errorf("SetAttribute returned another attribute than GetAttribute")
+			}
+			if attr.Expr() != expr {
+				t.Errorf("Expr returned another expression than was set")
+			}
+			object := f.Body().GetAttribute("a").Expr().AsObjectConsExpr()
+			if object == nil {
+				t.Fatalf("AsObjectConsExpr returned nil")
+			}
+
+			// The structured expression stays editable after it is set.
+			object.SetItemValue("size", cty.NumberIntVal(7))
+
+			if got := string(f.Bytes()); got != test.want {
+				t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, test.want)
+			}
+		})
+	}
+}
+
+func TestBodySetAttributeAttached(t *testing.T) {
+	f := testFn[*File](t)(ParseConfig([]byte("a = { hat = \"derby\" }\n"), "", hcl.InitialPos))
+	expr := f.Body().GetAttribute("a").Expr()
+
+	defer func() {
+		if recover() == nil {
+			t.Errorf("SetAttribute did not panic for an attached expression")
+		}
+	}()
+	f.Body().SetAttribute("b", expr)
+}
diff --git a/hclwrite/parser.go b/hclwrite/parser.go
index 4365a58..a34ab66 100644
--- a/hclwrite/parser.go
+++ b/hclwrite/parser.go
@@ -66,6 +66,30 @@ func parse(src []byte, filename string, start hcl.Pos) (*File, hcl.Diagnostics)
 	return ret, diags
 }
 
+// parseExpressionSource parses the given source as a standalone expression.
+// It uses the same strategy as parse, but for hclsyntax.ParseExpression. Any
+// tokens before or after the expression, such as comments and newlines, are
+// not part of the result.
+//
+// If parsing produces any errors, the returned Expression is nil.
+func parseExpressionSource(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	nativeTokens, lexDiags := hclsyntax.LexExpression(src, filename, start)
+	if lexDiags.HasErrors() {
+		// should never happen, since we would've caught these diags in
+		// the first call above.
+		return nil, lexDiags
+	}
+	from := newPartitionableTokens(nativeTokens)
+
+	_, exprTokens, _ := from.Partition(nativeExpr.Range())
+	return parseExpression(nativeExpr, exprTokens).content.(*Expression), diags
+}
+
 // parseBody locates the given body within the given input tokens and returns
 // the resulting *Body object as well as the tokens that appeared before and
 // after it.
diff --git a/hclwrite/public.go b/hclwrite/public.go
index 333508e..df5f7b0 100644
--- a/hclwrite/public.go
+++ b/hclwrite/public.go
@@ -30,6 +30,19 @@ func ParseConfig(src []byte, filename string, start hcl.Pos) (*File, hcl.Diagnos
 	return parse(src, filename, start)
 }
 
+// ParseExpression attempts to parse the given buffer as a HCL expression,
+// returning the resulting syntax element if successful.
+//
+// The result has the same structure that ParseConfig would produce for the
+// expression as an attribute value. Comments and newlines before or after the
+// expression are not part of the result.
+//
+// If the source is not a valid expression, the returned expression is nil
+// and the diagnostics describe the errors.
+func ParseExpression(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	return parseExpressionSource(src, filename, start)
+}
