 	ret := &File{
 		inTree: newInTree(),
 
 		srcBytes: src,
 		body:     root,
 	}
 
 	nodes := ret.children
 	nodes.Append(before.Tokens())
 	nodes.AppendNode(root)
 	nodes.Append(after.Tokens())
 
