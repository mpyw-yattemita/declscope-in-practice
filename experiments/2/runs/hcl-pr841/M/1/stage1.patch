+			"a = { hat = \"derby\" }\n",
+			"hat",
+			"a = { hat = \"bowler\" }\n",
+		},
+		{
+			"a = { \"hat\" = \"derby\" }\n",
+			"hat",
+			"a = { \"hat\" = \"bowler\" }\n",
+		},
+		{
+			"a = { hat: \"derby\" }\n",
+			"hat",
+			"a = { hat : \"bowler\" }\n",
+		},
+		{
+			"a = { \"$${hat}\" = \"derby\" }\n",
