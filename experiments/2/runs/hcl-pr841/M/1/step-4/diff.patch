+// parseExpr is like parse, but parses src as a single expression. The
+// tokens before and after the expression, such as comments and newlines,
+// are not part of the result.
+//
+// If the parsing step produces any errors, the returned Expression is nil.
+func parseExpr(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	from, lexDiags := lexInputTokens(src, filename, start)
+	if lexDiags.HasErrors() {
+		return nil, lexDiags
+	}
+
+	_, exprTokens, _ := from.Partition(nativeExpr.Range())
+	return parseExpression(nativeExpr, exprTokens).content.(*Expression), diags
+}
+
+// lexInputTokens lexes src into the token sequences that the parse
+// functions partition.
+//
+// To do our work, we use the "native" tokens (those from hclsyntax) to
+// match against source ranges in the AST, but ultimately produce slices
+// from our sequence of "writer" tokens, which contain only *relative*
+// position information that is more appropriate for transformation/writing
+// use-cases.
+//
+// The caller must have already parsed src without errors, so the lexing
+// step should never produce errors either.
+func lexInputTokens(src []byte, filename string, start hcl.Pos) (inputTokens, hcl.Diagnostics) {
+	nativeTokens, diags := hclsyntax.LexConfig(src, filename, start)
+	if diags.HasErrors() {
+		return inputTokens{}, diags
+	}
+	return inputTokens{
+		nativeTokens: nativeTokens,
+		writerTokens: writerTokens(nativeTokens),
+	}, diags
+}
+
 type inputTokens struct {
 	nativeTokens hclsyntax.Tokens
 	writerTokens Tokens
diff --git a/hclwrite/public.go b/hclwrite/public.go
index 7c38ee1..c4f581a 100644
--- a/hclwrite/public.go
+++ b/hclwrite/public.go
@@ -30,6 +30,19 @@ func ParseConfig(src []byte, filename string, start hcl.Pos) (*File, hcl.Diagnos
 	return parse(src, filename, start)
 }
 
+// ParseExpression attempts to parse the given buffer as a HCL expression,
+// returning the resulting syntax element if successful.
+//
+// The result has the same structure as the expression of an attribute
+// parsed by ParseConfig. Any comments and newlines before or after the
+// expression are not part of the result.
+//
+// If the source is not a valid expression, the returned expression is nil
+// and the diagnostics describe the errors.
+func ParseExpression(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	return parseExpr(src, filename, start)
+}
