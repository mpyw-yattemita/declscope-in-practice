+// Copyright IBM Corp. 2014, 2026
+// SPDX-License-Identifier: MPL-2.0
+
+package hclwrite
+
+import (
+	"testing"
+
+	"github.com/davecgh/go-spew/spew"
+	"github.com/google/go-cmp/cmp"
+
+	"github.com/hashicorp/hcl/v2"
+)
+
+// parseExpressionTests are the expressions that the ParseExpression tests
+// parse. kind is the structured expression type that the result wraps, or ""
+// if the expression is kept as tokens. want is the source text of the result,
+// if it is not the same as src.
+var parseExpressionTests = []struct {
+	src  string
+	kind string
+	want string
+}{
+	// Literals
+	{`1`, "", ""},
+	{`true`, "", ""},
+	{`null`, "", ""},
+	{`"hello"`, "quoted", ""},
+	{`"a\nb"`, "quoted", ""},
+
+	// Templates
+	{`"hello ${name}"`, "", ""},
+	{`"%{ if a }b%{ endif }"`, "", ""},
+	// The newline after the closing marker is not part of the expression.
+	{src: "<<EOT\nhello ${name}\nEOT\n", want: "<<EOT\nhello ${name}\nEOT"},
+
+	// Traversals and other expressions
+	{`foo`, "", ""},
+	{`foo.bar[0].baz`, "", ""},
+	{`foo.bar + baz`, "", ""},
+	{`a ? b : c`, "", ""},
+	{`[for x in xs : x]`, "", ""},
+	{`(foo)`, "", ""},
+
+	// Object-construct expressions with the different kinds of keys
+	{`{}`, "object", ""},
+	{`{ hat = "derby" }`, "object", ""},
+	{`{ "hat" = "derby" }`, "object", ""},
+	{`{ hat: "derby" }`, "object", ""},
+	{`{ (hat) = "derby" }`, "object", ""},
+	{`{ "${hat}" = "derby" }`, "object", ""},
+	{`{ hat.name = "derby" }`, "object", ""},
+	{"{\n  hat   = \"derby\" # comment\n  shoes = \"loafers\",\n}", "object", ""},
+
+	// Nested objects
+	{`{ a = { b = { c = 1 } } }`, "object", ""},
+	{"{\n  a = {\n    b = 1\n  }\n}", "object", ""},
+
+	// Function calls
+	{`foo()`, "call", ""},
+	{`foo(1, bar.baz, { a = 1 })`, "call", ""},
+	{`provider::local::foo(1)`, "call", ""},
+	{`foo(xs...)`, "call", ""},
+	{"foo(\n  1,\n  2,\n)", "call", ""},
+
+	// Tuples
+	{`[]`, "tuple", ""},
+	{`[1, "two", three]`, "tuple", ""},
+	{`[[1], { a = 2 }, foo()]`, "tuple", ""},
+	{"[\n  1,\n  2,\n]", "tuple", ""},
+}
+
+func TestParseExpression(t *testing.T) {
+	for _, test := range parseExpressionTests {
+		t.Run(test.src, func(t *testing.T) {
+			expr := testFn[*Expression](t)(ParseExpression([]byte(test.src), "", hcl.InitialPos))
+
+			want := test.want
+			if want == "" {
+				want = test.src
+			}
+			if got := string(expr.BuildTokens(nil).Bytes()); got != want {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, want)
+			}
+
+			kind := ""
+			switch {
+			case expr.AsObjectConsExpr() != nil:
+				kind = "object"
+			case expr.AsFunctionCallExpr() != nil:
+				kind = "call"
+			case expr.AsTupleConsExpr() != nil:
+				kind = "tuple"
+			case expr.asQuoted() != nil:
+				kind = "quoted"
+			}
+			if kind != test.kind {
+				t.Errorf("wrong kind\ngot:  %q\nwant: %q", kind, test.kind)
+			}
+		})
+	}
+}
+
+// TestParseExpression_SameAsParseConfig checks that ParseExpression builds
+// the same tree as ParseConfig builds for the expression of an attribute.
+func TestParseExpression_SameAsParseConfig(t *testing.T) {
+	for _, test := range parseExpressionTests {
+		t.Run(test.src, func(t *testing.T) {
+			expr := testFn[*Expression](t)(ParseExpression([]byte(test.src), "", hcl.InitialPos))
+
+			// No space after "=", so that the first token of the expression
+			// has no spaces before it, as in ParseExpression.
+			f := testFn[*File](t)(ParseConfig([]byte("a ="+test.src+"\n"), "", hcl.InitialPos))
+			attr := f.Body().GetAttribute("a")
+
+			got := makeTestTree(newNode(expr))
+			want := makeTestTree(attr.expr)
+			if !cmp.Equal(got, want) {
+				t.Errorf(
+					"wrong tree\ngot:\n%s\nwant:\n%s\ndiff:\n%s",
+					spew.Sdump(got), spew.Sdump(want), cmp.Diff(got, want),
+				)
+			}
+		})
+	}
+}
+
+func TestParseExpression_Tree(t *testing.T) {
+	expr := testFn[*Expression](t)(ParseExpression([]byte(`{ hat = foo.bar }`), "", hcl.InitialPos))
+
+	got := makeTestTree(newNode(expr))
+	want := TestTreeNode{
+		Type: "Expression",
+		Children: []TestTreeNode{
+			{
+				Type: "ObjectConsExpr",
+				Children: []TestTreeNode{
+					{Type: "Tokens", Val: "{"},
+					{
+						Type: "ObjectConsItem",
+						Children: []TestTreeNode{
+							{
+								Type: "ObjectConsKeyExpr",
+								Children: []TestTreeNode{
+									{
+										Type: "Expression",
+										Children: []TestTreeNode{
+											{Type: "Traversal", Children: []TestTreeNode{
+												{Type: "TraverseName", Children: []TestTreeNode{
+													{Type: "identifier", Val: " hat"},
+												}},
+											}},
+										},
+									},
+								},
+							},
+							{Type: "Tokens", Val: " ="},
+							{
+								Type: "ObjectConsValue",
+								Children: []TestTreeNode{
+									{
+										Type: "Expression",
+										Children: []TestTreeNode{
+											{Type: "Traversal", Children: []TestTreeNode{
+												{Type: "TraverseName", Children: []TestTreeNode{
+													{Type: "identifier", Val: " foo"},
+												}},
+												{Type: "TraverseName", Children: []TestTreeNode{
+													{Type: "Tokens", Val: "."},
+													{Type: "identifier", Val: "bar"},
+												}},
+											}},
+										},
+									},
+								},
+							},
+						},
+					},
+					{Type: "Tokens", Val: " }"},
+				},
+			},
+		},
+	}
+	if !cmp.Equal(got, want) {
+		t.Errorf("wrong tree\ngot:\n%s\ndiff:\n%s", spew.Sdump(got), cmp.Diff(got, want))
+	}
+}
+
+func TestParseExpression_SurroundingTokens(t *testing.T) {
+	tests := []struct {
+		src  string
+		want string
+	}{
+		{"# foo\n\n1\n# bar", "1"},
+		{"\n\n  1  \n\n", "1"},
+		{"/* foo */ 1 // bar\n", "1"},
+		{"# foo\n{ a = 1 }\n# bar\n", "{ a = 1 }"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.src, func(t *testing.T) {
+			expr := testFn[*Expression](t)(ParseExpression([]byte(test.src), "", hcl.InitialPos))
+
+			// Strip the spaces before the first token, which are recorded on
+			// the token rather than as a separate token.
+			toks := expr.BuildTokens(nil)
+			if len(toks) > 0 {
+				toks[0].SpacesBefore = 0
+			}
+			if got := string(toks.Bytes()); got != test.want {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, test.want)
+			}
+		})
+	}
+}
+
+func TestParseExpression_Invalid(t *testing.T) {
+	tests := []string{
+		``,
+		`{`,
+		`1 +`,
+		`foo(`,
+		`1 2`,
+		`a = 1`,
+	}
+
+	for _, src := range tests {
+		t.Run(src, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(src), "", hcl.InitialPos)
+			if !diags.HasErrors() {
+				t.Errorf("no error diagnostics")
+			}
+			if expr != nil {
+				t.Errorf("expression is not nil: %#v", expr)
+			}
+		})
+	}
+}
