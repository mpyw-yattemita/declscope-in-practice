+// SetAttribute either replaces the expression of an existing attribute of the
+// given name or adds a new attribute definition to the end of the block,
+// using the given expression. The expression keeps its structure, so
+// Attribute.Expr on the result returns the given expression.
+//
+// The expression must not already be part of a syntax tree, or SetAttribute
+// panics. Where possible, use SetAttributeValue or SetAttributeTraversal
+// instead.
+//
+// The return value is the attribute that was either modified in-place or
+// created.
+func (b *Body) SetAttribute(name string, expr *Expression) *Attribute {
+	expr.assertUnattached()
+
+	attrNode := b.getAttributeNode(name)
+	var attr *Attribute
+	if attrNode != nil {
+		attr = attrNode.content.(*Attribute)
+		attr.Expr().parent = nil
+		attr.expr = attr.expr.ReplaceWith(expr)
+	} else {
+		attr = newAttribute()
+		attr.init(name, expr)
+		attrNode = b.appendItem(attr)
+	}
+	expr.parent = attrNode
+	return attr
+}
