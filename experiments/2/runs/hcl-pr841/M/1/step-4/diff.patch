--- a/hclwrite/ast_body_test.go
+++ b/hclwrite/ast_body_test.go
@@ -2193,3 +2193,72 @@ func testFn[E any](t *testing.T) func(value E, diags hcl.Diagnostics) E {
 		return value
 	}
 }
+
+func TestBodySetAttribute(t *testing.T) {
+	tests := map[string]struct {
+		config string
+		want   string
+	}{
+		"new attribute": {
+			config: "b = 1\n",
+			want:   "b = 1\na = { hat = \"derby\" }\n",
+		},
+		"existing attribute": {
+			config: "a = 1 # comment\nb = 2\n",
+			want:   "a = { hat = \"derby\" } # comment\nb = 2\n",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			f := testFn[*File](t)(ParseConfig([]byte(test.config), "", hcl.InitialPos))
+			expr := testFn[*Expression](t)(ParseExpression([]byte(`{ hat = "derby" }`), "", hcl.InitialPos))
+
+			attr := f.Body().SetAttribute("a", expr)
+			if attr != f.Body().GetAttribute("a") {
+				t.Fatalf("returned attribute is not the attribute of the body")
+			}
+			if attr.Expr() != expr {
+				t.Fatalf("attribute expression is not the given expression")
+			}
+
+			// The structure is kept, so the object can be changed in place.
+			object := f.Body().GetAttribute("a").Expr().AsObjectConsExpr()
+			if object == nil {
+				t.Fatalf("attribute expression is not an object")
+			}
+			object.SetItemValue("shoes", cty.StringVal("loafers"))
+
+			got := string(f.Bytes())
+			want := strings.Replace(test.want, `"derby" }`, `"derby", shoes = "loafers" }`, 1)
+			if got != want {
+				t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, want)
+			}
+		})
+	}
+}
+
+func TestBodySetAttribute_AttachedExpression(t *testing.T) {
+	f := testFn[*File](t)(ParseConfig([]byte("a = 1\nb = 2\n"), "", hcl.InitialPos))
+	expr := f.Body().GetAttribute("a").Expr()
+
+	defer func() {
+		if recover() == nil {
+			t.Errorf("SetAttribute did not panic")
+		}
+	}()
+	f.Body().SetAttribute("b", expr)
+}
+
+func TestBodySetAttribute_ReplacedExpressionIsDetached(t *testing.T) {
+	f := testFn[*File](t)(ParseConfig([]byte("a = 1\n"), "", hcl.InitialPos))
+	old := f.Body().GetAttribute("a").Expr()
+	f.Body().SetAttributeValue("a", cty.True)
+
+	// The old expression is no longer part of the tree, so it can be used
+	// again.
+	f.Body().SetAttribute("b", old)
+	if got, want := string(f.Bytes()), "a = true\nb = 1\n"; got != want {
+		t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
