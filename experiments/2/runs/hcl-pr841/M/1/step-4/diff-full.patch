+// parseExpr is like parse, but parses src as a single expression. The
+// tokens before and after the expression, such as comments and newlines,
+// are not part of the result.
+//
+// If the parsing step produces any errors, the returned Expression is nil.
+func parseExpr(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
