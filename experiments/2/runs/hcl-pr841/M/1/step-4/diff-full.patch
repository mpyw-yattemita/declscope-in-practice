+func TestParseExpression_SurroundingTokens(t *testing.T) {
+	tests := []struct {
+		src  string
+		want string
+	}{
+		{"# foo\n\n1\n# bar", "1"},
+		{"\n\n  1  \n\n", "1"},
+		{"/* foo */ 1 // bar\n", "1"},
+		{"# foo\n{ a = 1 }\n# bar\n", "{ a = 1 }"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.src, func(t *testing.T) {
+			expr := testFn[*Expression](t)(ParseExpression([]byte(test.src), "", hcl.InitialPos))
+
+			// Strip the spaces before the first token, which are recorded on
+			// the token rather than as a separate token.
+			toks := expr.BuildTokens(nil)
+			if len(toks) > 0 {
+				toks[0].SpacesBefore = 0
+			}
+			if got := string(toks.Bytes()); got != test.want {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, test.want)
+			}
+		})
+	}
+}
