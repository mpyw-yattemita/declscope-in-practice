+// https://docs.github.com/en/graphql/guides/using-pagination-in-the-graphql-api
+func WithCursorPagination() mcp.ToolOption {
+	return func(tool *mcp.Tool) {
+		withPerPageParam()(tool)
+		withAfterParam()(tool)
+	}
