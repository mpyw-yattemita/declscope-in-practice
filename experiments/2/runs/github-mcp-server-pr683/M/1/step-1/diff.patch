+func TestPaginationParams_ToGraphQLParams(t *testing.T) {
+	tests := []struct {
+		name          string
+		params        PaginationParams
+		expectedFirst int32
+		expectedAfter *string
+		errContains   string
+	}{
+		{
+			name:          "no cursor",
+			params:        PaginationParams{Page: 1, PerPage: 30},
+			expectedFirst: 30,
+		},
+		{
+			name:          "cursor is used as after",
+			params:        PaginationParams{Page: 2, PerPage: 10, After: "Y3Vyc29yOjE="},
+			expectedFirst: 10,
+			expectedAfter: github.Ptr("Y3Vyc29yOjE="),
+		},
+		{
+			name:          "maximum perPage",
+			params:        PaginationParams{PerPage: 100},
+			expectedFirst: 100,
+		},
+		{
+			name:        "perPage above maximum",
+			params:      PaginationParams{PerPage: 101},
+			errContains: "perPage value 101 exceeds maximum of 100",
+		},
+		{
+			name:        "negative perPage",
+			params:      PaginationParams{PerPage: -1},
+			errContains: "perPage value -1 cannot be negative",
+		},
+	}
+
+	for _, tc := range tests {
+		t.Run(tc.name, func(t *testing.T) {
+			// PaginationParams and CursorPaginationParams must convert identically.
+			cursor := CursorPaginationParams{PerPage: tc.params.PerPage, After: tc.params.After}
+			for _, convert := range []func() (*GraphQLPaginationParams, error){
+				tc.params.ToGraphQLParams,
+				cursor.ToGraphQLParams,
+			} {
+				result, err := convert()
+				if tc.errContains != "" {
+					assert.EqualError(t, err, tc.errContains)
+					assert.Nil(t, result)
+					continue
+				}
+				require.NoError(t, err)
+				require.NotNil(t, result.First)
+				assert.Equal(t, tc.expectedFirst, *result.First)
+				assert.Equal(t, tc.expectedAfter, result.After)
+			}
+		})
+	}
+}
