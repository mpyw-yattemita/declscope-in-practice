+func TestPaginationToolOptions(t *testing.T) {
+	cursorTool := mcp.NewTool("cursor", WithCursorPagination())
+	assert.ElementsMatch(t, []string{"perPage", "after"}, mapKeys(cursorTool.InputSchema.Properties))
+
+	unifiedTool := mcp.NewTool("unified", WithUnifiedPagination())
+	assert.ElementsMatch(t, []string{"page", "perPage", "after"}, mapKeys(unifiedTool.InputSchema.Properties))
+
+	assert.Equal(t, map[string]any{
+		"type":        "number",
+		"description": "Results per page for pagination (min 1, max 100)",
+		"minimum":     float64(1),
+		"maximum":     float64(100),
+	}, unifiedTool.InputSchema.Properties["perPage"])
+	assert.Equal(t, map[string]any{
+		"type":        "string",
+		"description": "Cursor for pagination. Use the endCursor from the previous page's PageInfo for GraphQL APIs.",
+	}, unifiedTool.InputSchema.Properties["after"])
+	assert.Equal(t, map[string]any{
+		"type":        "number",
+		"description": "Page number for pagination (min 1)",
+		"minimum":     float64(1),
+	}, unifiedTool.InputSchema.Properties["page"])
+}
+
+func mapKeys(m map[string]any) []string {
+	keys := make([]string, 0, len(m))
+	for k := range m {
+		keys = append(keys, k)
+	}
+	return keys
+}
