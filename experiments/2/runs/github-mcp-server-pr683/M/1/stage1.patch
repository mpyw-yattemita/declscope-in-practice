+// WithUnifiedPagination returns a ToolOption that adds "page", "perPage", and "after" parameters to the tool.
+// It is meant for GraphQL tools that accept page/perPage and convert them to a cursor internally.
+// The "page" parameter is optional, min 1.
+// The "perPage" parameter is optional, min 1, max 100.
+// The "after" parameter is optional and takes precedence as the cursor when set.
+func WithUnifiedPagination() mcp.ToolOption {
+	return func(tool *mcp.Tool) {
+		mcp.WithNumber("page",
+			mcp.Description("Page number for pagination (min 1)"),
+			mcp.Min(1),
+		)(tool)
+
+		withPerPageParam()(tool)
+		withAfterParam()(tool)
+	}
+}
+
+// WithCursorPagination returns a ToolOption that adds "perPage" and "after" parameters to the tool.
+// The "perPage" parameter is optional, min 1, max 100. If unset, defaults to 30.
+// The "after" parameter is optional, the cursor of the page to start after.
+// https://docs.github.com/en/graphql/guides/using-pagination-in-the-graphql-api
+func WithCursorPagination() mcp.ToolOption {
+	return func(tool *mcp.Tool) {
+		withPerPageParam()(tool)
+		withAfterParam()(tool)
+	}
+}
+
+func withPerPageParam() mcp.ToolOption {
