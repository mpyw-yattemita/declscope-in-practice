+			name: "page and perPage parameters",
+			params: map[string]any{
+				"page":    float64(2),
+				"perPage": float64(50),
+			},
+			expected: PaginationParams{
+				Page:    2,
+				PerPage: 50,
+			},
+			expectError: false,
+		},
+		{
+			name: "after parameter",
+			params: map[string]any{
+				"after": "cursor123",
+			},
+			expected: PaginationParams{
+				Page:    1,
+				PerPage: 30,
+				After:   "cursor123",
+			},
+			expectError: false,
+		},
+		{
+			name: "invalid after parameter",
+			params: map[string]any{
+				"after": float64(1),
+			},
+			expected:    PaginationParams{},
+			expectError: true,
+		},
