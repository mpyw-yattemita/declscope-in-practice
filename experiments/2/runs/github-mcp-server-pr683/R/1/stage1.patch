+func TestToGraphQLParams(t *testing.T) {
+	ptr32 := func(v int32) *int32 { return &v }
+	ptrStr := func(v string) *string { return &v }
+
+	tests := []struct {
+		name        string
+		params      CursorPaginationParams
+		expected    *GraphQLPaginationParams
+		errContains string
+	}{
