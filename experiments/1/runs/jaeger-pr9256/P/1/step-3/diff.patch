+func TestToLegacyShape_Refuses(t *testing.T) {
+	attr := func(key string, level expression.Level) *expression.AttributeRef {
+		return &expression.AttributeRef{Key: key, Level: level}
+	}
+	str := &expression.StringValue{Value: "x"}
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{
+			name:    "or",
+			filter:  call(expression.OpOr, attrEq("a", "1"), attrEq("b", "2")),
+			wantErr: `does not support the operator "or"`,
+		},
+		{
+			name:    "or nested in a conjunction",
+			filter:  call(expression.OpAnd, attrEq("a", "1"), call(expression.OpOr, attrEq("b", "2"), attrEq("c", "3"))),
+			wantErr: `does not support the operator "or"`,
+		},
+		{
+			name:    "not",
+			filter:  call(expression.OpNot, attrEq("a", "1")),
+			wantErr: `does not support the operator "not"`,
+		},
+		{
+			name:    "exists",
+			filter:  call(expression.OpExists, attr("a", "")),
+			wantErr: `does not support the operator "exists"`,
+		},
+		{
+			name:    "a predicate without two arguments",
+			filter:  call(expression.OpEq, attr("a", "")),
+			wantErr: `does not support the operator "eq"`,
+		},
+		{
+			name:    "a conjunct that is not a predicate",
+			filter:  call(expression.OpAnd, attrEq("a", "1"), attr("b", "")),
+			wantErr: "conjunction of predicates only",
+		},
+		{
+			name:    "ne on an attribute",
+			filter:  call(expression.OpNe, attr("http.method", ""), str),
+			wantErr: `does not support the operator "ne" on "http.method"`,
+		},
+		{
+			name:    "in on an attribute",
+			filter:  call(expression.OpIn, attr("http.status_code", ""), &expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			wantErr: `does not support the operator "in" on "http.status_code"`,
+		},
+		{
+			name:    "gt on the duration",
+			filter:  boundCall(expression.OpGt, time.Second),
+			wantErr: `does not support the operator "gt" on "duration"`,
+		},
+		{
+			name:    "regex on the operation",
+			filter:  call(expression.OpRegex, operationRef(), str),
+			wantErr: `does not support the operator "regex" on "name"`,
+		},
+		{
+			name:    "ne on the service",
+			filter:  call(expression.OpNe, serviceRef(), str),
+			wantErr: `does not support the operator "ne" on "service"`,
+		},
+		{
+			name:    "an attribute at the link level",
+			filter:  call(expression.OpEq, attr("a", expression.LevelLink), str),
+			wantErr: `does not index the "link" level`,
+		},
+		{
+			name:    "an attribute at the scope level",
+			filter:  call(expression.OpEq, attr("a", expression.LevelScope), str),
+			wantErr: `does not index the "scope" level`,
+		},
+		{
+			name: "another built-in field",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}, str),
+			wantErr: `does not support the built-in field "kind" of the "span" level`,
+		},
+		{
+			name:    "an attribute against a list",
+			filter:  call(expression.OpEq, attr("a", ""), &expression.List{Values: []string{"1"}}),
+			wantErr: `compares "a" against a string constant only`,
+		},
+		{
+			name:    "an attribute against an integer",
+			filter:  call(expression.OpEq, attr("a", ""), &expression.IntValue{Value: 1}),
+			wantErr: `compares "a" against a string constant only`,
+		},
+		{
+			name:    "an attribute against another reference",
+			filter:  call(expression.OpEq, attr("a", ""), attr("b", "")),
+			wantErr: `compares "a" against a string constant only`,
+		},
+		{
+			name:    "the service against a boolean",
+			filter:  call(expression.OpEq, serviceRef(), &expression.BoolValue{Value: true}),
+			wantErr: `compares "service" against a string constant only`,
+		},
+		{
+			name:    "the operation against an integer",
+			filter:  call(expression.OpEq, operationRef(), &expression.IntValue{Value: 1}),
+			wantErr: `compares "name" against a string constant only`,
+		},
+		{
+			name:    "a duration bound against a string",
+			filter:  call(expression.OpGte, durationRef(), str),
+			wantErr: `compares "duration" against a duration such as "2s" only`,
+		},
+		{
+			name: "a quantifier over the events",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, &expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str)),
+			wantErr: "compares a reference against a constant only",
+		},
+		{
+			name:    "a constant on the left",
+			filter:  call(expression.OpEq, str, attr("a", "")),
+			wantErr: "compares a reference against a constant only",
+		},
+		{
+			name:    "the same attribute twice",
+			filter:  call(expression.OpAnd, attrEq("a", "1"), call(expression.OpEq, attr("a", expression.LevelSpan), str)),
+			wantErr: `only one predicate on "a"`,
+		},
+		{
+			name: "the service twice",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, serviceRef(), str), call(expression.OpEq, serviceRef(), str)),
+			wantErr: `only one predicate on "service"`,
+		},
+		{
+			name: "the operation twice",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, operationRef(), str), call(expression.OpEq, operationRef(), str)),
+			wantErr: `only one predicate on "name"`,
+		},
+		{
+			name: "the same duration bound twice",
+			filter: call(expression.OpAnd,
+				boundCall(expression.OpLte, time.Second), boundCall(expression.OpLte, time.Minute)),
+			wantErr: `only one predicate on "duration"`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			q := withFilter(tt.filter)
+			got, err := q.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, tt.wantErr)
+			assert.Equal(t, q, got, "the original query is returned on error")
+		})
+	}
+}
