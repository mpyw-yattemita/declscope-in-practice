 }
+
+func TestFilterCapabilities_EnsureSupported(t *testing.T) {
+	spanEq := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpSome},
+	}
+	attr := func(level expression.Level) *expression.AttributeRef {
+		return &expression.AttributeRef{Key: "k", Level: level}
+	}
+	constant := &expression.AnyValue{Value: "v"}
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{name: "nil filter"},
+		{
+			name:   "declared operators and levels",
+			filter: call(expression.OpAnd, call(expression.OpEq, attr(""), constant), call(expression.OpEq, attr(expression.LevelSpan), constant)),
+		},
+		{
+			name:    "operator not declared",
+			filter:  call(expression.OpOr, call(expression.OpEq, attr(""), constant), call(expression.OpEq, attr(""), constant)),
+			wantErr: `it does not support the operator "or"`,
+		},
+		{
+			name:    "operator not declared, nested",
+			filter:  call(expression.OpAnd, call(expression.OpEq, attr(""), constant), call(expression.OpGt, attr(""), constant)),
+			wantErr: `it does not support the operator "gt"`,
+		},
+		{
+			name:    "attribute level not declared",
+			filter:  call(expression.OpEq, attr(expression.LevelLink), constant),
+			wantErr: `it does not index the "link" level`,
+		},
+		{
+			name: "field level not declared",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}, constant),
+			wantErr: `it does not index the "resource" level`,
+		},
+		{
+			name: "nested reference level not declared",
+			filter: call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, attr(expression.LevelSpan), constant)),
+			wantErr: `it does not index the "event" level`,
+		},
+		{
+			name:    "level not declared on the right of a comparison",
+			filter:  call(expression.OpEq, attr(expression.LevelSpan), attr(expression.LevelResource)),
+			wantErr: `it does not index the "resource" level`,
+		},
+		{
+			name: "nested call on the right of a comparison",
+			filter: call(expression.OpEq, attr(expression.LevelSpan),
+				call(expression.OpRegex, attr(""), constant)),
+			wantErr: `it does not support the operator "regex"`,
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := spanEq.EnsureSupported(tt.filter)
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, tt.wantErr)
+		})
+	}
+}
+
+func TestFilterCapabilities_EnsureSupported_RefusesACycle(t *testing.T) {
+	caps := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd}}
+	cycle := &expression.Call{Op: expression.OpAnd}
+	cycle.Args = []expression.Expression{cycle, cycle}
+	err := caps.EnsureSupported(cycle)
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+}
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
+
+func TestFilterCapabilities_EnsureSupported_NilTerms(t *testing.T) {
+	caps := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd, expression.OpEq}}
+	filter := call(expression.OpAnd,
+		(*expression.Call)(nil),
+		call(expression.OpEq, (*expression.AttributeRef)(nil), (*expression.FieldRef)(nil)),
+		call(expression.OpEq, (*expression.NestedRef)(nil), (*expression.AnyValue)(nil)))
+	require.NoError(t, caps.EnsureSupported(filter), "a nil term names no level")
+}
diff --git a/internal/storage/v2/api/tracestore/query_filter.go b/internal/storage/v2/api/tracestore/query_filter.go
new file mode 100644
index 0000000..a4f7d50
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_filter.go
@@ -0,0 +1,360 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// A query carries its predicates in one of two filtering models: the scalar
+// predicate fields every backend serves (ServiceName, OperationName, Attributes
+// and the duration bounds), or the structured Filter. The methods in this file
+// decide which model a Reader is handed and convert between the two, so every
+// caller gets the same answer rather than each backend's own.
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. A query without a filter
+// passes, and so does an empty Attributes map, which is not a predicate.
+//
+// The error wraps ErrFilterInvalid and names every conflicting field.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, "service_name")
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, "operation_name")
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, "duration_min")
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, "duration_max")
+	}
+	if attributeCount(q.Attributes) > 0 {
+		conflicts = append(conflicts, "attributes")
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: a filter replaces the predicate fields %v, which must be left empty beside it",
+		ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A query without a filter is returned unchanged. A
+// Reader that declares no filter support gets the filter expressed in the
+// legacy predicate fields (see ToLegacyShape); one that declares support gets
+// the query as it is, or a refusal if the filter uses something it did not
+// declare (see FilterCapabilities.EnsureSupported).
+//
+// It expects a query that has passed EnsureFilterStandsAlone.
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates. It
+// cannot fail, because each legacy field has an exact filter equivalent. A
+// query that already has a Filter is returned as it is.
+//
+// The converted fields are cleared and everything else is kept. The filter is
+// nil when there is nothing to convert, a single predicate when there is one,
+// and a conjunction otherwise. It needs no further resolution: it is valid,
+// and its constants are already typed.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, compare(expression.OpEq,
+			&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+			&expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, compare(expression.OpEq,
+			&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+			&expression.StringValue{Value: q.OperationName}))
+	}
+	if attributeCount(q.Attributes) > 0 {
+		q.Attributes.Range(func(key string, value pcommon.Value) bool {
+			predicates = append(predicates, compare(expression.OpEq,
+				&expression.AttributeRef{Key: key},
+				&expression.AnyValue{Value: value.AsString()}))
+			return true
+		})
+	}
+	duration := func() *expression.FieldRef {
+		return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, compare(expression.OpGte,
+			duration(), &expression.DurationValue{Value: q.DurationMin}))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, compare(expression.OpLte,
+			duration(), &expression.DurationValue{Value: q.DurationMax}))
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	switch len(predicates) {
+	case 0:
+		q.Filter = nil
+	case 1:
+		q.Filter = predicates[0]
+	default:
+		args := make([]expression.Expression, len(predicates))
+		for i, predicate := range predicates {
+			args[i] = predicate
+		}
+		q.Filter = &expression.Call{Op: expression.OpAnd, Args: args}
+	}
+	return q
+}
+
+func compare(op expression.Operator, ref, value expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: []expression.Expression{ref, value}}
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves. It is the inverse of ToFilterShape, and accepts what a flat
+// index can answer exactly: a conjunction of equalities on attributes, the
+// service and the operation name, and inclusive bounds on the span duration.
+// Anything else is refused with ErrFilterUnsupported rather than approximated.
+//
+// A query without a filter is returned unchanged. Otherwise the result has a
+// nil Filter and a new Attributes map, so the caller's map is not changed; on
+// error the original query is returned. It expects a query that has passed
+// EnsureFilterStandsAlone: a legacy field the filter also sets is overwritten.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	predicates, err := conjuncts(q.Filter, nil, 1)
+	if err != nil {
+		return q, err
+	}
+	out := q
+	out.Filter = nil
+	out.Attributes = pcommon.NewMap()
+	if attributeCount(q.Attributes) > 0 {
+		q.Attributes.CopyTo(out.Attributes)
+	}
+	var written legacyFields
+	for _, predicate := range predicates {
+		if err := written.apply(&out, predicate); err != nil {
+			return q, err
+		}
+	}
+	return out, nil
+}
+
+// conjuncts flattens nested conjunctions into the predicates they conjoin.
+func conjuncts(call *expression.Call, into []*expression.Call, depth int) ([]*expression.Call, error) {
+	if depth > expression.MaxNestingDepth {
+		return nil, fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if call.Op != expression.OpAnd {
+		return append(into, call), nil
+	}
+	for _, arg := range call.Args {
+		nested, ok := arg.(*expression.Call)
+		if !ok || nested == nil {
+			return nil, fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+		}
+		var err error
+		if into, err = conjuncts(nested, into, depth+1); err != nil {
+			return nil, err
+		}
+	}
+	return into, nil
+}
+
+// legacyFields records which legacy fields the filter has written, so that a
+// second predicate on the same field is refused rather than silently replacing
+// the first: the legacy fields hold one value each.
+type legacyFields struct {
+	attributes  map[string]bool
+	service     bool
+	operation   bool
+	durationMin bool
+	durationMax bool
+}
+
+// apply writes one predicate into the legacy fields of q.
+func (w *legacyFields) apply(q *TraceQueryParams, predicate *expression.Call) error {
+	switch predicate.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return unsupportedOperator(predicate.Op)
+	}
+	if len(predicate.Args) != 2 {
+		return unsupportedOperator(predicate.Op)
+	}
+	value := predicate.Args[1]
+	switch ref := predicate.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return w.applyAttribute(q, predicate.Op, ref, value)
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return w.applyField(q, predicate.Op, ref, value)
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+func (w *legacyFields) applyAttribute(
+	q *TraceQueryParams, op expression.Operator, ref *expression.AttributeRef, value expression.Expression,
+) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+		// A tag of the legacy model matches any of these levels.
+	default:
+		return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, ref.Level)
+	}
+	text, err := equalityText(op, ref.Key, value)
+	if err != nil {
+		return err
+	}
+	if w.attributes[ref.Key] {
+		return onlyOnePredicate(ref.Key)
+	}
+	if w.attributes == nil {
+		w.attributes = make(map[string]bool)
+	}
+	w.attributes[ref.Key] = true
+	q.Attributes.PutStr(ref.Key, text)
+	return nil
+}
+
+func (w *legacyFields) applyField(
+	q *TraceQueryParams, op expression.Operator, ref *expression.FieldRef, value expression.Expression,
+) error {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		return applyString(&q.ServiceName, &w.service, op, ref.Name, value)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		return applyString(&q.OperationName, &w.operation, op, ref.Name, value)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		return w.applyDuration(q, op, ref.Name, value)
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+func applyString(
+	field *string, written *bool, op expression.Operator, name string, value expression.Expression,
+) error {
+	text, err := equalityText(op, name, value)
+	if err != nil {
+		return err
+	}
+	if *written {
+		return onlyOnePredicate(name)
+	}
+	*written = true
+	*field = text
+	return nil
+}
+
+func (w *legacyFields) applyDuration(
+	q *TraceQueryParams, op expression.Operator, name string, value expression.Expression,
+) error {
+	var field *time.Duration
+	var written *bool
+	switch op {
+	case expression.OpGte:
+		field, written = &q.DurationMin, &w.durationMin
+	case expression.OpLte:
+		field, written = &q.DurationMax, &w.durationMax
+	default:
+		return unsupportedOperatorOn(op, name)
+	}
+	bound, err := durationBound(name, value)
+	if err != nil {
+		return err
+	}
+	if *written {
+		return onlyOnePredicate(name)
+	}
+	*written = true
+	*field = bound
+	return nil
+}
+
+// durationBound returns the length of time a bound on name compares against.
+func durationBound(name string, value expression.Expression) (time.Duration, error) {
+	switch v := value.(type) {
+	case *expression.DurationValue:
+		if v != nil {
+			return v.Value, nil
+		}
+	case *expression.AnyValue:
+		if v != nil {
+			return 0, fmt.Errorf("%w: the bound %q on %q was never read as a duration",
+				ErrFilterInvalid, v.Value, name)
+		}
+	}
+	return 0, fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only",
+		ErrFilterUnsupported, name)
+}
+
+// equalityText returns the text an equality on name compares against, which is
+// all a legacy field can hold.
+func equalityText(op expression.Operator, name string, value expression.Expression) (string, error) {
+	if op != expression.OpEq {
+		return "", unsupportedOperatorOn(op, name)
+	}
+	switch v := value.(type) {
+	case *expression.StringValue:
+		if v != nil {
+			return v.Value, nil
+		}
+	case *expression.AnyValue:
+		if v != nil {
+			return v.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+func unsupportedOperator(op expression.Operator) error {
+	return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, op)
+}
+
+func unsupportedOperatorOn(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func onlyOnePredicate(name string) error {
+	return fmt.Errorf("%w: it takes only one predicate on %q", ErrFilterUnsupported, name)
+}
+
+// attributeCount is m.Len(), except that it answers 0 for a Map left at its
+// zero value, whose methods would panic.
+func attributeCount(m pcommon.Map) int {
+	if m == (pcommon.Map{}) {
+		return 0
+	}
+	return m.Len()
+}
diff --git a/internal/storage/v2/api/tracestore/query_filter_test.go b/internal/storage/v2/api/tracestore/query_filter_test.go
new file mode 100644
index 0000000..59efd65
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_filter_test.go
@@ -0,0 +1,516 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"testing"
+	"time"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+func attrEq(key, value string) *expression.Call {
+	return call(expression.OpEq, &expression.AttributeRef{Key: key}, &expression.AnyValue{Value: value})
+}
+
+func serviceRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService}
+}
+
+func operationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName}
+}
+
+func durationRef() *expression.FieldRef {
+	return &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration}
+}
+
+func boundCall(op expression.Operator, d time.Duration) *expression.Call {
+	return call(op, durationRef(), &expression.DurationValue{Value: d})
+}
+
+func withFilter(filter *expression.Call) TraceQueryParams {
+	return TraceQueryParams{Attributes: pcommon.NewMap(), Filter: filter}
+}
+
+// legacyQuery is a query that sets every legacy predicate field, beside fields
+// that are not predicates and so survive every conversion.
+func legacyQuery() TraceQueryParams {
+	attrs := pcommon.NewMap()
+	attrs.PutStr("http.method", "GET")
+	attrs.PutStr("http.status_code", "500")
+	return TraceQueryParams{
+		ServiceName:   "cart",
+		OperationName: "GET /cart",
+		Attributes:    attrs,
+		StartTimeMin:  time.Unix(100, 0),
+		StartTimeMax:  time.Unix(200, 0),
+		DurationMin:   time.Second,
+		DurationMax:   2 * time.Second,
+		SearchDepth:   20,
+	}
+}
+
+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := attrEq("a", "1")
+	tests := []struct {
+		name    string
+		query   func() TraceQueryParams
+		wantErr string
+	}{
+		{name: "no filter", query: legacyQuery},
+		{name: "filter alone", query: func() TraceQueryParams { return withFilter(filter) }},
+		{
+			name: "filter with zero-value attributes",
+			query: func() TraceQueryParams {
+				return TraceQueryParams{Filter: filter}
+			},
+		},
+		{
+			name: "service name",
+			query: func() TraceQueryParams {
+				q := withFilter(filter)
+				q.ServiceName = "cart"
+				return q
+			},
+			wantErr: "[service_name]",
+		},
+		{
+			name: "operation name",
+			query: func() TraceQueryParams {
+				q := withFilter(filter)
+				q.OperationName = "op"
+				return q
+			},
+			wantErr: "[operation_name]",
+		},
+		{
+			name: "attributes",
+			query: func() TraceQueryParams {
+				q := withFilter(filter)
+				q.Attributes.PutStr("a", "1")
+				return q
+			},
+			wantErr: "[attributes]",
+		},
+		{
+			name: "every field, in order",
+			query: func() TraceQueryParams {
+				q := legacyQuery()
+				q.Filter = filter
+				return q
+			},
+			wantErr: "[service_name operation_name duration_min duration_max attributes]",
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			err := tt.query().EnsureFilterStandsAlone()
+			if tt.wantErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.ErrorContains(t, err, tt.wantErr)
+		})
+	}
+}
