index f09bb74..9189aac 100644
--- a/internal/storage/v2/api/tracestore/filter.go
+++ b/internal/storage/v2/api/tracestore/filter.go
@@ -5,6 +5,7 @@ package tracestore
 
 import (
 	"errors"
+	"fmt"
 	"slices"
 
 	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
@@ -54,3 +55,58 @@ func (c FilterCapabilities) SupportsLevel(level expression.Level) bool {
 func (c FilterCapabilities) SupportsOperator(op expression.Operator) bool {
 	return slices.Contains(c.Operators, op)
 }
+
+// EnsureSupported walks filter and refuses the first predicate the Reader did
+// not declare it can evaluate: an operator it did not list, or a reference to a
+// level it did not list. Constants need no support. A nil filter is supported.
+//
+// The refusal wraps ErrFilterUnsupported. A tree nested deeper than
+// expression.MaxNestingDepth, which is also how a tree that contains itself is
+// answered, is refused with ErrFilterInvalid instead.
+func (c FilterCapabilities) EnsureSupported(filter *expression.Call) error {
+	return c.ensureCallSupported(filter, 1)
+}
+
+func (c FilterCapabilities) ensureCallSupported(call *expression.Call, depth int) error {
+	if call == nil {
+		return nil
+	}
+	if depth > expression.MaxNestingDepth {
+		return fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if !c.SupportsOperator(call.Op) {
+		return fmt.Errorf("%w: it does not support the operator %q", ErrFilterUnsupported, call.Op)
+	}
+	for _, arg := range call.Args {
+		if nested, ok := arg.(*expression.Call); ok {
+			if err := c.ensureCallSupported(nested, depth+1); err != nil {
+				return err
+			}
+			continue
+		}
+		if level, ok := referenceLevel(arg); ok && !c.SupportsLevel(level) {
+			return fmt.Errorf("%w: it does not index the %q level", ErrFilterUnsupported, level)
+		}
+	}
+	return nil
+}
+
+// referenceLevel returns the level a reference names. Its second result is
+// false for anything that is not a reference, such as a constant.
+func referenceLevel(e expression.Expression) (expression.Level, bool) {
+	switch ref := e.(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	case *expression.NestedRef:
+		if ref != nil {
+			return ref.Level, true
+		}
+	}
+	return "", false
+}
