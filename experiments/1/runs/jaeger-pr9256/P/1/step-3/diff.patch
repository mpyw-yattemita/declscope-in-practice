+	assert.Equal(t, want, got)
+
+	require.NoError(t, expression.ValidateFilter(got.Filter))
+	resolved, err := expression.ResolveConstants(got.Filter)
+	require.NoError(t, err)
+	assert.Equal(t, got.Filter, resolved, "the filter needs no further resolution")
+}
