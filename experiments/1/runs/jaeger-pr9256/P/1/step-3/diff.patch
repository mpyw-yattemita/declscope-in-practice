+			call(expression.OpEq, serviceRef(), &expression.StringValue{Value: "cart"}),
+			call(expression.OpEq, operationRef(), &expression.StringValue{Value: "GET /cart"}),
+			attrEq("http.method", "GET"),
+			attrEq("http.status_code", "500"),
