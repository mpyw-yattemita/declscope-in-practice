+func TestForCapabilities(t *testing.T) {
+	declared := SearchCapabilities{Filter: &FilterCapabilities{
+		Operators: []expression.Operator{expression.OpEq},
+	}}
+
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		q := legacyQuery()
+		for _, caps := range []SearchCapabilities{{}, declared} {
+			got, err := q.ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Equal(t, q, got)
+		}
+	})
+
+	t.Run("no declaration gets the legacy shape", func(t *testing.T) {
+		for _, caps := range []SearchCapabilities{{}, {Filter: &FilterCapabilities{}}} {
+			got, err := withFilter(attrEq("a", "1")).ForCapabilities(caps)
+			require.NoError(t, err)
+			assert.Nil(t, got.Filter)
+			assert.Equal(t, map[string]any{"a": "1"}, got.Attributes.AsRaw())
+		}
+	})
+
+	t.Run("no declaration refuses what the legacy shape cannot hold", func(t *testing.T) {
+		q := withFilter(call(expression.OpNe, &expression.AttributeRef{Key: "a"}, &expression.AnyValue{Value: "1"}))
+		got, err := q.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("a declaring reader gets the filter as it is", func(t *testing.T) {
+		q := withFilter(attrEq("a", "1"))
+		got, err := q.ForCapabilities(declared)
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("a declaring reader refuses what it did not declare", func(t *testing.T) {
+		q := withFilter(call(expression.OpAnd, attrEq("a", "1"), attrEq("b", "2")))
+		got, err := q.ForCapabilities(declared)
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		require.ErrorContains(t, err, `it does not support the operator "and"`)
+		assert.Equal(t, q, got)
+	})
+}
