+// TestToLegacyShape_NilTerms covers a tree holding typed nil pointers, which a
+// caller can build and must be refused rather than dereferenced.
+func TestToLegacyShape_NilTerms(t *testing.T) {
+	tests := []struct {
+		name    string
+		filter  *expression.Call
+		wantErr string
+	}{
+		{"nil conjunct", call(expression.OpAnd, attrEq("a", "1"), (*expression.Call)(nil)), "conjunction of predicates only"},
+		{"nil attribute", call(expression.OpEq, (*expression.AttributeRef)(nil), &expression.AnyValue{}), "reference against a constant only"},
+		{"nil field", call(expression.OpEq, (*expression.FieldRef)(nil), &expression.AnyValue{}), "reference against a constant only"},
+		{"nil string", call(expression.OpEq, serviceRef(), (*expression.StringValue)(nil)), `compares "service" against a string constant only`},
+		{"nil untyped", call(expression.OpEq, serviceRef(), (*expression.AnyValue)(nil)), `compares "service" against a string constant only`},
+		{"nil duration", call(expression.OpGte, durationRef(), (*expression.DurationValue)(nil)), `compares "duration" against a duration`},
+		{"nil untyped duration", call(expression.OpGte, durationRef(), (*expression.AnyValue)(nil)), `compares "duration" against a duration`},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			_, err := withFilter(tt.filter).ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, tt.wantErr)
+		})
+	}
+}
