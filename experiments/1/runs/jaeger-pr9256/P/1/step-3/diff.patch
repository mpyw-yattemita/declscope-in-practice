+func TestToLegacyShape_Converts(t *testing.T) {
+	tests := []struct {
+		name   string
+		filter *expression.Call
+		want   func(*TraceQueryParams)
+	}{
+		{
+			name: "nested conjunctions are flattened",
+			filter: call(expression.OpAnd,
+				attrEq("a", "1"),
+				call(expression.OpAnd, attrEq("b", "2"), call(expression.OpAnd, attrEq("c", "3"), attrEq("d", "4")))),
+			want: func(q *TraceQueryParams) {
+				q.Attributes.PutStr("a", "1")
+				q.Attributes.PutStr("b", "2")
+				q.Attributes.PutStr("c", "3")
+				q.Attributes.PutStr("d", "4")
+			},
+		},
+		{
+			name: "qualified attributes widen to plain tags",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, &expression.AttributeRef{Key: "s", Level: expression.LevelSpan}, &expression.StringValue{Value: "1"}),
+				call(expression.OpEq, &expression.AttributeRef{Key: "r", Level: expression.LevelResource}, &expression.AnyValue{Value: "2"}),
+				call(expression.OpEq, &expression.AttributeRef{Key: "e", Level: expression.LevelEvent}, &expression.AnyValue{Value: "3"})),
+			want: func(q *TraceQueryParams) {
+				q.Attributes.PutStr("s", "1")
+				q.Attributes.PutStr("r", "2")
+				q.Attributes.PutStr("e", "3")
+			},
+		},
+		{
+			name: "service and operation against untyped constants",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, serviceRef(), &expression.AnyValue{Value: "cart"}),
+				call(expression.OpEq, operationRef(), &expression.AnyValue{Value: "GET"})),
+			want: func(q *TraceQueryParams) {
+				q.ServiceName = "cart"
+				q.OperationName = "GET"
+			},
+		},
+		{
+			name:   "a lone duration bound",
+			filter: boundCall(expression.OpGte, time.Millisecond),
+			want:   func(q *TraceQueryParams) { q.DurationMin = time.Millisecond },
+		},
+	}
+	for _, tt := range tests {
+		t.Run(tt.name, func(t *testing.T) {
+			want := TraceQueryParams{Attributes: pcommon.NewMap()}
+			tt.want(&want)
+			got, err := withFilter(tt.filter).ToLegacyShape()
+			require.NoError(t, err)
+			assert.Equal(t, want, got)
+		})
+	}
+}
