+			path:        "httproute/with_backend_client_certificate_listenerset.yml",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}, "web-8080": {Address: ":8080"}},
+			wantHTTP: map[string][]string{
+				"httproute-default-http-app-1-gw-default-my-gateway-ep-web-8080-0-864beead39d1bde171d3-svc-default-whoami-0": {"client-a.example.com"},
+			},
+			wantTCP: map[string][]string{},
+		},
+		{
+			desc:        "two Gateways",
+			path:        "httproute/with_backend_client_certificate_multiple_gateways.yml",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			wantHTTP: map[string][]string{
+				"httproute-default-http-app-1-gw-default-gateway-a-ep-web-0-98c6658361553bbad8fa-svc-default-whoami-0": {"client-a.example.com"},
+				"httproute-default-http-app-1-gw-default-gateway-b-ep-web-0-ed3ecf8fc279a4fa5c9f-svc-default-whoami-0": {"client-b.example.com"},
+			},
+			wantTCP: map[string][]string{},
+		},
+		{
+			desc:        "unresolved client certificate",
+			path:        "httproute/with_backend_client_certificate_unresolved.yml",
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			wantHTTP: map[string][]string{
+				"httproute-default-http-app-1-gw-default-my-gateway-ep-web-0-f20abd7604e9c4caa5f3-svc-default-whoami-0": nil,
+			},
+			wantTCP: map[string][]string{},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			k8sObjects, gwObjects := readResources(t, []string{"services.yml", test.path})
+
+			client := newClientImpl(kubefake.NewClientset(k8sObjects...), newGatewaySimpleClientSet(t, gwObjects...))
+
+			eventCh, err := client.WatchAll(nil, make(chan struct{}))
+			require.NoError(t, err)
+
+			// just wait for the first event
+			<-eventCh
+
+			p := Provider{
+				EntryPoints: test.entryPoints,
+				client:      client,
+			}
+
+			conf, _, err := p.loadConfigurationFromGateways(t.Context())
+			require.NoError(t, err)
+
+			gotHTTP := map[string][]string{}
+			for name, st := range conf.HTTP.ServersTransports {
+				gotHTTP[name] = nil
+				for _, cert := range st.Certificates {
+					gotHTTP[name] = append(gotHTTP[name], certificateCommonName(t, cert.CertFile))
+				}
+			}
+			gotTCP := map[string][]string{}
+			for name, st := range conf.TCP.ServersTransports {
+				gotTCP[name] = nil
+				for _, cert := range st.TLS.Certificates {
+					gotTCP[name] = append(gotTCP[name], certificateCommonName(t, cert.CertFile))
+				}
+			}
+
+			assert.Equal(t, test.wantHTTP, gotHTTP)
+			assert.Equal(t, test.wantTCP, gotTCP)
+
+			if test.noPolicyService == "" {
+				return
+			}
+			if httpService, ok := conf.HTTP.Services[test.noPolicyService]; ok {
+				require.NotNil(t, httpService.LoadBalancer)
+				assert.Empty(t, httpService.LoadBalancer.ServersTransport)
+				return
+			}
+			tcpService, ok := conf.TCP.Services[test.noPolicyService]
+			require.True(t, ok)
+			require.NotNil(t, tcpService.LoadBalancer)
+			assert.Empty(t, tcpService.LoadBalancer.ServersTransport)
+		})
+	}
