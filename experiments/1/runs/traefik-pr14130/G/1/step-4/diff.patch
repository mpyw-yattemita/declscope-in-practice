+// createHTTPRouteRequestMirror builds the RequestMirror middleware of an HTTPRoute filter, mirroring to serviceName.
+func createHTTPRouteRequestMirror(serviceName string, filter *gatev1.HTTPRequestMirrorFilter) *dynamic.Middleware {
+	// Without percent nor fraction, the spec mirrors every request.
+	numerator, denominator := int64(1), int64(1)
+
+	switch {
+	case filter.Percent != nil:
+		numerator, denominator = min(max(int64(*filter.Percent), 0), 100), 100
+
+	case filter.Fraction != nil:
+		denominator = int64(ptr.Deref(filter.Fraction.Denominator, 100))
+		if denominator <= 0 {
+			numerator, denominator = 0, 1
+		} else {
+			numerator = min(max(int64(filter.Fraction.Numerator), 0), denominator)
+		}
+	}
+
+	return &dynamic.Middleware{
+		RequestMirror: &dynamic.RequestMirror{
+			Service:     serviceName,
+			Numerator:   numerator,
+			Denominator: denominator,
+		},
+	}
+}
