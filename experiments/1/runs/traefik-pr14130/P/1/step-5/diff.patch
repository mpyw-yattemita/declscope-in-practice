+
+func TestClientWatchAll_clusterTrustBundlesSupport(t *testing.T) {
+	testCases := []struct {
+		desc      string
+		api       clusterTrustBundleAPI
+		resources []*metav1.APIResourceList
+		// failingVerb and failingResource designate the API request failing.
+		failingVerb         string
+		failingResource     string
+		expectedUnsupported error
+		expectedErr         string
+	}{
+		{
+			desc:                "API not served",
+			api:                 clusterTrustBundleAPINotServed,
+			expectedUnsupported: errClusterTrustBundlesNotServed,
+		},
+		{
+			desc: "group version served without clustertrustbundles",
+			api:  clusterTrustBundleAPIAllowed,
+			resources: []*metav1.APIResourceList{{
+				GroupVersion: "certificates.k8s.io/v1",
+				APIResources: []metav1.APIResource{{Name: "certificatesigningrequests"}},
+			}},
+			expectedUnsupported: errClusterTrustBundlesNotServed,
+		},
+		{
+			desc:                "only allowed to list",
+			api:                 clusterTrustBundleAPIForbidden,
+			expectedUnsupported: errClusterTrustBundlesNotAllowed,
+		},
+		{
+			desc: "allowed to list and watch",
+			api:  clusterTrustBundleAPIAllowed,
+		},
+		{
+			desc:            "discovery failure",
+			api:             clusterTrustBundleAPIAllowed,
+			failingVerb:     "get",
+			failingResource: "resource",
+			expectedErr:     "discovering certificates.k8s.io/v1 resources: boom",
+		},
+		{
+			desc:            "access review failure",
+			api:             clusterTrustBundleAPIAllowed,
+			failingVerb:     "create",
+			failingResource: "selfsubjectaccessreviews",
+			expectedErr:     "reviewing access to list clustertrustbundles: boom",
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			kubeClient := newKubeClientSet(test.api)
+			if test.resources != nil {
+				kubeClient.Resources = test.resources
+			}
+			if test.failingVerb != "" {
+				kubeClient.PrependReactor(test.failingVerb, test.failingResource, func(ktesting.Action) (bool, runtime.Object, error) {
+					return true, nil, errors.New("boom")
+				})
+			}
+
+			client := newClientImpl(kubeClient, newGatewaySimpleClientSet(t))
+
+			_, err := client.WatchAll(nil, make(chan struct{}))
+			if test.expectedErr != "" {
+				require.EqualError(t, err, test.expectedErr)
+				return
+			}
+			require.NoError(t, err)
+
+			assert.Equal(t, test.expectedUnsupported, client.ClusterTrustBundlesUnsupported())
+			assert.Equal(t, test.expectedUnsupported == nil, client.factoryClusterTrustBundle != nil)
+		})
+	}
+}
