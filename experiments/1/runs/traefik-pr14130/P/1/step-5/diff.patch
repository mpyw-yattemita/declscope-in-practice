+// clusterTrustBundleAPI is the state of the ClusterTrustBundle API seen by Traefik.
+type clusterTrustBundleAPI int
+
+const (
+	clusterTrustBundleAPINotServed clusterTrustBundleAPI = iota
+	// clusterTrustBundleAPIForbidden only allows listing, to check that watching is required too.
+	clusterTrustBundleAPIForbidden
+	clusterTrustBundleAPIAllowed
+)
+
+// newKubeClientSet returns a fake Kubernetes clientset serving the ClusterTrustBundle API in the given state.
+func newKubeClientSet(api clusterTrustBundleAPI, objects ...runtime.Object) *kubefake.Clientset {
+	kubeClient := kubefake.NewClientset(objects...)
+	if api == clusterTrustBundleAPINotServed {
+		return kubeClient
+	}
+
+	kubeClient.Resources = []*metav1.APIResourceList{{
+		GroupVersion: "certificates.k8s.io/v1",
+		APIResources: []metav1.APIResource{{Name: "clustertrustbundles", Kind: "ClusterTrustBundle"}},
+	}}
+	kubeClient.PrependReactor("create", "selfsubjectaccessreviews", func(action ktesting.Action) (bool, runtime.Object, error) {
+		review := action.(ktesting.CreateAction).GetObject().(*authorizationv1.SelfSubjectAccessReview).DeepCopy()
+		review.Status.Allowed = api == clusterTrustBundleAPIAllowed || review.Spec.ResourceAttributes.Verb == "list"
+		return true, review, nil
+	})
+
+	return kubeClient
+}
