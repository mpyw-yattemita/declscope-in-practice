+// checkClusterTrustBundlesSupport returns why ClusterTrustBundles cannot be watched, or nil when they can.
+// The returned error is not nil when the support cannot be determined.
+func (c *clientWrapper) checkClusterTrustBundlesSupport(ctx context.Context) (unsupported, err error) {
+	resources, err := c.csKube.Discovery().ServerResourcesForGroupVersion(certificatesv1.SchemeGroupVersion.String())
+	if err != nil {
+		if kerrors.IsNotFound(err) {
+			return errClusterTrustBundlesNotServed, nil
+		}
+		return nil, fmt.Errorf("discovering %s resources: %w", certificatesv1.SchemeGroupVersion, err)
+	}
+
+	if !slices.ContainsFunc(resources.APIResources, func(r metav1.APIResource) bool { return r.Name == "clustertrustbundles" }) {
+		return errClusterTrustBundlesNotServed, nil
+	}
+
+	for _, verb := range []string{"list", "watch"} {
+		review := &authorizationv1.SelfSubjectAccessReview{
+			Spec: authorizationv1.SelfSubjectAccessReviewSpec{
+				ResourceAttributes: &authorizationv1.ResourceAttributes{
+					Group:    certificatesv1.GroupName,
+					Resource: "clustertrustbundles",
+					Verb:     verb,
+				},
+			},
+		}
+
+		review, err = c.csKube.AuthorizationV1().SelfSubjectAccessReviews().Create(ctx, review, metav1.CreateOptions{})
+		if err != nil {
+			return nil, fmt.Errorf("reviewing access to %s clustertrustbundles: %w", verb, err)
+		}
+
+		if !review.Status.Allowed {
+			return errClusterTrustBundlesNotAllowed, nil
+		}
+	}
+
+	return nil, nil
+}
