index b740286..af3652a 100644
--- a/pkg/provider/kubernetes/gateway/httproute_test.go
+++ b/pkg/provider/kubernetes/gateway/httproute_test.go
@@ -323,3 +323,83 @@ func Test_createCORS(t *testing.T) {
 		})
 	}
 }
+
+func Test_httpRouteRequestMirrorRatio(t *testing.T) {
+	testCases := []struct {
+		desc                string
+		mirror              *gatev1.HTTPRequestMirrorFilter
+		expectedNumerator   int64
+		expectedDenominator int64
+	}{
+		{
+			desc:                "neither percent nor fraction",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{},
+			expectedNumerator:   1,
+			expectedDenominator: 1,
+		},
+		{
+			desc:                "percent",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Percent: new(int32(42))},
+			expectedNumerator:   42,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "negative percent",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Percent: new(int32(-1))},
+			expectedNumerator:   0,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "percent over 100",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Percent: new(int32(101))},
+			expectedNumerator:   100,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "fraction",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 1, Denominator: new(int32(3))}},
+			expectedNumerator:   1,
+			expectedDenominator: 3,
+		},
+		{
+			desc:                "fraction without denominator",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 5}},
+			expectedNumerator:   5,
+			expectedDenominator: 100,
+		},
+		{
+			desc:                "fraction with zero denominator",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 5, Denominator: new(int32(0))}},
+			expectedNumerator:   0,
+			expectedDenominator: 1,
+		},
+		{
+			desc:                "fraction with negative denominator",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 5, Denominator: new(int32(-2))}},
+			expectedNumerator:   0,
+			expectedDenominator: 1,
+		},
+		{
+			desc:                "fraction with numerator over denominator",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: 3, Denominator: new(int32(2))}},
+			expectedNumerator:   2,
+			expectedDenominator: 2,
+		},
+		{
+			desc:                "fraction with negative numerator",
+			mirror:              &gatev1.HTTPRequestMirrorFilter{Fraction: &gatev1.Fraction{Numerator: -1, Denominator: new(int32(2))}},
+			expectedNumerator:   0,
+			expectedDenominator: 2,
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			numerator, denominator := httpRouteRequestMirrorRatio(test.mirror)
+			assert.Equal(t, test.expectedNumerator, numerator)
+			assert.Equal(t, test.expectedDenominator, denominator)
+		})
+	}
+}
