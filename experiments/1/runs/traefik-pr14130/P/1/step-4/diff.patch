+// loadHTTPRouteRequestMirror returns the middleware of a RequestMirror filter, and loads its backend in conf.
+// It returns nil when the mirror is invalid: as per the spec, an invalid mirror must not fail the request.
+func (p *Provider) loadHTTPRouteRequestMirror(ctx context.Context, gatewayName, gatewayNamespace string, listener gatewayListener, conf *dynamic.Configuration, route *gatev1.HTTPRoute, name string, mirror *gatev1.HTTPRequestMirrorFilter, statusReport *statusReport) *dynamic.Middleware {
+	if mirror == nil {
+		log.Ctx(ctx).Debug().Msgf("Ignoring HTTPRoute RequestMirror filter %s: requestMirror undefined", name)
+		return nil
+	}
+
+	backendRef := gatev1.HTTPBackendRef{BackendRef: gatev1.BackendRef{BackendObjectReference: mirror.BackendRef}}
+	// The rule backendRequest timeout bounds the request to the rule backends, not to the mirrors.
+	serviceName, errCondition := p.loadService(ctx, gatewayName, gatewayNamespace, listener, conf, name, route, 0, backendRef, 0, nil, statusReport)
+	if errCondition != nil {
+		log.Ctx(ctx).Debug().Msgf("Ignoring HTTPRoute RequestMirror filter %s: %s", name, errCondition.Message)
+		return nil
+	}
+
+	numerator, denominator := httpRouteRequestMirrorRatio(mirror)
+
+	return &dynamic.Middleware{
+		RequestMirror: &dynamic.RequestMirror{
+			Service:     serviceName,
+			Numerator:   numerator,
+			Denominator: denominator,
+		},
+	}
+}
+
+// httpRouteRequestMirrorRatio returns the numerator and denominator of the requests to mirror.
+func httpRouteRequestMirrorRatio(mirror *gatev1.HTTPRequestMirrorFilter) (int64, int64) {
+	switch {
+	case mirror.Percent != nil:
+		return int64(min(max(*mirror.Percent, 0), 100)), 100
+
+	case mirror.Fraction != nil:
+		denominator := int64(ptr.Deref(mirror.Fraction.Denominator, 100))
+		if denominator <= 0 {
+			return 0, 1
+		}
+		return min(max(int64(mirror.Fraction.Numerator), 0), denominator), denominator
+
+	default:
+		return 1, 1
+	}
+}
