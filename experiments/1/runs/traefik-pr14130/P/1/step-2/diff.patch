diff --git a/docs/content/reference/routing-configuration/kubernetes/gateway-api.md b/docs/content/reference/routing-configuration/kubernetes/gateway-api.md
index 2503d41..69364c7 100644
--- a/docs/content/reference/routing-configuration/kubernetes/gateway-api.md
+++ b/docs/content/reference/routing-configuration/kubernetes/gateway-api.md
@@ -144,12 +144,19 @@ spec:
 
 The `tls.backend.clientCertificateRef` field on a `Gateway` (`spec.tls.backend`, a sibling of `spec.listeners`) sets the client certificate that Traefik presents to backends that require mutual TLS (mTLS), as defined by [GEP-3155](https://gateway-api.sigs.k8s.io/geps/gep-3155/).
 
-Traefik presents the certificate to the backends selected by a [BackendTLSPolicy](https://gateway-api.sigs.k8s.io/reference/api-types/policy/backendtlspolicy/), for `HTTPRoute` and `GRPCRoute` routes.
+Traefik presents the certificate to the backends selected by a [BackendTLSPolicy](https://gateway-api.sigs.k8s.io/reference/api-types/policy/backendtlspolicy/), for `HTTPRoute` and `GRPCRoute` routes, and for `TLSRoute` routes in `Terminate` mode.
 Backends without a `BackendTLSPolicy` are not affected, because the field does not enable TLS by itself.
 The listeners of a `ListenerSet` use the certificate of their parent `Gateway`.
 
 The reference must point to a core `Secret` that contains the `tls.crt` and `tls.key` entries.
 A `Secret` in another namespace requires a [ReferenceGrant](https://gateway-api.sigs.k8s.io/reference/api-types/referencegrant/) in that namespace.
+When the reference cannot be resolved, Traefik presents no client certificate, and sets the `ResolvedRefs` condition of the `Gateway` status to `False`:
+
+| Problem | Reason |
+| --- | --- |
+| The reference is not a core `Secret` | `InvalidClientCertificateRef` |
+| The `Secret` is missing, or does not hold a valid certificate and key | `InvalidClientCertificateRef` |
+| The `Secret` is in another namespace and no `ReferenceGrant` allows it | `RefNotPermitted` |
 
 ```yaml
 ---
diff --git a/pkg/provider/kubernetes/gateway/backend_client_certificate.go b/pkg/provider/kubernetes/gateway/backend_client_certificate.go
new file mode 100644
index 0000000..7c71119
--- /dev/null
+++ b/pkg/provider/kubernetes/gateway/backend_client_certificate.go
@@ -0,0 +1,53 @@
+package gateway
+
+import (
+	"fmt"
+
+	"github.com/traefik/traefik/v3/pkg/tls"
+	metav1 "k8s.io/apimachinery/pkg/apis/meta/v1"
+	"k8s.io/utils/ptr"
+	gatev1 "sigs.k8s.io/gateway-api/apis/v1"
+)
+
+// loadBackendClientCertificate returns the client certificate the Gateway presents to the backends
+// targeted by a BackendTLSPolicy (GEP-3155), or the Gateway ResolvedRefs condition explaining why it cannot be resolved.
+// It returns no certificate when the Gateway references none.
+func (p *Provider) loadBackendClientCertificate(gateway *gatev1.Gateway) (tls.Certificates, *metav1.Condition) {
+	if gateway.Spec.TLS == nil || gateway.Spec.TLS.Backend == nil || gateway.Spec.TLS.Backend.ClientCertificateRef == nil {
+		return nil, nil
+	}
+
+	ref := gateway.Spec.TLS.Backend.ClientCertificateRef
+
+	group := ptr.Deref(ref.Group, "")
+	kind := ptr.Deref(ref.Kind, kindSecret)
+	if (group != "" && group != groupCore) || kind != kindSecret {
+		return nil, newBackendClientCertificateCondition(gateway, gatev1.GatewayReasonInvalidClientCertificateRef,
+			fmt.Sprintf("Unsupported ClientCertificateRef group/kind: %s/%s", group, kind))
+	}
+
+	namespace := string(ptr.Deref(ref.Namespace, gatev1.Namespace(gateway.Namespace)))
+	if err := p.isReferenceGranted(kindGateway, gateway.Namespace, groupCore, kindSecret, string(ref.Name), namespace); err != nil {
+		return nil, newBackendClientCertificateCondition(gateway, gatev1.GatewayReasonRefNotPermitted,
+			fmt.Sprintf("Cannot reference ClientCertificateRef %s/%s: %s", namespace, ref.Name, err))
+	}
+
+	cert, err := p.getTLSCert(ref.Name, namespace)
+	if err != nil {
+		return nil, newBackendClientCertificateCondition(gateway, gatev1.GatewayReasonInvalidClientCertificateRef,
+			fmt.Sprintf("Cannot load ClientCertificateRef %s/%s: %s", namespace, ref.Name, err))
+	}
+
+	return tls.Certificates{cert.Certificate}, nil
+}
+
+func newBackendClientCertificateCondition(gateway *gatev1.Gateway, reason gatev1.GatewayConditionReason, message string) *metav1.Condition {
+	return &metav1.Condition{
+		Type:               string(gatev1.GatewayConditionResolvedRefs),
+		Status:             metav1.ConditionFalse,
+		ObservedGeneration: gateway.Generation,
+		LastTransitionTime: metav1.Now(),
+		Reason:             string(reason),
+		Message:            message,
+	}
+}
