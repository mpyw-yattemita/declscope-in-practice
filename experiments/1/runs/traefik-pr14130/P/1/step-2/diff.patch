+func Test_loadConfigurationFromGateways_BackendClientCertificate(t *testing.T) {
+	testCases := []struct {
+		desc        string
+		paths       []string
+		entryPoints map[string]Entrypoint
+		// expected maps the name of each generated ServersTransport to the common names of its client certificates.
+		expectedHTTP map[string][]string
+		expectedTCP  map[string][]string
+	}{
+		{
+			desc:        "HTTPRoute",
+			paths:       []string{"services.yml", "httproute/with_backend_client_certificate.yml"},
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			expectedHTTP: map[string][]string{
+				"httproute-default-http-app-1-gw-default-my-gateway-ep-web-0-8471cdfe3fef3d93c07c-svc-default-whoami-0": {"example.com"},
+			},
+			expectedTCP: map[string][]string{},
+		},
+		{
+			desc:        "GRPCRoute",
+			paths:       []string{"services.yml", "grpcroute/with_backend_client_certificate.yml"},
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			expectedHTTP: map[string][]string{
+				"grpcroute-default-grpc-app-1-gw-default-my-gateway-ep-web-0-0abda411573f19f36296-svc-default-whoami-0": {"example.com"},
+			},
+			expectedTCP: map[string][]string{},
+		},
+		{
+			desc:         "TLSRoute",
+			paths:        []string{"services.yml", "tlsroute/with_backend_client_certificate.yml"},
+			entryPoints:  map[string]Entrypoint{"tls": {Address: ":9001"}},
+			expectedHTTP: map[string][]string{},
+			expectedTCP: map[string][]string{
+				"tlsroute-default-tls-app-1-gw-default-my-gateway-ep-tls-0-5c999a999d12ac0531c5-svc-default-whoami-0": {"bar.example.com"},
+			},
+		},
+		{
+			desc:        "ListenerSet uses the client certificate of its parent Gateway",
+			paths:       []string{"services.yml", "mixed/with_listenerset_backend_client_certificate.yml"},
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			expectedHTTP: map[string][]string{
+				"httproute-default-http-app-1-gw-default-my-gateway-ep-web-0-a94fdc274e011d680351-svc-default-whoami-0": {"example.com"},
+			},
+			expectedTCP: map[string][]string{},
+		},
+		{
+			desc:        "two Gateways present their own client certificate",
+			paths:       []string{"services.yml", "mixed/with_multiple_gateways_backend_client_certificates.yml"},
+			entryPoints: map[string]Entrypoint{"web": {Address: ":80"}},
+			expectedHTTP: map[string][]string{
+				"httproute-default-http-app-1-gw-default-gateway-bar-ep-web-0-56a5ab5333ea1e8937fc-svc-default-whoami-0": {"bar.example.com"},
+				"httproute-default-http-app-1-gw-default-gateway-foo-ep-web-0-d7e4dd2a9165724adf47-svc-default-whoami-0": {"foo.example.com"},
+			},
+			expectedTCP: map[string][]string{},
+		},
+	}
+
+	for _, test := range testCases {
+		t.Run(test.desc, func(t *testing.T) {
+			t.Parallel()
+
+			k8sObjects, gwObjects := readResources(t, test.paths)
+
+			client := newClientImpl(kubefake.NewClientset(k8sObjects...), newGatewaySimpleClientSet(t, gwObjects...))
+
+			eventCh, err := client.WatchAll(nil, make(chan struct{}))
+			require.NoError(t, err)
+
+			// just wait for the first event
+			<-eventCh
+
+			p := Provider{
+				EntryPoints: test.entryPoints,
+				client:      client,
+			}
+
+			conf, _, err := p.loadConfigurationFromGateways(t.Context())
+			require.NoError(t, err)
+
+			commonNames := func(certs tls.Certificates) []string {
+				names := []string{}
+				for _, cert := range certs {
+					names = append(names, certificateCommonName(t, cert.CertFile))
+				}
+				return names
+			}
+
+			gotHTTP := map[string][]string{}
+			for name, st := range conf.HTTP.ServersTransports {
+				gotHTTP[name] = commonNames(st.Certificates)
+			}
+			assert.Equal(t, test.expectedHTTP, gotHTTP)
+
+			gotTCP := map[string][]string{}
+			for name, st := range conf.TCP.ServersTransports {
+				require.NotNil(t, st.TLS)
+				gotTCP[name] = commonNames(st.TLS.Certificates)
+			}
+			assert.Equal(t, test.expectedTCP, gotTCP)
+		})
+	}
+}
