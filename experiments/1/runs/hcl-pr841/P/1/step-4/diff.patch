+func TestParseExpression(t *testing.T) {
+	tests := []struct {
+		src       string
+		wantBytes string
+		wantVars  int
+		wantKind  string // "object", "call", "tuple" or "" for unstructured
+	}{
+		{src: `1`, wantBytes: `1`},
+		{src: `true`, wantBytes: `true`},
+		{src: `null`, wantBytes: `null`},
+		{src: `"hello"`, wantBytes: `"hello"`},
+		{src: `"hello ${name}"`, wantBytes: `"hello ${name}"`, wantVars: 1},
+		{src: "<<EOT\nhello\nEOT\n", wantBytes: "<<EOT\nhello\nEOT"},
+		{src: `foo`, wantBytes: `foo`, wantVars: 1},
+		{src: `foo.bar[0].baz`, wantBytes: `foo.bar[0].baz`, wantVars: 1},
+		{src: `a + b * 2`, wantBytes: `a + b * 2`, wantVars: 2},
+		{src: `cond ? x : y`, wantBytes: `cond ? x : y`, wantVars: 3},
+		{src: `[for x in xs : x]`, wantBytes: `[for x in xs : x]`, wantVars: 1},
+		{src: `{}`, wantBytes: `{}`, wantKind: "object"},
+		{src: `{ hat = "derby" }`, wantBytes: `{ hat = "derby" }`, wantKind: "object"},
+		{src: `{ "hat" = "derby" }`, wantBytes: `{ "hat" = "derby" }`, wantKind: "object"},
+		{src: `{ (var.k) = 1 }`, wantBytes: `{ (var.k) = 1 }`, wantVars: 1, wantKind: "object"},
+		{src: `{ hat: "derby" }`, wantBytes: `{ hat: "derby" }`, wantKind: "object"},
+		{src: `{ hat = var.hat }`, wantBytes: `{ hat = var.hat }`, wantVars: 1, wantKind: "object"},
+		{
+			src:       "{\n  # lead\n  a = 1 # line\n  b = {\n    c = [d]\n  }\n}",
+			wantBytes: "{\n  # lead\n  a = 1 # line\n  b = {\n    c = [d]\n  }\n}",
+			wantVars:  1,
+			wantKind:  "object",
+		},
+		{src: `f()`, wantBytes: `f()`, wantKind: "call"},
+		{src: `join(" ", ["a", b])`, wantBytes: `join(" ", ["a", b])`, wantVars: 1, wantKind: "call"},
+		{src: `provider::p::f(x)`, wantBytes: `provider::p::f(x)`, wantVars: 1, wantKind: "call"},
+		{src: `f(xs...)`, wantBytes: `f(xs...)`, wantVars: 1, wantKind: "call"},
+		{src: `[]`, wantBytes: `[]`, wantKind: "tuple"},
+		{src: `[1, [2, x], { k = f(y) }]`, wantBytes: `[1, [2, x], { k = f(y) }]`, wantVars: 2, wantKind: "tuple"},
+		{src: "# foo\n\n1\n# bar", wantBytes: `1`},
+		{src: "\n\n  { a = 1 } // trailing\n\n", wantBytes: `{ a = 1 }`, wantKind: "object"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.src, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(test.src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags)
+			}
+
+			if got := string(expr.BuildTokens(nil).Bytes()); got != test.wantBytes {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, test.wantBytes)
+			}
+			if got := len(expr.Variables()); got != test.wantVars {
+				t.Errorf("wrong number of variables %d; want %d", got, test.wantVars)
+			}
+
+			gotKind := ""
+			switch {
+			case expr.AsObjectConsExpr() != nil:
+				gotKind = "object"
+			case expr.AsFunctionCallExpr() != nil:
+				gotKind = "call"
+			case expr.AsTupleConsExpr() != nil:
+				gotKind = "tuple"
+			}
+			if gotKind != test.wantKind {
+				t.Errorf("wrong kind %q; want %q", gotKind, test.wantKind)
+			}
+
+			// The tree must match the one ParseConfig builds for the same
+			// expression as an attribute value.
+			file, diags := ParseConfig([]byte("a ="+test.wantBytes+"\n"), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics from ParseConfig: %s", diags)
+			}
+			want := makeTestTree(file.Body().GetAttribute("a").expr)
+			got := makeTestTree(newNode(expr))
+			if diff := cmp.Diff(want, got); diff != "" {
+				t.Errorf("tree differs from ParseConfig\n%s", diff)
+			}
+		})
+	}
+}
+
