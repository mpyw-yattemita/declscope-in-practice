+func TestBodySetAttribute(t *testing.T) {
+	tests := []struct {
+		src  string
+		want string
+	}{
+		{
+			"",
+			"a = { hat = \"derby\" }\n",
+		},
+		{
+			"b = 1\n",
+			"b = 1\na = { hat = \"derby\" }\n",
+		},
+		{
+			"# lead\na = 1 # line\nb = 2\n",
+			"# lead\na = { hat = \"derby\" } # line\nb = 2\n",
+		},
+	}
+
+	for _, test := range tests {
+		t.Run(test.src, func(t *testing.T) {
+			f, diags := ParseConfig([]byte(test.src), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags)
+			}
+			expr, diags := ParseExpression([]byte(`{ hat = "derby" }`), "", hcl.InitialPos)
+			if diags.HasErrors() {
+				t.Fatalf("unexpected diagnostics: %s", diags)
+			}
+
+			attr := f.Body().SetAttribute("a", expr)
+			if attr != f.Body().GetAttribute("a") {
+				t.Errorf("returned attribute is not the one in the body")
+			}
+			if attr.Expr() != expr {
+				t.Errorf("attribute does not hold the given expression")
+			}
+			obj := f.Body().GetAttribute("a").Expr().AsObjectConsExpr()
+			if obj == nil {
+				t.Fatalf("expression lost its object-construct structure")
+			}
+
+			// The structure stays editable after attaching.
+			obj.SetItemValue("hat", cty.StringVal("fedora"))
+			want := strings.Replace(test.want, "derby", "fedora", 1)
+			if got := string(f.Bytes()); got != want {
+				t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, want)
+			}
+		})
+	}
+}
+
+func TestBodySetAttribute_AttachedExpression(t *testing.T) {
+	f := NewEmptyFile()
+	expr, _ := ParseExpression([]byte(`1`), "", hcl.InitialPos)
+	f.Body().SetAttribute("a", expr)
+
+	defer func() {
+		if recover() == nil {
+			t.Errorf("expected panic when reusing an attached expression")
+		}
+	}()
+	f.Body().SetAttribute("b", expr)
+}
