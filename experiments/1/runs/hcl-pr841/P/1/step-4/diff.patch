+// parseStandaloneExpression is like parse, but for a single expression
+// rather than a whole config file. Any comments and newlines around the
+// expression, and any spaces before it, are not included in the result.
+//
+// If the parsing step produces any errors, the returned Expression is nil.
+func parseStandaloneExpression(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	from, lexDiags := lexInputTokens(src, filename, start)
+	if lexDiags.HasErrors() {
+		// should never happen, since we would've caught these diags in
+		// the first call above.
+		return nil, lexDiags
+	}
+
+	_, within, _ := from.Partition(nativeExpr.Range())
+	if within.Len() > 0 {
+		// Spaces before the first token belong to the surrounding source,
+		// not to the expression.
+		within.writerTokens[0].SpacesBefore = 0
+	}
+	return parseExpression(nativeExpr, within).content.(*Expression), diags
+}
+
+// lexInputTokens lexes the given source and returns both the "native"
+// tokens (those from hclsyntax) and the equivalent "writer" tokens.
+//
+// To do our work, we use the native tokens to match against source ranges
+// in the AST, but ultimately produce slices from our sequence of writer
+// tokens, which contain only *relative* position information that is more
+// appropriate for transformation/writing use-cases.
+func lexInputTokens(src []byte, filename string, start hcl.Pos) (inputTokens, hcl.Diagnostics) {
+	nativeTokens, diags := hclsyntax.LexConfig(src, filename, start)
+	return inputTokens{
+		nativeTokens: nativeTokens,
+		writerTokens: writerTokens(nativeTokens),
+	}, diags
+}
+
 type inputTokens struct {
 	nativeTokens hclsyntax.Tokens
 	writerTokens Tokens
