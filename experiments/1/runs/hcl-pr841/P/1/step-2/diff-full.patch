+// Items returns the items of the object, in source order.
+func (o *ObjectConsExpr) Items() []*ObjectConsItem {
+	nodes := o.items.List()
+	items := make([]*ObjectConsItem, len(nodes))
+	for i, n := range nodes {
+		items[i] = n.content.(*ObjectConsItem)
+	}
+	return items
+}
 
