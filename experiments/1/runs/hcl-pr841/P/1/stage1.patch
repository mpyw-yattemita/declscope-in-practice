+		{
+			"a = { \"$${hat}\" = \"derby\" }\n",
+			"${hat}",
+			"a = { \"$${hat}\" = \"bowler\" }\n",
+		},
+		{
+			"a = {\n  hat = \"derby\" # comment\n  cat = \"calico\"\n}\n",
+			"hat",
+			"a = {\n  hat = \"bowler\" # comment\n  cat = \"calico\"\n}\n",
+		},
+		{
+			"a = {\n  hat = {\n    band = \"red\"\n  }\n}\n",
+			"hat",
+			"a = {\n  hat = \"bowler\"\n}\n",
+		},
+		{
+			// A key from a variable is not the same key, so a new item is added.
+			"a = { (hat) = \"derby\" }\n",
+			"hat",
+			"a = { (hat) = \"derby\", hat = \"bowler\" }\n",
+		},
+	}
