 // Detach removes the receiver from the list it currently belongs to. If the
 // node is not currently in a list, this is a no-op.
 func (n *node) Detach() {
 	if n.list == nil {
 		return
 	}
 	if n.before != nil {
 		n.before.after = n.after
 	}
 	if n.after != nil {
 		n.after.before = n.before
 	}
 	if n.list.first == n {
 		n.list.first = n.after
 	}
 	if n.list.last == n {
