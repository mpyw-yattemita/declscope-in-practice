+// ValueExprFor returns the value of the item that ItemFor finds for the given
+// key, or nil if there is no such item.
+func (o *ObjectConsExpr) ValueExprFor(key string) *ObjectConsValue {
+	item := o.ItemFor(key)
+	if item == nil {
