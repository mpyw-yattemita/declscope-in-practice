diff --git a/hclwrite/ast_body_test.go b/hclwrite/ast_body_test.go
index 7934c34..f1f09de 100644
--- a/hclwrite/ast_body_test.go
+++ b/hclwrite/ast_body_test.go
@@ -2193,3 +2193,90 @@ func testFn[E any](t *testing.T) func(value E, diags hcl.Diagnostics) E {
 		return value
 	}
 }
+
+func TestBodySetAttribute(t *testing.T) {
+	tests := map[string]struct {
+		src  string
+		expr string
+		want string
+	}{
+		"new attribute in empty body": {
+			src:  "",
+			expr: `{ hat = "derby" }`,
+			want: "a = { hat = \"derby\" }\n",
+		},
+		"new attribute after existing ones": {
+			src:  "b = 1\n",
+			expr: `f(x)`,
+			want: "b = 1\na = f(x)\n",
+		},
+		"replace existing attribute": {
+			src:  "a = 1 # one\nb = 2\n",
+			expr: "[\n  \"fedora\",\n]",
+			want: "a = [\n  \"fedora\",\n] # one\nb = 2\n",
+		},
+		"comments around the expression are dropped": {
+			src:  "a = 1\n",
+			expr: "# foo\n\nvar.b\n# bar",
+			want: "a = var.b\n",
+		},
+	}
+
+	for name, test := range tests {
+		t.Run(name, func(t *testing.T) {
+			f := testFn[*File](t)(ParseConfig([]byte(test.src), "", hcl.Pos{Line: 1, Column: 1}))
+			expr := testFn[*Expression](t)(ParseExpression([]byte(test.expr), "", hcl.Pos{Line: 1, Column: 1}))
+
+			attr := f.Body().SetAttribute("a", expr)
+			if attr != f.Body().GetAttribute("a") {
+				t.Errorf("returned attribute is not the one in the body")
+			}
+			if attr.Expr() != expr {
+				t.Errorf("attribute does not hold the given expression")
+			}
+
+			got := string(Format(f.Bytes()))
+			if got != test.want {
+				t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, test.want)
+			}
+		})
+	}
+}
+
+func TestBodySetAttribute_KeepsStructure(t *testing.T) {
+	f := NewFile()
+	expr := testFn[*Expression](t)(ParseExpression([]byte(`{ hat = "derby" }`), "", hcl.Pos{Line: 1, Column: 1}))
+
+	f.Body().SetAttribute("a", expr)
+
+	object := f.Body().GetAttribute("a").Expr().AsObjectConsExpr()
+	if object == nil {
+		t.Fatalf("AsObjectConsExpr returned nil")
+	}
+	if got := len(object.Items()); got != 1 {
+		t.Fatalf("wrong number of items: got %d, want 1", got)
+	}
+
+	// Changes through the structured expression show up in the file.
+	object.SetItemValue("hat", cty.StringVal("fedora"))
+	want := "a = { hat = \"fedora\" }\n"
+	if got := string(Format(f.Bytes())); got != want {
+		t.Errorf("wrong result\ngot:\n%s\nwant:\n%s", got, want)
+	}
+}
+
+func TestBodySetAttribute_AttachedExpression(t *testing.T) {
+	f := testFn[*File](t)(ParseConfig([]byte("a = 1\nb = 2\n"), "", hcl.Pos{Line: 1, Column: 1}))
+	expr := f.Body().GetAttribute("a").Expr()
+
+	for _, name := range []string{"b", "c"} {
+		t.Run(name, func(t *testing.T) {
+			defer func() {
+				if recover() == nil {
+					t.Errorf("expected a panic when setting an attached expression")
+				}
+			}()
+			f.Body().SetAttribute(name, expr)
+		})
+	}
+}
