+func TestParseExpression(t *testing.T) {
+	tests := []struct {
+		name string
+		src  string
+		// want is the source of the expression alone, without any
+		// surrounding comments or newlines.
+		want string
+		// wantWrapped is the type of the structured expression wrapped by
+		// the result, or "" if the expression is kept as tokens.
+		wantWrapped string
+	}{
+		{"number", `1`, `1`, ""},
+		{"bool", `true`, `true`, ""},
+		{"null", `null`, `null`, ""},
+		{"quoted string", `"hello"`, `"hello"`, "quoted"},
+		{"template", `"hello ${name}!"`, `"hello ${name}!"`, ""},
+		{"template directive", `"%{ if a }b%{ endif }"`, `"%{ if a }b%{ endif }"`, ""},
+		{"heredoc", "<<EOT\nhello ${name}\nEOT\n", "<<EOT\nhello ${name}\nEOT", ""},
+		{"traversal", `a.b[0].c`, `a.b[0].c`, ""},
+		{"binary operation", `a + b * 2`, `a + b * 2`, ""},
+		{"conditional", `a ? b : c`, `a ? b : c`, ""},
+		{"for expression", `[for x in xs : x]`, `[for x in xs : x]`, ""},
+		{"splat", `a[*].b`, `a[*].b`, ""},
+		{"comments and blank lines", "# foo\n\n1\n# bar", `1`, ""},
+		{"block comments", "/* foo */ 1 /* bar */", `1`, ""},
+		{"leading spaces", "   1", `1`, ""},
+		{"indented after comment", "# foo\n  { a = 1 }\n", `{ a = 1 }`, "ObjectConsExpr"},
+		{"empty object", `{}`, `{}`, "ObjectConsExpr"},
+		{"object with identifier key", `{ hat = "derby" }`, `{ hat = "derby" }`, "ObjectConsExpr"},
+		{"object with quoted key", `{ "hat" = "derby" }`, `{ "hat" = "derby" }`, "ObjectConsExpr"},
+		{"object with colon", `{ hat: "derby" }`, `{ hat: "derby" }`, "ObjectConsExpr"},
+		{"object with parenthesized key", `{ (var.hat) = "derby" }`, `{ (var.hat) = "derby" }`, "ObjectConsExpr"},
+		{"object with template key", `{ "${a}b" = "derby" }`, `{ "${a}b" = "derby" }`, "ObjectConsExpr"},
+		{"object with traversal key", `{ var.hat = "derby" }`, `{ var.hat = "derby" }`, "ObjectConsExpr"},
+		{
+			"multi-line object",
+			"{\n  hat   = \"derby\" # hat\n  shoes = var.shoes,\n}",
+			"{\n  hat   = \"derby\" # hat\n  shoes = var.shoes,\n}",
+			"ObjectConsExpr",
+		},
+		{
+			"nested object",
+			`{ a = { b = { c = 1 } }, d = [1, 2] }`,
+			`{ a = { b = { c = 1 } }, d = [1, 2] }`,
+			"ObjectConsExpr",
+		},
+		{"function call", `f()`, `f()`, "FunctionCallExpr"},
+		{"function call with arguments", `max(a, 2, { b = 3 })`, `max(a, 2, { b = 3 })`, "FunctionCallExpr"},
+		{"function call with ellipsis", `max(xs...)`, `max(xs...)`, "FunctionCallExpr"},
+		{"namespaced function call", `provider::foo::bar(1)`, `provider::foo::bar(1)`, "FunctionCallExpr"},
+		{"empty tuple", `[]`, `[]`, "TupleConsExpr"},
+		{"tuple", `["fedora", f(), { a = 1 }]`, `["fedora", f(), { a = 1 }]`, "TupleConsExpr"},
+		{"multi-line tuple", "[\n  \"fedora\", # hat\n  f(),\n]", "[\n  \"fedora\", # hat\n  f(),\n]", "TupleConsExpr"},
+	}
+
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(test.src), "", hcl.Pos{Line: 1, Column: 1})
+			if len(diags) > 0 {
+				for _, diag := range diags {
+					t.Logf(" - %s", diag.Error())
+				}
+				t.Fatalf("unexpected diagnostics")
+			}
+
+			if got := string(expr.BuildTokens(nil).Bytes()); got != test.want {
+				t.Errorf("wrong tokens\ngot:  %q\nwant: %q", got, test.want)
+			}
+
+			gotWrapped := ""
+			if expr.wrapped != nil {
+				gotWrapped = makeTestTree(expr.wrapped).Type
+			}
+			if gotWrapped != test.wantWrapped {
+				t.Errorf("wrong wrapped expression type\ngot:  %q\nwant: %q", gotWrapped, test.wantWrapped)
+			}
+
+			// The result must have the same structure that ParseConfig
+			// builds for the same expression as an attribute value.
+			file, diags := ParseConfig([]byte("a ="+test.want+"\n"), "", hcl.Pos{Line: 1, Column: 1})
+			if len(diags) > 0 {
+				for _, diag := range diags {
+					t.Logf(" - %s", diag.Error())
+				}
+				t.Fatalf("unexpected diagnostics from ParseConfig")
+			}
+			want := makeTestTree(file.Body().GetAttribute("a").expr)
+			got := makeTestTree(newNode(expr))
+			if !cmp.Equal(got, want) {
+				t.Errorf("wrong tree\ndiff:\n%s", cmp.Diff(want, got))
+			}
+		})
+	}
+}
+
+func TestParseExpression_Invalid(t *testing.T) {
+	tests := []string{
+		``,
+		`a =`,
+		`1 2`,
+		`{ a = }`,
+		`f(`,
+		"a = 1\n",
+	}
+
+	for _, src := range tests {
+		t.Run(src, func(t *testing.T) {
+			expr, diags := ParseExpression([]byte(src), "", hcl.Pos{Line: 1, Column: 1})
+			if !diags.HasErrors() {
+				t.Errorf("expected error diagnostics, got none")
+			}
+			if expr != nil {
+				t.Errorf("expected nil expression, got %q", expr.BuildTokens(nil).Bytes())
+			}
+		})
+	}
+}
