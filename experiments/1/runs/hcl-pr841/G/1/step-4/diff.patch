+// parseExpressionSource is like parse but for a single expression. Comments,
+// newlines and spaces before and after the expression are not part of the
+// result.
+//
+// If parsing produces any errors, the returned Expression is nil.
+func parseExpressionSource(src []byte, filename string, start hcl.Pos) (*Expression, hcl.Diagnostics) {
+	nativeExpr, diags := hclsyntax.ParseExpression(src, filename, start)
+	if diags.HasErrors() {
+		return nil, diags
+	}
+
+	nativeTokens, lexDiags := hclsyntax.LexExpression(src, filename, start)
+	if lexDiags.HasErrors() {
+		// should never happen, since we would've caught these diags in
+		// the first call above.
+		return nil, lexDiags
+	}
+
+	_, within, _ := newInputTokens(nativeTokens).Partition(nativeExpr.Range())
+	if within.Len() > 0 {
+		// Spaces before the expression are not part of it either. The
+		// writer tokens were created above, so this changes no one else's.
+		within.writerTokens[0].SpacesBefore = 0
+	}
+	return parseExpression(nativeExpr, within).content.(*Expression), diags
+}
+
 // inputTokens is a run of input tokens, both as hclsyntax lexed them and as
 // hclwrite keeps them, which the parse functions partition.
 //
@@ -77,6 +99,13 @@ type inputTokens struct {
 	writerTokens Tokens
 }
 
+func newInputTokens(nativeTokens hclsyntax.Tokens) inputTokens {
+	return inputTokens{
+		nativeTokens: nativeTokens,
+		writerTokens: writerTokens(nativeTokens),
+	}
+}
+
 func (it inputTokens) Partition(rng hcl.Range) (before, within, after inputTokens) {
 	start, end := partitionTokens(it.nativeTokens, rng)
 	before = it.Slice(0, start)
