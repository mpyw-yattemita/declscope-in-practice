   "servers": {
     "github": {
       "type": "http",
       "url": "https://api.githubcopilot.com/mcp/"
     }
   }
 }
 ```
 
 </td>
 <td>
 
 ```json
 {
   "servers": {
     "github": {
       "type": "http",
