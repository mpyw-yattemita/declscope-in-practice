+
+	tests := []struct {
+		name           string
+		restClient     *http.Client
+		gqlClient      *http.Client
+		requestArgs    map[string]any
+		expectedPR     *github.PullRequest
+		expectedErrMsg string
+	}{
+		{
+			name:       "convert to draft",
+			restClient: mock.NewMockedHTTPClient(getPR(draftPR)),
