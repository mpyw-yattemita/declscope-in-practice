+// subIssueResult turns the outcome of a sub-issue API call into a tool result.
+// An API error is reported through the GitHub API error helper, an unexpected
+// status code as a tool error, and a successful response as the JSON of v.
+// The client has already read and closed the response body, and decoded it into v.
+func subIssueResult(ctx context.Context, message string, v any, resp *github.Response, err error, wantStatus int) (*mcp.CallToolResult, error) {
+	if err != nil {
+		return ghErrors.NewGitHubAPIErrorResponse(ctx, message, resp, err), nil
+	}
+
+	if resp.StatusCode != wantStatus {
+		return mcp.NewToolResultError(fmt.Sprintf("%s: unexpected status %d", message, resp.StatusCode)), nil
+	}
+
+	r, err := json.Marshal(v)
+	if err != nil {
+		return nil, fmt.Errorf("failed to marshal response: %w", err)
+	}
+
+	return mcp.NewToolResultText(string(r)), nil
+}
