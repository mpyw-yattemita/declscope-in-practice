+		require.NoError(t, json.Unmarshal([]byte(text), &got))
+		assert.Equal(t, *expected.ID, *got.ID)
+		assert.Equal(t, *expected.Number, *got.Number)
+		assert.Equal(t, *expected.Title, *got.Title)
+	}
+}
