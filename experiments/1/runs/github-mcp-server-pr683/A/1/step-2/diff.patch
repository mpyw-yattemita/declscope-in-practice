+func unprocessable(message string) http.HandlerFunc {
+	return func(w http.ResponseWriter, _ *http.Request) {
+		w.WriteHeader(http.StatusUnprocessableEntity)
+		_, _ = w.Write([]byte(fmt.Sprintf(`{"message": %q}`, message)))
+	}
+}
