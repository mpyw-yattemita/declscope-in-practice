+// The githubv4 client builds the GraphQL document from the struct tags, so
+// each combination of category filter and ordering needs its own query type.
+type discussionsQuery interface {
+	connection() discussionConnection
+}
+
+type listDiscussionsQuery struct {
+	Repository struct {
+		Discussions discussionConnection `graphql:"discussions(first: $first, after: $after)"`
+	} `graphql:"repository(owner: $owner, name: $repo)"`
+}
+
+type listDiscussionsByCategoryQuery struct {
+	Repository struct {
+		Discussions discussionConnection `graphql:"discussions(first: $first, after: $after, categoryId: $categoryId)"`
+	} `graphql:"repository(owner: $owner, name: $repo)"`
+}
+
+type listDiscussionsOrderedQuery struct {
+	Repository struct {
+		Discussions discussionConnection `graphql:"discussions(first: $first, after: $after, orderBy: { field: $orderByField, direction: $orderByDirection })"`
+	} `graphql:"repository(owner: $owner, name: $repo)"`
+}
+
+type listDiscussionsByCategoryOrderedQuery struct {
+	Repository struct {
+		Discussions discussionConnection `graphql:"discussions(first: $first, after: $after, categoryId: $categoryId, orderBy: { field: $orderByField, direction: $orderByDirection })"`
+	} `graphql:"repository(owner: $owner, name: $repo)"`
+}
+
+func (q *listDiscussionsQuery) connection() discussionConnection {
+	return q.Repository.Discussions
+}
+func (q *listDiscussionsByCategoryQuery) connection() discussionConnection {
+	return q.Repository.Discussions
+}
+func (q *listDiscussionsOrderedQuery) connection() discussionConnection {
+	return q.Repository.Discussions
+}
+func (q *listDiscussionsByCategoryOrderedQuery) connection() discussionConnection {
+	return q.Repository.Discussions
+}
+
+// newDiscussionsQuery returns the query type for the given filter and ordering.
+func newDiscussionsQuery(byCategory, ordered bool) discussionsQuery {
+	switch {
+	case byCategory && ordered:
+		return &listDiscussionsByCategoryOrderedQuery{}
+	case byCategory:
+		return &listDiscussionsByCategoryQuery{}
+	case ordered:
+		return &listDiscussionsOrderedQuery{}
+	default:
+		return &listDiscussionsQuery{}
+	}
+}
