+func TestToFilterShape(t *testing.T) {
+	start, end := time.Unix(100, 0), time.Unix(200, 0)
+	tests := []struct {
+		name     string
+		query    func() TraceQueryParams
+		expected *expression.Call
+	}{
+		{
+			name:     "no predicates",
+			query:    func() TraceQueryParams { return TraceQueryParams{Attributes: pcommon.NewMap()} },
+			expected: nil,
+		},
+		{
+			name:     "service name alone",
+			query:    func() TraceQueryParams { return TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()} },
+			expected: call(expression.OpEq, serviceField, str("cart")),
+		},
+		{
+			name:     "operation name alone",
+			query:    func() TraceQueryParams { return TraceQueryParams{OperationName: "GET", Attributes: pcommon.NewMap()} },
+			expected: call(expression.OpEq, operationField, str("GET")),
+		},
+		{
+			name: "minimum duration alone",
+			query: func() TraceQueryParams {
+				return TraceQueryParams{DurationMin: time.Second, Attributes: pcommon.NewMap()}
+			},
+			expected: call(expression.OpGte, durationField, dur(time.Second)),
+		},
+		{
+			name: "maximum duration alone",
+			query: func() TraceQueryParams {
+				return TraceQueryParams{DurationMax: time.Second, Attributes: pcommon.NewMap()}
+			},
+			expected: call(expression.OpLte, durationField, dur(time.Second)),
+		},
+		{
+			name: "every field, in order",
+			query: func() TraceQueryParams {
+				q := TraceQueryParams{
+					ServiceName:   "cart",
+					OperationName: "GET /cart",
+					Attributes:    pcommon.NewMap(),
+					DurationMin:   time.Second,
+					DurationMax:   time.Minute,
+				}
+				q.Attributes.PutStr("http.method", "GET")
+				q.Attributes.PutInt("http.status_code", 500)
+				return q
+			},
+			expected: call(expression.OpAnd,
+				call(expression.OpEq, serviceField, str("cart")),
+				call(expression.OpEq, operationField, str("GET /cart")),
+				call(expression.OpEq, attr("http.method"), untyped("GET")),
+				call(expression.OpEq, attr("http.status_code"), untyped("500")),
+				call(expression.OpGte, durationField, dur(time.Second)),
+				call(expression.OpLte, durationField, dur(time.Minute))),
+		},
+		{
+			name:     "zero-value attribute map",
+			query:    func() TraceQueryParams { return TraceQueryParams{ServiceName: "cart"} },
+			expected: call(expression.OpEq, serviceField, str("cart")),
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			q := test.query()
+			q.StartTimeMin, q.StartTimeMax, q.SearchDepth = start, end, 20
+
+			got := q.ToFilterShape()
+
+			assert.Equal(t, TraceQueryParams{
+				Attributes:   pcommon.NewMap(),
+				StartTimeMin: start,
+				StartTimeMax: end,
+				SearchDepth:  20,
+				Filter:       test.expected,
+			}, got)
+			if got.Filter == nil {
+				return
+			}
+			require.NoError(t, expression.ValidateFilter(got.Filter))
+			resolved, err := expression.ResolveConstants(got.Filter)
+			require.NoError(t, err)
+			assert.Equal(t, got.Filter, resolved, "the filter needs no further resolution")
+		})
+	}
+}
