+func TestToLegacyShape_Converts(t *testing.T) {
+	tests := []struct {
+		name     string
+		filter   *expression.Call
+		expected TraceQueryParams
+		attrs    map[string]any
+	}{
+		{
+			name:     "service against an untyped constant",
+			filter:   call(expression.OpEq, serviceField, untyped("cart")),
+			expected: TraceQueryParams{ServiceName: "cart"},
+		},
+		{
+			name:     "operation against a string",
+			filter:   call(expression.OpEq, operationField, str("GET")),
+			expected: TraceQueryParams{OperationName: "GET"},
+		},
+		{
+			name: "duration bounds",
+			filter: call(expression.OpAnd,
+				call(expression.OpGte, durationField, dur(time.Second)),
+				call(expression.OpLte, durationField, dur(time.Minute))),
+			expected: TraceQueryParams{DurationMin: time.Second, DurationMax: time.Minute},
+		},
+		{
+			name: "qualified attributes widen to tags",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, &expression.AttributeRef{Key: "s", Level: expression.LevelSpan}, untyped("1")),
+				call(expression.OpEq, &expression.AttributeRef{Key: "r", Level: expression.LevelResource}, str("2")),
+				call(expression.OpEq, &expression.AttributeRef{Key: "e", Level: expression.LevelEvent}, untyped("3"))),
+			attrs: map[string]any{"s": "1", "r": "2", "e": "3"},
+		},
+		{
+			name: "a nested conjunction is flattened",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, serviceField, str("cart")),
+				call(expression.OpAnd,
+					call(expression.OpEq, attr("a"), untyped("1")),
+					call(expression.OpAnd,
+						call(expression.OpEq, attr("b"), untyped("2")),
+						call(expression.OpEq, operationField, str("GET"))))),
+			expected: TraceQueryParams{ServiceName: "cart", OperationName: "GET"},
+			attrs:    map[string]any{"a": "1", "b": "2"},
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			got, err := withFilter(test.filter).ToLegacyShape()
+			require.NoError(t, err)
+			assert.Nil(t, got.Filter)
+			attrs := test.attrs
+			if attrs == nil {
+				attrs = map[string]any{}
+			}
+			assert.Equal(t, attrs, got.Attributes.AsRaw())
+			got.Attributes = pcommon.Map{}
+			assert.Equal(t, test.expected, got)
+		})
+	}
+}
