 // Copyright (c) 2026 The Jaeger Authors.
 // SPDX-License-Identifier: Apache-2.0
 
 package tracestore
 
 import (
 	"testing"
 
 	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
 	"github.com/stretchr/testify/assert"
+	"github.com/stretchr/testify/require"
 )
 
 func TestFilterCapabilities_IsEmpty(t *testing.T) {
 	tests := []struct {
 		name string
 		caps *FilterCapabilities
 		want bool
 	}{
 		{name: "nil", caps: nil, want: true},
 		{name: "zero value", caps: &FilterCapabilities{}, want: true},
 		{
 			name: "empty non-nil slices",
 			caps: &FilterCapabilities{Levels: []expression.Level{}, Operators: []expression.Operator{}},
 			want: true,
 		},
 		{name: "one level", caps: &FilterCapabilities{Levels: []expression.Level{expression.LevelSpan}}, want: false},
 		{name: "one operator", caps: &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}}, want: false},
 	}
 	for _, tt := range tests {
 		t.Run(tt.name, func(t *testing.T) {
 			assert.Equal(t, tt.want, tt.caps.IsEmpty())
 		})
 	}
 }
 
 func TestFilterCapabilities_SupportsLevel(t *testing.T) {
 	caps := FilterCapabilities{Levels: []expression.Level{expression.LevelSpan, expression.LevelResource}}
 
 	assert.True(t, caps.SupportsLevel(""), "an unqualified reference always reaches the reader")
 	assert.True(t, caps.SupportsLevel(expression.LevelSpan))
 	assert.True(t, caps.SupportsLevel(expression.LevelResource))
 	assert.False(t, caps.SupportsLevel(expression.LevelScope))
 	assert.False(t, caps.SupportsLevel(expression.LevelEvent))
 
 	var zero FilterCapabilities
 	assert.True(t, zero.SupportsLevel(""), "the zero value still serves unqualified references")
 	assert.False(t, zero.SupportsLevel(expression.LevelSpan))
 }
 
 func TestFilterCapabilities_SupportsOperator(t *testing.T) {
 	conjunctive := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd, expression.OpEq}}
 
 	assert.True(t, conjunctive.SupportsOperator(expression.OpAnd))
 	assert.True(t, conjunctive.SupportsOperator(expression.OpEq))
 	assert.False(t, conjunctive.SupportsOperator(expression.OpOr), "OpOr is supported only when listed")
 	assert.False(t, conjunctive.SupportsOperator(expression.OpNot), "OpNot is supported only when listed")
 	assert.False(t, conjunctive.SupportsOperator(expression.OpRegex))
 
 	var zero FilterCapabilities
 	for _, op := range []expression.Operator{expression.OpAnd, expression.OpOr, expression.OpNot, expression.OpEq} {
 		assert.False(t, zero.SupportsOperator(op), "the zero value supports no operator, not even %q", op)
 	}
 }
+
+func TestFilterCapabilities_EnsureSupported(t *testing.T) {
+	caps := FilterCapabilities{
+		Levels:    []expression.Level{expression.LevelSpan},
+		Operators: []expression.Operator{expression.OpAnd, expression.OpEq, expression.OpNe, expression.OpIn, expression.OpSome},
+	}
+	spanAttr := &expression.AttributeRef{Key: "http.method", Level: expression.LevelSpan}
+	tests := []struct {
+		name        string
+		filter      *expression.Call
+		expectedErr string
+	}{
+		{name: "nil filter", filter: nil},
+		{
+			name:   "unqualified attribute against a constant",
+			filter: call(expression.OpEq, &expression.AttributeRef{Key: "a"}, &expression.AnyValue{Value: "1"}),
+		},
+		{
+			name: "conjunction of supported predicates",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, spanAttr, &expression.StringValue{Value: "GET"}),
+				call(expression.OpIn, spanAttr, &expression.List{Values: []string{"GET"}, Type: expression.ValueTypeString}),
+				call(expression.OpEq,
+					&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+					&expression.StringValue{Value: "op"})),
+		},
+		{
+			name:   "a nil argument is skipped",
+			filter: call(expression.OpAnd, (*expression.Call)(nil), &expression.StringValue{Value: "x"}),
+		},
+		{
+			name:        "an operator it does not list",
+			filter:      call(expression.OpGt, spanAttr, &expression.IntValue{Value: 1}),
+			expectedErr: `it does not support the operator "gt"`,
+		},
+		{
+			name: "an operator it does not list, nested",
+			filter: call(expression.OpAnd,
+				call(expression.OpEq, spanAttr, &expression.AnyValue{Value: "GET"}),
+				call(expression.OpOr,
+					call(expression.OpEq, spanAttr, &expression.AnyValue{Value: "GET"}),
+					call(expression.OpEq, spanAttr, &expression.AnyValue{Value: "PUT"}))),
+			expectedErr: `it does not support the operator "or"`,
+		},
+		{
+			name:        "an attribute at a level it does not index",
+			filter:      call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelResource}, &expression.AnyValue{Value: "1"}),
+			expectedErr: `it does not index the "resource" level`,
+		},
+		{
+			name: "a field at a level it does not index",
+			filter: call(expression.OpEq,
+				&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+				&expression.StringValue{Value: "cart"}),
+			expectedErr: `it does not index the "resource" level`,
+		},
+		{
+			name:        "a reference on the right of a comparison",
+			filter:      call(expression.OpNe, spanAttr, &expression.AttributeRef{Key: "a", Level: expression.LevelEvent}),
+			expectedErr: `it does not index the "event" level`,
+		},
+		{
+			name: "a nested call on the right of a comparison",
+			filter: call(expression.OpEq, spanAttr,
+				call(expression.OpExists, spanAttr)),
+			expectedErr: `it does not support the operator "exists"`,
+		},
+		{
+			name: "a collection it does not index",
+			filter: call(expression.OpSome,
+				&expression.NestedRef{Level: expression.LevelLink},
+				call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelLink}, &expression.AnyValue{Value: "1"})),
+			expectedErr: `it does not index the "link" level`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := caps.EnsureSupported(test.filter)
+			if test.expectedErr == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, test.expectedErr)
+		})
+	}
+}
+
+func TestFilterCapabilities_EnsureSupported_RefusesACycle(t *testing.T) {
+	caps := FilterCapabilities{Operators: []expression.Operator{expression.OpAnd, expression.OpEq}}
+	cycle := &expression.Call{Op: expression.OpAnd}
+	cycle.Args = []expression.Expression{cycle, cycle}
+
+	err := caps.EnsureSupported(cycle)
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	require.ErrorIs(t, err, expression.ErrTooDeeplyNested)
+}
+
+func call(op expression.Operator, args ...expression.Expression) *expression.Call {
+	return &expression.Call{Op: op, Args: args}
+}
diff --git a/internal/storage/v2/api/tracestore/query_shape.go b/internal/storage/v2/api/tracestore/query_shape.go
new file mode 100644
index 0000000..c88c3b0
--- /dev/null
+++ b/internal/storage/v2/api/tracestore/query_shape.go
@@ -0,0 +1,335 @@
+// Copyright (c) 2026 The Jaeger Authors.
+// SPDX-License-Identifier: Apache-2.0
+
+package tracestore
+
+import (
+	"fmt"
+	"time"
+
+	expression "github.com/jaegertracing/jaeger-idl/query/expression/v1"
+	"go.opentelemetry.io/collector/pdata/pcommon"
+)
+
+// The names of the legacy predicate fields, as the query API spells them.
+const (
+	legacyFieldServiceName   = "service_name"
+	legacyFieldOperationName = "operation_name"
+	legacyFieldDurationMin   = "duration_min"
+	legacyFieldDurationMax   = "duration_max"
+	legacyFieldAttributes    = "attributes"
+)
+
+// EnsureFilterStandsAlone rejects a query that carries both a filter and one
+// of the predicate fields the filter replaces. A Reader sees one filtering
+// model, so a mix of the two is malformed whatever the backend can do.
+func (q TraceQueryParams) EnsureFilterStandsAlone() error {
+	if q.Filter == nil {
+		return nil
+	}
+	var conflicts []string
+	if q.ServiceName != "" {
+		conflicts = append(conflicts, legacyFieldServiceName)
+	}
+	if q.OperationName != "" {
+		conflicts = append(conflicts, legacyFieldOperationName)
+	}
+	if q.DurationMin != 0 {
+		conflicts = append(conflicts, legacyFieldDurationMin)
+	}
+	if q.DurationMax != 0 {
+		conflicts = append(conflicts, legacyFieldDurationMax)
+	}
+	if attributeCount(q.Attributes) > 0 {
+		conflicts = append(conflicts, legacyFieldAttributes)
+	}
+	if len(conflicts) == 0 {
+		return nil
+	}
+	return fmt.Errorf("%w: a filter cannot be combined with the predicate fields %v", ErrFilterInvalid, conflicts)
+}
+
+// ForCapabilities gives the Reader whichever of the two filtering models it
+// declared it can evaluate. A Reader that declares filter support receives the
+// filter as it is, provided it can evaluate all of it; any other Reader
+// receives the filter rewritten into the legacy predicate fields.
+func (q TraceQueryParams) ForCapabilities(caps SearchCapabilities) (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if caps.Filter.IsEmpty() {
+		return q.ToLegacyShape()
+	}
+	return q, caps.Filter.EnsureSupported(q.Filter)
+}
+
+// ToFilterShape expresses q's scalar predicate fields as filter predicates. It
+// cannot fail, because each legacy field has an exact filter equivalent. A
+// query that already has a Filter is returned as it is.
+//
+// An attribute is compared as an untyped constant holding the value's string
+// form, because a tag never declared a type.
+func (q TraceQueryParams) ToFilterShape() TraceQueryParams {
+	if q.Filter != nil {
+		return q
+	}
+	var predicates []*expression.Call
+	if q.ServiceName != "" {
+		predicates = append(predicates, equals(
+			&expression.FieldRef{Level: expression.LevelResource, Name: expression.ResourceFieldService},
+			&expression.StringValue{Value: q.ServiceName}))
+	}
+	if q.OperationName != "" {
+		predicates = append(predicates, equals(
+			&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldName},
+			&expression.StringValue{Value: q.OperationName}))
+	}
+	if attributeCount(q.Attributes) > 0 {
+		for key, value := range q.Attributes.All() {
+			predicates = append(predicates, equals(
+				&expression.AttributeRef{Key: key},
+				&expression.AnyValue{Value: value.AsString()}))
+		}
+	}
+	if q.DurationMin != 0 {
+		predicates = append(predicates, durationBound(expression.OpGte, q.DurationMin))
+	}
+	if q.DurationMax != 0 {
+		predicates = append(predicates, durationBound(expression.OpLte, q.DurationMax))
+	}
+
+	q.ServiceName = ""
+	q.OperationName = ""
+	q.Attributes = pcommon.NewMap()
+	q.DurationMin = 0
+	q.DurationMax = 0
+	switch len(predicates) {
+	case 0:
+		q.Filter = nil
+	case 1:
+		q.Filter = predicates[0]
+	default:
+		args := make([]expression.Expression, len(predicates))
+		for i, predicate := range predicates {
+			args[i] = predicate
+		}
+		q.Filter = &expression.Call{Op: expression.OpAnd, Args: args}
+	}
+	return q
+}
+
+// ToLegacyShape expresses q's Filter in the scalar predicate fields every
+// backend serves. Those fields can say only "all of these hold", so only a flat
+// conjunction converts (a nested and is flattened), and each conjunct has to be
+// one that a legacy field expresses exactly. Anything else is refused rather
+// than approximated, because a dropped predicate widens the result.
+//
+// The result has a nil Filter and a new Attributes map, so the caller's map is
+// not changed. On error the original query is returned. A query that also
+// carries legacy predicate fields is refused as EnsureFilterStandsAlone refuses
+// it, since converting it would merge two filtering models.
+func (q TraceQueryParams) ToLegacyShape() (TraceQueryParams, error) {
+	if q.Filter == nil {
+		return q, nil
+	}
+	if err := q.EnsureFilterStandsAlone(); err != nil {
+		return q, err
+	}
+	conjuncts, err := flattenConjunction(q.Filter, nil, 1)
+	if err != nil {
+		return q, err
+	}
+	w := legacyWriter{query: q}
+	w.query.Filter = nil
+	w.query.Attributes = pcommon.NewMap()
+	for _, conjunct := range conjuncts {
+		if err := w.write(conjunct); err != nil {
+			return q, err
+		}
+	}
+	return w.query, nil
+}
+
+// attributeCount is the number of entries in m, reading a Map left at its zero
+// value (not created with pcommon.NewMap) as empty rather than panicking.
+func attributeCount(m pcommon.Map) int {
+	if m == (pcommon.Map{}) {
+		return 0
+	}
+	return m.Len()
+}
+
+func equals(ref, constant expression.Expression) *expression.Call {
+	return &expression.Call{Op: expression.OpEq, Args: []expression.Expression{ref, constant}}
+}
+
+func durationBound(op expression.Operator, d time.Duration) *expression.Call {
+	return &expression.Call{Op: op, Args: []expression.Expression{
+		&expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldDuration},
+		&expression.DurationValue{Value: d},
+	}}
+}
+
+// flattenConjunction appends to into the predicates call conjoins, descending
+// into nested conjunctions. depth bounds the walk, so a filter that contains
+// itself is refused rather than followed forever.
+func flattenConjunction(call *expression.Call, into []*expression.Call, depth int) ([]*expression.Call, error) {
+	if depth > expression.MaxNestingDepth {
+		return nil, fmt.Errorf("%w: %w", ErrFilterInvalid, expression.ErrTooDeeplyNested)
+	}
+	if call.Op != expression.OpAnd {
+		return append(into, call), nil
+	}
+	for _, arg := range call.Args {
+		nested, ok := arg.(*expression.Call)
+		if !ok || nested == nil {
+			return nil, fmt.Errorf("%w: it serves a conjunction of predicates only", ErrFilterUnsupported)
+		}
+		var err error
+		if into, err = flattenConjunction(nested, into, depth+1); err != nil {
+			return nil, err
+		}
+	}
+	return into, nil
+}
+
+// legacyWriter writes conjuncts into the legacy predicate fields of query,
+// refusing a second predicate on a field one has already written.
+type legacyWriter struct {
+	query                                    TraceQueryParams
+	hasService, hasOperation, hasMin, hasMax bool
+}
+
+func (w *legacyWriter) write(call *expression.Call) error {
+	switch call.Op {
+	case expression.OpOr, expression.OpNot, expression.OpExists:
+		return errOperator(call.Op)
+	}
+	if len(call.Args) != 2 {
+		return errOperator(call.Op)
+	}
+	switch ref := call.Args[0].(type) {
+	case *expression.AttributeRef:
+		if ref != nil {
+			return w.writeAttribute(call.Op, ref, call.Args[1])
+		}
+	case *expression.FieldRef:
+		if ref != nil {
+			return w.writeField(call.Op, ref, call.Args[1])
+		}
+	}
+	return fmt.Errorf("%w: it compares a reference against a constant only", ErrFilterUnsupported)
+}
+
+func (w *legacyWriter) writeAttribute(op expression.Operator, ref *expression.AttributeRef, operand expression.Expression) error {
+	switch ref.Level {
+	case "", expression.LevelSpan, expression.LevelResource, expression.LevelEvent:
+		// A plain tag matches the span, resource and event levels alike, so a
+		// qualified attribute widens to one.
+	default:
+		return errLevel(ref.Level)
+	}
+	if op != expression.OpEq {
+		return errOperatorOn(op, ref.Key)
+	}
+	value, err := stringOperand(ref.Key, operand)
+	if err != nil {
+		return err
+	}
+	if _, ok := w.query.Attributes.Get(ref.Key); ok {
+		return errSecondPredicate(ref.Key)
+	}
+	w.query.Attributes.PutStr(ref.Key, value)
+	return nil
+}
+
+func (w *legacyWriter) writeField(op expression.Operator, ref *expression.FieldRef, operand expression.Expression) error {
+	switch {
+	case ref.Level == expression.LevelResource && ref.Name == expression.ResourceFieldService:
+		return writeString(op, ref.Name, operand, &w.hasService, &w.query.ServiceName)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldName:
+		return writeString(op, ref.Name, operand, &w.hasOperation, &w.query.OperationName)
+	case ref.Level == expression.LevelSpan && ref.Name == expression.SpanFieldDuration:
+		switch op {
+		case expression.OpGte:
+			return writeDuration(op, ref.Name, operand, &w.hasMin, &w.query.DurationMin)
+		case expression.OpLte:
+			return writeDuration(op, ref.Name, operand, &w.hasMax, &w.query.DurationMax)
+		default:
+			return errOperatorOn(op, ref.Name)
+		}
+	default:
+		return fmt.Errorf("%w: it does not support the built-in field %q of the %q level",
+			ErrFilterUnsupported, ref.Name, ref.Level)
+	}
+}
+
+// writeString writes an equality on a string field into dst, which written
+// marks as taken.
+func writeString(op expression.Operator, name string, operand expression.Expression, written *bool, dst *string) error {
+	if op != expression.OpEq {
+		return errOperatorOn(op, name)
+	}
+	value, err := stringOperand(name, operand)
+	if err != nil {
+		return err
+	}
+	if *written {
+		return errSecondPredicate(name)
+	}
+	*written, *dst = true, value
+	return nil
+}
+
+// writeDuration writes an inclusive duration bound into dst, which written
+// marks as taken.
+func writeDuration(op expression.Operator, name string, operand expression.Expression, written *bool, dst *time.Duration) error {
+	var value time.Duration
+	switch constant := operand.(type) {
+	case *expression.DurationValue:
+		if constant == nil {
+			return errNotADuration(name)
+		}
+		value = constant.Value
+	case *expression.AnyValue:
+		if constant == nil {
+			return errNotADuration(name)
+		}
+		return fmt.Errorf("%w: the bound %q on %q was never read as a duration", ErrFilterInvalid, constant.Value, name)
+	default:
+		return errNotADuration(name)
+	}
+	if *written {
+		return errSecondPredicate(name)
+	}
+	*written, *dst = true, value
+	return nil
+}
+
+// stringOperand returns the text of a string or untyped constant, the only
+// constants a legacy string field or tag can hold.
+func stringOperand(name string, operand expression.Expression) (string, error) {
+	switch constant := operand.(type) {
+	case *expression.StringValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	case *expression.AnyValue:
+		if constant != nil {
+			return constant.Value, nil
+		}
+	}
+	return "", fmt.Errorf("%w: it compares %q against a string constant only", ErrFilterUnsupported, name)
+}
+
+func errOperatorOn(op expression.Operator, name string) error {
+	return fmt.Errorf("%w: it does not support the operator %q on %q", ErrFilterUnsupported, op, name)
+}
+
+func errNotADuration(name string) error {
+	return fmt.Errorf("%w: it compares %q against a duration such as \"2s\" only", ErrFilterUnsupported, name)
+}
+
+func errSecondPredicate(name string) error {
+	return fmt.Errorf("%w: it serves only one predicate on %q", ErrFilterUnsupported, name)
+}
