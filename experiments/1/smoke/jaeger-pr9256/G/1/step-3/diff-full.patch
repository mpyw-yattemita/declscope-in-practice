+func TestForCapabilities(t *testing.T) {
+	filter := call(expression.OpEq, attr("http.method"), untyped("GET"))
+	declaring := SearchCapabilities{Filter: &FilterCapabilities{Operators: []expression.Operator{expression.OpEq}}}
+
+	t.Run("no filter is returned unchanged", func(t *testing.T) {
+		q := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+		got, err := q.ForCapabilities(declaring)
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("a reader declaring nothing gets the legacy shape", func(t *testing.T) {
+		for name, caps := range map[string]SearchCapabilities{
+			"nil declaration":   {},
+			"empty declaration": {Filter: &FilterCapabilities{}},
+		} {
+			t.Run(name, func(t *testing.T) {
+				got, err := withFilter(filter).ForCapabilities(caps)
+				require.NoError(t, err)
+				assert.Nil(t, got.Filter)
+				assert.Equal(t, map[string]any{"http.method": "GET"}, got.Attributes.AsRaw())
+			})
+		}
+	})
+
+	t.Run("a reader declaring nothing gets the legacy refusal", func(t *testing.T) {
+		q := withFilter(call(expression.OpOr, filter, filter))
+		got, err := q.ForCapabilities(SearchCapabilities{})
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("a declaring reader gets the filter as it is", func(t *testing.T) {
+		q := withFilter(filter)
+		got, err := q.ForCapabilities(declaring)
+		require.NoError(t, err)
+		assert.Equal(t, q, got)
+	})
+
+	t.Run("a declaring reader refuses what it did not declare", func(t *testing.T) {
+		q := withFilter(call(expression.OpNe, attr("http.method"), untyped("GET")))
+		got, err := q.ForCapabilities(declaring)
+		require.ErrorIs(t, err, ErrFilterUnsupported)
+		require.ErrorContains(t, err, `does not support the operator "ne"`)
+		assert.Equal(t, q, got)
+	})
+}
