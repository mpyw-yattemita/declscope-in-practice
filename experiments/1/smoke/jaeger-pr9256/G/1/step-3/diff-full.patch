+func TestToLegacyShape_Refuses(t *testing.T) {
+	eqA := call(expression.OpEq, attr("a"), untyped("1"))
+	tests := []struct {
+		name        string
+		filter      *expression.Call
+		expectedErr string
+	}{
+		{"or", call(expression.OpOr, eqA, eqA), `does not support the operator "or"`},
+		{"not", call(expression.OpNot, eqA), `does not support the operator "not"`},
+		{"exists", call(expression.OpExists, attr("a")), `does not support the operator "exists"`},
+		{
+			"or nested in a conjunction",
+			call(expression.OpAnd, eqA, call(expression.OpOr, eqA, eqA)),
+			`does not support the operator "or"`,
+		},
+		{"a predicate with one argument", call(expression.OpEq, attr("a")), `does not support the operator "eq"`},
+		{"a conjunct that is not a predicate", call(expression.OpAnd, eqA, attr("b")), "conjunction of predicates only"},
+		{"a nil conjunct", call(expression.OpAnd, eqA, (*expression.Call)(nil)), "conjunction of predicates only"},
+		{"ne on an attribute", call(expression.OpNe, attr("http.method"), untyped("GET")), `does not support the operator "ne" on "http.method"`},
+		{
+			"in on an attribute",
+			call(expression.OpIn, attr("http.status_code"), &expression.List{Values: []string{"500"}, Type: expression.ValueTypeInt}),
+			`does not support the operator "in" on "http.status_code"`,
+		},
+		{"gt on duration", call(expression.OpGt, durationField, dur(time.Second)), `does not support the operator "gt" on "duration"`},
+		{"regex on name", call(expression.OpRegex, operationField, str("GET.*")), `does not support the operator "regex" on "name"`},
+		{"ne on service", call(expression.OpNe, serviceField, str("cart")), `does not support the operator "ne" on "service"`},
+		{
+			"a link attribute",
+			call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelLink}, untyped("1")),
+			`does not index the "link" level`,
+		},
+		{
+			"a scope attribute",
+			call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelScope}, untyped("1")),
+			`does not index the "scope" level`,
+		},
+		{
+			"another built-in field",
+			call(expression.OpEq, &expression.FieldRef{Level: expression.LevelSpan, Name: expression.SpanFieldKind}, str("server")),
+			`does not support the built-in field "kind" of the "span" level`,
+		},
+		{"an attribute against an integer", call(expression.OpEq, attr("code"), &expression.IntValue{Value: 500}), `compares "code" against a string constant only`},
+		{"an attribute against a boolean", call(expression.OpEq, attr("ok"), &expression.BoolValue{Value: true}), `compares "ok" against a string constant only`},
+		{
+			"an attribute against a list",
+			call(expression.OpEq, attr("a"), &expression.List{Values: []string{"1"}, Type: expression.ValueTypeString}),
+			`compares "a" against a string constant only`,
+		},
+		{"an attribute against a nil constant", call(expression.OpEq, attr("a"), (*expression.StringValue)(nil)), `compares "a" against a string constant only`},
+		{"service against a reference", call(expression.OpEq, serviceField, attr("peer.service")), `compares "service" against a string constant only`},
+		{"operation against an integer", call(expression.OpEq, operationField, &expression.IntValue{Value: 1}), `compares "name" against a string constant only`},
+		{"duration against a string", call(expression.OpGte, durationField, str("2s")), `compares "duration" against a duration such as "2s" only`},
+		{"duration against a nil constant", call(expression.OpGte, durationField, (*expression.DurationValue)(nil)), `compares "duration" against a duration such as "2s" only`},
+		{"duration against an untyped nil constant", call(expression.OpGte, durationField, (*expression.AnyValue)(nil)), `compares "duration" against a duration such as "2s" only`},
+		{
+			"a quantifier over the events",
+			call(expression.OpSome, &expression.NestedRef{Level: expression.LevelEvent},
+				call(expression.OpEq, &expression.FieldRef{Level: expression.LevelEvent, Name: expression.EventFieldName}, str("exception"))),
+			"compares a reference against a constant only",
+		},
+		{"a constant on the left", call(expression.OpEq, untyped("1"), attr("a")), "compares a reference against a constant only"},
+		{"a nil reference on the left", call(expression.OpEq, (*expression.AttributeRef)(nil), untyped("1")), "compares a reference against a constant only"},
+		{"a nil field on the left", call(expression.OpEq, (*expression.FieldRef)(nil), untyped("1")), "compares a reference against a constant only"},
+		{
+			"the same attribute twice",
+			call(expression.OpAnd, eqA, call(expression.OpEq, &expression.AttributeRef{Key: "a", Level: expression.LevelSpan}, untyped("2"))),
+			`only one predicate on "a"`,
+		},
+		{
+			"the service twice",
+			call(expression.OpAnd, call(expression.OpEq, serviceField, str("a")), call(expression.OpEq, serviceField, str("b"))),
+			`only one predicate on "service"`,
+		},
+		{
+			"the operation twice",
+			call(expression.OpAnd, call(expression.OpEq, operationField, str("a")), call(expression.OpEq, operationField, str("b"))),
+			`only one predicate on "name"`,
+		},
+		{
+			"the minimum duration twice",
+			call(expression.OpAnd, call(expression.OpGte, durationField, dur(time.Second)), call(expression.OpGte, durationField, dur(0))),
+			`only one predicate on "duration"`,
+		},
+		{
+			"the maximum duration twice",
+			call(expression.OpAnd, call(expression.OpLte, durationField, dur(time.Second)), call(expression.OpLte, durationField, dur(time.Minute))),
+			`only one predicate on "duration"`,
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			q := withFilter(test.filter)
+			got, err := q.ToLegacyShape()
+			require.ErrorIs(t, err, ErrFilterUnsupported)
+			assert.ErrorContains(t, err, test.expectedErr)
+			assert.Equal(t, q, got, "the original query is returned")
+		})
+	}
+}
+
+func TestToLegacyShape_RefusesAnUnresolvedDuration(t *testing.T) {
+	q := withFilter(call(expression.OpGte, durationField, untyped("2s")))
+	got, err := q.ToLegacyShape()
+	require.ErrorIs(t, err, ErrFilterInvalid)
+	require.ErrorContains(t, err, `the bound "2s" on "duration" was never read as a duration`)
+	assert.Equal(t, q, got)
+}
+
+func TestToLegacyShape_RefusesAMixedQuery(t *testing.T) {
