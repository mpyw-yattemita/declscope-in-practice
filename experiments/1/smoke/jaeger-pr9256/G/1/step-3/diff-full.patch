+func TestEnsureFilterStandsAlone(t *testing.T) {
+	filter := call(expression.OpEq, attr("a"), untyped("1"))
+	tests := []struct {
+		name     string
+		query    func() TraceQueryParams
+		expected string
+	}{
+		{
+			name: "no filter",
+			query: func() TraceQueryParams {
+				q := TraceQueryParams{ServiceName: "cart", Attributes: pcommon.NewMap()}
+				q.Attributes.PutStr("a", "1")
+				return q
+			},
+		},
+		{name: "filter with an empty attribute map", query: func() TraceQueryParams { return withFilter(filter) }},
+		{name: "filter with a zero-value attribute map", query: func() TraceQueryParams { return TraceQueryParams{Filter: filter} }},
+		{
+			name: "filter beside a service name",
+			query: func() TraceQueryParams {
+				q := withFilter(filter)
+				q.ServiceName = "cart"
+				return q
+			},
+			expected: "[service_name]",
+		},
+		{
+			name: "filter beside every legacy field",
+			query: func() TraceQueryParams {
+				q := withFilter(filter)
+				q.ServiceName = "cart"
+				q.OperationName = "GET /cart"
+				q.DurationMin = time.Second
+				q.DurationMax = time.Minute
+				q.Attributes.PutStr("a", "1")
+				return q
+			},
+			expected: "[service_name operation_name duration_min duration_max attributes]",
+		},
+	}
+	for _, test := range tests {
+		t.Run(test.name, func(t *testing.T) {
+			err := test.query().EnsureFilterStandsAlone()
+			if test.expected == "" {
+				require.NoError(t, err)
+				return
+			}
+			require.ErrorIs(t, err, ErrFilterInvalid)
+			assert.ErrorContains(t, err, test.expected)
+		})
+	}
+}
