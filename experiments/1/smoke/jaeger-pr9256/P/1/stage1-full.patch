 		TagKeysAsFields:   []string{"a", "b.b", "b*"},
 		TagDotReplacement: ":",
 	})
 	converter.convertNestedTagsToFieldTags(&dbSpan)
 
 	assert.Len(t, dbSpan.Tags, 1)
