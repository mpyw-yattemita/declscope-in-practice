 	focalService := r.URL.Query().Get("service")
 	data := deepdependencies.GetData(focalService)
 	aH.writeJSON(w, r, &data)
 }
 
 func (aH *APIHandler) latencies(w http.ResponseWriter, r *http.Request) {
