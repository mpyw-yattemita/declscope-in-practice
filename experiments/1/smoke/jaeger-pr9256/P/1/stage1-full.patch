 			},
 		},
 		{
 			Spans: []*model.Span{
 				{
 					TraceID:       model.NewTraceID(6, 7),
 					SpanID:        model.SpanID(3),
 					OperationName: "operation-c",
 				},
 			},
 		},
 	}
 	sr := new(spanstoremocks.Reader)
