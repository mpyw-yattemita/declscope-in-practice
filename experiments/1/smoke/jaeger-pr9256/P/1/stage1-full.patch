 func TestBuildSpanItem(t *testing.T) {
 	withSpanWriter(func(w *spanWriterTest) {
 		item, err := w.writer.buildSpanItem("jaeger-1995-04-21", &dbmodel.Span{})
 
 		require.NoError(t, err)
