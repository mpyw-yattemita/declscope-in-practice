+				assert.Equal(t, clickhouse.DefaultConfiguration().AttributeMetadataCacheMaxSize, tb.ClickHouse.AttributeMetadataCacheMaxSize)
+				require.NoError(t, xconfmap.Validate(tb))
+			},
+		},
