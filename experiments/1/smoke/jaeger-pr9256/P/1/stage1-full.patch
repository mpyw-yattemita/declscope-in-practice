 	TraceID pcommon.TraceID
 	Start   time.Time
 	End     time.Time
 }
 
 // OperationQueryParams contains parameters of query operations, empty spanKind means get operations for all kinds of span.
 type OperationQueryParams struct {
 	ServiceName string
 	SpanKind    string
 }
 
