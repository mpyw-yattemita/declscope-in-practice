 	reader, err := NewSpanReader(session, metricsFactory, logger, tracer.Tracer("test"))
 	require.NoError(t, err)
 	r := &spanReaderTest{
 		session:     session,
 		logger:      logger,
 		logBuffer:   logBuffer,
 		traceBuffer: exp,
 		reader:      reader,
 	}
