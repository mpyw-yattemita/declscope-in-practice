 func mockIter(traces []cassdbmodel.Trace, err error) iter.Seq2[cassdbmodel.Trace, error] {
 	return func(yield func(cassdbmodel.Trace, error) bool) {
 		if err != nil {
 			yield(cassdbmodel.Trace{}, err)
 			return
 		}
 		for _, trace := range traces {
 			if !yield(trace, err) {
 				return
 			}
 		}
 	}
 }
