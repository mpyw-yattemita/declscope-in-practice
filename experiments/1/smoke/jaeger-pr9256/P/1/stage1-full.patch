 	}
 }
 
 func newToolCallRequestWithMeta(toolName string, meta mcp.Meta) *mcp.ServerRequest[*mcp.CallToolParamsRaw] {
 	return &mcp.ServerRequest[*mcp.CallToolParamsRaw]{
 		Params: &mcp.CallToolParamsRaw{
 			Meta: meta,
